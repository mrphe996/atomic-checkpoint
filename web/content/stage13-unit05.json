a?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "error", "t": "Counting the edges instead", "p": ["Find the first wrong line."], "q": "Area of a 3 by 2 rectangle.", "lines": ["3 + 2 + 3 + 2 = 10"], "bad": 0, "why": "That is the perimeter. Area = squares inside = 6.", "fix": [["6 squares", ""]], "id": "m3u05s3t04"}, {"k": "mistake", "t": "Mixing up area and perimeter", "p": ["Area = squares inside; perimeter = around the edge."]}, {"k": "tip", "t": "Real life", "p": ["Tiling a floor, covering a book and planting a garden need area."]}, {"k": "summary", "t": "What to remember", "p": ["Area = surface covered.", "Count squares; pair halves.", "Rows × columns for rectangles."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "5.3-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u05s3k01", "type": "mcq", "prompt": "Before you read on: bigger floor?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "B (15 tiles)", "ok": true, "fb": ""}, {"t": "A (12 tiles)", "ok": false, "fb": ""}]}}, {"id": "5.3-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u05s3k02", "type": "num", "prompt": "Area of a 2 by 3 rectangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.3-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u05s3k03", "type": "num", "prompt": "4 rows of 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.3-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u05s3k04", "type": "num", "prompt": "Quick check: area of 3 by 2?", "diff": "M", "obj": "O1", "skill": "Appli