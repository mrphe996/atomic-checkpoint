{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 5, "stage": 13, "title": "Measurement, Area and Perimeter", "strandShort": "Geometry and measure", "blurb": "Measuring length in centimetres, metres and kilometres, finding the perimeter of shapes, and finding area by counting squares.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u05.pdf"}, "objectives": {"O1": {"code": "3Gm.01", "sec": "5.1", "codeNote": "", "t": "Estimate and measure lengths in centimetres, metres and kilometres, and convert between cm and m."}, "O2": {"code": "3Gm.02", "sec": "5.2", "codeNote": "", "t": "Find the perimeter of 2D shapes by adding the lengths of the sides."}, "O3": {"code": "3Gm.03", "sec": "5.3", "codeNote": "", "t": "Find the area of 2D shapes by counting squares."}}, "sections": [{"id": "5.1", "title": "Measurement", "objs": ["O1"], "lesson": [{"k": "hook", "t": "How long?", "p": ["A pencil, a classroom and the road to the next town all have a length.", "Would you measure them all with the same unit? Think before you read on."]}, {"k": "recall", "t": "Using a ruler", "p": ["Start measuring from 0 on the ruler."], "qq": {"id": "m3u05s1t01", "type": "num", "prompt": "A pencil starts at 0 and ends at 15 on a cm ruler. Length (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15 cm."}}, {"k": "idea", "t": "Units of length", "p": [], "table": {"head": ["Unit", "Use for", "Example"], "rows": [["centimetre (cm)", "small things", "a pencil: 15 cm"], ["metre (m)", "rooms, people, buildings", "a door: 2 m"], ["kilometre (km)", "long distances", "to the next town: 8 km"]]}, "p2": ["**100 cm = 1 m** and **1000 m = 1 km**."]}, {"k": "idea", "t": "Estimating and converting", "p": ["Use things you know to **estimate**: your hand span is about 15 cm; a big step is about 1 m.", "Convert: 3 m = 300 cm; 250 cm = 2 m 50 cm; 1½ m = 150 cm."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m3u05s1t02", "type": "num", "prompt": "How many cm in 4 m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 400, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "400."}}, {"k": "method", "t": "How do I measure and convert lengths?", "p": ["Step 1: Choose a sensible unit.", "Step 2: Measure from 0 on the ruler or tape.", "Step 3: m → cm: × 100. cm → m: ÷ 100.", "Step 4: Write the unit with your answer."]}, {"k": "example", "t": "Choose a unit", "p": [], "q": "The length of a football pitch.", "steps": [["too big for cm, too small for km", ""]], "a": "metres"}, {"k": "example", "t": "Convert", "p": [], "q": "600 cm in metres.", "steps": [["÷ 100", ""]], "a": "6 m"}, {"k": "example", "t": "Mixed units", "p": [], "q": "1 m 35 cm in cm.", "steps": [["100 + 35", ""]], "a": "135 cm"}, {"k": "example", "t": "Compare", "p": [], "q": "Which is longer: 2 m or 180 cm?", "steps": [["2 m = 200 cm", ""]], "a": "2 m"}, {"k": "try", "t": "Unit", "p": [], "qq": {"id": "m3u05s1t03", "type": "mcq", "prompt": "Best unit for the length of an ant:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm", "ok": true, "fb": ""}, {"t": "m", "ok": false, "fb": ""}, {"t": "km", "ok": false, "fb": ""}], "fixed": true}}, {"k": "error", "t": "Mixing units", "p": ["Find the first wrong line."], "q": "Which is longer: 3 m or 90 cm?", "lines": ["90 > 3, so 90 cm is longer"], "bad": 0, "why": "3 m = 300 cm, and 300 > 90: 3 m is longer.", "fix": [["3 m", ""]], "id": "m3u05s1t04"}, {"k": "mistake", "t": "Comparing lengths in different units", "p": ["Change to the same unit first."]}, {"k": "tip", "t": "Real life", "p": ["Builders, tailors and runners all measure length – a running track lap is 400 m."]}, {"k": "summary", "t": "What to remember", "p": ["cm small, m medium, km long.", "100 cm = 1 m; 1000 m = 1 km.", "Same unit before comparing."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "5.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u05s1k01", "type": "mcq", "prompt": "Before you read on: measure the road to town in…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "km", "ok": true, "fb": ""}, {"t": "cm", "ok": false, "fb": ""}]}}, {"id": "5.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u05s1k02", "type": "num", "prompt": "cm in 1 m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u05s1k03", "type": "num", "prompt": "600 cm in m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u05s1k04", "type": "mcq", "prompt": "Quick check: longer?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3 m", "ok": true, "fb": ""}, {"t": "90 cm", "ok": false, "fb": ""}]}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u05s1r01", "type": "num", "prompt": "cm in 2 m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 200, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1r02", "type": "num", "prompt": "500 cm in m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1r03", "type": "num", "prompt": "m in 1 km?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1r04", "type": "num", "prompt": "1 m 20 cm in cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 120, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1r05", "type": "mcq", "prompt": "Height of a tree:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm", "ok": false, "fb": ""}, {"t": "m", "ok": true, "fb": ""}, {"t": "km", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u05s1r06", "type": "mcq", "prompt": "Length of a book:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm", "ok": true, "fb": ""}, {"t": "m", "ok": false, "fb": ""}, {"t": "km", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u05s1r07", "type": "mcq", "prompt": "Distance between two cities:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm", "ok": false, "fb": ""}, {"t": "m", "ok": false, "fb": ""}, {"t": "km", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u05s1r08", "type": "num", "prompt": "Half a metre in cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m3u05s1p01", "type": "num", "prompt": "350 cm = 3 m and ? cm", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1p02", "type": "num", "prompt": "2 km in m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1p03", "type": "mcq", "prompt": "Longest?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1 km", "ok": true, "fb": ""}, {"t": "900 m", "ok": false, "fb": ""}, {"t": "99 cm", "ok": false, "fb": ""}]}, {"id": "m3u05s1p04", "type": "explain", "prompt": "Explain why 150 cm is longer than 1 m.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "1 m = 100 cm", "kw": ["100"]}], "need": 1, "model": "1 m = 100 cm, and 150 cm is more than 100 cm.", "hint": "", "reason": "1 m = 100 cm, and 150 cm is more than 100 cm."}, {"id": "m3u05s1p05", "type": "num", "prompt": "A ribbon is 1 m. You cut off 35 cm. Left (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 65, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1p06", "type": "mcq", "prompt": "Best estimate for the height of a door:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2 m", "ok": true, "fb": ""}, {"t": "2 cm", "ok": false, "fb": ""}, {"t": "20 m", "ok": false, "fb": ""}]}, {"id": "m3u05s1p07", "type": "num", "prompt": "Two 75 cm planks end to end (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 150, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1p08", "type": "num", "prompt": "A 400 m track. How many laps make 2 km?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m3u05s1a01", "type": "num", "prompt": "* Advanced. How many 20 cm pieces from a 3 m rope?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1a02", "type": "explain", "prompt": "* Advanced. Order: 1 m 5 cm, 150 cm, 1 m 50 cm, 115 cm.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "105, 115, 150 = 150", "kw": ["105.*115.*150"]}], "need": 1, "model": "1 m 5 cm (105), 115 cm, then 150 cm = 1 m 50 cm (equal).", "hint": "", "reason": "1 m 5 cm (105), 115 cm, then 150 cm = 1 m 50 cm (equal)."}, {"id": "m3u05s1a03", "type": "num", "prompt": "* Advanced. Half a km in m?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 500, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m3u05s1m01", "type": "num", "prompt": "cm in 1 m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1m02", "type": "num", "prompt": "300 cm in m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1m03", "type": "mcq", "prompt": "Length of your finger:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm", "ok": true, "fb": ""}, {"t": "m", "ok": false, "fb": ""}, {"t": "km", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u05s1m04", "type": "mcq", "prompt": "Length of a bus:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm", "ok": false, "fb": ""}, {"t": "m", "ok": true, "fb": ""}, {"t": "km", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u05s1m05", "type": "num", "prompt": "1 m 50 cm in cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 150, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u05s1m06", "type": "num", "prompt": "1000 m in km?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c3u05", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 5.1 notes · Measurement", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "5.2", "title": "Perimeter", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Ant walk", "p": ["An ant walks all the way round the edge of a rectangular card **8 cm long** and **5 cm wide**.", "How far does it walk? Try it before you read on."]}, {"k": "recall", "t": "Adding lengths", "p": ["8 + 5 = 13."], "qq": {"id": "m3u05s2t01", "type": "num", "prompt": "8 + 5 + 8 + 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 26, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "26."}}, {"k": "idea", "t": "Perimeter", "p": ["The **perimeter** is the total distance **around the outside** of a shape. Add the lengths of all the sides.", "Ant: 8 + 5 + 8 + 5 = **26 cm**."]}, {"k": "idea", "t": "Different shapes", "p": [], "table": {"head": ["Shape", "Sides", "Perimeter"], "rows": [["square side 4 cm", "4 + 4 + 4 + 4", "16 cm"], ["triangle 3, 4, 5 cm", "3 + 4 + 5", "12 cm"], ["rectangle 6 m by 2 m", "6 + 2 + 6 + 2", "16 m"]]}, "p2": ["Rectangles and squares have matching opposite sides – use them to find missing lengths."]}, {"k": "try", "t": "Square", "p": [], "qq": {"id": "m3u05s2t02", "type": "num", "prompt": "Perimeter of a square with sides 5 cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "20 cm."}}, {"k": "method", "t": "How do I find the perimeter?", "p": ["Step 1: Find the length of every side.", "Step 2: Start at one corner and go round.", "Step 3: Add all the sides.", "Step 4: Write the unit."]}, {"k": "example", "t": "Rectangle", "p": [], "q": "10 cm by 3 cm.", "steps": [["10 + 3 + 10 + 3", ""]], "a": "26 cm"}, {"k": "example", "t": "Triangle", "p": [], "q": "Sides 6 cm, 6 cm, 6 cm.", "steps": [["6 + 6 + 6", ""]], "a": "18 cm"}, {"k": "example", "t": "Missing side", "p": [], "q": "A rectangle 7 m by ? m has perimeter 20 m.", "steps": [["7 + 7 = 14", ""], ["20 − 14 = 6", ""], ["6 ÷ 2", ""]], "a": "3 m"}, {"k": "example", "t": "On a grid", "p": [], "q": "A rectangle 4 squares by 2 squares (1 cm squares).", "steps": [["4 + 2 + 4 + 2", ""]], "a": "12 cm"}, {"k": "try", "t": "Rectangle", "p": [], "qq": {"id": "m3u05s2t03", "type": "num", "prompt": "Perimeter of 9 m by 1 m?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "20 m."}}, {"k": "error", "t": "Adding only two sides", "p": ["Find the first wrong line."], "q": "Perimeter of 8 cm by 5 cm.", "lines": ["8 + 5 = 13 cm"], "bad": 0, "why": "Add all four sides: 26 cm.", "fix": [["26 cm", ""]], "id": "m3u05s2t04"}, {"k": "mistake", "t": "Adding only the labelled sides", "p": ["Go all the way round."]}, {"k": "tip", "t": "Real life", "p": ["Fences, picture frames and the edge of a football pitch are perimeters."]}, {"k": "summary", "t": "What to remember", "p": ["Perimeter = distance around.", "Add every side.", "Opposite sides of rectangles are equal."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "5.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u05s2k01", "type": "num", "prompt": "Before you read on: how far does the ant walk?", "diff": "M", "obj": "O1", "skill": "Application", 