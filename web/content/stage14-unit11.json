{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 11, "stage": 14, "title": "Fractions and Percentages", "strandShort": "Number", "blurb": "Equivalent fractions, comparing and ordering fractions, and percentages as parts of 100.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u11.pdf"}, "objectives": {"O1": {"code": "4Nf.03", "sec": "11.1", "codeNote": "", "t": "Recognise equivalent fractions and compare and order fractions."}, "O2": {"code": "4Nf.04", "sec": "11.2", "codeNote": "", "t": "Understand percentages as parts of 100 and link 50%, 25% and 10% to fractions."}}, "sections": [{"id": "11.1", "title": "Equivalence, comparing and ordering fractions", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Chocolate squares", "p": ["Ana eats **2/4** of her chocolate bar. Ben eats **1/2** of an identical bar.", "Who ate more? Draw the bars before you read on."]}, {"k": "recall", "t": "Halves and quarters", "p": ["Two quarters fill the same space as one half."], "qq": {"id": "m4u11s1t01", "type": "num", "prompt": "How many quarters in a half?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2."}}, {"k": "idea", "t": "Equivalent fractions", "p": ["**Equivalent fractions** are the same amount: ½ = 2/4 = 3/6 = 4/8. Ana and Ben ate the **same**.", "Multiply (or divide) the numerator and denominator by the **same number**: ½ = (1 × 3)/(2 × 3) = 3/6."]}, {"k": "idea", "t": "Comparing and ordering", "p": ["**Same denominator**: compare numerators – 3/8 < 5/8.", "**Same numerator (unit fractions)**: the bigger the denominator, the **smaller** each piece – 1/3 > 1/5."], "table": {"head": ["Compare", "How", "Answer"], "rows": [["3/8 and 5/8", "same denominator", "5/8 is bigger"], ["1/3 and 1/5", "fifths are smaller", "1/3 is bigger"], ["1/2 and 3/8", "1/2 = 4/8", "1/2 is bigger"]]}}, {"k": "try", "t": "Equivalent", "p": [], "qq": {"id": "m4u11s1t02", "type": "num", "prompt": "1/3 = ?/6", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× 2.", "reason": "2."}}, {"k": "method", "t": "How do I compare fractions?", "p": ["Step 1: Same denominator → compare numerators.", "Step 2: Unit fractions → bigger denominator means smaller.", "Step 3: Otherwise make an equivalent fraction with the same denominator.", "Step 4: Draw bars to check."]}, {"k": "example", "t": "Equivalent", "p": [], "q": "2/5 = ?/10.", "steps": [["5 × 2 = 10", ""], ["2 × 2 = 4", ""]], "a": "4/10"}, {"k": "example", "t": "Order", "p": [], "q": "Order 1/2, 1/8, 1/4.", "steps": [["bigger denominator → smaller piece", ""]], "a": "1/8, 1/4, 1/2"}, {"k": "example", "t": "Compare", "p": [], "q": "3/4 or 5/8?", "steps": [["3/4 = 6/8", ""], ["6/8 > 5/8", ""]], "a": "3/4"}, {"k": "example", "t": "Simplify", "p": [], "q": "6/8 = ?/4.", "steps": [["÷ 2", ""]], "a": "3/4"}, {"k": "try", "t": "Compare", "p": [], "qq": {"id": "m4u11s1t03", "type": "mcq", "prompt": "Bigger: 1/6 or 1/4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/4", "ok": true, "fb": ""}, {"t": "1/6", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Bigger denominator, bigger fraction", "p": ["Find the first wrong line."], "q": "Compare 1/3 and 1/10.", "lines": ["10 > 3, so 1/10 is bigger."], "bad": 0, "why": "Tenths are smaller pieces: 1/3 > 1/10.", "fix": [["1/3 is bigger", ""]], "id": "m4u11s1t04"}, {"k": "mistake", "t": "Thinking a bigger denominator means a bigger fraction", "p": ["More pieces → smaller pieces."]}, {"k": "tip", "t": "Real life", "p": ["Cutting a cake into 8 instead of 4 makes smaller slices – 2 eighths is the same as 1 quarter."]}, {"k": "summary", "t": "What to remember", "p": ["Equivalent: × or ÷ top and bottom by the same number.", "Same denominator: compare numerators.", "Unit fractions: bigger denominator → smaller."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "11.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u11s1k01", "type": "mcq", "prompt": "Before you read on: who ate more?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the same", "ok": true, "fb": ""}, {"t": "Ana", "ok": false, "fb": ""}]}}, {"id": "11.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u11s1k02", "type": "num", "prompt": "1/2 = ?/8", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u11s1k03", "type": "mcq", "prompt": "Order 1/2, 1/8, 1/4 from smallest:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/8, 1/4, 1/2", "ok": true, "fb": ""}, {"t": "1/2, 1/4, 1/8", "ok": false, "fb": ""}]}}, {"id": "11.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u11s1k04", "type": "mcq", "prompt": "Quick check: 3/4 or 5/8?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3/4", "ok": true, "fb": ""}, {"t": "5/8", "ok": false, "fb": ""}]}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u11s1r01", "type": "num", "prompt": "1/2 = ?/6", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1r02", "type": "num", "prompt": "1/4 = ?/8", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1r03", "type": "num", "prompt": "2/3 = ?/6", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1r04", "type": "num", "prompt": "1/5 = ?/10", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1r05", "type": "mcq", "prompt": "Bigger: 2/7 or 5/7?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "5/7", "ok": true, "fb": ""}, {"t": "2/7", "ok": false, "fb": ""}]}, {"id": "m4u11s1r06", "type": "mcq", "prompt": "Bigger: 1/2 or 1/3?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/2", "ok": true, "fb": ""}, {"t": "1/3", "ok": false, "fb": ""}]}, {"id": "m4u11s1r07", "type": "mcq", "prompt": "Equal to 1/2?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "5/10", "ok": true, "fb": ""}, {"t": "5/8", "ok": false, "fb": ""}]}, {"id": "m4u11s1r08", "type": "num", "prompt": "Simplify 4/8. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m4u11s1p01", "type": "mcq", "prompt": "Order from smallest: 1/5, 1/2, 1/10", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/10, 1/5, 1/2", "ok": true, "fb": ""}, {"t": "1/2, 1/5, 1/10", "ok": false, "fb": ""}]}, {"id": "m4u11s1p02", "type": "mcq", "prompt": "Bigger: 1/2 or 3/8?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/2", "ok": true, "fb": ""}, {"t": "3/8", "ok": false, "fb": ""}]}, {"id": "m4u11s1p03", "type": "mcq", "prompt": "Bigger: 3/5 or 7/10?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "7/10", "ok": true, "fb": "3/5 = 6/10."}, {"t": "3/5", "ok": false, "fb": ""}]}, {"id": "m4u11s1p04", "type": "explain", "prompt": "Explain why 3/6 and 1/2 are equal.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "÷ 3 / half", "kw": ["3|half|1/2|divide|same"]}], "need": 1, "model": "3/6 ÷ 3 top and bottom = 1/2 – 3 of 6 is half.", "hint": "", "reason": "3/6 ÷ 3 top and bottom = 1/2 – 3 of 6 is half."}, {"id": "m4u11s1p05", "type": "num", "prompt": "3/4 = ?/12", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1p06", "type": "num", "prompt": "Simplify 5/10. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1p07", "type": "mcq", "prompt": "Not equal to 1/4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3/8", "ok": true, "fb": ""}, {"t": "2/8", "ok": false, "fb": ""}, {"t": "3/12", "ok": false, "fb": ""}]}, {"id": "m4u11s1p08", "type": "mcq", "prompt": "Order smallest first: 2/8, 1/2, 1/8", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/8, 2/8, 1/2", "ok": true, "fb": ""}, {"t": "2/8, 1/8, 1/2", "ok": false, "fb": ""}]}], "adv": [{"id": "m4u11s1a01", "type": "explain", "prompt": "* Advanced. Write three fractions equivalent to 2/3.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "examples", "kw": ["4/6|6/9|8/12|10/15|20/30"]}], "need": 1, "model": "e.g. 4/6, 6/9, 8/12.", "hint": "", "reason": "e.g. 4/6, 6/9, 8/12."}, {"id": "m4u11s1a02", "type": "mcq", "prompt": "* Advanced. Which is nearest to 1?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "7/8", "ok": true, "fb": ""}, {"t": "3/4", "ok": false, "fb": ""}, {"t": "1/2", "ok": false, "fb": ""}]}, {"id": "m4u11s1a03", "type": "mcq", "prompt": "* Advanced. Bigger: 2/3 or 3/4?", "diff": "VH", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3/4", "ok": true, "fb": "8/12 < 9/12."}, {"t": "2/3", "ok": false, "fb": ""}]}], "more": [{"id": "m4u11s1m01", "type": "num", "prompt": "1/2 = ?/4", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1m02", "type": "num", "prompt": "1/3 = ?/9", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u11s1m03", "type": "mcq", "prompt": "Bigger: 3/4 or 1/4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3/4", "ok": true, "fb": ""}, {"t": "1/4", "ok": false, "fb": ""}]}, {"id": "m4u11s1m04", "type": "mcq", "prompt": "Bigger: 1/4 or 1/8?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/4", "ok": true, "fb": ""}, {"t": "1/8", "ok": false, "fb": ""}]}, {"id": "m4u11s1m05", "type": "mcq", "prompt": "Equal to 1/2?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2/4", "ok": true, "fb": ""}, {"t": "2/3", "ok": false, "fb": ""}]}, {"id": "m4u11s1m06", "type": "num", "prompt": "2/4 = ?/8", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u11", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 11.1 notes · Equivalence, comparing and ordering fractions", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "11.2", "title": "Percentages", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Sale sign", "p": ["A shop sign says **50% off** all toys. Another shop says **half price**.", "Which is the better deal? Think before you read on."]}, {"k": "recall", "t": "Hundredths", "p": ["100 equal parts make a whole."], "qq": {"id": "m4u11s2t01", "type": "num", "prompt": "How many squares in a 10 by 10 grid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "100."}}, {"k": "idea", "t": "Per cent", "p": ["**Per cent (%)** means 'out of 100'. 25% means 25 out of 100."], "fig": {"kind": "waffle", "n": 25}, "p2": ["25 of the 100 squares are shaded: **25%** – that is the same as ¼."]}, {"k": "idea", "t": "Key percentages", "p": [], "table": {"head": ["Percentage", "Fraction"], "rows": [["100%", "1 whole"], ["50%", "1/2"], ["25%", "1/4"], ["10%", "1/10"]]}, "p2": ["50% off and half price are the **same deal**."]}, {"k": "try", "t": "Fraction", "p": [], "qq": {"id": "m4u11s2t02", "type": "mcq", "prompt": "10% is the same as…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/10", "ok": true, "fb": ""}, {"t": "1/100", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I use percentages?", "p": ["Step 1: Remember: % means out of 100.", "Step 2: Shaded squares out of 100 = the percentage.", "Step 3: 50% = half, 25% = quarter, 10% = tenth.", "Step 4: 100% − shaded % = not shaded %."]}, {"k": "example", "t": "Grid", "p": [], "q": "A 100-square grid has 40 squares shaded.", "steps": [["40 out of 100", ""]], "a": "40%"}, {"k": "example", "t": "Not shaded", "p": [], "q": "30% shaded. Not shaded?", "steps": [["100 − 30", ""]], "a": "70%"}, {"k": "example", "t": "Fraction", "p": [], "q": "What fraction is 50%?", "steps": [["50 out of 100", ""]], "a": "1/2"}, {"k": "example", "t": "Amount", "p": [], "q": "50% of 40 children.", "steps": [["half of 40", ""]], "a": "20"}, {"k": "try", "t": "Not shaded", "p": [], "qq": {"id": "m4u11s2t03", "type": "num", "prompt": "25% shaded. % not shaded?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 75, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "75%."}}, {"k": "error", "t": "Mixing 10% with 1/100", "p": ["Find the first wrong line."], "q": "10% as a fraction.", "lines": ["1/100"], "bad": 0, "why": "10% = 10/100 = 1/10.", "fix": [["1/10", ""]], "id": "m4u11s2t04"}, {"k": "mistake", "t": "Thinking 10% = 1/100", "p": ["10 out of 100 is one tenth."]}, {"k": "tip", "t": "Real life", "p": ["Sales, phone batteries and test scores use percentages."]}, {"k": "summary", "t": "What to remember", "p": ["% = out of 100.", "50% = ½, 25% = ¼, 10% = 1/10.", "Whole = 100%."]}], "video": {"src": null, "offset": 0, "dur": 600, "range": ""}, "stops": [{"id": "11.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u11s2k01", "type": "mcq", "prompt": "Before you read on: better deal?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "they are the same", "ok": true, "fb": ""}, {"t": "50% off", "ok": false, "fb": ""}]}}, {"id": "11.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id