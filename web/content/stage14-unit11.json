{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 11, "stage": 14, "title": "Fractions and Percentages", "strandShort": "Number", "blurb": "Equivalent fractions, comparing and ordering fractions, and percentages as parts of 100.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u11.pdf"}, "objectives": {"O1": {"code": "4Nf.03", "sec": "11.1", "codeNote": "", "t": "Recognise equivalent fractions and compare and order fractions."}, "O2": {"code": "4Nf.04", "sec": "11.2", "codeNote": "", "t": "Understand percentages as parts of 100 and link 50%, 25% and 10% to fractions."}}, "sections": [{"id": "11.1", "title": "Equivalence, comparing and ordering fractions", "objs": ["O1"], "lesson": [{"k": "idea", "t": "What are equivalent fractions?", "p": ["**Equivalent fractions** look different but are worth the **same amount**.", "In the circle cut into 8 parts, 4 parts shaded is the same as half the circle: 4/8 = 1/2.", "To make an equivalent fraction, **multiply (or divide) the top and bottom by the same number**: 2/3 = 4/6 (× 2)."], "fig": {"kind": "pie", "labels": ["", "", "", "", "", "", "", ""], "values": [1, 1, 1, 1, 1, 1, 1, 1], "shade": [0, 1, 2, 3]}}, {"k": "idea", "t": "How do I compare fractions?", "p": ["Make the **denominators the same**, then compare the numerators.", "Which is bigger, 1/2 or 3/8? 1/2 = 4/8, and 4/8 > 3/8, so 1/2 is bigger."]}, {"k": "method", "t": "How do I find a missing number in equivalent fractions?", "p": ["Step 1: Look at the two numbers you know on the same level (top or bottom).", "Step 2: Work out what they were multiplied by.", "Step 3: Do the same to the other number."]}, {"k": "example", "t": "Missing", "p": [], "q": "Find ☐: 2/5 = ☐/10.", "steps": [["5 × 2 = 10", ""], ["2 × 2 = 4", ""]], "a": "4"}, {"k": "example", "t": "Order", "p": [], "q": "Put in order, smallest first: 1/2, 1/4, 5/8.", "steps": [["Change to eighths: 4/8, 2/8, 5/8", ""]], "a": "1/4, 1/2, 5/8"}, {"k": "mistake", "t": "Adding instead of multiplying", "p": ["1/2 is not equal to 2/3 just because 1 + 1 = 2 and 2 + 1 = 3. You must multiply."]}, {"k": "tip", "t": "Use a fraction wall", "p": ["A fraction wall shows equivalent fractions lined up – great for checking."]}], "video": {"src": null, "offset": 0, "dur": 300, "range": ""}, "stops": [{"id": "11.1-k2", "t": 2, "after": -1, "review": [0, 0], "note": "", "q": {"id": "m4u11s1k02", "type": "mcq", "prompt": "Before you read on: is 2/4 the same as 1/2?", "diff": "M", "obj": "O1", "skill": "Reasoning", "options": [{"t": "No", "ok": false, "fb": "Two quarters fill half."}, {"t": "Yes", "ok": true, "fb": "Correct."}, {"t": "Only for pizzas", "ok": false, "fb": "It is true for any whole."}]}}, {"id": "11.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u11s1k01", "type": "num", "prompt": "Find the missing number: 3/4 = ☐/8", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u11s1r01", "type": "mcq", "prompt": "Whi