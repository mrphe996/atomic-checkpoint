{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 17, "stage": 15, "title": "Number and the Laws of Arithmetic", "strandShort": "Number", "blurb": "The order of operations, including brackets, and using the commutative, associative and distributive laws to calculate mentally.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u17.pdf"}, "objectives": {"O1": {"code": "5Ni.04", "sec": "17.1", "codeNote": "", "t": "Use the order of operations, including brackets, to work out calculations."}, "O2": {"code": "5Ni.05", "sec": "17.2", "codeNote": "", "t": "Use the commutative, associative and distributive laws to calculate mentally."}}, "sections": [{"id": "17.1", "title": "Order of operations", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Two answers", "p": ["Kim and Raj both work out **5 + 3 × 4**. Kim gets **32**. Raj gets **17**.", "Who is right? Why do we need a rule? Decide before you read on."]}, {"k": "recall", "t": "Times tables", "p": ["3 × 4 = 12."], "qq": {"id": "m5u17s1t01", "type": "num", "prompt": "6 × 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 42, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "42."}}, {"k": "idea", "t": "The order of operations", "p": ["Everyone must get the same answer, so mathematicians agree an order:"], "table": {"head": ["Order", "What", "Example"], "rows": [["1", "Brackets ( )", "(5 + 3) × 4 = 8 × 4 = 32"], ["2", "× and ÷ (left to right)", "5 + 3 × 4 = 5 + 12 = 17"], ["3", "+ and − (left to right)", "20 − 6 + 1 = 15"]]}, "p2": ["Raj is right: 5 + 3 × 4 = **17**. Kim worked left to right, which gives (5 + 3) × 4."]}, {"k": "idea", "t": "Using brackets", "p": ["Brackets change the order: 5 + 3 × 4 = 17 but (5 + 3) × 4 = 32. Put brackets in to show what you want done first."]}, {"k": "try", "t": "Order", "p": [], "qq": {"id": "m5u17s1t02", "type": "num", "prompt": "10 − 2 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× first.", "reason": "4."}}, {"k": "method", "t": "How do I use the order of operations?", "p": ["Step 1: Work out brackets first.", "Step 2: Then × and ÷, from left to right.", "Step 3: Then + and −, from left to right.", "Step 4: Check by doing one step per line."]}, {"k": "example", "t": "× before +", "p": [], "q": "7 + 8 ÷ 2.", "steps": [["8 ÷ 2 = 4", ""], ["7 + 4", ""]], "a": "11"}, {"k": "example", "t": "Brackets", "p": [], "q": "(12 − 4) × 3.", "steps": [["12 − 4 = 8", ""], ["8 × 3", ""]], "a": "24"}, {"k": "example", "t": "Left to right", "p": [], "q": "20 ÷ 4 × 2.", "steps": [["20 ÷ 4 = 5", ""], ["5 × 2", ""]], "a": "10"}, {"k": "example", "t": "Story", "p": [], "q": "3 packs of 6 pens and 4 loose pens.", "steps": [["3 × 6 + 4", ""], ["18 + 4", ""]], "a": "22 pens"}, {"k": "try", "t": "Brackets", "p": [], "qq": {"id": "m5u17s1t03", "type": "num", "prompt": "(4 + 6) × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "50."}}, {"k": "error", "t": "Working left to right", "p": ["Find the first wrong line."], "q": "9 + 6 ÷ 3", "lines": ["9 + 6 = 15", "15 ÷ 3 = 5"], "bad": 0, "why": "Divide first: 6 ÷ 3 = 2, then 9 + 2 = 11.", "fix": [["11", ""]], "id": "m5u17s1t04"}, {"k": "mistake", "t": "Always working from left to right", "p": ["× and ÷ come before + and −, unless there are brackets."]}, {"k": "tip", "t": "Real life", "p": ["Calculators, spreadsheets and computer programs all follow the order of operations."]}, {"k": "summary", "t": "What to remember", "p": ["Brackets → × ÷ → + −.", "Same level: left to right.", "Brackets change the order."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "17.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u17s1k01", "type": "mcq", "prompt": "Before you read on: who is right?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Raj (17)", "ok": true, "fb": ""}, {"t": "Kim (32)", "ok": false, "fb": ""}]}}, {"id": "17.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u17s1k02", "type": "num", "prompt": "(5 + 3) × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 32, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u17s1k03", "type": "num", "prompt": "7 + 8 ÷ 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u17s1k04", "type": "num", "prompt": "Quick check: 20 ÷ 4 × 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u17s1r01", "type": "num", "prompt": "2 + 3 × 5?", "diff": "M", "obj": "O1", "