"answer": 36, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1p03", "type": "num", "prompt": "100 − 4 × 20?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1p04", "type": "explain", "prompt": "Explain why 8 + 2 × 5 is 18, not 50.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "× first", "kw": ["multipl|×|times|first"]}, {"pt": "18", "kw": ["18"]}], "need": 2, "model": "Multiply first: 2 × 5 = 10, then 8 + 10 = 18.", "hint": "", "reason": "Multiply first: 2 × 5 = 10, then 8 + 10 = 18."}, {"id": "m5u17s1p05", "type": "mcq", "prompt": "Where do brackets make 3 + 4 × 2 = 14?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "(3 + 4) × 2", "ok": true, "fb": ""}, {"t": "3 + (4 × 2)", "ok": false, "fb": ""}]}, {"id": "m5u17s1p06", "type": "num", "prompt": "Tickets: 2 adults at $8 and 3 children at $5. Total ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 31, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "2 × 8 + 3 × 5.", "reason": ""}, {"id": "m5u17s1p07", "type": "num", "prompt": "36 ÷ (4 + 2)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1p08", "type": "num", "prompt": "7 × 3 − 4 × 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m5u17s1a01", "type": "mcq", "prompt": "* Advanced. Which makes 24 − 6 ÷ 2 + 1 equal 10?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "(24 − 6) ÷ 2 + 1", "ok": true, "fb": ""}, {"t": "24 − 6 ÷ (2 + 1)", "ok": false, "fb": ""}]}, {"id": "m5u17s1a02", "type": "explain", "prompt": "* Advanced. Use 2, 3, 4 once each with +, × and brackets to make 20.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "(2 + 3) × 4", "kw": ["\\(2 ?\\+ ?3\\) ?[×x*] ?4|4 ?[×x*] ?\\(2 ?\\+ ?3\\)|\\(3 ?\\+ ?2\\)"]}], "need": 1, "model": "(2 + 3) × 4 = 20.", "hint": "", "reason": "(2 + 3) × 4 = 20."}, {"id": "m5u17s1a03", "type": "num", "prompt": "* Advanced. 50 − (6 + 4) × 3 + 2?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 22, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m5u17s1m01", "type": "num", "prompt": "1 + 2 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1m02", "type": "num", "prompt": "(1 + 2) × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1m03", "type": "num", "prompt": "10 − 6 ÷ 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1m04", "type": "num", "prompt": "4 × 5 − 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1m05", "type": "num", "prompt": "4 × (5 − 2)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u17s1m06", "type": "num", "prompt": "12 ÷ 2 + 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u17", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 17.1 notes · Order of operations", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "17.2", "title": "Using the laws of arithmetic", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Mental maths race", "p": ["Work out **25 × 7 × 4** in your head as fast as you can.", "Is there a clever order that makes it easy? Try it before you read on."]}, {"k": "recall", "t": "Easy pairs", "p": ["25 × 4 = 100."], "qq": {"id": "m5u17s2t01", "type": "num", "prompt": "50 × 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "100."}}, {"k": "idea", "t": "Commutative and associative laws", "p": ["**Commutative**: you can swap the order of + or ×: 7 × 4 = 4 × 7.", "**Associative**: you can group + or × in any way: (25 × 7) × 4 = 7 × (25 × 4)."], "p2": ["25 × 7 × 4 = 7 × (25 × 4) = 7 × 100 = **700**."]}, {"k": "idea", "t": "Distributive law", "p": ["**Distributive**: split a number to multiply each part: 6 × 23 = 6 × 20 + 6 × 3 = 120 + 18 = 138.", "It also works with subtraction: 8 × 19 = 8 × 20 − 8 × 1 = 160 − 8 = 152."], "table": {"head": ["Law", "Works for", "Example"], "rows": [["commutative", "+ and ×", "3 + 9 = 9 + 3"], ["associative", "+ and ×", "(2 × 5) × 7 = 2 × (5 × 7)"], ["distributive", "× over + and −", "4 × 17 = 4 × 10 + 4 × 7"]]}, "p2": ["They do **not** work for − and ÷ in the same way: 10 − 4 ≠ 4 − 10."]}, {"k": "try", "t": "Regroup", "p": [], "qq": {"id": "m5u17s2t02", "type": "num", "prompt": "2 × 13 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 130, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "2 × 5 first.", "reason": "130."}}, {"k": "method", "t": "How do I use the laws to calculate mentally?", "p": ["Step 1: Look for pairs that make 10, 100 or 1000.", "Step 2: Swap and regroup (+ and × only).", "Step 3: Split a number to multiply each part.", "Step 4: Use 'one less' (× 19 = × 20 − 1 lot)."]}, {"k": "example", "t": "Pairs to 100", "p": [], "q": "37 + 48 + 63.", "steps": [["37 + 63 = 100", ""], ["+ 48", ""]], "a": "148"}, {"k": "example", "t": "Regroup ×", "p": [], "q": "5 × 9 × 2.", "steps": [["5 × 2 = 10", ""], ["10 × 9", ""]], "a": "90"}, {"k": "example", "t": "Distribute", "p": [], "q": "7 × 34.", "steps": [["7 × 30 = 210", ""], ["7 × 4 = 28", ""]], "a": "238"}, {"k": "example", "t": "One less", "p": [], "q": "9 × 99.", "steps": [["9 × 100 − 9", ""]], "a": "891"}, {"k": "try", "t": "Distribute", "p": [], "qq": {"id": "m5u17s2t03", "type": "num", "prompt": "4 × 26?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 104, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "4 × 20 + 4 × 6.", "reason": "104."}}, {"k": "error", "t": "Using the laws with subtraction", "p": ["Find the first wrong line."], "q": "20 − 8 − 2", "lines": ["= 20 − (8 − 2) = 20 − 6 = 14"], "bad": 0, "why": "Subtraction is not associative: (20 − 8) − 2 = 10.", "fix": [["10", ""]], "id": "m5u17s2t04"}, {"k": "mistake", "t": "Regrouping subtraction or division", "p": ["Only + and × can be swapped and regrouped."]}, {"k": "tip", "t": "Real life", "p": ["Shop assistants and quiz champions use these tricks to calculate fast without a calculator."]}, {"k": "summary", "t": "What to remember", "p": ["Commutative: swap (+, ×).", "Associative: regroup (+, ×).", "Distributive: split, multiply each part, recombine.", "Not for − and ÷."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "17.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u17s2k01", "type": "num", "prompt": "Before you read on: 25 × 7 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 700, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u17s2k02", "type": "num"