 easier","p":["Look for pairs that make 10, 100 or 1000.","Change the order of adding or multiplying.","Split numbers: 6 × 14 = 6 × 10 + 6 × 4."],"v2p":true},{"k":"mistake","t":"Not for subtraction","p":["8 − 3 is not the same as 3 − 8. Swapping only works for + and ×."]}],"video":{"src":null,"offset":0,"dur":300,"range":""},"stops":[{"id":"17.2-k1","t":1,"after":0,"review":[0,0],"note":"","q":{"id":"m5u17s2k01","type":"num","prompt":"Work out 25 × 7 × 4 in your head.","diff":"M","obj":"O2","skill":"Application","answer":700,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true}},{"id":"17.2-k2","t":2,"after":0,"review":[0,0],"note":"","q":{"id":"m5u17s2k02","type":"mcq","prompt":"Before you read on: is 6 × 7 the same as 7 × 6?","diff":"M","obj":"O2","skill":"Reasoning","options":[{"t":"Only for small numbers","ok":false,"fb":"It works for every number."},{"t":"Yes","ok":true,"fb":"Correct."},{"t":"No","ok":false,"fb":"Multiplying can be done in either order."}]}}],"captions":[],"chapters":[[0,300]],"req":[{"id":"m5u17s2r01","type":"grid","prompt":"Which law does each statement show?","diff":"M","obj":"O2","skill":"Data","cols":["commutative","associative","distributive"],"rows":[{"l":"12 × 3 = 3 × 12","a":["commutative"]},{"l":"9 + 6 = 6 + 9","a":["commutative"]},{"l":"(4 × 5) × 3 = 4 × (5 × 3)","a":["associative"]},{"l":"8 × 14 = 8 × 10 + 8 × 4","a":["distributive"]}],"mode":"classify"},{"id":"m5u17s2r02","type":"table","prompt":"Work out 26 × 5 by splitting 26.","diff":"M","obj":"O2","skill":"Data","head":["Part","Answer"],"rows":[["20 × 5",{"ans":100}],["6 × 5",{"ans":30}],["Total",{"ans":130}]]},{"id":"m5u17s2r03","type":"num","prompt":"Use the distributive law to work out 26 × 8.","diff":"M","obj":"O2","skill":"Application","answer":208,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m5u17s2r04","type":"num","prompt":"Work out 5 × 13 × 2 in your head.","diff":"M","obj":"O2","skill":"Application","answer":130,"unit":"×","units":["×"],"tol":0,"er