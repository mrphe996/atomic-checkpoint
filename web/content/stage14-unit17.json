rompt": "528 × 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3696, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1p03", "type": "num", "prompt": "A school buys 9 boxes of 144 pencils. Pencils?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1296, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1p04", "type": "explain", "prompt": "Tom says 263 × 3 = 689. Use an estimate to check.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "about 800", "kw": ["800|789|wrong|not"]}], "need": 1, "model": "263 × 3 ≈ 250 × 3 = 750, so 689 is too small – it is 789.", "hint": "", "reason": "263 × 3 ≈ 250 × 3 = 750, so 689 is too small – it is 789."}, {"id": "m4u17s1p05", "type": "num", "prompt": "Tickets $15 each, 8 people ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 120, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1p06", "type": "num", "prompt": "409 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1636, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1p07", "type": "mcq", "prompt": "Best estimate for 395 × 6:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2400", "ok": true, "fb": ""}, {"t": "240", "ok": false, "fb": ""}]}, {"id": "m4u17s1p08", "type": "num", "prompt": "A bus does 165 km a day. 5 days (km)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 825, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m4u17s1a01", "type": "num", "prompt": "* Advanced. ? × 4 = 512", "diff": "H", "obj": "O1", "skill": "Application", "answer": 128, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1a02", "type": "explain", "prompt": "* Advanced. Use the digits 3, 5, 7, 9 once each to make ☐☐☐ × ☐ as large as possible.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "753 × 9 = 6777", "kw": ["753.{0,6}9|6777"]}], "need": 1, "model": "753 × 9 = 6777.", "hint": "", "reason": "753 × 9 = 6777."}, {"id": "m4u17s1a03", "type": "num", "prompt": "* Advanced. 125 × 8?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 1000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m4u17s1m01", "type": "num", "prompt": "12 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 36, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1m02", "type": "num", "prompt": "31 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 124, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1m03", "type": "num", "prompt": "100 × 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 600, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1m04", "type": "num", "prompt": "120 × 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 240, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1m05", "type": "num", "prompt": "25 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 125, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u17s1m06", "type": "num", "prompt": "111 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 555, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u17", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 17.1 notes · Developing written methods of multiplication", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "17.2", "title": "Developing written methods of division", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Packing apples", "p": ["A farm picks **156 apples** and packs them in trays of **6**.", "How many trays are filled? Any left over? Try it before you read on."]}, {"k": "recall", "t": "Division facts", "p": ["6 × 20 = 120."], "qq": {"id": "m4u17s2t01", "type": "num", "prompt": "36 ÷ 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "idea", "t": "Chunking", "p": ["Take away multiples of 6 you know: 156 − 120 (20 trays) = 36; 36 − 36 (6 trays) = 0. **156 ÷ 6 = 26 trays**.", "Estimate first: 150 ÷ 6 = 25, so about 25."]}, {"k": "idea", "t": "Short division", "p": ["Divide each digit from the left, carrying the remainder: 156 ÷ 6 → 15 tens ÷ 6 = 2 tens r 3 tens; 36 ones ÷ 6 = 6 → **26**."], "table": {"head": ["Division", "Answer"], "rows": [["84 ÷ 4", "21"], ["135 ÷ 5", "27"], ["217 ÷ 7", "31"], ["100 ÷ 3", "33 r 1"]]}, "p2": ["What to do with remainders depends on the question: round up if everything must fit."]}, {"k": "try", "t": "Divide", "p": [], "qq": {"id": "m4u17s2t02", "type": "num", "prompt": "96 ÷ 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "24."}}, {"k": "method", "t": "How do I divide on paper?", "p": ["Step 1: Estimate.", "Step 2: Chunk: subtract easy multiples (10×, 20×) and count them.", "Step 3: Or use short division from the left.", "Step 4: Decide what the remainder means."]}, {"k": "example", "t": "Chunking", "p": [], "q": "182 ÷ 7.", "steps": [["140 = 20 × 7, 42 left", ""], ["42 = 6 × 7", ""]], "a": "26"}, {"k": "example", "t": "Short division", "p": [], "q": "345 ÷ 5.", "steps": [["34 tens ÷ 5 = 6 r 4", ""], ["45 ÷ 5 = 9", ""]], "a": "69"}, {"k": "example", "t": "Remainder", "p": [], "q": "130 ÷ 4.", "steps": [["120 = 30 × 4, 10 left", ""], ["8 = 2 × 4, 2 left", ""]], "a": "32 r 2"}, {"k": "example", "t": "Round up", "p": [], "q": "130 people, 4 per car.", "steps": [["32 r 2", ""], ["2 people need a car", ""]], "a": "33 cars"}, {"k": "try", "t": "Remainder", "p": [], "qq": {"id": "m4u17s2t03", "type": "short", "prompt": "75 ÷ 4? Write it like 7 r 2.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["18 r 3", "/^\\s*18\\s*r(em(ainder)?)?\\s*3\\s*$/i"], "hint": "", "reason": "18 r 3."}}, {"k": "error", "t": "Ignoring what the remainder means", "p": ["Find the first wrong line."], "q": "150 children, 8 per tent. Tents?", "lines": ["150 ÷ 8 = 18 r 6, so 18 tents"], "bad": 0, "why": "6 children would have no tent – 19 tents.", "fix": [["19 tents", ""]], "id": "m4u17s2t04"}, {"k": "mistake", "t": "Ignoring the remainder", "p": ["Ask: does everyone/everything need a place?"]}, {"k": "tip", "t": "Real life", "p": ["Packing, sharing costs and planning transport all need division."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate, then chunk or short divide.", "Remainder < divisor.", "Round up or down depending on the story."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "17.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u17s2k01", "type": "num", "prompt": "Before you read on: trays?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 26, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u17s2k02", "type": "num", "prompt": "182 ÷ 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 26, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.2-k3", "t": 3, "after": 9, "review": [0, 0],