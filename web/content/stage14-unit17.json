{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 17, "stage": 14, "title": "Multiplication and Division", "strandShort": "Number", "blurb": "Written methods to multiply 2- and 3-digit numbers by 1-digit numbers, and to divide 2- and 3-digit numbers by 1-digit numbers, with remainders.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u17.pdf"}, "objectives": {"O1": {"code": "4Nc.08", "sec": "17.1", "codeNote": "", "t": "Use written methods to multiply 2- and 3-digit numbers by 1-digit numbers."}, "O2": {"code": "4Nc.09", "sec": "17.2", "codeNote": "", "t": "Use written methods to divide 2- and 3-digit numbers by 1-digit numbers and interpret remainders."}}, "sections": [{"id": "17.1", "title": "Developing written methods of multiplication", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Theatre seats", "p": ["A theatre has **8 sections**, each with **124 seats**.", "About how many seats is that? How can you find the exact number on paper? Try it before you read on."]}, {"k": "recall", "t": "Tables and place value", "p": ["8 × 4 = 32, so 8 × 40 = 320."], "qq": {"id": "m4u17s1t01", "type": "num", "prompt": "8 × 100?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 800, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "800."}}, {"k": "idea", "t": "The grid method", "p": ["Estimate: 124 × 8 ≈ 100 × 8 = 800 (a bit more). Split 124 into 100 + 20 + 4:"], "table": {"head": ["×", "100", "20", "4"], "rows": [["8", "800", "160", "32"]]}, "p2": ["800 + 160 + 32 = **992 seats**."]}, {"k": "idea", "t": "Expanded column method", "p": ["Write the parts underneath each other: 4 × 8 = 32; 20 × 8 = 160; 100 × 8 = 800; add: 992.", "This leads to the short column method, carrying tens and hundreds."]}, {"k": "try", "t": "Grid", "p": [], "qq": {"id": "m4u17s1t02", "type": "num", "prompt": "213 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 639, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "200×3 + 10×3 + 3×3.", "reason": "639."}}, {"k": "method", "t": "How do I multiply by a 1-digit number on paper?", "p": ["Step 1: Estimate.", "Step 2: Split into hundreds, tens and ones.", "Step 3: Multiply each part by the 1-digit number.", "Step 4: Add the parts; check with the estimate."]}, {"k": "example", "t": "2-digit", "p": [], "q": "57 × 6.", "steps": [["50 × 6 = 300", ""], ["7 × 6 = 42", ""]], "a": "342"}, {"k": "example", "t": "3-digit", "p": [], "q": "235 × 4.", "steps": [["200 × 4 = 800", ""], ["30 × 4 = 120", ""], ["5 × 4 = 20", ""]], "a": "940"}, {"k": "example", "t": "Zero", "p": [], "q": "306 × 5.", "steps": [["300 × 5 = 1500", ""], ["6 × 5 = 30", ""]], "a": "1530"}, {"k": "example", "t": "Problem", "p": [], "q": "A bag of rice weighs 125 g. 7 bags?", "steps": [["100×7 + 25×7 = 700 + 175", ""]], "a": "875 g"}, {"k": "try", "t": "3-digit", "p": [], "qq": {"id": "m4u17s1t03", "type": "num", "prompt": "142 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 710, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "710."}}, {"k": "error", "t": "Wrong place value", "p": ["Find the first wrong line."], "q": "124 × 8", "lines": ["100 × 8 = 800", "2 × 8 = 16", "4 × 8 = 32", "800 + 16 + 32 = 848"], "bad": 1, "why": "The 2 is 20: 20 × 8 = 160, total 992.", "fix": [["992", ""]], "id": "m4u17s1t04"}, {"k": "mistake", "t": "Forgetting a digit's value", "p": ["Split into 100 + 20 + 4, not 1, 2, 4."]}, {"k": "tip", "t": "Real life", "p": ["Theatre seats, crates of fruit and the cost of school trips use written multiplication."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate first.", "Split by place value; multiply each part.", "Add the parts; check."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "17.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u17s1k01", "type": "num", "prompt": "Before you read on: estimate 100 × 8.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 800, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u17s1k02", "type": "num", "prompt": "124 × 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 992, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u17s1k03", "type": "num", "prompt": "235 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 940, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u17s1k04", "type": "num", "prompt": "Quick check: 306 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1530, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{