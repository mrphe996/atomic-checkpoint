{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 15, "stage": 15, "title": "Multiplying and Dividing Fractions and Decimals", "strandShort": "Number", "blurb": "Multiplying a unit or non-unit fraction by a whole number, and multiplying and dividing numbers with one decimal place by single-digit numbers.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u15.pdf"}, "objectives": {"O1": {"code": "5Nf.06", "sec": "15.1", "codeNote": "", "t": "Multiply a unit or non-unit fraction by a whole number."}, "O2": {"code": "5Nc.07", "sec": "15.2", "codeNote": "", "t": "Estimate, multiply and divide numbers with one decimal place by 1-digit whole numbers."}}, "sections": [{"id": "15.1", "title": "Multiplying a fraction by a whole number", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Water bottles", "p": ["Each of **5 children** drinks **¾ litre** of water on a hike.", "How much water do they drink altogether? Try it before you read on."]}, {"k": "recall", "t": "Repeated addition", "p": ["3 × 4 = 4 + 4 + 4."], "qq": {"id": "m5u15s1t01", "type": "num", "prompt": "1/5 + 1/5 + 1/5? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/5."}}, {"k": "idea", "t": "Fraction × whole number", "p": ["Multiplying by a whole number is repeated addition: 3 × ⅖ = ⅖ + ⅖ + ⅖ = **6/5**.", "Multiply the **numerator** by the whole number; keep the denominator: 3 × 2/5 = (3 × 2)/5 = 6/5 = 1⅕."], "table": {"head": ["Calculation", "Multiply numerator", "Answer"], "rows": [["4 × 1/3", "4/3", "1⅓"], ["5 × 3/4", "15/4", "3¾"], ["6 × 2/3", "12/3", "4"]]}, "p2": ["Water: 5 × ¾ = 15/4 = **3¾ litres**."]}, {"k": "idea", "t": "A fraction of an amount", "p": ["¾ of 20 = 20 ÷ 4 × 3 = 15. This is the same as 20 × ¾ – the order of multiplying does not matter."]}, {"k": "try", "t": "Multiply", "p": [], "qq": {"id": "m5u15s1t02", "type": "num", "prompt": "2 × 3/7? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.8571428571428571, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "6/7."}}, {"k": "method", "t": "How do I multiply a fraction by a whole number?", "p": ["Step 1: Multiply the numerator by the whole number.", "Step 2: Keep the denominator.", "Step 3: Simplify; change an improper fraction to a mixed number.", "Step 4: Check with repeated addition or a bar model."]}, {"k": "example", "t": "Unit fraction", "p": [], "q": "6 × 1/4.", "steps": [["6/4", ""], ["= 1½", ""]], "a": "1½"}, {"k": "example", "t": "Non-unit fraction", "p": [], "q": "4 × 2/5.", "steps": [["8/5", ""]], "a": "1⅗"}, {"k": "example", "t": "Whole answer", "p": [], "q": "9 × 2/3.", "steps": [["18/3", ""]], "a": "6"}, {"k": "example", "t": "Real life", "p": [], "q": "A recipe uses ⅔ cup of rice per person. 4 people?", "steps": [["8/3", ""]], "a": "2⅔ cups"}, {"k": "try", "t": "Unit", "p": [], "qq": {"id": "m5u15s1t03", "type": "num", "prompt": "3 × 1/8? Give your answer as a fraction in its simplest for