oning"}, {"id": "m3u17v3Bq23", "type": "num", "prompt": "A pattern repeats every 3 shapes. How many full groups are in the first 60 shapes?", "diff": "H", "obj": "O2", "skill": "Application", "pts": 2, "sec": "D · Reasoning", "unit": "groups", "units": ["groups"]}, {"id": "m3u17v3Bq24", "type": "short", "prompt": "The pattern triangle, circle, square, triangle, circle, square, … continues. What is shape number 12?", "diff": "H", "obj": "O2", "skill": "Knowledge", "pts": 1, "sec": "D · Reasoning"}, {"id": "m3u17v3Bq25", "type": "short", "prompt": "The pattern square, star, circle, square, star, circle, … continues. What is shape number 7?", "diff": "H", "obj": "O2", "skill": "Knowledge", "pts": 1, "sec": "D · Reasoning"}], "pass": 0.7}, "mindmap": {"id": "root", "t": "Pattern and Symmetry", "sec": null, "kids": [{"id": "k0", "t": "Symmetry", "d": "Fold to check • mirror lines", "obj": "O1", "sec": "17.1"}, {"id": "k1", "t": "Patterns", "d": "Find the repeating group", "obj": "O2", "sec": "17.2"}]}, "build": {"at": "2026-11-26", "unit": "stage13-unit17"}, "cmap": {"nodes": [{"id": "root", "t": "Pattern and Symmetry", "s": "17.1", "c": 2, "r": 0, "k": "root"}, {"id": "k0", "t": "Symmetry", "s": "17.1", "c": 0, "r": 1, "k": "key", "d": ["Fold to check", "mirror lines"]}, {"id": "k1", "t": "Patterns", "s": "17.2", "c": 4, "r": 1, "k": "key", "d": ["Find the repeating group"]}], "links": [["root", "k0", ""], ["root", "k1", ""]]}, "est": 150}