{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 17, "stage": 13, "title": "Pattern and Symmetry", "strandShort": "Geometry and measure", "blurb": "Lines of symmetry in 2D shapes and letters, completing symmetrical shapes, and repeating and symmetrical patterns.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u17.pdf"}, "objectives": {"O1": {"code": "3Gg.04", "sec": "17.1", "codeNote": "", "t": "Identify 2D shapes and lines of symmetry, and complete symmetrical shapes."}, "O2": {"code": "3Gg.05", "sec": "17.2", "codeNote": "", "t": "Recognise, continue and make repeating and symmetrical patterns."}}, "sections": [{"id": "17.1", "title": "Shape and symmetry", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Paper butterfly", "p": ["Fold a piece of paper, cut half a butterfly shape along the fold, then open it.", "Why do both wings match exactly? Think before you read on."]}, {"k": "recall", "t": "2D shapes", "p": ["A rectangle has 4 sides and 4 right angles."], "qq": {"id": "m3u17s1t01", "type": "num", "prompt": "Sides on a pentagon?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "idea", "t": "2D shapes", "p": [], "table": {"head": ["Shape", "Sides", "Corners"], "rows": [["triangle", "3", "3"], ["square / rectangle", "4", "4"], ["pentagon", "5", "5"], ["hexagon", "6", "6"], ["octagon", "8", "8"], ["circle", "1 curved", "0"]]}, "fig": {"kind": "shape", "pts": [[0, 0], [4, 0], [4, 2.5], [0, 2.5]]}}, {"k": "idea", "t": "Lines of symmetry", "p": ["A **line of symmetry** is a fold line where the two halves **match exactly** – like the butterfly.", "A square has 4 lines of symmetry, a rectangle 2, a circle very many. Some shapes have none."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m3u17s1t02", "type": "num", "prompt": "Lines of symmetry in a rectangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2."}}, {"k": "method", "t": "How do I find lines of symmetry?", "p": ["Step 1: Imagine folding the shape (or use a mirror).", "Step 2: Check the two halves match exactly.", "Step 3: Try up–down, across and corner to corner.", "Step 4: Count every line that works."]}, {"k": "example", "t": "Square", "p": [], "q": "Lines of symmetry in a square.", "steps": [["up, across and 2 diagonals", ""]], "a": "4"}, {"k": "example", "t": "Letter", "p": [], "q": "The letter A.", "steps": [["one up–down line", ""]], "a": "1"}, {"k": "example", "t": "Letter", "p": [], "q": "The letter F.", "steps": [["no fold matches", ""]], "a": "0"}, {"k": "example", "t": "Complete", "p": [], "q": "Half a heart drawn next to a mirror line.", "steps": [["draw the same on the other side", ""]], "a": "a whole heart"}, {"k": "try", "t": "Letter", "p": [], "qq": {"id": "m3u17s1t03", "type": "num", "prompt": "Lines of symmetry in the letter H?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2."}}, {"k": "error", "t": "Diagonals of a rectangle", "p": ["Find the first wrong line."], "q": "Lines of symmetry in a rectangle.", "lines": ["4 (like a square)"], "bad": 0, "why": "Diagonal folds don't match on a rectangle: only 2.", "fix": [["2", ""]], "id": "m3u17s1t04"}, {"k": "mistake", "t": "Thinking every rectangle is like a square", "p": ["Test each fold – do the halves match?"]}, {"k": "tip", "t": "Real life", "p": ["Butterflies, leaves, faces and many logos are symmetrical."]}, {"k": "summary", "t": "What to remember", "p": ["Name shapes by their sides.", "Line of symmetry: halves match.", "Square 4, rectangle 2."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "17.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u17s1k01", "type": "mcq", "prompt": "Before you read on: the wings match because…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the fold is a line of symmetry", "ok": true, "fb": ""}, {"t": "the paper is red", "ok": false, "fb": ""}]}}, {"id": "17.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u17s1k02", "type": "num", "prompt": "Sides on a hexagon?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u17s1k03", "type": "num", "prompt": "Lines in the letter A?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "17.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u17s1k04", "type": "num", "prompt": "Quick check: lines in a rectangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u17s1r01", "type": "num", "prompt": "Sides on a triangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1r02", "type": "num", "prompt": "Sides on an octagon?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1r03", "type": "num", "prompt": "Lines in a square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1r04", "type": "num", "prompt": "Lines in the letter M?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1r05", "type": "num", "prompt": "Lines in the letter G?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1r06", "type": "num", "prompt": "Lines in an equilateral triangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1r07", "type": "mcq", "prompt": "A circle has…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "very many lines of symmetry", "ok": true, "fb": ""}, {"t": "no lines", "ok": false, "fb": ""}]}, {"id": "m3u17s1r08", "type": "mcq", "prompt": "6 sides:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "hexagon", "ok": true, "fb": ""}, {"t": "pentagon", "ok": false, "fb": ""}]}], "prac": [{"id": "m3u17s1p01", "type": "num", "prompt": "Lines in the letter T?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1p02", "type": "num", "prompt": "Lines in the letter X?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1p03", "type": "mcq", "prompt": "Which letter has a line across the middle?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "E", "ok": true, "fb": ""}, {"t": "A", "ok": false, "fb": ""}]}, {"id": "m3u17s1p04", "type": "explain", "prompt": "How can a mirror help you check symmetry?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "mirror on the line shows the other half", "kw": ["mirror|reflect|other half|same|whole"]}], "need": 1, "model": "Put the mirror on the line – if the reflection makes the whole shape, the line is a line of symmetry.", "hint": "", "reason": "Put the mirror on the line – if the reflection makes the whole shape, the line is a line of symmetry."}, {"id": "m3u17s1p05", "type": "num", "prompt": "Lines in a regular hexagon?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1p06", "type": "mcq", "prompt": "Which shape has no lines of symmetry?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a scribble shape", "ok": true, "fb": ""}, {"t": "a square", "ok": false, "fb": ""}]}, {"id": "m3u17s1p07", "type": "num", "prompt": "Total sides: 2 triangles and 1 square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1p08", "type": "mcq", "prompt": "Which word has a line of symmetry down the middle?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "TOT", "ok": true, "fb": ""}, {"t": "CAT", "ok": false, "fb": ""}]}], "adv": [{"id": "m3u17s1a01", "type": "explain", "prompt": "* Advanced. Name a shape with exactly 1 line of symmetry.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "example", "kw": ["isosceles|kite|heart|letter|arrow"]}], "need": 1, "model": "e.g. a heart, a kite or an isosceles triangle.", "hint": "", "reason": "e.g. a heart, a kite or an isosceles triangle."}, {"id": "m3u17s1a02", "type": "num", "prompt": "* Advanced. Lines in a regular octagon?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1a03", "type": "mcq", "prompt": "* Advanced. Which number has a line of symmetry across the middle?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "8", "ok": true, "fb": ""}, {"t": "7", "ok": false, "fb": ""}]}], "more": [{"id": "m3u17s1m01", "type": "num", "prompt": "Sides on a square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1m02", "type": "num", "prompt": "Corners on a triangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1m03", "type": "num", "prompt": "Lines in the letter O (round)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1m04", "type": "num", "prompt": "Lines in the letter L?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u17s1m05", "type": "mcq", "prompt": "Matching halves show…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "symmetry", "ok": true, "fb": ""}, {"t": "a pattern of numbers", "ok": false, "fb": ""}]}, {"id": "m3u17s1m06", "type": "num", "prompt": "Sides on a pentagon?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c3u17", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 17.1 notes · Shape and symmetry", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "17.2", "title": "Pattern and symmetry", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Bead necklace", "p": ["Mia threads beads: **red, blue, blue, red, blue, blue, …**", "What colour is the 10th bead? Think before you read on."]}, {"k": "recall", "t": "Counting in 3s", "p": ["3, 6, 9, 12."], "qq": {"id": "m3u17s2t01", "type": "num", "prompt": "Count in 3s: 3, 6, 9, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Repeating patterns", "p": ["A **repeating pattern** has a part that repeats. Find the **repeating unit**: red, blue, blue (3 beads)."], "fig": {"kind": "cells", "cells": [[0, 0, "#F4A6A6", "R"], [1, 0, "#9EC1F2", "B"], [2, 0, "#9EC1F2", "B"], [3, 0, "#F4A6A6", "R"], [4, 0, "#9EC1F2", "B"], [5, 0, "#9EC1F2", "B"], [6, 0, "#F4A6A6", "R"], [7, 0, "#9EC1F2", "B"], [8, 0, "#9EC1F2", "B"]], "cols": 9, "rows": 1}, "p2": ["Beads 3, 6, 9 are blue (end of each unit), so bead 10 starts a new unit: **red**."]}, {"k": "idea", "t": "Symmetrical patterns", "p": ["A pattern can also be **symmetrical** – the same on both sides of a mirror line: R B Y B R. Read from either end, it is the same."], "fig": {"kind": "cells", "cells": [[0, 0, "#F4A6A6", "R"], [1, 0, "#9EC1F2", "B"], [2, 0, "#FCE39A", "Y"], [3, 0, "#9EC1F2", "B"], [4, 0, "#F4A6A6", "R"]], "cols": 5, "rows": 1}}, {"k": "try", "t": "Next", "p": [], "qq": {"id": "m3u17s2t02", "type": "mcq", "prompt": "Next: ★ ● ● ★ ● ● ★ …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "●", "ok": true, "fb": ""}, {"t": "★", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I work with patterns?", "p": ["Step 1: Find the repeating unit.", "Step 2: Count how long it is.", "Step 3: Use counting in that number to find later items.", "Step 4: For symmetry: check both sides match."]}, {"k": "example", "t": "Continue", "p": [], "q": "A, B, C, A, B, C, …", "steps": [["unit ABC", ""]], "a": "A, B, C"}, {"k": "example", "t": "Later item", "p": [], "q": "The 12th bead of red, blue, blue…", "steps": [["12 is a multiple of 3", ""], ["end of a unit → blue", ""]], "a": "blue"}, {"k": "example", "t": "Make symmetrical", "p": [], "q": "Complete R Y B _ _ so it is symmetrical.", "steps": [["mirror: B is the middle", ""], ["Y, R", ""]], "a": "R Y B Y R"}, {"k": "example", "t": "Shape pattern", "p": [], "q": "▲ ■ ■ ▲ ■ ■ — how many ■ in 3 units?", "steps": [["2 per unit", ""]], "a": "6"}, {"k": "try", "t": "Later", "p": [], "qq": {"id": "m3u17s2t03", "type": "mcq", "prompt": "Pattern red, blue. The 7th bead?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "red", "ok": true, "fb": ""}, {"t": "blue", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Wrong unit", "p": ["Find the first wrong line."], "q": "Pattern: ● ● ■ ● ● ■ …", "lines": ["The unit is ● ■."], "bad": 0, "why": "The repeating unit is ● ● ■ (3 items).", "fix": [["● ● ■", ""]], "id": "m3u17s2t04"}, {"k": "mistake", "t": "Choosing the wrong repeating unit", "p": ["Find where the pattern starts again."]}, {"k": "tip", "t": "Real life", "p": ["Wallpaper, fabric, tiles and music all use repeating and symmetrical patterns."]}, {"k": "summary", "t": "What to remember", "p": ["Repeating pattern: find the unit.",