num", "prompt": "398 + 247?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 645, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1p02", "type": "num", "prompt": "1000 − 997?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1p03", "type": "num", "prompt": "18 + 47 + 82 + 53?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 200, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1p04", "type": "explain", "prompt": "Which strategy would you use for 604 − 598, and why?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "count on", "kw": ["count|difference|close|near"]}, {"pt": "6", "kw": ["\\b6\\b"]}], "need": 2, "model": "Count on – the numbers are close: 598 → 600 → 604 = 6.", "hint": "", "reason": "Count on – the numbers are close: 598 → 600 → 604 = 6."}, {"id": "m4u13s1p05", "type": "num", "prompt": "765 − 348?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 417, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1p06", "type": "num", "prompt": "A $199 bike and a $49 helmet. Total ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 248, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1p07", "type": "mcq", "prompt": "Best method for 512 − 387?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "written columns", "ok": true, "fb": ""}, {"t": "count on 1", "ok": false, "fb": ""}]}, {"id": "m4u13s1p08", "type": "num", "prompt": "In a game you have 1000 points and lose 285. Points left?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 715, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m4u13s1a01", "type": "num", "prompt": "* Advanced. 999 + 999?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 1998, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1a02", "type": "num", "prompt": "* Advanced. 4002 − 3997?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1a03", "type": "explain", "prompt": "* Advanced. Show two different ways to work out 296 + 307.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "two methods", "kw": ["300|round|adjust|partition|column"]}, {"pt": "603", "kw": ["603"]}], "need": 2, "model": "e.g. 300 + 307 − 4 = 603, or 296 + 300 + 7 = 603.", "hint": "", "reason": "e.g. 300 + 307 − 4 = 603, or 296 + 300 + 7 = 603."}], "more": [{"id": "m4u13s1m01", "type": "num", "prompt": "49 + 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 59, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1m02", "type": "num", "prompt": "49 + 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 58, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1m03", "type": "num", "prompt": "100 − 98?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1m04", "type": "num", "prompt": "25 + 75?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1m05", "type": "num", "prompt": "60 + 19?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 79, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u13s1m06", "type": "num", "prompt": "80 − 39?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 41, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u13", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 13.1 notes · Adding and subtracting efficiently", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "13.2", "title": "Adding and subtracting fractions with the same denominator", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Painting a fence", "p": ["On Saturday Tom paints **2/7** of a fence. On Sunday he paints **3/7**.", "How much has he painted? How much is left? Try it before you read on."]}, {"k": "recall", "t": "Fractions", "p": ["2/7 means 2 of 7 equal parts."], "qq": {"id": "m4u13s2t01", "type": "num", "prompt": "How many sevenths make a whole?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7."}}, {"k": "idea", "t": "Adding", "p": ["When the denominators are the same, **add the numerators** and keep the denominator: 2/7 + 3/7 = **5/7**.", "Think in words: 2 sevenths + 3 sevenths = 5 sevenths."]}, {"k": "idea", "t": "Subtracting", "p": ["**Subtract the numerators**, keep the denominator: 7/7 − 5/7 = **2/7** of the fence is left."], "table": {"head": ["Calculation", "Answer"], "rows": [["1/5 + 2/5", "3/5"], ["4/9 + 4/9", "8/9"], ["5/6 − 1/6", "4/6"], ["1 − 3/8", "5/8"]]}}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m4u13s2t02", "type": "num", "prompt": "1/4 + 2/4? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.75, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/4."}}, {"k": "method", "t": "How do I add or subtract fractions with the same denominator?", "p": ["Step 1: Check the denominators are the same.", "Step 2: Add or subtract the numerators.", "Step 3: Keep the denominator.", "Step 4: For 1 − a fraction, write 1 as n/n."]}, {"k": "example", "t": "Add", "p": [], "q": "3/10 + 4/10.", "steps": [["3 + 4 = 7", ""]], "a": "7/10"}, {"k": "example", "t": "Subtract", "p": [], "q": "7/8 − 2/8.", "steps": [["7 − 2 = 5", ""]], "a": "5/8"}, {"k": "example", "t": "Make a whole", "p": [], "q": "2/5 + 3/5.", "steps": [["5/5", ""]], "a": "1 whole"}, {"k": "example", "t": "From one", "p": [], "q": "1 − 1/3.", "steps": [["3/3 − 1/3", ""]], "a": "2/3"}, {"k": "try", "t": "Subtract", "p": [], "qq": {"id": "m4u13s2t03", "type": "num", "prompt": "6/9 − 2/9? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.4444444444444444, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "4/9."}}, {"k": "error", "t": "Adding the denominators", "p": ["Find the first wrong line."], "q": "2/7 + 3/7", "lines": ["= 5/14"], "bad": 0, "why": "Sevenths + sevenths = sevenths: 5/7.", "fix": [["5/7", ""]], "id": "m4u13s2t04"}, {"k": "mistake", "t": "Adding the denominators", "p": ["The size of the pieces doesn't change – keep the denominator."]}, {"k": "tip", "t": "Real life", "p": ["Recipes (1/4 cup + 2/4 cup) and sharing a pizza use fractions with the same denominator."]}, {"k": "summary", "t": "What to remember", "p": ["Same denominator: + or − the numerators only.", "Keep the denominator.", "1 = n/n."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "13.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u13s2k01", "type": "num", "prompt": "Before you read on: painted altogether? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.7142857142857143, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason