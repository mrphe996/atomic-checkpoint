{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 13, "stage": 14, "title": "Addition and Subtraction", "strandShort": "Number", "blurb": "Mental strategies for adding and subtracting, such as rounding and adjusting, and adding and subtracting fractions with the same denominator.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u13.pdf"}, "objectives": {"O1": {"code": "4Nc.06", "sec": "13.1", "codeNote": "", "t": "Choose efficient mental and written strategies to add and subtract."}, "O2": {"code": "4Nf.05", "sec": "13.2", "codeNote": "", "t": "Add and subtract fractions with the same denominator."}}, "sections": [{"id": "13.1", "title": "Adding and subtracting efficiently", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Quick shopper", "p": ["A jacket costs **$299** and shoes cost **$145**. The cashier works out the total in her head in two seconds.", "How might she do it so fast? Try before you read on."]}, {"k": "recall", "t": "Number bonds", "p": ["60 + 40 = 100."], "qq": {"id": "m4u13s1t01", "type": "num", "prompt": "100 − 45?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 55, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "55."}}, {"k": "idea", "t": "Mental strategies", "p": [], "table": {"head": ["Strategy", "Example"], "rows": [["round and adjust", "299 + 145 = 300 + 145 − 1 = 444"], ["make 10s or 100s", "37 + 28 + 63 = (37 + 63) + 28 = 128"], ["count on (difference)", "403 − 397: count on 3 + 3 = 6"], ["partition", "256 + 32 = 256 + 30 + 2 = 288"]]}, "p2": ["The cashier rounded $299 to $300, then took away $1: **$444**."]}, {"k": "idea", "t": "Mental or written?", "p": ["Use a **mental** strategy when numbers are close to tens or hundreds, or close together. Use the **written column method** when there are lots of exchanges, e.g. 683 − 457.", "Always estimate first to check your answer."]}, {"k": "try", "t": "Round and adjust", "p": [], "qq": {"id": "m4u13s1t02", "type": "num", "prompt": "198 + 56?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 254, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "200 + 56 − 2.", "reason": "254."}}, {"k": "method", "t": "How do I choose a strategy?", "p": ["Step 1: Look at the numbers: near a multiple of 10 or 100?", "Step 2: Close together? Count on to find the difference.", "Step 3: Pairs that make 10 or 100? Add them first.", "Step 4: Otherwise, use columns. Check with an estimate."]}, {"k": "example", "t": "Round and adjust", "p": [], "q": "456 − 199.", "steps": [["456 − 200 = 256", ""], ["+ 1", ""]], "a": "257"}, {"k": "example", "t": "Count on", "p": [], "q": "802 − 795.", "steps": [["795 → 800 = 5", ""], ["800 → 802 = 2", ""]], "a": "7"}, {"k": "example", "t": "Make 100", "p": [], "q": "45 + 36 + 55.", "steps": [["45 + 55 = 100", ""], ["+ 36", ""]], "a": "136"}, {"k": "example", "t": "Column", "p": [], "q": "683 − 457.", "steps": [["exchange a ten: 13 − 7 = 6", ""], ["7 − 5 = 2, 6 − 4 = 2", ""]], "a": "226"}, {"k": "try", "t": "Count on", "p": [], "qq": {"id": "m4u13s1t03", "type": "num", "prompt": "501 − 496?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "error", "t": "Adjusting the wrong way", "p": ["Find the first wrong line."], "q": "456 − 199", "lines": ["456 − 200 = 256", "256 − 1 = 255"], "bad": 1, "why": "You took away 1 too many, so add 1 back: 257.", "fix": [["257", ""]], "id": "m4u13s1t04"}, {"k": "mistake", "t": "Adjusting the wrong way after rounding", "p": ["Took too much away? Add it back. Added too much? Take it away."]}, {"k": "tip", "t": "Real life", "p": ["Shop assistants, darts players and market sellers use these tricks every day."]}, {"k": "summary", "t": "What to remember", "p": ["Round and adjust near 10s and 100s.", "Count on for close numbers.", "Pair to make 10 or 100.", "Columns for harder sums; estimate to check."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "13.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u13s1k01", "type": "num", "prompt": "Before you read on: 299 + 145?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 444, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u13s1k02", "type": "num", "prompt": "37 + 28 + 63?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 128, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u13s1k03", "type": "num", "prompt": "802 − 795?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u13s1k04", "type": "num", "prompt": "Q