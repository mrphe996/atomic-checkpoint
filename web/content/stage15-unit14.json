{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 14, "stage": 15, "title": "Area and Perimeter", "strandShort": "Geometry and measure", "blurb": "Finding the perimeter of rectangles and shapes made of rectangles, and the area of rectangles by counting squares and by multiplying.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u14.pdf"}, "objectives": {"O1": {"code": "5Gg.07", "sec": "14.1", "codeNote": "", "t": "Measure and calculate the perimeter of rectangles and simple compound shapes."}, "O2": {"code": "5Gg.08", "sec": "14.2", "codeNote": "", "t": "Find the area of rectangles and shapes made from rectangles, in square centimetres and square metres."}}, "sections": [{"id": "14.1", "title": "Perimeter", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Garden fence", "p": ["A rectangular vegetable garden is **6 m long** and **4 m wide**. Fencing is sold by the metre.", "How much fencing goes all the way round? Try it before you read on."]}, {"k": "recall", "t": "Rectangles", "p": ["Opposite sides of a rectangle are equal."], "qq": {"id": "m5u14s1t01", "type": "num", "prompt": "A rectangle is 6 m by 4 m. Length of the other long side?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6 m."}}, {"k": "idea", "t": "Perimeter", "p": ["The **perimeter** is the total distance around the outside of a shape. Add all the sides.", "Rectangle: P = length + width + length + width = **2 × (length + width)**."], "p2": ["Garden: 2 × (6 + 4) = **20 m** of fencing."]}, {"k": "idea", "t": "Compound shapes", "p": ["A **compound shape** is made of rectangles. Find any missing sides first, then add **all** the sides."], "fig": {"kind": "cells", "cells": [[0, 2], [0, 3], [1, 2], [1, 3], [2, 2], [2, 3], [3, 2], [3, 3], [0, 0], [0, 1], [1, 0], [1, 1]], "cols": 4, "rows": 4, "grid": true}, "p2": ["Each square is 1 cm. Sides: 2, 2, 2, 2, 4, 4 → perimeter **16 cm**."]}, {"k": "try", "t": "Rectangle", "p": [], "qq": {"id": "m5u14s1t02", "type": "num", "prompt": "Perimeter of a 7 cm by 3 cm rectangle (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "2 × (7 + 3).", "reason": "20 cm."}}, {"k": "method", "t": "How do I find a perimeter?", "p": ["Step 1: Label every side, finding any missing lengths.", "Step 2: Start at one corner and go round.", "Step 3: Add all the sides (rectangle: 2 × (l + w)).", "Step 4: Give the units."]}, {"k": "example", "t": "Rectangle", "p": [], "q": "A rectangle 12 cm by 5 cm.", "steps": [["12 + 5 = 17", ""], ["× 2", ""]], "a": "34 cm"}, {"k": "example", "t": "Square", "p": [], "q": "A square with side 9 m.", "steps": [["4 × 9", ""]], "a": "36 m"}, {"k": "example", "t": "Missing side", "p": [], "q": "Rectangle perimeter 30 cm, length 10 cm. Width?", "steps": [["30 ÷ 2 = 15", ""], ["15 − 10", ""]], "a": "5 cm"}, {"k": "example", "t": "Compound", "p": [], "q": "An L-shape: sides 8, 3, 5, 4, 3, 7 (m).", "steps": [["8 + 3 + 5 + 4 + 3 + 7", ""]], "a": "30 m"}, {"k": "try", "t": "Square", "p": [], "qq": {"id": "m5u14s1t03", "type": "num", "prompt": "Perimeter of a square with side 6 cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "24 cm."}}, {"k": "error", "t": "Adding only two sides", "p": ["Find the first wrong line."], "q": "Perimeter of a 6 m by 4 m rectangle.", "lines": ["6 + 4 = 10 m"], "bad": 0, "why": "There are four sides: 6 + 4 + 6 + 4 = 20 m.", "fix": [["20 m", ""]], "id": "m5u14s1t04"}, {"k": "mistake", "t": "Adding only the two labelled sides", "p": ["Go all the way round – every side counts."]}, {"k": "tip", "t": "Real life", "p": ["Fences, picture frames, skirting boards and running tracks are all perimeters."]}, {"k": "summary", "t": "What to remember", "p": ["Perimeter = distance around.", "Rectangle: 2 × (l + w); square: 4 × side.", "Find missing sides in compound shapes.", "Units: cm, m."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "14.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u14s1k01", "type": "num", "prompt": "Before you read on: fencing for 6 m by 4 m (m)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u14s1k02", "type": "num", "prompt": "Perimeter of the L-shape (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u14s1k03", "type": "num", "prompt": "Perimeter of 12 cm by 5 cm (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 34, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.1-k4", "t": 4, "after":