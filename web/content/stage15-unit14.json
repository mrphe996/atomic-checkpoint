: ""}, {"id": "m5u14s1r08", "type": "num", "prompt": "Regular hexagon side 3 cm. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m5u14s1p01", "type": "num", "prompt": "Rectangle perimeter 26 cm, length 8 cm. Width?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1p02", "type": "num", "prompt": "L-shape sides 6, 2, 4, 3, 2, 5 (cm). Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 22, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1p03", "type": "num", "prompt": "Fence costs $4 per metre. Garden 9 m by 6 m. Cost?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 120, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Perimeter 30 m.", "reason": ""}, {"id": "m5u14s1p04", "type": "explain", "prompt": "Two rectangles: 6 × 2 and 4 × 4. Do they have the same perimeter? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "yes", "kw": ["\\byes\\b|same"]}, {"pt": "16", "kw": ["16"]}], "need": 2, "model": "Yes – 2 × (6 + 2) = 16 and 2 × (4 + 4) = 16.", "hint": "", "reason": "Yes – 2 × (6 + 2) = 16 and 2 × (4 + 4) = 16."}, {"id": "m5u14s1p05", "type": "num", "prompt": "A square photo frame has perimeter 64 cm. Side?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1p06", "type": "num", "prompt": "A field 100 m by 50 m. Twice round – how far (m)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 600, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1p07", "type": "mcq", "prompt": "Rectangle with perimeter 12 cm?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "4 cm by 2 cm", "ok": true, "fb": ""}, {"t": "4 cm by 3 cm", "ok": false, "fb": ""}]}, {"id": "m5u14s1p08", "type": "num", "prompt": "Two 3 cm × 1 cm rectangles side by side make a 3 × 2 rectangle. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m5u14s1a01", "type": "num", "prompt": "* Advanced. A rectangle's length is twice its width; perimeter 24 cm. Length?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "6 widths = 24.", "reason": ""}, {"id": "m5u14s1a02", "type": "explain", "prompt": "* Advanced. Find three different rectangles with whole-number sides and perimeter 16 cm.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "three", "kw": ["1.{0,6}7|2.{0,6}6|3.{0,6}5|4.{0,6}4"]}], "need": 1, "model": "1 × 7, 2 × 6, 3 × 5 (and 4 × 4).", "hint": "", "reason": "1 × 7, 2 × 6, 3 × 5 (and 4 × 4)."}, {"id": "m5u14s1a03", "type": "num", "prompt": "* Advanced. A square of side 4 cm has a 1 cm square cut from one corner. New perimeter?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Cutting a corner square doesn't change it.", "reason": ""}], "more": [{"id": "m5u14s1m01", "type": "num", "prompt": "Rectangle 4 by 3. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1m02", "type": "num", "prompt": "Square side 5. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1m03", "type": "num", "prompt": "Triangle sides 3, 4, 5. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1m04", "type": "num", "prompt": "Rectangle 10 by 1. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 22, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1m05", "type": "num", "prompt": "Square side 10. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u14s1m06", "type": "num", "prompt": "Rectangle 7 by 7. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 28, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u14", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 14.1 notes · Perimeter", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "14.2", "title": "Area", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Carpet tiles", "p": ["A bedroom floor is **5 m by 3 m**. Carpet tiles are **1 m by 1 m**.", "How many tiles cover the floor? Is there a faster way than counting? Try it before you read on."]}, {"k": "recall", "t": "Arrays", "p": ["5 columns of 3 = 15."], "qq": {"id": "m5u14s2t01", "type": "num", "prompt": "4 rows of 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "24."}}, {"k": "idea", "t": "Area", "p": ["**Area** is the amount of surface a shape covers, measured in **square units**: cm², m²."], "fig": {"kind": "cells", "cells": [[0, 0], [0, 1], [0, 2], [1, 0], [1, 1], [1, 2], [2, 0], [2, 1], [2, 2], [3, 0], [3, 1], [3, 2], [4, 0], [4, 1], [4, 2]], "cols": 5, "rows": 3, "grid": true}, "p2": ["A 5 by 3 rectangle holds 5 × 3 = 15 squares. Rectangle: **Area = length × width**. The floor needs **15 tiles** (15 m²)."]}, {"k": "idea", "t": "Shapes made from rectangles", "p": ["Split a compound shape into rectangles, find each area, then **add**."], "fig": {"kind": "cells", "cells": [[0, 2], [0, 3], [1, 2], [1, 3], [2, 2], [2, 3], [3, 2], [3, 3], [0, 0], [0, 1], [1, 0], [1, 1]], "cols": 4, "rows": 4, "grid": true}, "p2": ["Top 2 × 2 = 4, bottom 4 × 2 = 8 → area **12 cm²**."]}, {"k": "try", "t": "Rectangle", "p": [], "qq": {"id": "m5u14s2t02", "type": "num", "prompt": "Area of 8 cm by 4 cm (cm²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 32, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "32 cm²."}}, {"k": "method", "t": "How do I find an area?", "p": ["Step 1: Rectangle: length × width.", "Step 2: Compound: split into rectangles (find missing sides).", "Step 3: Find each area and add.", "Step 4: Write square units: cm² or m²."]}, {"k": "example", "t": "Rectangle", "p": [], "q": "A rug 3 m by 2 m.", "steps": [["3 × 2", ""]], "a": "6 m²"}, {"k": "example", "t": "Square", "p": [], "q": "A tile 9 cm by 9 cm.", "steps": [["9 × 9", ""]], "a": "81 cm²"}, {"k": "example", "t": "Missing side", "p": [], "q": "A rectangle has area 42 cm² and width 6 cm. Length?", "steps": [["42 ÷ 6", ""]], "a": "7 cm"}, {"k": "example", "t": "Compound", "p": [], "q": "An L-shape split into 6 × 2 and 3 × 4 rectangles.", "steps": [["12 + 12", ""]], "a": "24 cm²"}, {"k": "try", "t": "Missing", "p": [], "qq": {"id": "m5u14s2t03", "type": "num", "prompt": "Area 36 m², length 9 m. Width (m)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4 m."}}, {"k": "error", "t": "Mixing up area and perimeter", "p": ["Find the first wrong line."], "q": "Area of a 5 m by 3 m floor.", "lines": [