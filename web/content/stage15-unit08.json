"hint": "", "reason": "", "options": [{"t": "yes", "ok": true, "fb": ""}, {"t": "no", "ok": false, "fb": ""}]}, {"id": "m5u08s1r08", "type": "mcq", "prompt": "Spinner: 6 yellow and 2 purple equal parts. More likely?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "yellow", "ok": true, "fb": ""}, {"t": "purple", "ok": false, "fb": ""}]}], "prac": [{"id": "m5u08s1p01", "type": "mcq", "prompt": "Picking a vowel from the letters of CAT:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": true, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1p02", "type": "mcq", "prompt": "Picking a consonant from the letters of BOOK:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": true, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1p03", "type": "mcq", "prompt": "A number from 1–10 picked at random is less than 9:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": true, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1p04", "type": "explain", "prompt": "A spinner has red, blue and green sections of different sizes. Explain why the colours might not be equally likely.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "different sizes", "kw": ["size|bigger|smaller|larger|area|different"]}], "need": 1, "model": "The sections are different sizes, so a bigger section has a better chance.", "hint": "", "reason": "The sections are different sizes, so a bigger section has a better chance."}, {"id": "m5u08s1p05", "type": "mcq", "prompt": "Which is most likely with a 1–6 dice?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a number bigger than 1", "ok": true, "fb": ""}, {"t": "a 6", "ok": false, "fb": ""}, {"t": "an even number", "ok": false, "fb": ""}]}, {"id": "m5u08s1p06", "type": "num", "prompt": "A bag has 3 red and some blue counters. Red has an even chance. How many blue?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s1p07", "type": "mcq", "prompt": "The day after Friday is Saturday:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": true, "fb": ""}], "fixed": true}, {"id": "m5u08s1p08", "type": "mcq", "prompt": "Bag A: 2 red of 10. Bag B: 2 red of 4. Which gives a better chance of red?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Bag B", "ok": true, "fb": ""}, {"t": "Bag A", "ok": false, "fb": ""}]}], "adv": [{"id": "m5u08s1a01", "type": "explain", "prompt": "* Advanced. Design a bag of 12 counters where red is likely but not certain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "red more than 6 and fewer than 12", "kw": ["\\b(7|8|9|10|11)\\b"]}], "need": 1, "model": "e.g. 9 red and 3 blue – more than half red, but not all.", "hint": "", "reason": "e.g. 9 red and 3 blue – more than half red, but not all."}, {"id": "m5u08s1a02", "type": "num", "prompt": "* Advanced. A bag has 5 red, 3 blue and some green. Red and 'not red' have an even chance. How many green?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Not red must also be 5.", "reason": ""}, {"id": "m5u08s1a03", "type": "mcq", "prompt": "* Advanced. Two fair dice are rolled. Total of 13?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": true, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}]}], "more": [{"id": "m5u08s1m01", "type": "mcq", "prompt": "The sun rises tomorrow:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": true, "fb": ""}], "fixed": true}, {"id": "m5u08s1m02", "type": "mcq", "prompt": "A coin lands tails:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": true, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1m03", "type": "mcq", "prompt": "Picking blue from a bag of only red:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": true, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1m04", "type": "mcq", "prompt": "Bag: 1 red, 9 blue. Red is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": true, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1m05", "type": "mcq", "prompt": "Bag: 1 red, 9 blue. Blue is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": true, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u08s1m06", "type": "mcq", "prompt": "Fair dice outcomes are…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "equally likely", "ok": true, "fb": ""}, {"t": "not equally likely", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c5u08", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 8.1 notes · Likelihood", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "8.2", "title": "Experiments and simulations", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Paper cup flip", "p": ["Flip a paper cup. It can land **upright**, **upside down** or **on its side**.", "Are the three outcomes equally likely? How could you find out? Decide before you read on."]}, {"k": "recall", "t": "Tally", "p": ["𝍸 = 5."], "qq": {"id": "m5u08s2t01", "type": "num", "prompt": "A tally shows 𝍸 𝍸 ||. How many?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Chance experiments", "p": ["In a **chance experiment** you repeat something many times (each try is a **trial**) and record the results in a **tally chart** or frequency table."], "table": {"head": ["Cup lands", "Tally", "Frequency"], "rows": [["upright", "𝍸 |||", "8"], ["upside down", "𝍸 𝍸", "10"], ["on its side", "𝍸 𝍸 𝍸 𝍸 𝍸 𝍸 ||", "32"]]}, "p2": ["After 50 trials 'on its side' happened most – the outcomes are **not** equally likely."]}, {"k": "idea", "t": "Predictions and simulations", "p": ["**Predict** first, then compare. A fair coin, 20 flips: predict about 10 heads. You might get 8 or 12 – results vary, but more trials usually get closer to the prediction.", "A **simulation** uses something simple to act out a real event, e.g. a coin to stand for 'boy or girl', or a dice for 'which of 6 lunches'."]}, {"k": "try", "t": "Predict", "p": [], "qq": {"id": "m5u08s2t02", "type": "num", "prompt": "A fair dice is rolled 60 times. About how many 4s would you expect?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "60 ÷ 6.", "reason": "About 10."}}, {"k": "method", "t": "How do I carry out a chance experiment?", "p": ["Step 1: Predict what should happen.", "Step 2: Do many trials and record with tallies.", "Step 3: Total the frequencies.", "Step 4: Compare results with the prediction – more trials is more reliable."]}, {"k": "example", "t": "Coin", "p": [], "q": "40 coin flips: 23 heads. Compare with the prediction.", "steps": [["prediction 20 heads", ""], ["23 is close to 20", ""]], "a": "close to the prediction"}, {"k": "example", "t": "Spinner", "p": [], "q": "Spinner ¼ red. 80 spins. Prediction for red?", "steps": [["80 ÷ 4", ""]], "a": "about 20"}, {"k": "example", "t": "Is the dice fair?", "p": [], "q": "120 rolls: six came up 45 times.", "steps": [["expected about 20", ""], ["45 is far more", ""]], "a": "probably not fair"}, {"k": "example", "t": "Simulation", "p": [], "q": "Use a dice to simulate choosing one of 3 teams.", "steps": [["1–2 → A, 3–4 → B, 5–6 → C", ""]], "a": "each team 2 numbers"}, {"k": "try", "t": "More trials", "p": [], "qq": {"id": "m5u08s2t03", "type": "mcq", "prompt": "Which is more reliable?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "200 trials", "ok": true, "fb": ""}, {"t": "10 trials", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Expecting exact results", "p": ["Find the first wrong line."], "q": "10 coin flips gave 7 heads.", "lines": ["It should be exactly 5, so the coin is unfair."], "bad": 0, "why": "Results vary; 10 trials is too few to decide. Do many more trials.", "fix": [["do more trials", ""]], "id": "m5u08s2t04"}, {"k": "mistake", "t": "Deciding from a few trials", "p": ["Small experiments vary a lot – repeat many times."]}, {"k": "tip", "t": "Real life", "p": ["Scientists test new medicines with many trials, and game designers simulate thousands of games before release."]}, {"k": "summary", "t": "What to remember", "p": ["Trial = one try; record with tallies.", "Predict, then compare.", "Results vary; more trials → more reliable.", "A simulation models a real event."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "8.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u08s2k01", "type": "mcq", "prompt": "Before you read on: how could you find out?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "flip it many times and record", "ok": true, "fb": ""}, {"t": "flip it once", "ok": false, "fb": ""}]}}, {"id": "8.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u08s2k02", "type": "num", "prompt": "Total trials: 8 + 10 + 32?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "8.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u08s2k03", "type": "num", "prompt": "A fair coin, 50 flips. Expected heads?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "8.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u08s2k04", "type": "mcq", "prompt": "Quick check: 10 flips, 7 heads. Unfair?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "can't tell yet", "ok": true, "fb": ""}, {"t": "yes, definitely", "ok": false, "fb": ""}]}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u08s2r01", "type": "num", "prompt": "Tally 𝍸 𝍸 𝍸 |. Frequency?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2r02", "type": "num", "prompt": "A fair coin, 100 flips. Expected heads?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2r03", "type": "num", "prompt": "A fair 1–6 dice, 30 rolls. Expected 2s?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2r04", "type": "num", "prompt": "Spinner ½ blue, 40 spins. Expected blue?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2r05", "type": "num", "prompt": "Results: red 12, blue 15, green 3. Total trials?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2r06", "type": "mcq", "prompt": "Do results always match predictions exactly?", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "no", "ok": true, "fb": ""}, {"t": "yes", "ok": false, "fb": ""}]}, {"id": "m5u08s2r07", "type": "mcq", "prompt": "Simulating 'yes or no' with equal chance – use a…", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "coin", "ok": true, "fb": ""}, {"t": "1–6 dice (only the 6)", "ok": false, "fb": ""}]}, {"id": "m5u08s2r08", "type": "num", "prompt": "A fair dice, 600 rolls. Expected 6s?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m5u08s2p01", "type": "num", "prompt": "Spinner with 5 equal parts, 1 is gold. 50 spins. Expected gold?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2p02", "type": "mcq", "prompt": "200 coin flips: 104 heads. The coin is…", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "probably fair", "ok": true, "fb": ""}, {"t": "unfair", "ok": false, "fb": ""}]}, {"id": "m5u08s2p03", "type": "mcq", "prompt": "60 dice rolls: 1 came up 31 times. The dice is…", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "Expected 10.", "reason": "", "options": [{"t": "probably not fair", "ok": true, "fb": ""}, {"t": "fair", "ok": false, "fb": ""}]}, {"id": "m5u08s2p04", "type": "explain", "prompt": "Explain why doing 500 trials is better than 20.", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "more reliable / closer", "kw": ["reliable|closer|accurate|better|nearer"]}], "need": 1, "model": "More trials give results that are more reliable and closer to what is expected.", "hint": "", "reason": "More trials give results that are more reliable and closer to what is expected."}, {"id": "m5u08s2p05", "type": "explain", "prompt": "How could you use a 1–6 dice to simulate picking one of 2 drinks with equal chance?", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "split odd/even or 1–3/4–6", "kw": ["odd|even|1.{0,5}3|4.{0,5}6"]}], "need": 1, "model": "e.g. odd numbers → juice, even numbers → water.", "hint": "", "reason": "e.g. odd numbers → juice, even numbers → water."}, {"id": "m5u08s2p06", "type": "num", "prompt": "Bag: 1 red, 3 blue (replaced each time). 80 picks. Expected red?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2p07", "type": "mcq", "prompt": "A drawing pin lands point up 14 times in 40 trials. Point up is…", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "unlikely", "ok": true, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}]}, {"id": "m5u08s2p08", "type": "num", "prompt": "Point up 14 of 40. How many times NOT point up?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 26, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m5u08s2a01", "type": "num", "prompt": "* Advanced. Point up 14 times in 40 trials. Predict point up in 200 trials.", "diff": "H", "obj": "O2", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "×5.", "reason": ""}, {"id": "m5u08s2a02", "type": "explain", "prompt": "* Advanced. Two groups flipped the same cup. Group A: 20 trials, 2 upright. Group B: 300 trials, 45 upright. Whose result would you trust more and why?", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "Group B", "kw": ["\\bB\\b"]}, {"pt": "more trials", "kw": ["more|300"]}], "need": 2, "model": "Group B – 300 trials is far more reliable than 20.", "hint": "", "reason": "Group B – 300 trials is far more reliable than 20."}, {"id": "m5u08s2a03", "type": "mcq", "prompt": "* Advanced. A spinner is ⅓ red. In 90 spins, red came up 29 times. Is that close to the prediction?", "diff": "H", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "yes – 30 predicted", "ok": true, "fb": ""}, {"t": "no", "ok": false, "fb": ""}]}], "more": [{"id": "m5u08s2m01", "type": "num", "prompt": "Tally 𝍸 ||. Frequency?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2m02", "type": "num", "prompt": "A fair coin, 20 flips. Expected tails?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2m03", "type": "num", "prompt": "A fair dice, 12 rolls. Expected 5s?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u08s2m04", "type": "mcq", "prompt": "One try in an experiment is a…", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "trial", "ok": true, "fb": ""}, {"t": "tally", "ok": false, "fb": ""}]}, {"id": "m5u08s2m05", "type": "mcq", "prompt": "More trials usually give…", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "more reliable results", "ok": true, "fb": ""}, {"t": "exact results", "ok": false, "fb": ""}]}, {"id": "m5u08s2m06", "type": "num", "prompt": "Results 9, 6, 5. Total?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u08", "p0": 7, "p1": 10, "label": "pages 7–10", "title": "Lesson 8.2 notes · Experiments and simulations", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}], "segments": {"O1": ["8.1", 0, 300, "Likelihood"], "O2": ["8.2", 0, 300, "Experiments and simulations"]}, "sources": [], "tests": {"A": [{"id": "m5u08v3Aq01", "type": "num", "prompt": "The table shows the results of an experiment. How many goes were there altogether?", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "data": {"head": ["Colour", "red", "blue", "green"], "rows": [["Frequency", "7", "12", "11"]]}, "sec": "A · Fluency", "unit": "goes", "units": ["goes"]}, {"id": "m5u08v3Aq02", "type": "mcq", "prompt": "A bag has 1 red and 1 blue counters. Which is true?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "red and blue are equally likely"}, {"t": "red is impossible"}, {"t": "blue is more likely"}, {"t": "red is more likely"}]}, {"id": "m5u08v3Aq03", "type": "short", "prompt": "A spinner was spun many times. The bar chart shows the results. Which colour came up most?", "diff": "M", "obj": "O2", "skill": "Figure", "pts": 1, "fig": {"kind": "barchart", "labels": ["red", "blue", "green", "yellow"], "values": [10, 3, 14, 7], "ymax": 16, "step": 2, "ylabel": "Frequency"}, "sec": "A · Fluency"}, {"id": "m5u08v3Aq04", "type": "mcq", "prompt": "A class of 8 children has 5 who wear glasses. One child is picked at random. How likely is it that they wear glasses?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "unlikely"}, {"t": "even chance"}, {"t": "impossible"}, {"t": "likely"}]}, {"id": "m5u08v3Aq05", "type": "mcq", "prompt": "A bag has 4 green counters and nothing else. How likely is it to pick a green counter?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "likely"}, {"t": "impossible"}, {"t": "even chance"}, {"t": "certain"}]}, {"id": "m5u08v3Aq06", "type": "num", "prompt": "In an experiment, red came up 8 times, blue 8 times and green 10 times. How many more times did the most common colour appear than the least common?", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "times", "units": ["times"]}, {"id": "m5u08v3Aq07", "type": "mcq", "prompt": "A spinner has 9 equal sections and 2 of them are yellow. Is yellow more likely, less likely or as likely as not yellow?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "less likely"}, {"t": "more likely"}, {"t": "as likely"}]}, {"id": "m5u08v3Aq08", "type": "num", "prompt": "The table shows the results of picking a counter and putting it back. How many times was red picked?", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "data": {"head": ["Colour", "red", "blue", "green"], "rows": [["Frequency", "9", "8", "7"]]}, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m5u08v3Aq09", "type": "order", "prompt": "Order these from least likely to most likely for a fair coin flipped once.", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 2, "sec": "B · Methods", "items": ["landing on heads or tails", "landing on heads", "landing on its edge"]}, {"id": "m5u08v3Aq10", "type": "table", "prompt": "A coin was flipped 20 times and landed on heads 10 times. Complete the table.", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "sec": "B · Methods", "head": ["Outcome", "Frequency"], "rows": [["Heads", {"blank": true}], ["Tails", {"blank": true}]]}, {"id": "m5u08v3Aq11", "type": "mcq", "prompt": "A bag has 6 red and 7 blue counters. Which colour is more likely to be picked?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "B · Methods", "options": [{"t": "blue"}, {"t": "red"}, {"t": "they are equally likely"}]}, {"id": "m5u08v3Aq12", "type": "num", "prompt": "Tom recorded 7 sunny days and 12 rainy days in a month. How many days did he record?", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "B · Methods", "unit": "days", "units": ["days"]}, {"id": "m5u08v3Aq13", "type": "grid", "prompt": "How likely is each event?", "diff": "M", "obj": "O1", "skill": "Data", "pts": 1, "sec": "B · Methods", "cols": ["impossible", "even chance", "certain", "unlikely", "likely"], "mode": "classify", "rows": [{"l": "a dice shows 7"}, {"l": "a coin lands on tails"}, {"l": "a dice shows a number from 1 to 6"}, {"l": "a dice shows an odd number"}]}, {"id": "m5u08v3Aq14", "type": "num", "prompt": "A coin was flipped 20 times and landed on heads 5 times. How many tails were there?", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "B · Methods", "unit": "tails", "units": ["tails"]}, {"id": "m5u08v3Aq15", "type": "num", "prompt": "A bag has 2 red and 6 blue cubes. How many red cubes must be added so that red and blue are equally likely?", "diff": "H", "obj": "O1", "skill": "Application", "pts": 2, "sec": "C · Problem solving", "unit": "cubes", "units": ["cubes"]}, {"id": "m5u08v3Aq16", "type": "num", "prompt": "A fair spinner has 4 equal sections: red, blue, green, yellow. It is spun 24 times. About how many times would you expect blue?", "diff": "H", "obj": "O2", "skill": "Application", "pts": 1, "sec": "C · Problem solving", "unit": "times", "units": ["times"]}, {"id": "m5u08v3Aq17", "type": "num", "prompt": "A fair dice is rolled 90 times. About how many times would you expect it to show a number less than 5?", "diff": "H", "obj": "O2", "skill": "Application", "pts": 1, "sec": "C · Problem solving", "unit": "times", "units": ["times"]}, {"id": "m5u08v3Aq18", "type": "mcq", "prompt": "Maya rolled 2 sixes in a row. What is the chance of a six on her next roll?", "diff": "H", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "C · Problem solving", "options": [{"t": "the same as always (1 in 6)"}, {"t": "much less likely"}, {"t": "impossible"}, {"t": "certain"}]}, {"id": "m5u08v3Aq19", "type": "num", "prompt": "A counter was picked 20 times and green came up 6 times. If you did 40 picks, about how many greens would you expect?", "diff": "H", "obj": "O2", "skill": "Application", "pts": 1, "sec": "C · Problem solving", "unit": "greens", "units": ["greens"]}, {"id": "m5u08v3Aq20", "type": "mcq", "prompt": "A coin was flipped 20 times and gave 8 heads. Is the coin likely to be fair?", "diff": "H", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "C · Problem solving", "options": [{"t": "Yes, the result is close to 10"}, {"t": "No, coins never land on heads"}, {"t": "No, it should be exactly 10"}]}, {"id": "m5u08v3Aq21", "type": "explain", "prompt": "Explain why picking a red counter from a bag of 3 red and 3 blue is an even chance.", "diff": "H", "obj": "O1", "skill": "Reasoning", "pts": 2, "sec": "D · Reasoning"}, {"id": "m5u08v3Aq22", "type": "explain", "prompt": "Explain why rolling a 7 on a normal dice is impossible.", "diff": "H", "obj": "O1", "skill": "Reasoning", "pts": 2, "sec": "D · Reasoning"}, {"id": "m5u08v3Aq23", "type": "mcq", "prompt": "In 50 picks from a bag, red came up 19 times. Which is the best conclusion?", "diff": "H", "obj": "O2", "skill": "Reasoning", "pts": 2, "sec": "D · Reasoning", "options": [{"t": "red is impossible"}, {"t": "red is unlikely"}, {"t": "red is certain"}]}, {"id": "m5u08v3Aq24", "type": "mcq", "prompt": "A coin was flipped 100 times and gave 37 heads. Which statement is best?", "diff": "H", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "D · Reasoning", "options": [{"t": "the result is far from what we expect"}, {"t": "heads is impossible"}, {"t": "the next flip must be tails"}]}, {"id": "m5u08v3Aq25", "type": "mcq", "prompt": "A box has 2 pencils and 8 crayons. One is taken without looking. How likely is it to be a pencil?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "D · Reasoning", "options": [{"t": "likely"}, {"t": "even chance"}, {"t": "impossible"}, {"t": "unlikely"}]}], "B": [{"id": "m5u08v3Bq01", "type": "mcq", "prompt": "A bag has 5 red and 5 blue counters. Which is true?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "red is impossible"}, {"t": "red and blue are equally likely"}, {"t": "red is more likely"}, {"t": "blue is more likely"}]}, {"id": "m5u08v3Bq02", "type": "num", "prompt": "The table shows the results of picking a counter and putting it back. How many times was red picked?", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "data": {"head": ["Colour", "red", "blue", "green"], "rows": [["Frequency", "9", "12", "3"]]}, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m5u08v3Bq03", "type": "num", "prompt": "The table shows the results of an experiment. How many goes were there altogether?", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "data": {"head": ["Colour", "red", "blue", "green"], "rows": [["Frequency", "9", "12", "5"]]}, "sec": "A · Fluency", "unit": "goes", "units": ["goes"]}, {"id": "m5u08v3Bq04", "type": "mcq", "prompt": "A bag has 1 green counters and nothing else. How likely is it to pick a green counter?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "even chance"}, {"t": "certain"}, {"t": "likely"}, {"t": "impossible"}]}, {"id": "m5u08v3Bq05", "type": "mcq", "prompt": "A class of 8 children has 3 who wear glasses. One child is picked at random. How likely is it that they wear glasses?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "even chance"}, {"t": "likely"}, {"t": "unlikely"}, {"t": "impossible"}]}, {"id": "m5u08v3Bq06", "type": "num", "prompt": "In an experiment, red came up 11 times, blue 15 times and green 13 times. How many more times did the most common colour appear than the least common?", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "times", "units": ["times"]}, {"id": "m5u08v3Bq07", "type": "mcq", "prompt": "A bag has 7 red and 5 blue counters. Which colour is more likely to be picked?", "diff": "M", "obj": "O1", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "red"}, {"t": "blue"}, {"t": "they are equally likely"}]}, {"id": "m5u08v3Bq08", "type": "short", "prompt": "A spinner was spun many times. The bar chart shows the results. Which colour came up most?", "diff": "M", "obj": "O2", "skill": "Figure", "pts": 1, "fig": {"kind": "barchart", "labels": ["red", "blue", "green", "yellow"], "values": [7, 6, 2, 3], "ymax": 16, "step": 2, "ylabe