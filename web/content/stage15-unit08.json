{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 8, "stage": 15, "title": "Probability", "strandShort": "Statistics and probability", "blurb": "Describing how likely events are, equally likely outcomes, and carrying out chance experiments and comparing their results with predictions.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u08.pdf"}, "objectives": {"O1": {"code": "5Sp.01", "sec": "8.1", "codeNote": "", "t": "Use the language of chance to describe and compare how likely events are."}, "O2": {"code": "5Sp.02", "sec": "8.2", "codeNote": "", "t": "Carry out chance experiments and simulations, record the results and compare them with predictions."}}, "sections": [{"id": "8.1", "title": "Likelihood", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Sports day", "p": ["The weather app says **90% chance of rain** on sports day. Your friend says 'It **might** rain.'", "Which description tells you more? Think about it before you read on."]}, {"k": "recall", "t": "Fractions of a whole", "p": ["3 out of 4 parts is ¾."], "qq": {"id": "m5u08s1t01", "type": "mcq", "prompt": "Which is bigger: 1/2 or 1/4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/2", "ok": true, "fb": ""}, {"t": "1/4", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "The language of chance", "p": ["We describe how likely an event is with words on a **likelihood scale**:"], "table": {"head": ["Word", "Meaning", "Example"], "rows": [["impossible", "cannot happen", "rolling a 7 on a 1–6 dice"], ["unlikely", "less than half", "snow in a desert"], ["even chance", "half the time", "a coin landing heads"], ["likely", "more than half", "rain with a 90% forecast"], ["certain", "must happen", "a Monday after a Sunday"]]}, "p2": ["90% chance of rain is **likely** – much more useful than 'might'."]}, {"k": "idea", "t": "Equally likely outcomes", "p": ["Outcomes are **equally likely** when each has the same chance – a fair coin (heads, tails), a fair dice (1 to 6)."], "fig": {"kind": "spinner", "labels": ["red", "blue", "red", "green"]}, "p2": ["On this spinner red has 2 of 4 equal parts – **even chance**. Blue and green are equally likely to each other, but each is **unlikely**."]}, {"k": "try", "t": "Place it", "p": [], "qq": {"id": "m5u08s1t02", "type": "mcq", "prompt": "Rolling an even number on a fair 1–6 dice is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "even chance", "ok": true, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I describe how likely something is?", "p": ["Step 1: Count all the possible outcomes.", "Step 2: Count the ones you want.", "Step 3: None → impossible; all → certain; exactly half → even chance.", "Step 4: Less than half → unlikely; more than half → likely."]}, {"k": "example", "t": "Dice", "p": [], "q": "How likely is rolling a number less than 6 on a 1–6 dice?", "steps": [["5 of 6 outcomes", ""], ["more than half", ""]], "a": "likely"}, {"k": "example", "t": "Bag of counters", "p": [], "q": "A bag has 1 blue and 9 yellow counters. Take one without looking. Blue?", "steps": [["1 of 10", ""], ["less than half", ""]], "a": "unlikely"}, {"k": "example", "t": "Compare", "p": [], "q": "Spinner: 3 green sections and 5 orange, all equal. Which colour is more likely?", "steps": [["5 > 3", ""]], "a": "orange"}, {"k": "example", "t": "Impossible", "p": [], "q": "Picking a red counter from a bag of blue counters.", "steps": [["no red at all", ""]], "a": "impossible"}, {"k": "try", "t": "Bag", "p": [], "qq": {"id": "m5u08s1t03", "type": "mcq", "prompt": "A bag has 4 red and 4 white beads. Red is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "even chance", "ok": true, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Mixing up 'possible' with 'likely'", "p": ["Find the first wrong line."], "q": "A bag has 2 red and 8 green sweets. How likely is red?", "lines": ["Red is possible, so it is likely."], "bad": 0, "why": "Possible is not the same as likely: 2 of 10 is less than half, so red is unlikely.", "fix": [["unlikely", ""]], "id": "m5u08s1t04"}, {"k": "mistake", "t": "Thinking 'it could happen' means 'likely'", "p": ["Compare with half: less than half is unlikely."]}, {"k": "tip", "t": "Real life", "p": ["Weather forecasts, games and sports commentators use the language of chance every day."]}, {"k": "summary", "t": "What to remember", "p": ["impossible – unlikely – even chance – likely – certain.", "Equally likely outcomes have the same chance.", "Count outcomes and compare with half.", "Possible does not mean likely."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "8.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u08s1k01", "type": "mcq", "prompt": "Before you read on: which tells you more?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "90% chance of rain", "ok": true, "fb": ""}, {"t": "it might rain", "ok":