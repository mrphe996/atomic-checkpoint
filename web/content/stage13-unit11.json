"O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "3."}}, {"k": "idea", "t": "Unit fractions of numbers", "p": ["To find **1/4 of 12**, share 12 into **4 equal groups**: 12 ÷ 4 = **3**. Sam gets 3.", "1/2 of a number: ÷ 2. 1/3: ÷ 3. 1/5: ÷ 5."]}, {"k": "idea", "t": "Non-unit fractions", "p": ["**3/4 of 12**: find 1/4 (3), then take **3 lots**: 3 × 3 = **9**. Ana gets 9."], "table": {"head": ["Find", "Step 1 (÷ bottom)", "Step 2 (× top)", "Answer"], "rows": [["2/3 of 15", "15 ÷ 3 = 5", "5 × 2", "10"], ["3/5 of 20", "20 ÷ 5 = 4", "4 × 3", "12"], ["1/2 of 18", "18 ÷ 2 = 9", "–", "9"]]}}, {"k": "try", "t": "Unit", "p": [], "qq": {"id": "m3u11s1t02", "type": "num", "prompt": "1/3 of 18?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "method", "t": "How do I find a fraction of a number?", "p": ["Step 1: Divide by the bottom number.", "Step 2: Multiply by the top number.", "Step 3: Draw groups to check.", "Step 4: Include units (cm, $, sweets…)."]}, {"k": "example", "t": "Half", "p": [], "q": "1/2 of 16.", "steps": [["16 ÷ 2", ""]], "a": "8"}, {"k": "example", "t": "Fifth", "p": [], "q": "1/5 of 30.", "steps": [["30 ÷ 5", ""]], "a": "6"}, {"k": "example", "t": "Non-unit", "p": [], "q": "2/5 of 30.", "steps": [["1/5 = 6", ""], ["6 × 2", ""]], "a": "12"}, {"k": "example", "t": "Measure", "p": [], "q": "1/4 of 100 cm.", "steps": [["100 ÷ 4", ""]], "a": "25 cm"}, {"k": "try", "t": "Non-unit", "p": [], "qq": {"id": "m3u11s1t03", "type": "num", "prompt": "3/4 of 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "error", "t": "Dividing by the top number", "p": ["Find the first wrong line."], "q": "3/4 of 12", "lines": ["12 ÷ 3 = 4"], "bad": 0, "why": "Divide by the bottom (4): 3, then × 3 = 9.", "fix": [["9", ""]], "id": "m3u11s1t04"}, {"k": "mistake", "t": "Dividing by the top number", "p": ["Bottom number = how many equal groups."]}, {"k": "tip", "t": "Real life", "p": ["Sharing food, money and time: half an hour is 30 minutes."]}, {"k": "summary", "t": "What to remember", "p": ["÷ bottom, × top.", "1/4 of 12 = 3; 3/4 of 12 = 9.", "Draw groups to check."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "11.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u11s1k01", "type": "num", "prompt": "Before you read on: strawberries for Sam?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u11s1k02", "type": "num", "prompt": "Strawberries for Ana?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u11s1k03", "type": "num", "prompt": "2/5 of 30?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u11s1k04", "type": "num", "prompt": "Quick check: 3/4 of 12?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u11s1r01", "type": "num", "prompt": "1/2 of 20?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u11s1r02", "type": "num", "prompt": "1/