{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 5, "stage": 15, "title": "Addition and Subtraction (1)", "strandShort": "Number", "blurb": "Adding and subtracting whole numbers and decimals with one decimal place, and adding and subtracting with negative numbers.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u05.pdf"}, "objectives": {"O1": {"code": "5Nc.01", "sec": "5.1", "codeNote": "", "t": "Estimate, add and subtract whole numbers and numbers with one decimal place."}, "O2": {"code": "5Ni.01", "sec": "5.2", "codeNote": "", "t": "Add and subtract positive and negative numbers in context, such as temperature."}}, "sections": [{"id": "5.1", "title": "Addition and subtraction including decimal numbers", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Pocket money", "p": ["Sara has **$12.75**. She buys a book for **$6.40** and a pen for **$1.85**.", "How much does she spend? How much is left? Try it before you read on."]}, {"k": "recall", "t": "Column addition", "p": ["Line up ones under ones, tens under tens: 2456 + 1378 = 3834."], "qq": {"id": "m5u05s1t01", "type": "num", "prompt": "Work out 3648 + 2175.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5823, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5823."}}, {"k": "idea", "t": "Adding decimals", "p": ["Line up the **decimal points**, then add from the right, carrying as usual."], "table": {"head": ["", "Ones", ".", "Tenths", "Hundredths"], "rows": [["book", "6", ".", "4", "0"], ["pen", "1", ".", "8", "5"], ["total", "8", ".", "2", "5"]]}, "p2": ["She spends **$8.25**."]}, {"k": "idea", "t": "Subtracting decimals", "p": ["Line up the decimal points and subtract, exchanging when needed: 12.75 − 8.25 = **$4.50** left.", "**Estimate** first: 13 − 8 = 5. Check by adding back: 4.50 + 8.25 = 12.75 ✓.", "Mental methods: 5.6 + 2.9 = 5.6 + 3 − 0.1 = 8.5."]}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m5u05s1t02", "type": "num", "prompt": "Work out 4.6 + 3.8.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8.4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8.4."}}, {"k": "method", "t": "How do I add and subtract decimals?", "p": ["Step 1: Estimate first.", "Step 2: Line up the decimal points (fill gaps with 0).", "Step 3: Add or subtract column by column from the right.", "Step 4: Check by estimating or by the inverse."]}, {"k": "example", "t": "Different lengths", "p": [], "q": "Work out 7.5 + 2.36.", "steps": [["7.50 + 2.36", ""], ["9.86", ""]], "a": "9.86"}, {"k": "example", "t": "Subtract with exchange", "p": [], "q": "Work out 6.2 − 3.7.", "steps": [["exchange 1 one for 10 tenths", ""], ["2.5", ""]], "a": "2.5"}, {"k": "example", "t": "Whole numbers", "p": [], "q": "Work out 8204 − 3567.", "steps": [["exchange across zeros", ""], ["4637", ""]], "a": "4637"}, {"k": "example", "t": "Mental", "p": [], "q": "Work out 9.9 + 4.3.", "steps": [["10 + 4.3 − 0.1", ""], ["14.2", ""]], "a": "14.2"}, {"k": "try", "t": "Subtract", "p": [], "qq": {"id": "m5u05s1t03", "type": "num", "prompt": "Work out 10 − 3.45.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6.55, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6.55."}}, {"k": "error", "t": "Points not lined up", "p": ["Find the first wrong line."], "q": "Work out 5.4 + 1.25.", "lines": ["54 + 125 = 179 → 1.79"], "bad": 0, "why": "Line up the decimal points: 5.40 + 1.25 = 6.65.", "fix": [["6.65", ""]], "id": "m5u05s1t04"}, {"k": "mistake", "t": "Lining up the last digits", "p": ["Line up the decimal points."]}, {"k": "tip", "t": "Real life", "p": ["Shopping, measuring and sports scores need decimal addition and subtraction."]}, {"k": "summary", "t": "What to remember", "p": ["Line up decimal points.", "Fill gaps with zeros.", "Exchange when needed.", "Estimate and check."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "5.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u05s1k01", "type": "num", "prompt": "Before you read on: money left ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u05s1k02", "type": "num", "prompt": "6.40 + 1.85?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8.25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u05s1k03", "type": "num", "prompt": "5.6 + 2.9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u05s1k04", "type": "num", "prompt": "Quick check: 3.5 + 1.5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true,