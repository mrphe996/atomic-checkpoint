,"p":["A linear sequence changes by the same amount each time. Finding that step lets us continue the sequence forwards or backwards."],"v2p":true},{"k":"example","t":"Find the rule","p":[],"q":"What are the next two terms of 7, 11, 15, 19, …?","steps":[["11 − 7 = 4, 15 − 11 = 4","the step is +4"],["19 + 4 = 23, 23 + 4 = 27",""]],"a":"23, 27","v2p":true},{"k":"method","t":"Continue a sequence","p":["Find the difference between neighbouring terms.","Check it is the same each time.","Add (or subtract) it to find more terms."],"v2p":true},{"k":"mistake","t":"Check every step","p":["Look at more than two numbers to find the rule: it must work for every step."]}],"video":{"src":null,"offset":0,"dur":300,"range":""},"stops":[{"id":"1.1-k1","t":1,"after":0,"review":[0,0],"note":"","q":{"id":"m4u01s1k01","type":"num","prompt":"What is the next number: 25, 50, 75, 100, …?","diff":"M","obj":"O1","skill":"Application","answer":125,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true}},{"id":"1.1-k2","t":2,"after":0,"review":[0,0],"note":"","q":{"id":"m4u01s1k02","type":"mcq","prompt":"Before you read on: the sequence is 50, 45, 40, … What is the next term?","diff":"M","obj":"O1","skill":"Reasoning","options":[{"t":"45","ok":false,"fb":"The rule is subtract 5."},{"t":"35","ok":true,"fb":"Correct."},{"t":"30","ok":false,"fb":"40 − 5 = 35."}]}}],"captions":[],"chapters":[[0,300]],"req":[{"id":"m4u01s1r01","type":"num","prompt":"Pattern 1 has 4 tiles, pattern 2 has 7 and pattern 3 has 10. How many tiles in pattern 6?","diff":"M","obj":"O1","skill":"Data","answer":19,"unit":"tiles","units":["tiles"],"tol":0,"errs":[],"data":{"head":["Pattern","1","2","3"],"rows":[["Tiles","4","7","10"]]}},{"id":"m4u01s1r02","type":"table","prompt":"A sequence starts at 13. The rule is 'add 5'. Complete it.","diff":"M","obj":"O1","skill":"Data","head":["1st","2nd","3rd","4th","5th"],"rows":[["13",{"ans":18},{"ans":23},{"ans":28},{"ans":33}]]},{"id":"m4u01s1r03","type":"num","prompt":"What is the n