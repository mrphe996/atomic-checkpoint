{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 1, "stage": 14, "title": "Numbers and the Number System", "strandShort": "Number", "blurb": "Counting on and back in steps, sequences, negative numbers on a number line and in temperatures, and place value in 4-digit numbers.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u01.pdf"}, "objectives": {"O1": {"code": "4Ns.01", "sec": "1.1", "codeNote": "", "t": "Count on and back in steps of constant size, and continue and describe linear sequences."}, "O2": {"code": "4Ni.01", "sec": "1.2", "codeNote": "", "t": "Read, write and order negative numbers in context, such as temperature."}, "O3": {"code": "4Np.01", "sec": "1.3", "codeNote": "", "t": "Understand the value of each digit in 4-digit numbers, and multiply and divide by 10 and 100."}}, "sections": [{"id": "1.1", "title": "Counting and sequences", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Stepping stones", "p": ["A frog jumps along stepping stones numbered **4, 7, 10, 13, …**", "Which stone will it land on next? Will it ever land on 30? Think before you read on."]}, {"k": "recall", "t": "Counting in steps", "p": ["Counting in 5s: 5, 10, 15, 20."], "qq": {"id": "m4u01s1t01", "type": "num", "prompt": "Count in 3s: 3, 6, 9, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Sequences", "p": ["A **sequence** is a list of numbers in a pattern. Each number is a **term**. In a **linear sequence** you add or subtract the **same step** each time."], "fig": {"kind": "numline", "min": 0, "max": 20, "minor": 1, "marks": [4, 7, 10, 13, 16]}, "p2": ["4, 7, 10, 13 → the step is **+3**. Next: 16, 19, 22, 25, 28, 31 – the frog jumps over 30."]}, {"k": "idea", "t": "Counting back", "p": ["Sequences can go down: 50, 44, 38, 32, … (step −6). They can go below zero: 6, 4, 2, 0, −2, −4."]}, {"k": "try", "t": "Next term", "p": [], "qq": {"id": "m4u01s1t02", "type": "num", "prompt": "Next term: 25, 35, 45, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 55, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "55."}}, {"k": "method", "t": "How do I continue a sequence?", "p": ["Step 1: Find the difference between neighbouring terms.", "Step 2: Check it is the same every time.", "Step 3: Add (or subtract) that step to get the next term.", "Step 4: Describe the rule in words: 'start at …, add … each time'."]}, {"k": "example", "t": "Going up", "p": [], "q": "8, 14, 20, 26, …", "steps": [["step +6", ""]], "a": "32, 38"}, {"k": "example", "t": "Going down", "p": [], "q": "100, 90, 80, …", "steps": [["step −10", ""]], "a": "70, 60"}, {"k": "example", "t": "Below zero", "p": [], "q": "9, 6, 3, …", "steps": [["step −3", ""]], "a": "0, −3"}, {"k": "example", "t": "Describe", "p": [], "q": "2, 9, 16, 23", "steps": [["difference 7 each time", ""]], "a": "start at 2, add 7"}, {"k": "try", "t": "Down", "p": [], "qq": {"id": "m4u01s1t03", "type": "num", "prompt": "Next term: 60, 52, 44, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 36, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "36."}}, {"k": "error", "t": "Using the wrong step", "p": ["Find the first wrong line."], "q": "5, 9, 13, 17, …", "lines": ["step +5, next 22"], "bad": 0, "why": "The step is +4 (9 − 5): next term 21.", "fix": [["21", ""]], "id": "m4u01s1t04"}, {"k": "mistake", "t": "Using the first number as the step", "p": ["The step is the difference between two terms."]}, {"k": "tip", "t": "Real life", "p": ["House numbers on one side of a street go up in 2s; bus timetables repeat every 15 minutes."]}, {"k": "summary", "t": "What to remember", "p": ["Linear sequence: same step each time.", "Step = difference between terms.", "Sequences can go down and below zero.", "Describe the rule: start and step."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "1.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u01s1k01", "type": "num", "prompt": "Before you read on: the next stone?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "1.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u01s1k02", "type": "mcq", "prompt": "Does the frog land on 30?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "no", "ok": true, "fb": ""}, {"t": "yes", "ok": false, "fb": ""}]}}, {"id": "1.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u01s1k03", "type": "num", "prompt": "100, 90, 80, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "1.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u01s1k04", "type": "num", "prompt": "Quick check: 9, 6, 3, 0, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u01s1r01", "type": "num", "prompt": "Next: 2, 4, 6, 8, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r02", "type": "num", "prompt": "Next: 11, 21, 31, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 41, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r03", "type": "num", "prompt": "Next: 30, 27, 24, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 21, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r04", "type": "num", "prompt": "Next: 0, 25, 50, 75, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r05", "type": "num", "prompt": "Step in 3, 11, 19, 27?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r06", "type": "num", "prompt": "Next: 4, 2, 0, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r07", "type": "num", "prompt": "Missing: 12, 18, ?, 30", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1r08", "type": "num", "prompt": "Next: 1000, 900, 800, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 700, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m4u01s1p01", "type": "short", "prompt": "Write the next two terms: 7, 16, 25, … Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["34, 43", "/^\\s*34\\s*[,; ]\\s*43\\s*$/"], "hint": "", "reason": ""}, {"id": "m4u01s1p02", "type": "num", "prompt": "Missing: 45, ?, 31, 24", "diff": "M", "obj": "O1", "skill": "Application", "answer": 38, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1p03", "type": "mcq", "prompt": "Rule for 5, 12, 19, 26?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "start at 5, add 7", "ok": true, "fb": ""}, {"t": "start at 5, add 5", "ok": false, "fb": ""}]}, {"id": "m4u01s1p04", "type": "explain", "prompt": "Will 3, 6, 9, 12, … ever reach 40? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|not|never"]}, {"pt": "multiples of 3", "kw": ["multiple|3|39|42"]}], "need": 2, "model": "No – the terms are multiples of 3: 39 then 42, so it jumps over 40.", "hint": "", "reason": "No – the terms are multiples of 3: 39 then 42, so it jumps over 40."}, {"id": "m4u01s1p05", "type": "num", "prompt": "Count back in 4s from 10: 10, 6, 2, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1p06", "type": "num", "prompt": "The 6th term of 5, 10, 15, …?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1p07", "type": "short", "prompt": "Write the first four terms: start at 50, subtract 11. Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["50, 39, 28, 17", "/^\\s*50\\s*[,; ]\\s*39\\s*[,; ]\\s*28\\s*[,; ]\\s*17\\s*$/"], "hint": "", "reason": ""}, {"id": "m4u01s1p08", "type": "num", "prompt": "Missing: −8, −5, ?, 1", "diff": "M", "obj": "O1", "skill": "Application", "answer": -2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m4u01s1a01", "type": "num", "prompt": "* Advanced. The 10th term of 4, 7, 10, 13, …?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 31, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "4 + 9 × 3.", "reason": ""}, {"id": "m4u01s1a02", "type": "explain", "prompt": "* Advanced. A sequence starts at 6 and adds 4. Will 50 be a term? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "yes", "kw": ["\\byes\\b"]}, {"pt": "6 + 4×11", "kw": ["11|44|50"]}], "need": 2, "model": "Yes: 50 − 6 = 44 = 11 steps of 4.", "hint": "", "reason": "Yes: 50 − 6 = 44 = 11 steps of 4."}, {"id": "m4u01s1a03", "type": "num", "prompt": "* Advanced. First term below zero in 40, 33, 26, …?", "diff": "H", "obj": "O1", "skill": "Application", "answer": -2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m4u01s1m01", "type": "num", "prompt": "Next: 10, 20, 30, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1m02", "type": "num", "prompt": "Next: 5, 10, 15, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1m03", "type": "num", "prompt": "Next: 20, 18, 16, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1m04", "type": "num", "prompt": "Next: 1, 4, 7, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1m05", "type": "num", "prompt": "Next: 3, 2, 1, 0, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u01s1m06", "type": "num", "prompt": "Step in 9, 18, 27?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u01", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 1.1 notes · Counting and sequences", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "1.2", "title": "More on negative numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Freezer and fridge", "p": ["A fridge is **4 °C**. A freezer is **−18 °C**. Outside on a winter night it is **−3 °C**.", "Which is the coldest? Order them before you read on."]}, {"k": "recall", "t": "Number lines", "p": ["Numbers get bigger to the right."], "qq": {"id": "m4u01s2t01", "type": "mcq", "prompt": "Which is bigger: 7 or 4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "7", "ok": true, "fb": ""}, {"t": "4", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Negative numbers", "p": ["**Negative numbers** are less than zero. We write them with a minus sign: −3 is read 'negative three'."], "fig": {"kind": "numline", "min": -10, "max": 10, "minor": 1, "marks": [-3, 4]}, "p2": ["On a number line, numbers to the **left** are **smaller**: −3 < 4."]}, {"k": "idea", "t": "Ordering negative numbers", "p": ["The further a negative number is from zero, the **smaller** it is: −18 < −3 < 4. The freezer is coldest.", "On a thermometer, colder is lower down."]}, {"k": "try", "t": "Order", "p": [], "qq": {"id": "m4u01s2t02", "type": "mcq", "prompt": "Which is colder: −5 °C or −2 °C?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−5 °C", "ok": true, "fb": ""}, {"t": "−2 °C", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I order negative numbers?", "p": ["Step 1: Picture a number line or thermometer.", "Step 2: Left (or lower) is smaller.", "Step 3: Among negatives, the bigger digit is the smaller number.", "Step 4: Write them in order and check."]}, {"k": "example", "t": "Compare", "p": [], "q": "−7 or −1?", "steps": [["−7 is further left", ""]], "a": "−7 < −1"}, {"k": "example", "t": "Order", "p": [], "q": "Order 2, −6, 0, −1 from smallest.", "steps": [["negatives first, furthest left first", ""]], "a": "−6, −1, 0, 2"}, {"k": "example", "t": "Temperature change", "p": [], "q": "It is −2 °C and gets 5 degrees warmer.", "steps": [["count up 5 from −2", ""]], "a": "3 °C"}, {"k": "example", "t": "Difference", "p": [], "q": "From −4 °C to 6 °C.", "steps": [["4 to zero, 6 more", ""]], "a": "10 degrees"}, {"k": "try", "t": "Warmer", "p": [], "qq": {"id": "m4u01s2t03", "type": "num", "prompt": "It is −6 °C and rises 4 degrees. New temperature?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "−2 °C."}}, {"k": "error", "t": "Thinking −8 is bigger than −3", "p": ["Find the first wrong line."], "q": "Order −8 and −3.", "lines": ["8 > 3, so −8 > −3"], "bad": 0, "why": "−8 is further below zero: −8 < −3.", "fix": [["−8 < −3", ""]], "id": "m4u01s2t04"}, {"k": "mistake", "t": "Treating negatives like positives", "p": ["For negatives, bigger digits mean colder (smaller)."]}, {"k": "tip", "t": "Real life", "p": ["Temperatures, floors below ground (−1 for the car park) and lifts use negative numbers."]}, {"k": "summary", "t": "What to remember", "p": ["Negative numbers are below zero.", "Left / lower = smaller.", "−18 < −3.", "Count on a number line for changes."]}], "video": {"src": null, "offset": 0, "dur": 660, "ran