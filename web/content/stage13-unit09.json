": "* Advanced. Use digits 1–6 once to make two 3-digit numbers with the smallest total.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "e.g. 135 + 246 = 381", "kw": ["381|135|146|136|145"]}], "need": 1, "model": "Smallest hundreds 1 and 2: e.g. 135 + 246 = 381.", "hint": "", "reason": "Smallest hundreds 1 and 2: e.g. 135 + 246 = 381."}, {"id": "m3u09s1a02", "type": "num", "prompt": "* Advanced. 456 + 456?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 912, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u09s1a03", "type": "num", "prompt": "* Advanced. 99 + 199 + 299?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 597, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m3u09s1m01", "type": "num", "prompt": "45 + 27?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 72, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u09s1m02", "type": "num", "prompt": "118 + 15?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 133, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u09s1m03", "type": "num", "prompt": "250 + 160?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 410, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u09s1m04", "type": "num", "prompt": "330 + 270?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 600, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u09s1m05", "type": "num", "prompt": "25 + 50 + 75?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 150, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u09s1m06", "type": "num", "prompt": "199 + 1?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 200, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c3u09", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 9.1 notes · Addition", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "9.2", "title": "Subtraction", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Saving up", "p": ["A bike costs **$432**. Mia has saved **$178**.", "How much more does she need? Estimate first. Try it before you read on."]}, {"k": "recall", "t": "Exchanging", "p": ["1 ten = 10 ones."], "qq": {"id": "m3u09s2t01", "type": "num", "prompt": "How many ones in 3 tens?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "30."}}, {"k": "idea", "t": "Subtracting with exchange", "p": ["Start with the ones. If the top digit is smaller, **exchange** 1 ten for 10 ones (or 1 hundred for 10 tens)."], "table": {"head": ["", "H", "T", "O"], "rows": [["", "4", "3", "2"], ["−", "1", "7", "8"], ["", "2", "5", "4"]]}, "p2": ["2 − 8: exchange → 12 − 8 = 4. Tens now 2 − 7: exchange → 12 − 7 = 5. Hundreds 3 − 1 = 2. **$254**. Estimate 430 − 180 = 250 ✓."]}, {"k": "idea", "t": "Check with the inverse", "p": ["Add back: 254 + 178 = 432 ✓."]}, {"k": "try", "t": "Subtract", "p": [], "qq": {"id": "m3u09s2t02", "type": "num", "prompt": "352 − 127?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 225, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "225."}}, {"k": "method", "t": "How do I subtract with exchanging?", "p": ["Step 1: Estimate first.", "Step 2: Ones: exchange a ten if needed.", "Step 3: Tens: exchange a hundred if needed.", "Step 4: Hundreds; then check by adding."]}, {"k": "example", "t": "Ones", "p": [], "q": "563 − 248.", "steps": [["13 − 8 = 5", ""], ["5 − 4 = 1", ""], ["5 − 2 = 3", ""]], "a": "315"}, {"k": "example", "t": "Tens", "p": [], "q": "629 − 354.", "steps": [["9 − 4 = 5", ""], ["12 − 5 = 7", ""], ["5 − 3 = 2", ""]], "a": "275"}, {"k": "example", "t": "Zero in the middle", "p": [], "q": "403 − 156.", "steps": [["exchange: 3 hundreds, 9 tens, 13 ones", ""], ["13 − 6 = 7, 9 − 5 = 4, 3 − 1 = 2", ""]], "a": "247"}, {"k": "example", "t": "Check", "p": [], "q": "Is 500 − 275 = 225?", "steps": [["225 + 275 = 500 ✓", ""]], "a": "yes"}, {"k": "try", "t": "Zero", "p": [], "qq": {"id": "m3u09s2t03", "type": "num", "prompt": "300 − 125?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 175, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "175."}}, {"k": "error", "t": "Subtracting smaller from bigger", "p": ["Find the first wrong line."], "q": "432 − 178", "lines": ["ones: 8 − 2 = 6", "tens: 7 − 3 = 4", "346"], "bad": 0, "why": "Top minus bottom: exchange, 12 − 8 = 4… answer 254.", "fix": [["254", ""]], "id": "m3u09s2t04"}, {"k": "mistake", "t": "Swapping the digits", "p": ["Always top minus bottom – exchange when needed."]}, {"k": "tip", "t": "Real life", "p": ["Saving money, distances left on a journey and scores needed to win."]}, {"k": "summary", "t": "What to remember", "p": ["Exchange 1 ten = 10 ones; 1 hundred = 10 tens.", "Top minus bottom.", "Check by adding."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "9.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u09s2k01", "type": "num", "prompt": "Before you read on: how much more?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 254, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "9.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u09s2k02", "type": "num", "prompt": "254 + 178?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 432, "unit": "×", "units": ["×