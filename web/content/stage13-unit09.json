{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 9, "stage": 13, "title": "More Addition and Subtraction", "strandShort": "Number", "blurb": "Adding and subtracting 3-digit numbers with exchanging, estimating answers, and number pairs that make 100 and 1000.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u09.pdf"}, "objectives": {"O1": {"code": "3Nc.06", "sec": "9.1", "codeNote": "", "t": "Estimate and add 3-digit numbers, including exchanging."}, "O2": {"code": "3Nc.07", "sec": "9.2", "codeNote": "", "t": "Estimate and subtract 3-digit numbers, including exchanging, and check with the inverse."}, "O3": {"code": "3Nc.08", "sec": "9.3", "codeNote": "", "t": "Know complements: pairs of multiples of 10 that make 100 and multiples of 100 that make 1000."}}, "sections": [{"id": "9.1", "title": "Addition", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Football tickets", "p": ["**258** adults and **167** children buy tickets for a match.", "Estimate first: about how many people? Then find the exact total. Try it before you read on."]}, {"k": "recall", "t": "Rounding", "p": ["258 ≈ 260; 167 ≈ 170."], "qq": {"id": "m3u09s1t01", "type": "num", "prompt": "Estimate 260 + 170?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 430, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "430."}}, {"k": "idea", "t": "Adding with exchange", "p": ["Add the ones, tens, then hundreds. When a column makes **10 or more**, exchange 10 ones for 1 ten (or 10 tens for 1 hundred)."], "table": {"head": ["", "H", "T", "O"], "rows": [["", "2", "5", "8"], ["+", "1", "6", "7"], ["", "4", "2", "5"]]}, "p2": ["8 + 7 = 15 → write 5, carry 1 ten. 5 + 6 + 1 = 12 → write 2, carry 1 hundred. 2 + 1 + 1 = 4. **425** – close to 430 ✓."]}, {"k": "idea", "t": "Reordering", "p": ["Add numbers in any order to make it easier: 36 + 58 + 64 = (36 + 64) + 58 = 100 + 58 = 158."]}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m3u09s1t02", "type": "num", "prompt": "176 + 148?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 324, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "324."}}, {"k": "method", "t": "How do I add with exchanging?", "p": ["Step 1: Estimate first.", "Step 2: Add the ones; exchange if 10 or more.", "Step 3: Add the tens (and any exchanged ten); exchange if needed.", "Step 4: Add the hundreds; check with the estimate."]}, {"k": "example", "t": "Ones exchange", "p": [], "q": "347 + 126.", "steps": [["7 + 6 = 13 → 3, carry 1", ""], ["4 + 2 + 1 = 7", ""], ["3 + 1 = 4", ""]], "a": "473"}, {"k": "example", "t": "Tens exchange", "p": [], "q": "281 + 154.", "steps": [["1 + 4 = 5", ""], ["8 + 5 = 13 → 3, carry 1", ""], ["2 + 1 + 1 = 4", ""]], "a": "435"}, {"k": "example", "t": "Both", "p": [], "q": "468 + 275.", "steps": [["8 + 5 = 13", ""], ["6 + 7 + 1 = 14", ""], ["4 + 2 + 1 = 7", ""]], "a": "743"}, {"k": "example", "t": "Reorder", "p": [], "q": "45 + 27 + 55.", "steps": [["45 + 55 = 100", ""]], "a": "127"}, {"k": "try", "t": "Reorder", "p": [], "qq": {"id": "m3u09s1t03", "type": "num", "prompt": "72 + 19 + 28?", "diff": "M", "obj": "O1", "skill": "Application", "answer":