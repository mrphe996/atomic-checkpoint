units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1p06", "type": "num", "prompt": "Point: 135°, 2x, x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 75, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "3x = 225.", "reason": ""}, {"id": "m6u13s1p07", "type": "mcq", "prompt": "Estimate an angle a bit bigger than a right angle:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "about 100°", "ok": true, "fb": ""}, {"t": "about 60°", "ok": false, "fb": ""}]}, {"id": "m6u13s1p08", "type": "num", "prompt": "Reflex angle when the inside angle is 85°?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 275, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m6u13s1a01", "type": "num", "prompt": "* Advanced. Angle between clock hands at 4:00 (smaller angle)?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 120, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1a02", "type": "num", "prompt": "* Advanced. Five equal angles around a point. Each?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 72, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1a03", "type": "explain", "prompt": "* Advanced. Why should you estimate before measuring an angle?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "check / catch wrong scale", "kw": ["check|scale|mistake|wrong|sense"]}], "need": 1, "model": "An estimate tells you if the angle is acute or obtuse, so you notice if you read the wrong scale.", "hint": "", "reason": "An estimate tells you if the angle is acute or obtuse, so you notice if you read the wrong scale."}], "more": [{"id": "m6u13s1m01", "type": "mcq", "prompt": "45° is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": true, "fb": ""}, {"t": "reflex", "ok": false, "fb": ""}]}, {"id": "m6u13s1m02", "type": "mcq", "prompt": "170° is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "obtuse", "ok": true, "fb": ""}, {"t": "acute", "ok": false, "fb": ""}]}, {"id": "m6u13s1m03", "type": "num", "prompt": "Line: 90° and x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1m04", "type": "num", "prompt": "Full turn?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 360, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1m05", "type": "num", "prompt": "Half turn?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1m06", "type": "num", "prompt": "Line: 30° and x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 150, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u13", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 13.1 notes · Measuring and drawing angles", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "13.2", "title": "Angles in a triangle", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Paper triangle trick", "p": ["Draw any triangle on paper, tear off its three corners and put them together, points touching.", "What do you notice about the three angles? Try it before you read on."]}, {"k": "recall", "t": "Angles on a line", "p": ["Angles on a straight line add to 180°."], "qq": {"id": "m6u13s2t01", "type": "num", "prompt": "Line: 65° and x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 115, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "115°."}}, {"k": "idea", "t": "The angle sum", "p": ["The three torn corners always fit together to make a **straight line**. So the angles in any triangle **add to 180°**."], "fig": {"kind": "shape", "pts": [[0, 0], [7, 0], [2, 4]], "ang": ["58°", "39°", "?"]}}, {"k": "idea", "t": "Finding a missing angle", "p": ["Subtract the known angles from 180°: 180 − 58 − 39 = **83°**.", "Special triangles: an **equilateral** triangle has three 60° angles; an **isosceles** triangle has two equal angles; a **right-angled** triangle has one 90° angle."], "table": {"head": ["Triangle", "Angles"], "rows": [["equilateral", "60°, 60°, 60°"], ["isosceles, top 40°", "40°, 70°, 70°"], ["right-angled with 35°", "90°, 35°, 55°"]]}}, {"k": "try", "t": "Missing", "p": [], "qq": {"id": "m6u13s2t02", "type": "num", "prompt": "Triangle angles 72° and 48°. Third?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "60°."}}, {"k": "method", "t": "How do I find a missing angle in a triangle?", "p": ["Step 1: Add the known angles.", "Step 2: Subtract from 180°.", "Step 3: Use special facts (right angle 90°, isosceles equal angles).", "Step 4: Check: all three add to 180°."]}, {"k": "example", "t": "Right-angled", "p": [], "q": "A right-angled triangle has an angle of 27°.", "steps": [["180 − 90 − 27 = 63", ""]], "a": "63°"}, {"k": "example", "t": "Isosceles", "p": [], "q": "An isosceles triangle has a top angle of 50°.", "steps": [["180 − 50 = 130", ""], ["130 ÷ 2 = 65", ""]], "a": "65° and 65°"}, {"k": "example", "t": "Isosceles base given", "p": [], "q": "An isosceles triangle has two angles of 35°.", "steps": [["180 − 70 = 110", ""]], "a": "110°"}, {"k": "example", "t": "Is it possible?", "p": [], "q": "Can a triangle have angles 100°, 50° and 40°?", "steps": [["100 + 50 + 40 = 190", "not 180"]], "a": "no"}, {"k": "try", "t": "Isosceles", "p": [], "qq": {"id": "m6u13s2t03", "type": "num", "prompt": "Isosceles triangle, top angle 80°. Each base angle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "50°."}}, {"k": "error", "t": "Used 360°", "p": ["Find the first wrong line."], "q": "Triangle angles 70° and 60°. Third?", "lines": ["360 − 130 = 230°"], "bad": 0, "why": "Triangles add to 180°: 180 − 130 = 50°.", "fix": [["180 − 130 = 50°", ""]], "id": "m6u13s2t04"}, {"k": "mistake", "t": "Using 360° for a triangle", "p": ["Triangle 180°; quadrilateral 360°."]}, {"k": "tip", "t": "Real life", "p": ["Roof trusses, bridges and bike frames are built from triangles; engineers calculate their angles."]}, {"k": "summary", "t": "What to remember", "p": ["Angles in a triangle add to 180°.", "Missing angle = 180 − the others.", "Equilateral: 60° each.", "Isosceles: two equal angles."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "13.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u13s2k01", "type": "mcq", "prompt": "Before you read on: the corners make …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a straight line", "ok": true, "fb": ""}, {"t": "a full circle", "ok": false, "fb": ""}]}}, {"id": "13.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u13s2k02", "type": "num", "prompt": "Angles in a triangle add to?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u13s2k03", "type": "num", "prompt": "Missing angle 180 − 58 − 39?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 83, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "h