{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 13, "stage": 16, "title": "Angles", "strandShort": "Geometry and measure", "blurb": "Classifying, estimating, measuring and drawing angles, angles on a straight line and around a point, and the angles in a triangle.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u13.pdf"}, "objectives": {"O1": {"code": "6Gg.07", "sec": "13.1", "codeNote": "", "t": "Classify, estimate, measure and draw angles, and use angles on a straight line and around a point."}, "O2": {"code": "6Gg.08", "sec": "13.2", "codeNote": "", "t": "Know that the angles in a triangle add up to 180° and use this to find missing angles."}}, "sections": [{"id": "13.1", "title": "Measuring and drawing angles", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Ramp angle", "p": ["A skateboard ramp must not be steeper than **35°**. A builder measures the angle between the ramp and the ground with a protractor.", "How do you read a protractor correctly – the inner or the outer numbers? Think about it before you read on."]}, {"k": "recall", "t": "Types of angle", "p": ["Acute < 90°; right = 90°; obtuse between 90° and 180°; reflex > 180°."], "qq": {"id": "m6u13s1t01", "type": "mcq", "prompt": "An angle of 125° is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "obtuse", "ok": true, "fb": ""}, {"t": "acute", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Measuring with a protractor", "p": ["1. Put the centre cross on the **vertex** (the corner).", "2. Line up the **zero line** with one arm of the angle.", "3. Read from the scale that **starts at 0** on that arm, counting round to the other arm.", "**Estimate first**: is it acute or obtuse? A 35° ramp angle is acute – if you read 145° you used the wrong scale."], "fig": {"kind": "anglept", "angles": [35, 145], "start": 0, "labels": ["35°", ""], "line": true}}, {"k": "idea", "t": "Drawing an angle", "p": ["Draw one arm with a ruler; mark the vertex. Place the protractor on the vertex with 0 along the arm.", "Count round to the angle and make a dot; join the vertex to the dot. Label the angle.", "Reflex angles: draw 360° − the angle as the inside angle, then mark the outside (e.g. 250° → draw 110°)."]}, {"k": "try", "t": "Scale", "p": [], "qq": {"id": "m6u13s1t02", "type": "mcq", "prompt": "A protractor shows 50 on one scale and 130 on the other for an acute angle. The angle is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "50°", "ok": true, "fb": ""}, {"t": "130°", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I measure or draw an angle?", "p": ["Step 1: Estimate first (acute, obtuse or reflex?).", "Step 2: Centre on the vertex; zero line along one arm.", "Step 3: Read the scale that starts at 0 on that arm.", "Step 4: Check against your estimate."]}, {"k": "example", "t": "Obtuse", "p": [], "q": "An angle reads 70 and 110 on the two scales and is wider than a right angle.", "steps": [["obtuse → 110°", ""]], "a": "110°"}, {"k": "example", "t": "Reflex", "p": [], "q": "Draw an angle of 300°.", "steps": [["360 − 300 = 60", ""], ["draw 60° and mark the outside angle", ""]], "a": "draw 60°, mark the reflex angle"}, {"k": "example", "t": "Around a point", "p": [], "q": "Angles around a point are 120°, 95° and x.", "steps": [["360 − 215 = 145", ""]], "a": "145°"}, {"k": "example", "t": "On a straight line", "p": [], "q": "Two angles on a line: 62° and x.", "steps": [["180 − 62 = 118", ""]], "a": "118°"}, {"k": "try", "t": "Line", "p": [], "qq": {"id": "m6u13s1t03", "type": "num", "prompt": "Angles on a straight line: 47° and x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 133, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "133°."}}, {"k": "error", "t": "Wrong scale", "p": ["Find the first wrong line."], "q": "A ramp angle is clearly acute.", "lines": ["the protractor reads 145°", "so the ramp is 145°"], "bad": 1, "why": "An acute angle is less than 90°: the other scale gives 35°.", "fix": [["use the scale starting at 0 → 35°", ""]], "id": "m6u13s1t04"}, {"k": "mistake", "t": "Reading the wrong scale", "p": ["Estimate first and start from 0."]}, {"k": "tip", "t": "Real life", "p": ["Builders, designers and sports coaches (e.g. a kick angle) measure angles."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate: acute, right, obtuse, reflex.", "Centre on the vertex, zero on one arm.", "Read from 0.", "Line 180°, point 360°."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "13.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u13s1k01", "type": "mcq", "prompt": "Before you read on: a 35° ramp is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": true, "fb": ""}, {"t": "obtuse", "ok": false, "fb": ""}]}}, {"id": "13.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u13s1k02", "type": "mcq", "prompt": "Put the protractor's centre on the …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "vertex", "ok": true, "fb": ""}, {"t": "end of an arm", "ok": false, "fb": ""}]}}, {"id": "13.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u13s1k03", "type": "num", "prompt": "To draw 250°, draw an inside angle of?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 110, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u13s1k04", "type": "num", "prompt": "Quick check: around a point 120°, 95°, x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 145, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u13s1r01", "type": "mcq", "prompt": "75° is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": true, "fb": ""}, {"t": "obtuse", "ok": false, "fb": ""}]}, {"id": "m6u13s1r02", "type": "mcq", "prompt": "200° is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "reflex", "ok": true, "fb": ""}, {"t": "obtuse", "ok": false, "fb": ""}]}, {"id": "m6u13s1r03", "type": "num", "prompt": "Line: 110° and x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1r04", "type": "num", "prompt": "Point: 90°, 90°, 100°, x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 80, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1r05", "type": "num", "prompt": "Reflex 330°: inside angle to draw?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u13s1r06", "type": "mcq", "prompt": "Readings 40 and 140, obtuse angle:", "diff": "M", 