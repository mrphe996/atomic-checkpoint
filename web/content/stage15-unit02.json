": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u02s1p06", "type": "mcq", "prompt": "Which can't be drawn?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a triangle with two right angles", "ok": true, "fb": ""}, {"t": "a right-angled scalene triangle", "ok": false, "fb": ""}]}, {"id": "m5u02s1p07", "type": "num", "prompt": "Isosceles: two sides 7 cm, perimeter 20 cm. Third side?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u02s1p08", "type": "mcq", "prompt": "A scalene triangle has …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3 different angles", "ok": true, "fb": ""}, {"t": "2 equal angles", "ok": false, "fb": ""}]}], "adv": [{"id": "m5u02s1a01", "type": "explain", "prompt": "* Advanced. Why can't a triangle have two right angles?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "too much / 180", "kw": ["180|too|already|no room|lines would be parallel"]}], "need": 1, "model": "Two right angles already make 180°, leaving nothing for the third angle – the sides would never meet.", "hint": "", "reason": "Two right angles already make 180°, leaving nothing for the third angle – the sides would never meet."}, {"id": "m5u02s1a02", "type": "num", "prompt": "* Advanced. Isosceles triangle: base 10 cm, perimeter 36 cm. Each equal side?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u02s1a03", "type": "mcq", "prompt": "* Advanced. How many lines of symmetry has an equilateral triangle?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3", "ok": true, "fb": ""}, {"t": "1", "ok": false, "fb": ""}]}], "more": [{"id": "m5u02s1m01", "type": "mcq", "prompt": "3 equal sides →", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "equilateral", "ok": true, "fb": ""}, {"t": "isosceles only", "ok": false, "fb": ""}]}, {"id": "m5u02s1m02", "type": "mcq", "prompt": "2 equal sides →", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "isosceles", "ok": true, "fb": ""}, {"t": "scalene", "ok": false, "fb": ""}]}, {"id": "m5u02s1m03", "type": "mcq", "prompt": "No equal sides →", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "scalene", "ok": true, "fb": ""}, {"t": "equilateral", "ok": false, "fb": ""}]}, {"id": "m5u02s1m04", "type": "num", "prompt": "Right angle (°)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u02s1m05", "type": "num", "prompt": "Equilateral side 4. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u02s1m06", "type": "mcq", "prompt": "Triangles have … angles", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3", "ok": true, "fb": ""}, {"t": "4", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c5u02", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 2.1 notes · Triangles", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "2.2", "title": "Symmetry", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Folding paper", "p": ["Fold a piece of paper in half, cut out a shape along the fold, and open it up. You get a perfectly matching pattern on both sides.", "Why do the two halves match? Where is the fold line? Think about it before you read on."]}, {"k": "recall", "t": "Lines of symmetry", "p": ["A line of symmetry splits a shape into two halves that are mirror images."], "qq": {"id": "m5u02s2t01", "type": "num", "prompt": "Lines of symmetry in a square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "idea", "t": "Finding lines of symmetry", "p": ["Fold (or imagine folding) along a line: if the two halves fit exactly, it is a **line of symmetry**."], "table": {"head": ["Shape", "Lines of symmetry"], "rows": [["rectangle", "2"], ["square", "4"], ["equilateral triangle", "3"], ["isosceles triangle", "1"], ["regular hexagon", "6"], ["circle", "infinitely many"]]}}, {"k": "idea", "t": "Completing symmetrical patterns", "p": ["To reflect a pattern in a mirror line, each square must be the **same distance** from the line on the other side."], "fig": {"kind": "cells", "cells": [[0, 0], [1, 0], [1, 1], [2, 2], [5, 0], [4, 0], [4, 1], [3, 2]], "cols": 6, "rows": 3, "grid": true, "mirror": {"x": 3}}, "p2": ["Lines can be vertical, horizontal or diagonal."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m5u02s2t02", "type": "num", "prompt": "Lines of symmetry in an equilateral triangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "3."}}, {"k": "method", "t": "How do I find and use lines of symmetry?", "p": ["Step 1: Imagine folding the shape along a line.", "Step 2: Check whether the halves match exactly.", "Step 3: To complete a pattern, count squares from the mirror line.", "Step 4: Draw the same distance on the other side."]}, {"k": "example", "t": "Rectangle", "p": [], "q": "Lines of symmetry in a rectangle (not a square).", "steps": [["vertical and horizontal through the middle", ""], ["diagonals don't work", ""]], "a": "2"}, {"k": "example", "t": "Letter", "p": [], "q": "Lines of symmetry in the letter H.", "steps": [["vertical and horizontal", ""]], 