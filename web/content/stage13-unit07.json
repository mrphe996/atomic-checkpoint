{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 7, "stage": 13, "title": "Statistics: Tally Charts and Frequency Tables", "strandShort": "Statistics and probability", "blurb": "Collecting data with tally marks, counting tallies, and reading and completing frequency tables to answer questions.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u07.pdf"}, "objectives": {"O1": {"code": "3Ss.01", "sec": "7.1", "codeNote": "", "t": "Record data using tally marks and count tallies in groups of five."}, "O2": {"code": "3Ss.02", "sec": "7.2", "codeNote": "", "t": "Complete and interpret frequency tables to answer questions."}}, "sections": [{"id": "7.1", "title": "Tally charts", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Bird watch", "p": ["Ana watches the bird feeder for 10 minutes and sees lots of sparrows, pigeons and robins.", "How can she keep count quickly while the birds fly in and out? Think before you read on."]}, {"k": "recall", "t": "Counting in 5s", "p": ["5, 10, 15, 20."], "qq": {"id": "m3u07s1t01", "type": "num", "prompt": "Count in 5s: 5, 10, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15."}}, {"k": "idea", "t": "Tally marks", "p": ["A **tally mark** is a quick line for each thing you count. Every **fifth** mark goes **across** the four before it: 𝍸 = 5."], "table": {"head": ["Bird", "Tally"], "rows": [["sparrow", "𝍸 𝍸 |||"], ["pigeon", "𝍸 |"], ["robin", "||||"]]}, "p2": ["Count in 5s, then add the ones: sparrows 5, 10, 11, 12, **13**; pigeons **6**; robins **4**."]}, {"k": "idea", "t": "Why groups of 5?", "p": ["Groups of 5 are quick to count. 𝍸 𝍸 𝍸 || = 15 + 2 = 17."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m3u07s1t02", "type": "num", "prompt": "𝍸 𝍸 | = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "11."}}, {"k": "method", "t": "How do I use tally marks?", "p": ["Step 1: Make one mark for each thing.", "Step 2: Cross the fifth mark over the four.", "Step 3: Count the groups in 5s.", "Step 4: Add the single marks."]}, {"k": "example", "t": "Count", "p": [], "q": "𝍸 𝍸 𝍸 𝍸 |||.", "steps": [["5, 10, 15, 20", ""], ["+ 3", ""]], "a": "23"}, {"k": "example", "t": "Write", "p": [], "q": "Show 9 with tallies.", "steps": [["one group of 5 + 4", ""]], "a": "𝍸 ||||"}, {"k": "example", "t": "Most", "p": [], "q": "Which bird was seen most?", "steps": [["13 sparrows", ""]], "a": "sparrow"}, {"k": "example", "t": "Total", "p": [], "q": "All birds seen.", "steps": [["13 + 6 + 4", ""]], "a": "23"}, {"k": "try", "t": "Write", "p": [], "qq": {"id": "m3u07s1t03", "type": "mcq", "prompt": "Which shows 7?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "𝍸 ||", "ok": true, "fb": ""}, {"t": "|||||||", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Not crossing the fifth", "p": ["Find the first wrong line."], "q": "Write 6 in tallies.", "lines": ["||||||"], "bad": 0, "why": "Cross the fifth: 𝍸 | – easier to count.", "fix": [["𝍸 |", ""]], "id": "m3u07s1t04"}, {"k": "mistake", "t": "Not grouping in 5s", "p": ["The fifth mark goes across."]}, {"k": "tip", "t": "Real life", "p": ["Scorekeepers, traffic counters and bird watchers use tally marks."]}, {"k": "summary", "t": "What to remember", "p": ["One mark per thing.", "𝍸 = 5.", "Count 5s, then add ones."]}], "video": {"src": null, "offset": 0, "dur": 600, "range": ""}, "stops": [{"id": "7.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u07s1k01", "type": "mcq", "prompt": "Before you read on: a quick way to count?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "tally marks", "ok": true, "fb": ""}, {"t": "writing every word", "ok": false, "fb": ""}]}}, {"id": "7.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u07s1k02", "type": "num", "prompt": "Sparrows seen?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u07s1k03", "type": "num", "prompt": "𝍸 𝍸 𝍸 𝍸 ||| = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 23, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u07s1k04", "type": "num", "prompt": "Quick check: 𝍸 | = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u07s1r01", "type": "num", "prompt": "𝍸 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1r02", "type": "num", "prompt": "𝍸 || = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1r03", "type": "num", "prompt": "𝍸 𝍸 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1r04", "type": "num", "prompt": "𝍸 𝍸 |||| = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1r05", "type": "num", "prompt": "||| = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1r06", "type": "num", "prompt": "𝍸 𝍸 𝍸 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1r07", "type": "mcq", "prompt": "Which shows 12?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "𝍸 𝍸 ||", "ok": true, "fb": ""}, {"t": "𝍸 ||", "ok": false, "fb": ""}]}, {"id": "m3u07s1r08", "type": "num", "prompt": "Pigeons seen?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m3u07s1p01", "type": "num", "prompt": "How many groups of 5 in 20 tallies?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1p02", "type": "num", "prompt": "Red 𝍸 |||, blue 𝍸 𝍸. How many more blue?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u07s1p03", "type": "num", "prompt": "Red 𝍸 |||, blue 𝍸 𝍸. Total?", "diff": "M", "obj": "O1", "skill": 