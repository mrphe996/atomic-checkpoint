"units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "59."}}, {"k": "idea", "t": "Adding by partitioning", "p": ["Split both numbers into hundreds, tens and ones, add each part, then put them together:"], "table": {"head": ["", "Hundreds", "Tens", "Ones"], "rows": [["146", "100", "40", "6"], ["228", "200", "20", "8"], ["total", "300", "60", "14"]]}, "p2": ["300 + 60 + 14 = **374 people**."]}, {"k": "idea", "t": "Mental tricks", "p": ["Add the tens, then the ones: 57 + 36 = 57 + 30 + 6 = 87 + 6 = 93.", "Near a ten? 49 + 25 = 50 + 25 − 1 = 74."]}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m3u02s1t02", "type": "num", "prompt": "123 + 245?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 368, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "368."}}, {"k": "method", "t": "How do I add?", "p": ["Step 1: Estimate first.", "Step 2: Partition into hundreds, tens and ones.", "Step 3: Add each part.", "Step 4: Recombine and check with your estimate."]}, {"k": "example", "t": "Partition", "p": [], "q": "235 + 152.", "steps": [["200 + 100 = 300", ""], ["30 + 50 = 80", ""], ["5 + 2 = 7", ""]], "a": "387"}, {"k": "example", "t": "Make a ten", "p": [], "q": "47 + 8.", "steps": [["47 + 3 = 50", ""], ["+ 5", ""]], "a": "55"}, {"k": "example", "t": "Near a ten", "p": [], "q": "29 + 46.", "steps": [["30 + 46 = 76", ""], ["− 1", ""]], "a": "75"}, {"k": "example", "t": "Story", "p": [], "q": "A book has 124 pages; another has 63.", "steps": [["124 + 63", ""]], "a": "187 pages"}, {"k": "try", "t": "Near ten", "p": [], "qq": {"id": "m3u02s1t03", "type": "num", "prompt": "39 + 27?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 66, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "40 + 27 − 1.", "reason": "66."}}, {"k": "error", "t": "Adding digits without place value", "p": ["Find the first wrong line."], "q": "146 + 228", "lines": ["1 + 2 = 3, 4 + 2 = 6, 6 + 8 = 14", "answe