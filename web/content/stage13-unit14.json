{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 14, "stage": 13, "title": "Angles and Movement", "strandShort": "Geometry and measure", "blurb": "Turns as angles, right angles and quarter, half and whole turns, compass directions, and describing position and movement on a grid.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u14.pdf"}, "objectives": {"O1": {"code": "3Gg.03", "sec": "14.1", "codeNote": "", "t": "Recognise angles as turns, including right angles, and compare angles with a right angle."}, "O2": {"code": "3Gp.01", "sec": "14.2", "codeNote": "", "t": "Use compass directions and describe position and movement on a grid."}}, "sections": [{"id": "14.1", "title": "Angles and turns", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Spinning round", "p": ["In PE you face the board, then turn until you face the door on your right.", "How much of a full turn did you make? Think before you read on."]}, {"k": "recall", "t": "Clockwise", "p": ["Clock hands turn clockwise."], "qq": {"id": "m3u14s1t01", "type": "mcq", "prompt": "Which way do clock hands turn?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "clockwise", "ok": true, "fb": ""}, {"t": "anticlockwise", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Turns", "p": [], "table": {"head": ["Turn", "Right angles", "Example"], "rows": [["quarter turn", "1", "face the board → face the right wall"], ["half turn", "2", "face the board → face the back"], ["three-quarter turn", "3", "board → left wall (clockwise)"], ["whole turn", "4", "back to the board"]]}, "p2": ["A **quarter turn** is a **right angle**."]}, {"k": "idea", "t": "Comparing angles with a right angle", "p": ["An angle is the amount of turn between two lines. Use a right-angle checker (the corner of paper): angles are **smaller than**, **equal to** or **bigger than** a right angle."], "fig": {"kind": "anglept", "angles": [90], "start": 0, "labels": ["right angle"]}}, {"k": "try", "t": "Turn", "p": [], "qq": {"id": "m3u14s1t02", "type": "mcq", "prompt": "Turning from facing front to facing back is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "quarter turn", "ok": false, "fb": ""}, {"t": "half turn", "ok": true, "fb": ""}, {"t": "three-quarter turn", "ok": false, "fb": ""}, {"t": "whole turn", "ok": false, "fb": ""}], "fixed": true}}, {"k": "method", "t": "How do I describe turns and angles?", "p": ["Step 1: Count right angles: 1 quarter, 2 half, 3 three-quarters, 4 whole.", "Step 2: Say clockwise or anticlockwise.", "Step 3: Check angles with a right-angle checker.", "Step 4: Smaller, equal or bigger than a right angle."]}, {"k": "example", "t": "Clock", "p": [], "q": "Minute hand from 12 to 3.", "steps": [["one right angle", ""]], "a": "quarter turn"}, {"k": "example", "t": "Clock", "p": [], "q": "Minute hand from 12 to 6.", "steps": [["two right angles", ""]], "a": "half turn"}, {"k": "example", "t": "Angle", "p": [], "q": "The corner of a book.", "steps": [["fits the checker", ""]], "a": "a right angle"}, {"k": "example", "t": "Angle", "p": [], "q": "A slice of pizza tip.", "steps": [["narrower than the checker", ""]], "a": "smaller than a right angle"}, {"k": "try", "t": "Clock", "p": [], "qq": {"id": "m3u14s1t03", "type": "mcq", "prompt": "Minute hand from 12 to 9 (clockwise):", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "quarter turn", "ok": false, "fb": ""}, {"t": "half turn", "ok": false, "fb": ""}, {"t": "three-quarter turn", "ok": true, "fb": ""}, {"t": "whole turn", "ok": false, "fb": ""}], "fixed": true}}, {"k": "error", "t": "Counting a half turn as a quarter", "p": ["Find the first wrong line."], "q": "Face front, turn to face back.", "lines": ["quarter turn"], "bad": 0, "why": "That is 2 right angles – a half turn.", "fix": [["half turn", ""]], "id": "m3u14s1t04"}, {"k": "mistake", "t": "Mixing up quarter and half turns", "p": ["Count the right angles."]}, {"k": "tip", "t": "Real life", "p": ["Turning a key, a steering wheel or a door handle; dance moves."]}, {"k": "summary", "t": "What to remember", "p": ["Quarter turn = right angle.", "Half = 2, three-quarter = 3, whole = 4 right angles.", "Compare angles with a right angle."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "14.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u14s1k01", "type": "mcq", "prompt": "Before you read on: board to right wall is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "quarter turn", "ok": true, "fb": ""}, {"t": "half turn", "ok": false, "fb": ""}, {"t": "three-quarter turn", "ok": false, "fb": ""}, {"t": "whole turn", "ok": false, "fb": ""}], "fixed": true}}, {"id": "14.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u14s1k02", "type": "num", "prompt": "Right angles in a whole turn?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.1-k3", "t": 3, "after": 9, "review": [0, 0], "no