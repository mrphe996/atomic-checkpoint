{"course": {"id": "s18", "title": "Camday – Cambridge Lower Secondary Mathematics — Stage 8", "units": [{"n": 1, "t": "Integers"}, {"n": 2, "t": "Expressions, Formulae and Equations"}, {"n": 3, "t": "Place Value and Rounding"}, {"n": 4, "t": "Decimals"}, {"n": 5, "t": "Angles and Constructions"}, {"n": 6, "t": "Collecting Data"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Shapes and Symmetry"}, {"n": 9, "t": "Sequences and Functions"}, {"n": 10, "t": "Percentages"}, {"n": 11, "t": "Graphs"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Probability"}, {"n": 14, "t": "Position and Transformation"}, {"n": 15, "t": "Distance, Area and Volume"}, {"n": 16, "t": "Interpreting and Discussing Results"}]}, "unit": {"n": 3, "stage": 18, "title": "Place Value and Rounding", "strandShort": "Number", "blurb": "Multiplying and dividing by 0.1 and 0.01, and rounding to decimal places and significant figures.", "strand": "Number", "framework": "Cambridge Lower Secondary Mathematics (0862), Stage 8", "lesson": true, "subject": "maths", "read": "media/read/m8u03.pdf"}, "objectives": {"O1": {"code": "8Np.01", "sec": "3.1", "codeNote": "", "t": "Multiply and divide integers and decimals by 0.1 and 0.01, and explain the effect."}, "O2": {"code": "8Np.02", "sec": "3.2", "codeNote": "", "t": "Round numbers to a given number of decimal places or significant figures."}}, "sections": [{"id": "3.1", "title": "Multiplying and dividing by 0.1 and 0.01", "objs": ["O1"], "lesson": [{"k": "hook", "t": "A shrinking discount", "p": ["A shop takes **0.1 of the price** off in a sale. A jacket costs **$85**. A phone app calculates 85 × 0.1.", "Will the answer be bigger or smaller than 85? What is 85 × 0.1? Try it before you read on."]}, {"k": "recall", "t": "× and ÷ by 10 and 100", "p": ["× 10 moves digits one place left; ÷ 100 moves digits two places right."], "qq": {"id": "m8u03s1t01", "type": "num", "prompt": "Work out 3.6 ÷ 100.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.036, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.036."}}, {"k": "idea", "t": "Multiplying by 0.1 and 0.01", "p": ["0.1 = 1/10, so multiplying by 0.1 means finding one tenth: **× 0.1 is the same as ÷ 10**.", "0.01 = 1/100, so **× 0.01 is the same as ÷ 100**."], "table": {"head": ["Calculation", "Equivalent", "Answer"], "rows": [["85 × 0.1", "85 ÷ 10", "8.5"], ["85 × 0.01", "85 ÷ 100", "0.85"], ["4.2 × 0.1", "4.2 ÷ 10", "0.42"]]}, "p2": ["Multiplying by a number less than 1 makes the answer **smaller**. The discount is **$8.50**."]}, {"k": "idea", "t": "Dividing by 0.1 and 0.01", "p": ["How many tenths are in 3? There are 30. So **÷ 0.1 is the same as × 10**.", "How many hundredths are in 3? 300. So **÷ 0.01 is the same as × 100**.", "Dividing by a number between 0 and 1 makes the answer **bigger**: 0.7 ÷ 0.01 = 70."]}, {"k": "try", "t": "Multiply by 0.01", "p": [], "qq": {"id": "m8u03s1t02", "type": "num", "prompt": "Work out 260 × 0.01.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2.6, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 26000, "fb": "× 0.01 makes it smaller: ÷ 100."}], "bare": true, "hint": "Same as ÷ 100.", "reason": "2.6."}}, {"k": "method", "t": "How do I × or ÷ by 0.1 and 0.01?", "p": ["Step 1: × 0.1 → ÷ 10; × 0.01 → ÷ 100.", "Step 2: ÷ 0.1 → × 10; ÷ 0.01 → × 100.", "Step 3: Move the digits the right way.", "Step 4: Check: × by a number less than 1 → smaller; ÷ by it → bigger."]}, {"k": "example", "t": "Dividing", "p": [], "q": "Work out 0.45 ÷ 0.1.", "steps": [["÷ 0.1 is × 10", ""], ["0.45 × 10 = 4.5", ""]], "a": "4.5", "check": "4.5 × 0.1 = 0.45. ✓"}, {"k": "example", "t": "Two steps", "p": [], "q": "Work out 7.2 × 0.01 ÷ 0.1.", "steps": [["7.2 × 0.01 = 0.072", "÷ 100"], ["0.072 ÷ 0.1 = 0.72", "× 10"]], "a": "0.72", "check": "Overall ÷ 10: 7.2 ÷ 10 = 0.72. ✓"}, {"k": "example", "t": "Missing number", "p": [], "q": "Find ☐: 53 × ☐ = 0.53.", "steps": [["53 → 0.53: digits moved 2 places right", ""], ["that is ÷ 100 = × 0.01", ""]], "a": "0.01"}, {"k": "example", "t": "Real life", "p": [], "q": "1 cent = $0.01. How many dollars is 4750 cents?", "steps": [["4750 × 0.01", ""], ["= 47.5", ""]], "a": "$47.50"}, {"k": "try", "t": "Divide by 0.01", "p": [], "qq": {"id": "m8u03s1t03", "type": "num", "prompt": "Work out 0.09 ÷ 0.01.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 0.0009, "fb": "÷ 0.01 makes it bigger."}], "bare": true, "hint": "How many hundredths in 0.09?", "reason": "9."}}, {"k": "error", "t": "The wrong direction", "p": ["Find the first wrong line."], "q": "Work out 6 ÷ 0.1.", "lines": ["÷ 0.1 is the same as ÷ 10", "6 ÷ 0.1 = 0.6"], "bad": 0, "why": "There are 10 tenths in every whole, so there are 60 tenths in 6. ÷ 0.1 = × 10.", "fix": [["÷ 0.1 is the same as × 10", ""], ["6 ÷ 0.1 = 60", ""]], "id": "m8u03s1t04"}, {"k": "mistake", "t": "Multiplying always makes bigger", "p": ["× 0.1 and × 0.01 make numbers smaller; ÷ 0.1 and ÷ 0.01 make them bigger."]}, {"k": "tip", "t": "Think 'how many'", "p": ["÷ 0.1 asks 'how many tenths?' – always more than the number of wholes."]}, {"k": "summary", "t": "What to remember", "p": ["× 0.1 = ÷ 10; × 0.01 = ÷ 100.", "÷ 0.1 = × 10; ÷ 0.01 = × 100.", "Multiplying by a number less than 1 makes it smaller.", "Dividing by a number less than 1 makes it bigger."]}], "video": {"src": null, "offset": 0, "dur": 780, "range": ""}, "stops": [{"id": "3.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m8u03s1k01", "type": "num", "prompt": "Before you read on: 85 × 0.1 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 850, "fb": "× 0.1 makes it smaller."}], "bare": true, "hint": "One tenth of 85.", "reason": "8.5."}}, {"id": "3.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m8u03s1k02", "type": "num", "prompt": "Work out 