Answer"], "rows": [["1 d.p.", {"blank": true}], ["2 d.p.", {"blank": true}], ["1 s.f.", {"blank": true}]]}, {"id": "m8u03v3Aq14", "type": "grid", "prompt": "Which operation has the same effect?", "diff": "M", "obj": "O1", "skill": "Data", "pts": 1, "sec": "B · Methods", "cols": ["× 100", "× 10", "÷ 100", "÷ 10", "× 1000", "÷ 1000"], "mode": "classify", "rows": [{"l": "÷ 0.01"}, {"l": "÷ 0.1"}, {"l": "× 0.01"}, {"l": "× 0.1"}]}, {"id": "m8u03v3Aq15", "type": "mcq", "prompt": "Round each number to 1 significant figure. Which calculation estimates (3.4 + 5.8)² ÷ (7.7 − 2.3)?", "diff": "H", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "C · Problem solving", "options": [{"t": "(3 + 6)² ÷ (8 − 2)"}, {"t": "(3 + 6) × 2 ÷ (8 − 2)"}, {"t": "(3 + 5)² ÷ (7 − 2)"}, {"t": "(30 + 60)² ÷ (8 − 2)"}]}, {"id": "m8u03v3Aq16", "type": "num", "prompt": "Ms Hana has 2.5 kg of tea. It is packed into bags that each hold 0.01 kg. How many bags can be filled?", "diff": "H", "obj": "O1", "skill": "Application", "pts": 2, "sec": "C · Problem solving", "unit": "×", "units": ["×"], "bare": true}, {"id": "m8u03v3Aq17", "type": "num", "prompt": "Work out the exact value of (9.4 + 2.6)² ÷ (7.5 − 3.5).", "diff": "H", "obj": "O2", "skill": "Application", "pts": 1, "sec": "C · Problem solving", "unit": "×", "units": ["×"], "bare": true}, {"id": "m8u03v3Aq18", "type": "grid", "prompt": "Arun thinks of a whole number greater than 0. Is each statement about the number true or false?", "diff": "H", "obj": "O1", "skill": "Data", "pts": 1, "sec": "C · Problem solving", "cols": ["True", "False"], "mode": "classify", "rows": [{"l": "Multiplying it by 0.01 will make it smaller."}, {"l": "Multiplying it by 10² makes it 20 times bigger."}, {"l": "Dividing it by 0.1 is the same as ÷ 10."}, {"l": "Multiplying it by 0.01 is the same as ÷ 100."}]}, {"id": "m8u03v3Aq19", "type": "num", "prompt": "Round 0.08346 to 2 significant figures.", "diff": "H", "obj": "O2", "skill": "Application", "pts": 1, "sec": "C · P