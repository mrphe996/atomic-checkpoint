{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 6, "stage": 13, "title": "Fractions of Shapes", "strandShort": "Number", "blurb": "Halves, quarters, thirds, fifths and tenths of shapes, unit and non-unit fractions, and simple equivalent fractions.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u06.pdf"}, "objectives": {"O1": {"code": "3Nf.01", "sec": "6.1", "codeNote": "", "t": "Understand that a fraction is equal parts of a whole and name unit and non-unit fractions of shapes."}, "O2": {"code": "3Nf.02", "sec": "6.2", "codeNote": "", "t": "Recognise that two fractions can be equivalent, such as 1/2 = 2/4."}}, "sections": [{"id": "6.1", "title": "Fractions of shapes", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Sharing a sandwich", "p": ["Two children share a sandwich. One cuts it into a big piece and a small piece.", "Is each piece a half? What makes a fair half? Think before you read on."]}, {"k": "recall", "t": "Halves", "p": ["A half is one of two equal parts."], "qq": {"id": "m3u06s1t01", "type": "num", "prompt": "How many halves make a whole?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2."}}, {"k": "idea", "t": "Equal parts", "p": ["A **fraction** is part of a whole that has been split into **equal** parts."], "fig": {"kind": "cells", "cells": [[0, 0, "#9EC1F2", ""], [1, 0, "#9EC1F2", ""], [2, 0, "#9EC1F2", ""], [3, 0, "#FFFFFF", ""]], "cols": 4, "rows": 1}, "p2": ["This bar has 4 equal parts; 3 are shaded: **3/4** (three quarters)."]}, {"k": "idea", "t": "Unit and non-unit fractions", "p": ["A **unit fraction** has 1 on top: 1/2, 1/3, 1/4, 1/5. A **non-unit fraction** has more than 1 on top: 2/3, 3/4, 4/5."], "table": {"head": ["Equal parts", "One part", "Name"], "rows": [["2", "1/2", "half"], ["3", "1/3", "third"], ["4", "1/4", "quarter"], ["5", "1/5", "fifth"], ["10", "1/10", "tenth"]]}}, {"k": "try", "t": "Name", "p": [], "qq": {"id": "m3u06s1t02", "type": "num", "prompt": "5 equal parts, 2 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.4, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "2/5."}}, {"k": "method", "t": "How do I name a fraction of a shape?", "p": ["Step 1: Check the parts are equal.", "Step 2: Count all the parts → bottom number.", "Step 3: Count the shaded parts → top number.", "Step 4: Read it: e.g. two fifths."]}, {"k": "example", "t": "Thirds", "p": [], "q": "A circle in 3 equal parts, 1 shaded.", "steps": [["1 of 3", ""]], "a": "1/3"}, {"k": "example", "t": "Tenths", "p": [], "q": "10 equal parts, 7 shaded.", "steps": [["7 of 10", ""]], "a": "7/10"}, {"k": "example", "t": "Not shaded", "p": [], "q": "4 equal parts, 1 shaded. Not shaded?", "steps": [["4 − 1 = 3", ""]], "a": "3/4"}, {"k": "example", "t": "Not equal", "p": [], "q": "A shape cut into 3 different-sized pieces, 1 shaded.", "steps": [["pieces not equal", ""]], "a": "not 1/3"}, {"k": "try", "t": "Not shaded", "p": [], "qq": {"id": "m3u06s1t03", "type": "num", "prompt": "5 equal parts, 1 shaded. Fraction NOT shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.8, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "4/5."}}, {"k": "error", "t": "Unequal parts", "p": ["Find the first wrong line."], "q": "A sandwich in a big and a small piece.", "lines": ["2 pieces, so each is a half."], "bad": 0, "why": "Halves must be equal. These are not halves.", "fix": [["not halves", ""]], "id": "m3u06s1t04"}, {"k": "mistake", "t": "Forgetting the parts must be equal", "p": ["Fractions need equal parts."]}, {"k": "tip", "t": "Real life", "p": ["Pizza slices, chocolate bars and cake are shared in fractions."]}, {"k": "summary", "t": "What to remember", "p": ["Fractions = equal parts.", "Bottom: number of parts; top: parts we have.", "Unit fractions have 1 on top."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "6.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u06s1k01", "type": "mcq", "prompt": "Before you read on: are big and small pieces halves?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "no", "ok": true, "fb": ""}, {"t": "yes", "ok": false, "fb": ""}]}}, {"id": "6.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u06s1k02", "type": "num", "prompt": "Fraction of the bar shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.75, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "6.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u06s1k03", "type": "num", "prompt": "10 equal parts, 7 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.7, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}, {