{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 4, "stage": 14, "title": "Probability", "strandShort": "Statistics and probability", "blurb": "Describing how likely events are with words like impossible, unlikely, even chance, likely and certain, and carrying out chance experiments.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u04.pdf"}, "objectives": {"O1": {"code": "4Sp.01", "sec": "4.1", "codeNote": "", "t": "Use the language of chance to describe events: impossible, unlikely, even chance, likely, certain."}, "O2": {"code": "4Sp.02", "sec": "4.2", "codeNote": "", "t": "Carry out chance experiments, record results and discuss whether outcomes are equally likely."}}, "sections": [{"id": "4.1", "title": "Likelihood", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Lucky dip", "p": ["A lucky-dip bag has **8 toy cars** and **2 toy boats**. You pull one out without looking.", "Are you more likely to get a car or a boat? Could you get a plane? Think before you read on."]}, {"k": "recall", "t": "More and fewer", "p": ["8 is more than 2."], "qq": {"id": "m4u04s1t01", "type": "num", "prompt": "How many toys in the bag?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "10."}}, {"k": "idea", "t": "Words for chance", "p": ["We use these words to say how likely something is:"], "table": {"head": ["Word", "Meaning", "Lucky dip"], "rows": [["impossible", "can never happen", "a plane"], ["unlikely", "probably won't happen", "a boat (2 of 10)"], ["even chance", "as likely as not", "–"], ["likely", "probably will happen", "a car (8 of 10)"], ["certain", "must happen", "a toy"]]}}, {"k": "idea", "t": "A likelihood scale", "p": ["Put the words on a line from **impossible** to **certain**, with **even chance** in the middle."], "fig": {"kind": "spinner", "labels": ["car", "car", "car", "boat"]}, "p2": ["On this spinner 'car' is likely (3 of 4) and 'boat' is unlikely (1 of 4)."]}, {"k": "try", "t": "Word", "p": [], "qq": {"id": "m4u04s1t02", "type": "mcq", "prompt": "Pulling a car from the lucky dip is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": true, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}}, {"k": "method", "t": "How do I choose the right word?", "p": ["Step 1: Can it happen at all? If not → impossible.", "Step 2: Must it happen? → certain.", "Step 3: Is it about half? → even chance.", "Step 4: More than half → likely; less → unlikely."]}, {"k": "example", "t": "Dice", "p": [], "q": "Rolling a 7 on a 1–6 dice.", "steps": [["no 7 on the dice", ""]], "a": "impossible"}, {"k": "example", "t": "Coin", "p": [], "q": "A coin landing heads.", "steps": [["1 of 2 sides", ""]], "a": "even chance"}, {"k": "example", "t": "Weather", "p": [], "q": "Snow in a hot desert in summer.", "steps": [["possible but very rare", ""]], "a": "unlikely"}, {"k": "example", "t": "Days", "p": [], "q": "Tomorrow will be a day of the week.", "steps": [["always", ""]], "a": "certain"}, {"k": "try", "t": "Spinner", "p": [], "qq": {"id": "m4u04s1t03", "type": "mcq", "prompt": "A spinner with 4 equal parts, all red. Landing on red is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": true, "fb": ""}], "fixed": true}}, {"k": "error", "t": "Mixing up unlikely and impossible", "p": ["Find the first wrong line."], "q": "Pulling a boat from the bag (8 cars, 2 boats).", "lines": ["There are fewer boats, so it is impossible."], "bad": 0, "why": "There ARE boats, so it can happen – it is unlikely, not impossible.", "fix": [["unlikely", ""]], "id": "m4u04s1t04"}, {"k": "mistake", "t": "Saying 'impossible' when something is just unlikely", "p": ["Impossible means it can never happen."]}, {"k": "tip", "t": "Real life", "p": ["Weather forecasts, board games and raffles all use the language of chance."]}, {"k": "summary", "t": "What to remember", "p": ["impossible – unlikely – even chance – likely – certain.", "Count how many ways each outcome can happen.", "Unlikely is not impossible."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "4.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u04s1k01", "type": "mcq", "prompt": "Before you read on: more likely?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a car", "ok": true, "fb": ""}, {"t": "a boat", "ok": false, "fb": ""}]}}, {"id": "4.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u04s1k02", "type": "mcq", "prompt": "Pulling a plane from the bag is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": true, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}}, {"id": "4.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u04s1k03", "type": "mcq", "prompt": "A coin landing heads is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": true, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": false, "fb": ""}], "fixed": true}}, {"id": "4.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u04s1k04", "type": "mcq", "prompt": "Quick check: tomorrow is a day of the week. It is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": true, "fb": ""}], "fixed": true}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u04s1r01", "type": "mcq", "prompt": "Rolling a number less than 7 on a 1–6 dice:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": false, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": false, "fb": ""}, {"t": "certain", "ok": true, "fb": ""}], "fixed": true}, {"id": "m4u04s1r02", "type": "mcq", "prompt": "Rolling a 0 on a 1–6 dice:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "impossible", "ok": true, "fb": ""}, {"t": "unlikely", "ok": false, "fb": ""}, {"t": "even chance", "ok": false, "fb": ""}, {"t": "likely", "ok": fals