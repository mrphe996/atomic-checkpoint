{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 10, "stage": 14, "title": "Collecting and Recording Data", "strandShort": "Statistics and probability", "blurb": "Asking questions that can be answered with data, collecting data with tally charts, and recording it in frequency tables, Venn diagrams and Carroll diagrams.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u10.pdf"}, "objectives": {"O1": {"code": "4Ss.01", "sec": "10.1", "codeNote": "", "t": "Plan how to collect data to answer a question, and record it in a tally chart."}, "O2": {"code": "4Ss.02", "sec": "10.2", "codeNote": "", "t": "Record and sort data in frequency tables, Venn diagrams and Carroll diagrams."}}, "sections": [{"id": "10.1", "title": "Planning and collecting data", "objs": ["O1"], "lesson": [{"k": "hook", "t": "School garden", "p": ["The class wants to plant flowers that most pupils like.", "What question should they ask? Who should they ask? How will they record the answers? Plan it before you read on."]}, {"k": "recall", "t": "Tally marks", "p": ["𝍸 = 5."], "qq": {"id": "m4u10s1t01", "type": "num", "prompt": "𝍸 𝍸 || = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Planning a survey", "p": ["1. Decide the **question**: 'Which of these flowers do you like best: rose, sunflower, tulip or daisy?'", "2. Decide **who** to ask (e.g. all of Stage 4) and **how many**.", "3. Decide **how to record**: a tally chart with each choice in a row."], "p2": ["Giving set choices keeps answers easy to count."]}, {"k": "idea", "t": "Collecting with a tally chart", "p": [], "table": {"head": ["Flower", "Tally", "Frequency"], "rows": [["rose", "𝍸 |||", "8"], ["sunflower", "𝍸 𝍸 ||", "12"], ["tulip", "𝍸", "5"], ["daisy", "||||", "4"]]}, "p2": ["The **frequency** is the total. Sunflower is the most popular. 8 + 12 + 5 + 4 = 29 pupils."]}, {"k": "try", "t": "Total", "p": [], "qq": {"id": "m4u10s1t02", "type": "num", "prompt": "How many chose rose or tulip?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "13."}}, {"k": "method", "t": "How do I plan and collect data?", "p": ["Step 1: Write a clear question with set choices.", "Step 2: Decide who and how many to ask.", "Step 3: Record each answer with a tally (bundle in 5s).", "Step 4: Count the frequencies and check the total."]}, {"k": "example", "t": "Good question?", "p": [], "q": "'Do you like sports?'", "steps": [["only yes/no – which sport is unknown", ""]], "a": "better: 'Which sport do you like best: football, swimming, tennis or other?'"}, {"k": "example", "t": "Tally", "p": [], "q": "Show 17 with tallies.", "steps": [["three bundles of 5 = 15", ""], ["2 more", ""]], "a": "𝍸 𝍸 𝍸 ||"}, {"k": "example", "t": "Least popular", "p": [], "q": "From the flower chart.", "steps": [["smallest frequency 4", ""]], "a": "daisy"}, {"k": "example", "t": "Difference", "p": [], "q": "How many more chose sunflower than tulip?", "steps": [["12 − 5", ""]], "a": "7"}, {"k": "try", "t": "Tally", "p": [], "qq": {"id": "m4u10s1t03", "type": "num", "prompt": "𝍸 𝍸 𝍸 | = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "16."}}, {"k": "error", "t": "Not bundling tallies", "p": ["Find the first wrong line."], "q": "Record 9 votes.", "lines": ["|||||||||"], "bad": 0, "why": "Bundle in fives: 𝍸 |||| – much easier to count.", "fix": [["𝍸 ||||", ""]], "id": "m4u10s1t04"}, {"k": "mistake", "t": "Writing long rows of single tallies", "p": ["Every fifth mark crosses the four before it."]}, {"k": "tip", "t": "Real life", "p": ["Schools, shops and city councils run surveys before making decisions."]}, {"k": "summary", "t": "What to remember", "p": ["Plan: question, who, how to record.", "Tallies in bundles of 5.", "Frequency = total for each choice."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "10.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u10s1k01", "type": "mcq", "prompt": "Before you read on: a good question gives…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "set choices to pick from", "ok": true, "fb": ""}, {"t": "no choices", "ok": false, "fb": ""}]}}, {"id": "10.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u10s1k02", "type": "num", "prompt": "Pupils asked altogether?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 29, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u10s1k03", "type": "mcq", "prompt": "Least popular flower?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "daisy", "ok": true, "fb": ""}, {"t": "tulip", "ok": false, "fb": ""}]}}, {"id": "10.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u10s1k04", "type": "num", "prompt": "Quick check: sunflower − tulip?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u10s1r01", "type": "num", "prompt": "𝍸 ||| = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1r02", "type": "num", "prompt": "𝍸 𝍸 𝍸 𝍸 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1r03", "type": "num", "prompt": "Frequencies 6, 9, 3. Total?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1r04", "type": "mcq", "prompt": "Most popular: red 7, blue 11, green 4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "blue", "ok": true, "fb": ""}, {"t": "red", "ok": false, "fb": ""}]}, {"id": "m4u10s1r05", "type": "mcq", "prompt": "Better survey question:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Which fruit do you like best: apple, banana, mango?", "ok": true, "fb": ""}, {"t": "Do you like fruit?", "ok": false, "fb": ""}]}, {"id": "m4u10s1r06", "type": "num", "prompt": "How many bundles of 5 for 25 tallies?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1r07", "type": "mcq", "prompt": "Frequency means…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "how many times", "ok": true, "fb": ""}, {"t": "the question", "ok": false, "fb": ""}]}, {"id": "m4u10s1r08", "type": "num", "prompt": "Red 7, blue 11. Difference?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m4u10s1p01", "type": "num", "prompt": "30 pupils: apple 12, banana 9, rest mango. Mango?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1p02", "type": "mcq", "prompt": "To find the favourite lunch of Stage 4, ask…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Stage 4 pupils", "ok": true, "fb": ""}, {"t": "only teachers", "ok": false, "fb": ""}]}, {"id": "m4u10s1p03", "type": "num", "prompt": "Tallies for 23: how many complete bundles?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1p04", "type": "explain", "prompt": "Why should a survey ask more than 3 people?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "fair / reliable", "kw": ["fair|reliable|more people|true|accurate|everyone|representative"]}], "need": 1, "model": "A few people may not show what most people think – more answers give a fairer result.", "hint": "", "reason": "A few people may not show what most people think – more answers give a fairer result."}, {"id": "m4u10s1p05", "type": "mcq", "prompt": "Which data is best collected by measuring?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "heights of pupils", "ok": true, "fb": ""}, {"t": "favourite colours", "ok": false, "fb": ""}]}, {"id": "m4u10s1p06", "type": "num", "prompt": "Cars past school in 10 minutes: 𝍸 𝍸 𝍸 𝍸 |||. How many?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 23, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1p07", "type": "mcq", "prompt": "Adding an 'other' choice helps when…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "someone's answer isn't listed", "ok": true, "fb": ""}, {"t": "everyone agrees", "ok": false, "fb": ""}]}, {"id": "m4u10s1p08", "type": "num", "prompt": "Total 40; three choices are 15, 12, 8. Fourth?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m4u10s1a01", "type": "explain", "prompt": "* Advanced. Plan a survey to find the most popular after-school club. Write the question and how you will record.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "question with choices", "kw": ["which|what"]}, {"pt": "tally / table", "kw": ["tally|table|chart"]}], "need": 2, "model": "e.g. 'Which club would you most like: art, chess, football, music or other?' Record with a tally chart.", "hint": "", "reason": "e.g. 'Which club would you most like: art, chess, football, music or other?' Record with a tally chart."}, {"id": "m4u10s1a02", "type": "mcq", "prompt": "* Advanced. Asking only the football team 'What is your favourite sport?' is…", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "unfair – they will choose football", "ok": true, "fb": ""}, {"t": "fair", "ok": false, "fb": ""}]}, {"id": "m4u10s1a03", "type": "num", "prompt": "* Advanced. In a survey ⅓ of 36 pupils chose music. How many?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m4u10s1m01", "type": "num", "prompt": "𝍸 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1m02", "type": "num", "prompt": "𝍸 || = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1m03", "type": "num", "prompt": "Frequencies 2, 3, 4. Total?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u10s1m04", "type": "mcq", "prompt": "Tallies are bundled in…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "5s", "ok": true, "fb": ""}, {"t": "10s", "ok": false, "fb": ""}]}, {"id": "m4u10s1m05", "type": "mcq", "prompt": "Most: cat 5, dog 8?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "dog", "ok": true, "fb": ""}, {"t": "cat", "ok": false, "fb": ""}]}, {"id": "m4u10s1m06", "type": "num", "prompt": "𝍸 𝍸 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u10", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 10.1 notes · Planning and collecting data", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "10.2", "title": "Recording and sorting data", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Sorting numbers", "p": ["Mr Lee writes **3, 4, 6, 9, 10, 12, 15, 20** on the board and asks: 'Which are even? Which are multiples of 3?'", "Some numbers are both! How can we show that clearly? Think before you read on."]}, {"k": "recall", "t": "Multiples", "p": ["Multiples of 3: 3, 6, 9, 12, 15, …"], "qq": {"id": "m4u10s2t01", "type": "mcq", "prompt": "Is 12 even?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "yes", "ok": true, "fb": ""}, {"t": "no", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Venn diagrams", "p": ["A **Venn diagram** sorts items into circles. Items in **both** groups go in the **overlap**; items in neither go **outside**."], "fig": {"kind": "venn", "sets": ["even", "multiple of 3"], "a": ["4", "10", "20"], "ab": ["6", "12"], "b": ["3", "9", "15"], "out": []}, "p2": ["6 and 12 are even AND multiples of 3, so they sit in the overlap."]}, {"k": "idea", "t": "Carroll diagrams", "p": ["A **Carroll diagram** sorts with a grid: each criterion and its opposite ('not')."], "table": {"head": ["", "even", "not even"], "rows": [["multiple of 3", "6, 12", "3, 9, 15"], ["not multiple of 3", "4, 10, 20", "–"]]}, "p2": ["Every number goes in exactly one box."]}, {"k": "try", "t": "Sort", "p": [], "qq": {"id": "m4u10s2t02", "type": "mcq", "prompt": "Where does 18 go in the Venn diagram?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the overlap", "ok": true, "fb": ""}, {"t": "even only", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I sort data in a Venn or Carroll diagram?", "p": ["Step 1: Read the two rules (criteria).", "Step 2: Test each item against both rules.", "Step 3: Both → overlap (Venn) or the matching box (Carroll).", "Step 4: Neither → outside (Venn) or the 'not, not' box."]}, {"k": "example", "t": "Venn", "p": [], "q": "Where does 7 go (even / multiple of 3)?", "steps": [["not even, not a multiple of 3", ""]], "a": "outside both circles"}, {"k": "example", "t": "Carroll", "p": [], "q": "Where does 30 go?", "steps": [["even ✓, multiple of 3 ✓", ""]], "a": "even / multiple of 3 box"}, {"k": "example", "t": "Read", "p": [], "q": "How many numbers are even?", "steps": [["4, 10, 20 + overlap 6, 12", ""]], "a": "5"}, {"k": "example", "t": "Frequency table", "p": [], "q": "Count: rain on 9 days, sun on 14, cloud on 7.", "steps": [["total 30", ""]], "a": "30 days recorded"},