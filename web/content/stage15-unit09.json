{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 9, "stage": 15, "title": "Addition and Subtraction (2)", "strandShort": "Number", "blurb": "Adding and subtracting fractions with the same denominator and with denominators that are multiples of each other.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u09.pdf"}, "objectives": {"O1": {"code": "5Nf.04", "sec": "9.1", "codeNote": "", "t": "Add fractions with the same denominator, or where one denominator is a multiple of the other."}, "O2": {"code": "5Nf.05", "sec": "9.2", "codeNote": "", "t": "Subtract fractions with the same denominator, or where one denominator is a multiple of the other."}}, "sections": [{"id": "9.1", "title": "Adding fractions", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Ribbon", "p": ["Mia uses **⅜ m** of ribbon for one bow and **¼ m** for another.", "How much ribbon does she use altogether? Can you just add the tops and bottoms? Try it before you read on."]}, {"k": "recall", "t": "Equivalent fractions", "p": ["¼ = 2/8."], "qq": {"id": "m5u09s1t01", "type": "num", "prompt": "½ = ?/6", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "3."}}, {"k": "idea", "t": "Same denominator", "p": ["When the denominators are the same, **add the numerators** and keep the denominator: 2/7 + 3/7 = 5/7 (2 sevenths + 3 sevenths = 5 sevenths).", "Never add the denominators: sevenths stay sevenths."]}, {"k": "idea", "t": "One denominator is a multiple of the other", "p": ["Change one fraction so both have the **same denominator**: ⅜ + ¼ → ¼ = 2/8 → ⅜ + 2/8 = **⅝ m**."], "table": {"head": ["Sum", "Change", "Add", "Answer"], "rows": [["⅜ + ¼", "¼ = 2/8", "3/8 + 2/8", "5/8"], ["½ + 3/10", "½ = 5/10", "5/10 + 3/10", "8/10 = 4/5"], ["⅔ + ⅚", "⅔ = 4/6", "4/6 + 5/6", "9/6 = 1½"]]}}, {"k": "try", "t": "Same denominator", "p": [], "qq": {"id": "m5u09s1t02", "type": "num", "prompt": "3/9 + 4/9? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.7777777777777778, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "7/9."}}, {"k": "method", "t": "How do I add fractions?", "p": ["Step 1: Same denominator? If not, change one fraction to match.", "Step 2: Add the numerators; keep the denominator.", "Step 3: Simplify if you can.", "Step 4: Change an improper answer to a mixed number."]}, {"k": "example", "t": "Same denominator", "p": [], "q": "1/5 + 2/5.", "steps": [["1 + 2 = 3 fifths", ""]], "a": "3/5"}, {"k": "example", "t": "Multiple", "p": [], "q": "1/3 + 1/6.", "steps": [["1/3 = 2/6", ""], ["2/6 + 1/6 = 3/6", ""], ["= 1/2", ""]], "a": "1/2"}, {"k": "example", "t": "More than one", "p": [], "q": "3/4 + 5/8.", "steps": [["3/4 = 6/8", ""], ["6/8 + 5/8 = 11/8", ""]], "a": "1⅜"}, {"k": "example", "t": "Real life", "p": [], "q": "A jug has ½ litre of juice; add 3/10 litre.", "steps": [["5/10 + 3/10 = 8/10", ""]], "a": "4/5 litre"}, {"k": "try", "t": "Multiple", "p": [], "qq": {"id": "m5u09s1t03", "type": "num", "prompt": "1/2 + 1/4? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.75, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/4."}}, {"k": "error", "t": "Adding the denominators", "p": ["Find the first wrong line."], "q": "2/5 + 1/5", "lines": ["= 3/10"], "bad": 0, "why": "Add only the numerators: 3/5.", "fix": [["3/5", ""]], "id": "m5u09s1t04"}, {"k": "mistake", "t": "Adding tops and bottoms", "p": ["Fifths + fifths = fifths. Keep the denominator."]}, {"k": "tip", "t": "Real life", "p": ["Recipes and DIY often add fractions: ½ cup + ¼ cup of flour."]}, {"k": "summary", "t": "What to remember", "p": ["Same denominator: add numerators only.", "Otherwise make the denominators the same first.", "Simplify; change improper fractions to mixed numbers."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "9.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u09s1k01", "type": "mcq", "prompt": "Before you read on: ⅜ + ¼ = 4/12?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "No", "ok": true, "fb": ""}, {"t": "Yes", "ok": false, "fb": ""}]}}, {"id": "9.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u09s1k02", "type": "num", "prompt": "2/7 + 3/7? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.7142857142857143, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "9.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u09s1k03", "type": "num", "prompt": "1/3 + 1/6? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "9.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "