{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 6, "stage": 15, "title": "3D Shapes", "strandShort": "Geometry and measure", "blurb": "Nets of cubes and other solids, counting faces, edges and vertices, and drawing and recognising 3D shapes from different views.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u06.pdf"}, "objectives": {"O1": {"code": "5Gg.03", "sec": "6.1", "codeNote": "", "t": "Identify and sketch different nets for a cube and other simple 3D shapes."}, "O2": {"code": "5Gg.04", "sec": "6.2", "codeNote": "", "t": "Describe 3D shapes by their faces, edges and vertices, and recognise them from drawings and views."}}, "sections": [{"id": "6.1", "title": "Nets of cubes", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Dice factory", "p": ["A toy factory makes paper dice. Each dice is cut from a flat piece of card made of **6 squares** and folded up.", "Will any arrangement of 6 squares fold into a cube? Think about it before you read on."]}, {"k": "recall", "t": "Cubes", "p": ["A cube has 6 square faces."], "qq": {"id": "m5u06s1t01", "type": "num", "prompt": "How many edges does a cube have?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Nets of a cube", "p": ["A **net** of a cube is a flat shape of **6 squares** that folds into a cube with no gaps or overlaps."], "fig": {"kind": "cells", "cells": [[1, 0], [0, 1], [1, 1], [2, 1], [3, 1], [1, 2]], "cols": 4, "rows": 3, "grid": true}, "p2": ["The cross shape works. There are **11** different nets of a cube."]}, {"k": "idea", "t": "Testing a net", "p": ["Imagine folding: pick a base square, fold up the 4 sides, then check one square is left for the lid.", "Arrangements that **don't** work: a row of more than 4 squares, or a 2 × 3 rectangle (faces overlap).", "On a dice, opposite faces add to 7 – in a net, opposite faces are never next to each other."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m5u06s1t02", "type": "num", "prompt": "How many squares in every net of a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "method", "t": "How do I check a net of a cube?", "p": ["Step 1: Count: exactly 6 squares.", "Step 2: Choose a base and fold the others up in your head.", "Step 3: Check no two squares land on the same face.", "Step 4: Check there is a lid."]}, {"k": "example", "t": "T shape", "p": [], "q": "Four squares in a row with one square above and one below the second square.", "steps": [["row of 4 folds round; the two extra squares make top and bottom", ""]], "a": "a net"}, {"k": "example", "t": "2 × 3 rectangle", "p": [], "q": "Six squares in 2 rows of 3.", "steps": [["folding makes faces overlap", ""]], "a": "not a net"}, {"k": "example", "t": "Five in a row", "p": [], "q": "Five squares in a row plus one more.", "steps": [["5 in a row overlaps itself", ""]], "a": "not a net"}, {"k": "example", "t": "Dice", "p": [], "q": "In a dice net, 1 is opposite 6. Where can 6 go?", "steps": [["on the square opposite 1 (not touching it)", ""]], "a": "the square opposite 1"}, {"k": "try", "t": "Net?", "p": [], "qq": {"id": "m5u06s1t03", "type": "mcq", "prompt": "Six squares in a straight row:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "not a net", "ok": true, "fb": ""}, {"t": "a net", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Counted only squares", "p": ["Find the first wrong line."], "q": "A shape of 6 squares in a 2 × 3 block.", "lines": ["it has 6 squares, so it is a net of a cube"], "bad": 0, "why": "Six squares is not enough – they must fold without overlapping. A 2 × 3 block overlaps.", "fix": [["not a net", ""]], "id": "m5u06s1t04"}, {"k": "mistake", "t": "Thinking any 6 squares make a cube", "p": ["Test by folding."]}, {"k": "tip", "t": "Real life", "p": ["Boxes, dice and packaging start as nets cut from flat card."]}, {"k": "summary", "t": "What to remember", "p": ["A cube net has 6 squares.", "There are 11 different cube nets.", "Test by imagining the fold.", "Opposite faces are never touching in the net."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "6.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u06s1k01", "type": "mcq", "prompt": "Before you read on: will any 6 squares work?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "No", "ok": true, "fb": ""}, {"t": "Yes", "ok": false, "fb": ""}]}}, {"id": "6.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u06s1k02", "type": "num", "prompt": "How many different cube nets?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "6.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u06s1k03", "type": "mcq", "prompt": "A 2 × 3 block of squares is …", "diff"