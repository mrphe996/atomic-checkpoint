": "num", "prompt": "Squares in a cube net?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u06s1m02", "type": "num", "prompt": "Opposite 1 on a dice?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u06s1m03", "type": "mcq", "prompt": "Cross shape:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a net", "ok": true, "fb": ""}, {"t": "not a net", "ok": false, "fb": ""}]}, {"id": "m5u06s1m04", "type": "mcq", "prompt": "6 in a row:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "not a net", "ok": true, "fb": ""}, {"t": "a net", "ok": false, "fb": ""}]}, {"id": "m5u06s1m05", "type": "num", "prompt": "Edges of a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u06s1m06", "type": "num", "prompt": "Faces of a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u06", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 6.1 notes · Nets of cubes", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "6.2", "title": "Describing and drawing 3D shapes", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Mystery shape", "p": ["A friend describes a hidden shape: 'It has **5 faces**: **2 triangles** and **3 rectangles**. It has **9 edges** and **6 vertices**.'", "What is it? Think about it before you read on."]}, {"k": "recall", "t": "3D shape names", "p": ["cube, cuboid, sphere, cylinder, cone, pyramid, prism."], "qq": {"id": "m5u06s2t01", "type": "mcq", "prompt": "A tin of soup is shaped like a …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cylinder", "ok": true, "fb": ""}, {"t": "cone", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Faces, edges and vertices", "p": [], "table": {"head": ["Shape", "Faces", "Edges", "Vertices"], "rows": [["cube / cuboid", "6", "12", "8"], ["triangular prism", "5", "9", "6"], ["square-based pyramid", "5", "8", "5"], ["triangular pyramid", "4", "6", "4"], ["cylinder", "3 (2 flat, 1 curved)", "2", "0"]]}, "fig": {"kind": "solid", "solid": "triprism", "a": "", "b": "", "c": ""}, "p2": ["The mystery shape is a **triangular prism**."]}, {"k": "idea", "t": "Drawing 3D shapes", "p": ["Draw on **isometric** (triangle-dot) paper so that vertical edges are vertical and the other edges slope at the same angle.", "A **prism** has the same shape all along it; a **pyramid** narrows to a point (apex)."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m5u06s2t02", "type": "num", "prompt": "Edges of a square-based pyramid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "method", "t": "How do I describe a 3D shape?", "p": ["Step 1: Name the shapes of the faces.", "Step 2: Count faces, edges and vertices.", "Step 3: Say whether it is a prism (same all along) or pyramid (point).", "Step 4: Sketch it, ideally on isometric paper."]}, {"k": "example", "t": "Pyramid", "p": [], "q": "Faces: 1 square + 4 triangles.", "steps": [["square-based pyramid", ""]], "a": "5 faces, 8 edges, 5 vertices"}, {"k": "example", "t": "Cuboid", "p": [], "q": "Faces, edges, vertices of a cuboid.", "steps": [["6, 12, 8", ""]], "a": "6, 12, 8"}, {"k": "example", "t": "Curved", "p": [], "q": "A cone.", "steps": [["1 flat circle + 1 curved face, 1 edge, 1 apex", ""]], "a": "2 faces, 1 edge, 1 vertex (apex)"}, {"k": "exampl