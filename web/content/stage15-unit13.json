{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 13, "stage": 15, "title": "Ratio and Proportion", "strandShort": "Number", "blurb": "Using ratio to compare parts with parts ('for every') and proportion to compare a part with the whole ('in every'), in patterns, recipes and mixtures.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u13.pdf"}, "objectives": {"O1": {"code": "5Nf.07", "sec": "13.1", "codeNote": "", "t": "Understand and use ratio to compare one part with another, using the language 'for every'."}, "O2": {"code": "5Nf.08", "sec": "13.2", "codeNote": "", "t": "Understand and use proportion to compare a part with the whole, using the language 'in every'."}}, "sections": [{"id": "13.1", "title": "Ratio", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Bead bracelet", "p": ["Zara makes a bracelet with a pattern: **2 red beads for every 3 white beads**.", "If she uses 8 red beads, how many white beads does she need? Try it before you read on."]}, {"k": "recall", "t": "Groups", "p": ["4 groups of 3 = 12."], "qq": {"id": "m5u13s1t01", "type": "num", "prompt": "5 groups of 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15."}}, {"k": "idea", "t": "Ratio: 'for every'", "p": ["A **ratio** compares one part with another part. '2 red **for every** 3 white' is written **2 : 3** (red : white)."], "fig": {"kind": "cells", "cells": [[0, 0, "#F4A6A6", "R"], [1, 0, "#F4A6A6", "R"], [2, 0, "#FFFFFF", "W"], [3, 0, "#FFFFFF", "W"], [4, 0, "#FFFFFF", "W"], [5, 0, "#F4A6A6", "R"], [6, 0, "#F4A6A6", "R"], [7, 0, "#FFFFFF", "W"], [8, 0, "#FFFFFF", "W"], [9, 0, "#FFFFFF", "W"]], "cols": 10, "rows": 1}, "p2": ["Order matters: red : white = 2 : 3, but white : red = 3 : 2."]}, {"k": "idea", "t": "Scaling a ratio", "p": ["Repeat the pattern: each group has 2 red and 3 white."], "table": {"head": ["Groups", "Red", "White"], "rows": [["1", "2", "3"], ["2", "4", "6"], ["3", "6", "9"], ["4", "8", "12"]]}, "p2": ["8 red = 4 groups → **12 white**."]}, {"k": "try", "t": "Write it", "p": [], "qq": {"id": "m5u13s1t02", "type": "short", "prompt": "For every 1 cat there are 4 mice. Ratio cats : mice?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["1:4", "1:4", "1 : 4"], "hint": "", "reason": "1 : 4."}}, {"k": "method", "t": "How do I use a ratio?", "p": ["Step 1: Write the ratio in the order given.", "Step 2: Find how many groups (÷ by the part you know).", "Step 3: Multiply the other part by the number of groups.", "Step 4: Check by making a table."]}, {"k": "example", "t": "Write a ratio", "p": [], "q": "A fruit bowl: 5 apples and 2 bananas. Apples : bananas?", "steps": [["apples first", ""]], "a": "5 : 2"}, {"k": "example", "t": "Scale up", "p": [], "q": "Squash: 1 cup of juice for every 6 cups of water. Juice for 18 cups of water?", "steps": [["18 ÷ 6 = 3 groups", ""], ["1 × 3", ""]], "a": "3 cups"}, {"k": "example", "t": "Find the total", "p": [], "q": "Ratio boys : girls = 3 : 4, 12 boys. Children altogether?", "steps": [["12 ÷ 3 = 4 groups", ""], ["girls 4 × 4 = 16", ""], ["12 + 16", ""]], "a": "28"}, {"k": "example", "t": "Order matters", "p": [], "q": "4 green for every 1 yellow. Yellow : green?", "steps": [["swap", ""]], "a": "1 : 4"}, {"k": "try", "t": "Scale", "p": [], "qq": {"id": "m5u13s1t03", "type": "num", "prompt": "2 red : 3 white. 10 red. White?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "5 groups.", "reason": "15."}}, {"k": "error", "t": "Adding instead of multiplying", "p": ["Find the first wrong line."], "q": "2 red : 3 white. 8 red. White?", "lines": ["8 is 6 more than 2, so 3 + 6 = 9 white"], "bad": 0, "why": "8 red is 4 groups of 2, so white = 4 × 3 = 12.", "fix": [["12", ""]], "id": "m5u13s1t04"}, {"k": "mistake", "t": "Adding the same amount to both parts", "p": ["Ratios scale by multiplying."]}, {"k": "tip", "t": "Real life", "p": ["Recipes, paint mixing and building with concrete (1 cement for every 3 sand) all use ratios."]}, {"k": "summary", "t": "What to remember", "p": ["Ratio compares part to part: 'for every'.", "Written a : b – order matters.", "Scale by multiplying both parts by the same number."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "13.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u13s1k01", "type": "num", "prompt": "Before you read on: white beads for 8 red?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u13s1k02", "type": "short", "prompt": "White : red?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["3:2", "3:2", "3 : 2"], "hint": "", "reason": ""}}, {"id": "13.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u13s1k03", "type": "num", "prompt": "Juice for 18 cups of water (1 : 6)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u13s1k04", "type": "num", "prompt": "Quick check: 3 : 4, 12 boys. Girls?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u13s1r01", "type": "short", "prompt": "3 dogs and 7 cats. Dogs : cats?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["3:7", "3:7", "3 : 7"], "hint": "", "reason": ""}, {"id": "m5u13s1r02", "type": "short", "prompt": "3 dogs and 7 cats. Cats : dogs?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["7:3", "7:3", "7 : 3"], "hint": "", "reason": ""}, {"id": "m5u13s1r03", "type": "num", "prompt": "1 teacher for every 8 pupils. Pupils for 3 teachers?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1r04", "type": "num", "prompt": "2 eggs for every 1 cup of flour. Eggs for 5 cups?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1r05", "type": "num", "prompt": "1 : 5. The first part is 4. The second?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1r06", "type": "num", "prompt": "3 : 2. The first part is 9. The second?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1r07", "type": "short", "prompt": "For every 2 squares there are 5 circles. Ratio squares : circles?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["2:5", "2:5", "2 : 5"], "hint": "", "reason": ""}, {"id": "m5u13s1r08", "type": "num", "prompt": "2 : 5. 6 squares. Circles?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m5u13s1p01", "type": "num", "prompt": "Paint: 3 blue for every 1 white. 12 tins blue. White?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1p02", "type": "num", "prompt": "Same paint: total tins?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1p03", "type": "num", "prompt": "5 : 2. Second part is 14. First?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1p04", "type": "explain", "prompt": "A recipe uses 1 lemon for every 4 glasses. Explain how to find the lemons for 20 glasses.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "20 ÷ 4", "kw": ["20 ?÷ ?4|divide|groups"]}, {"pt": "5 lemons", "kw": ["\\b5\\b|five"]}], "need": 2, "model": "20 ÷ 4 = 5 groups, so 5 lemons.", "hint": "", "reason": "20 ÷ 4 = 5 groups, so 5 lemons."}, {"id": "m5u13s1p05", "type": "num", "prompt": "4 : 3 ratio of boys to girls, 21 girls. Boys?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 28, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1p06", "type": "mcq", "prompt": "Which shows the same ratio as 2 : 3?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "6 : 9", "ok": true, "fb": ""}, {"t": "4 : 5", "ok": false, "fb": ""}]}, {"id": "m5u13s1p07", "type": "num", "prompt": "A pattern: 1 star for every 3 hearts. 32 shapes. Stars?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "groups of 4.", "reason": ""}, {"id": "m5u13s1p08", "type": "short", "prompt": "8 apples, 4 pears. Simplest ratio apples : pears?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["2:1", "2:1", "2 : 1"], "hint": "", "reason": ""}], "adv": [{"id": "m5u13s1a01", "type": "num", "prompt": "* Advanced. 2 : 3 red to white, 40 beads in total. Red?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "5 per group, 8 groups.", "reason": ""}, {"id": "m5u13s1a02", "type": "short", "prompt": "* Advanced. A class has 12 boys and 18 girls. Simplest ratio boys : girls?", "diff": "H", "obj": "O1", "skill": "Knowledge", "accept": ["2:3", "2:3", "2 : 3"], "hint": "", "reason": ""}, {"id": "m5u13s1a03", "type": "explain", "prompt": "* Advanced. Is 3 : 4 the same as 4 : 3? Use an example.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|not"]}, {"pt": "example", "kw": ["\\d"]}], "need": 2, "model": "No – 3 boys : 4 girls means more girls; 4 : 3 means more boys.", "hint": "", "reason": "No – 3 boys : 4 girls means more girls; 4 : 3 means more boys."}], "more": [{"id": "m5u13s1m01", "type": "short", "prompt": "2 cars, 5 bikes. Cars : bikes?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["2:5", "2:5", "2 : 5"], "hint": "", "reason": ""}, {"id": "m5u13s1m02", "type": "num", "prompt": "1 : 2. First 3. Second?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1m03", "type": "num", "prompt": "1 : 3. First 5. Second?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1m04", "type": "num", "prompt": "2 : 1. First 10. Second?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u13s1m05", "type": "short", "prompt": "4 red, 1 blue. Blue : red?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["1:4", "1:4", "1 : 4"], "hint": "", "reason": ""}, {"id": "m5u13s1m06", "type": "num", "prompt": "1 : 4. Second 20. First?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u13", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 13.1 notes · Ratio", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "13.2", "title": "Proportion", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Same bracelet", "p": ["Zara's bracelet has **2 red beads for every 3 white beads**.", "What fraction of all the beads are red? Is it 2/3? Think about it before you read on."]}, {"k": "recall", "t": "Ratio", "p": ["2 red for every 3 white is 2 : 3."], "qq": {"id": "m5u13s2t01", "type": "num", "prompt": "How many beads in one group of 2 red and 3 white?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "idea", "t": "Proportion: 'in every', 'out of'", "p": ["A **proportion** compares a part with the **whole**. In every group of 5 beads, 2 are red: **2 out of 5**, or 2/5 of the beads are red."], "fig": {"kind": "cells", "cells": [[0, 0, "#F4A6A6", "R"], [1, 0, "#F4A6A6", "R"], [2, 0, "#FFFFFF", "W"], [3, 0, "#FFFFFF", "W"], [4, 0, "#FFFFFF", "W"]], "cols": 5, "rows": 1}, "p2": ["Ratio red : white = 2 : 3 (part : part). Proportion red = 2/5 (part : whole)."]}, {"k": "idea", "t": "Using proportion", "p": ["If 2 in every 5 beads are red, in 20 beads there are 4 groups → **8 red**."], "table": {"head": ["Whole", "Red (2 in every 5)"], "rows": [["5", "2"], ["10", "4"], ["20", "8"], ["35", "14"]]}}, {"k": "try", "t": "Out of", "p": [], "qq": {"id": "m5u13s2t02", "type": "num", "prompt": "3 in every 4 pupils walk to school. What fraction walk? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.75, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/4."}}, {"k": "method", "t": "How do I use proportion?", "p": ["Step 1: Find the size of one whole group.", "Step 2: Write the part 'out of' the whole as a fraction.", "Step 3: Scale: how many groups in the total?", "Step 4: Multiply the part by the number of groups."]}, {"k": "example", "t": "Fraction", "p": [], "q": "In every 10 cars, 3 are white.", "steps": [["3 out of 10", ""]], "a": "3/10 white"}, {"k": "example", "t": "From a ratio", "p": [], "q": "1 blue for every 4 green. Proportion blue?", "steps": [["group = 5", ""], ["1 out of 5", ""]], "a": "1/5"}, {"k": "example", "t": "Scale", "p": [], "q": "2 in every 7 days are weekend days. Weekend days in 28 days?", "steps": [["28 ÷ 7 = 4 groups", ""], ["2 × 4", ""]], "a": "8"}, {"k": "example", "t": "Percent", "p": [], "q": "1 in every 4 tickets wins.", "steps": [["1/4", ""]], "a": "25%"}, {"k": "try", "t": "Scale", "p": [], "qq": {"id": "m5u13s2t03", "type": "num", "prompt": "1 in every 3 sweets is red. Red in 24 sweets?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "error", "t": "Using the ratio as the fraction", "p": ["Find the first wrong line."], "q": "2 red for every 3 white. Fraction red?", "lines": ["2/3"], "bad": 0, "why": "The whole group is 2 + 3 = 5, so red = 2/5.", "fix": [["2/5", ""]], "id": "m5u13s2t04"}, {"k": "mistake", "t": "Mixing up part : part and part : whole", "p": ["Proportion uses the whole group as the denominator."]}, {"k": "tip", "t": "Real life", "p": ["'4 out of 5 dentists…', '1 in every 3 days is rainy' – adverts and weather reports use proportion."]}, {"k": "summary", "t": "What to remember", "p": ["Proportion: part out of whole ('in every', 'out of').", "Ratio a : b → proportion a/(a + b).", "Scale by the number of groups."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "13.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u13s2k01", "type": "mcq", "prompt": "Before you read on: fraction red?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2/5", "ok": true, "fb": ""}, {"t": "2/3", "ok": false, "fb": ""}]}}, {"id": "13.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u13s2k02", "type": "num", "prompt": "Red beads in 20?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u13s2k03", "type": "num", "prompt": "1 blue for every 4 green. Fraction blue? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.2, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "13.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u13s2k04", "type": "num", "prompt": "Quick check: 2 in every 7 days, 28 days. How many?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u13s2r01", "type": "num", "prompt": "1 in every 2 pupils has a pet. Frac