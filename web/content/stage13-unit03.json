{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 3, "stage": 13, "title": "Multiplication and Division", "strandShort": "Number", "blurb": "Multiplication as equal groups and arrays, division as sharing and grouping, and the 2, 4, 8, 3, 6 and 9 times tables.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u03.pdf"}, "objectives": {"O1": {"code": "3Nc.03", "sec": "3.1", "codeNote": "", "t": "Understand multiplication as equal groups or arrays and division as sharing or grouping."}, "O2": {"code": "3Nc.04", "sec": "3.2", "codeNote": "", "t": "Know the 2, 4 and 8 times tables and how they are connected by doubling."}, "O3": {"code": "3Nc.05", "sec": "3.3", "codeNote": "", "t": "Know the 3, 6 and 9 times tables and how they are connected."}}, "sections": [{"id": "3.1", "title": "Exploring multiplication and division", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Egg boxes", "p": ["An egg box has **2 rows of 6** eggs.", "How many eggs are in one box? If you share 12 eggs between 3 friends, how many each? Try it before you read on."]}, {"k": "recall", "t": "Counting in steps", "p": ["6, 12, 18 (counting in 6s)."], "qq": {"id": "m3u03s1t01", "type": "num", "prompt": "Count in 5s: 5, 10, 15, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "20."}}, {"k": "idea", "t": "Multiplication: equal groups and arrays", "p": ["**Multiplication** is adding equal groups. An **array** shows it in rows and columns."], "fig": {"kind": "cells", "cells": [[0, 0], [0, 1], [1, 0], [1, 1], [2, 0], [2, 1], [3, 0], [3, 1], [4, 0], [4, 1], [5, 0], [5, 1]], "cols": 6, "rows": 2, "grid": true}, "p2": ["2 rows of 6 = 2 × 6 = **12**. It is also 6 × 2 – the order does not change the answer."]}, {"k": "idea", "t": "Division: sharing and grouping", "p": ["**Sharing**: 12 eggs shared between 3 → 12 ÷ 3 = **4 each**.", "**Grouping**: how many groups of 3 in 12? → also **4**.", "Multiplication and division are **inverses**: 3 × 4 = 12, so 12 ÷ 3 = 4 and 12 ÷ 4 = 3."]}, {"k": "try", "t": "Array", "p": [], "qq": {"id": "m3u03s1t02", "type": "num", "prompt": "3 rows of 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15."}}, {"k": "method", "t": "How do I multiply and divide?", "p": ["Step 1: Multiply: count equal groups or rows × columns.", "Step 2: Divide: share equally or make groups.", "Step 3: Use a fact family: 3 × 4 = 12, 4 × 3 = 12, 12 ÷ 3 = 4, 12 ÷ 4 = 3.", "Step 4: Check with the inverse."]}, {"k": "example", "t": "Groups", "p": [], "q": "4 bags with 5 apples each.", "steps": [["4 × 5", ""]], "a": "20 apples"}, {"k": "example", "t": "Sharing", "p": [], "q": "18 sweets shared between 2.", "steps": [["18 ÷ 2", ""]], "a": "9 each"}, {"k": "example", "t": "Grouping", "p": [], "q": "20 children in teams of 5.", "steps": [["20 ÷ 5", ""]], "a": "4 teams"}, {"k": "example", "t": "Fact family", "p": [], "q": "Use 5 × 3 = 15.", "steps": [["3 × 5 = 15", ""], ["15 ÷ 5 = 3, 15 ÷ 3 = 5", ""]], "a": "four facts"}, {"k": "try", "t": "Divide", "p": [], "qq": {"id": "m3u03s1t03", "type": "num", "prompt": "24 shared between 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "error", "t": "Adding instead of multiplying", "p": ["Find the first wrong line."], "q": "3 bags of 4 oranges.", "lines": ["3 + 4 = 7 oranges"], "bad": 0, "why": "3 groups of 4: 3 × 4 = 12.", "fix": [["12", ""]], "id": "m3u03s1t04"}, {"k": "mistake", "t": "Adding the numbers instead of multiplying", "p": ["'Groups of' means multiply."]}, {"k": "tip", "t": "Real life", "p": ["Egg boxes, chocolate bars and seats in rows are arrays."]}, {"k": "summary", "t": "What to remember", "p": ["× = equal groups / arrays.", "÷ = sharing or grouping.", "× and ÷ are inverses."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "3.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u03s1k01", "type": "num", "prompt": "Before you read on: eggs in a box?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u03s1k02", "type": "num", "prompt": "6 × 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u03s1k03", "type": "num", "prompt": "18 ÷ 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u03s1k04", "type": "num", "prompt": "Quick check: 3 bags of 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u03s1r01", "type": "num", "prompt": "2 groups of 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r02", "type": "num", "prompt": "5 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r03", "type": "num", "prompt": "10 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r04", "type": "num", "prompt": "15 ÷ 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r05", "type": "num", "prompt": "20 ÷ 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r06", "type": "num", "prompt": "4 rows of 3 chairs?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r07", "type": "num", "prompt": "16 shared between 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1r08", "type": "num", "prompt": "How many 5s in 25?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m3u03s1p01", "type": "num", "prompt": "30 pencils in packs of 10. Packs?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1p02", "type": "num", "prompt": "6 spiders, 8 legs each. Legs?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 48, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1p03", "type": "mcq", "prompt": "Which is the same as 4 × 6?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "6 × 4", "ok": true, "fb": ""}, {"t": "4 + 6", "ok": false, "fb": ""}]}, {"id": "m3u03s1p04", "type": "explain", "prompt": "Write the fact family for 2 × 9 = 18.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "9 × 2", "kw": ["9 ?[×x] ?2"]}, {"pt": "18 ÷", "kw": ["18 ?÷"]}], "need": 2, "model": "2 × 9 = 18, 9 × 2 = 18, 18 ÷ 2 = 9, 18 ÷ 9 = 2.", "hint": "", "reason": "2 × 9 = 18, 9 × 2 = 18, 18 ÷ 2 = 9, 18 ÷ 9 = 2."}, {"id": "m3u03s1p05", "type": "num", "prompt": "35 ÷ 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1p06", "type": "num", "prompt": "An array has 4 rows and 24 dots. Dots in each row?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1p07", "type": "num", "prompt": "Bikes have 2 wheels. 9 bikes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1p08", "type": "num", "prompt": "? × 3 = 21", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m3u03s1a01", "type": "explain", "prompt": "* Advanced. Find all the arrays you can make with 12 counters.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "pairs", "kw": ["1.{0,5}12|2.{0,5}6|3.{0,5}4"]}], "need": 1, "model": "1 × 12, 2 × 6, 3 × 4 (and the other way round).", "hint": "", "reason": "1 × 12, 2 × 6, 3 × 4 (and the other way round)."}, {"id": "m3u03s1a02", "type": "num", "prompt": "* Advanced. 3 boxes of 6 eggs and 2 boxes of 10. Eggs?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 38, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1a03", "type": "num", "prompt": "* Advanced. 40 sweets shared by 4 children, then each shares theirs with 1 friend equally. Each person gets?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m3u03s1m01", "type": "num", "prompt": "2 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1m02", "type": "num", "prompt": "3 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1m03", "type": "num", "prompt": "10 ÷ 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1m04", "type": "num", "prompt": "12 ÷ 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1m05", "type": "num", "prompt": "5 groups of 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u03s1m06", "type": "num", "prompt": "6 ÷ 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c3u03", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 3.1 notes · Exploring multiplication and division", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "3.2", "title": "Connecting 2×, 4× and 8×", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Wheels", "p": ["A bike has **2** wheels, a car has **4** and a lorry trailer has **8**.", "If you know 3 × 2, can you quickly find 3 × 4 and 3 × 8? Think before you read on."]}, {"k": "recall", "t": "Doubling", "p": ["Double 6 is 12."], "qq": {"id": "m3u03s2t01", "type": "num", "prompt": "Double 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "14."}}, {"k": "idea", "t": "Doubling links the tables", "p": ["The **4 times table** is double the 2 times table. The **8 times table** is double the 4 times table."], "table": {"head": ["×", "2×", "4×", "8×"], "rows": [["1", "2", "4", "8"], ["3", "6", "12", "24"], ["5", "10", "20", "40"], ["7", "14", "28", "56"], ["10", "20", "40", "80"]]}, "p2": ["3 × 2 = 6 → double → 3 × 4 = 12 → double → 3 × 8 = 24."]}, {"k": "idea", "t": "Patterns", "p": ["All multiples of 2, 4 and 8 are **even**. Multiples of 4 are every second multiple of 2."]}, {"k": "try", "t": "Double", "p": [], "qq": {"id": "m3u03s2t02", "type": "num", "prompt": "6 × 4 is double 6 × 2. 6 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "24."}}, {"k": "method", "t": "How do I use doubling?", "p": ["Step 1: Know the 2 times table.", "Step 2: Double it for the 4 times table.", "Step 3: Double again for the 8 times table.", "Step 4: Halve to go back."]}, {"k": "example", "t": "4×", "p": [], "q": "8 × 4.", "steps": [["8 × 2 = 16", ""], ["double", ""]], "a": "32"}, {"k": "example", "t": "8×", "p": [], "q": "6 × 8.", "steps": [["6 × 4 = 24", ""], ["double", ""]], "a": "48"}, {"k": "example", "t": "Divide", "p": [], "q": "40 ÷ 8.", "steps": [["8 × 5 = 40", ""]], "a": "5"}, {"k": "example", "t": "Halve", "p": [], "q": "From 9 × 8 = 72 find 9 × 4.", "steps": [["halve 72", ""]], "a": "36"}, {"k": "try", "t": "8×", "p": [], "qq": {"id": "m3u03s2t03", "type": "num", "prompt": "4 × 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 32, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "32."}}, {"k": "error", "t": "Adding 2 instead of doubling", "p": ["Find the first wrong line."], "q": "7 × 4 from 7 × 2 = 14.", "lines": ["14 + 2 = 16"], "bad": 0, "why": "Double it: 14 + 14 = 28.", "fix": [["28", ""]], "id": "m3u03s2t04"}, {"k": "mistake", "t": "Adding instead of doubling", "p": ["4× is twice 2×."]}, {"k": "tip", "t": "Real life", "p": ["Counting wheels, legs of animals (spiders have 8) and pairs of socks."]}, {"k": "summary", "t": "What to remember", "p": ["4× = double 2×.", "8× = double 4×.", "Halve to go back."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "3.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u03s2k01", "type": "num", "prompt": "Before you read on: 3 × 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u03s2k02", "type": "num", "prompt": "7 × 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 56, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u03s2k03", "type": "num", "prompt": "6 × 8?", "diff": "M", "obj": "O