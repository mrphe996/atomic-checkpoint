: "4.15", "ok": false, "fb": ""}]}], "prac": [{"id": "m5u01s1p01", "type": "num", "prompt": "? × 10 = 56", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5.6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1p02", "type": "num", "prompt": "? ÷ 100 = 0.37", "diff": "M", "obj": "O1", "skill": "Application", "answer": 37, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1p03", "type": "mcq", "prompt": "Order smallest first: 2.4, 2.04, 2.14", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2.04, 2.14, 2.4", "ok": true, "fb": ""}, {"t": "2.4, 2.14, 2.04", "ok": false, "fb": ""}]}, {"id": "m5u01s1p04", "type": "explain", "prompt": "Explain why 3.6 × 10 is 36, not 3.60.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "digits move left", "kw": ["move|left|place"]}, {"pt": "10 times bigger", "kw": ["bigger|10 times|ten times"]}], "need": 2, "model": "Multiplying by 10 makes the number 10 times bigger: each digit moves one place left, so 3 ones become 3 tens.", "hint": "", "reason": "Multiplying by 10 makes the number 10 times bigger: each digit moves one place left, so 3 ones become 3 tens."}, {"id": "m5u01s1p05", "type": "num", "prompt": "How many hundredths in 0.6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1p06", "type": "num", "prompt": "10 bags of sweets weigh 4.5 kg. One bag (kg)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1p07", "type": "mcq", "prompt": "Which equals 7.3?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "6 + 1.3", "ok": true, "fb": ""}, {"t": "7 + 0.03", "ok": false, "fb": ""}]}, {"id": "m5u01s1p08", "type": "num", "prompt": "8 + 0.4 + 0.06?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8.46, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m5u01s1a01", "type": "num", "prompt": "* Advanced. A number × 100 ÷ 10 = 52. The number?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 5.2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1a02", "type": "explain", "prompt": "* Advanced. Make the largest number with 2 decimal places using 1, 5, 8 once each.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "8.51", "kw": ["8\\.51"]}], "need": 1, "model": "8.51 – put the largest digit in the ones place.", "hint": "", "reason": "8.51 – put the largest digit in the ones place."}, {"id": "m5u01s1a03", "type": "num", "prompt": "* Advanced. How many tenths are in 4.2?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 42, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m5u01s1m01", "type": "num", "prompt": "Value of 5 in 0.5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1m02", "type": "num", "prompt": "0.8 × 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1m03", "type": "num", "prompt": "7 ÷ 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1m04", "type": "num", "prompt": "1.23 × 100?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 123, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1m05", "type": "num", "prompt": "2 + 0.5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u01s1m06", "type": "mcq", "prompt": "Bigger?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "0.7", "ok": true, "fb": ""}, {"t": "0.65", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c5u01", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 1.1 notes · Understanding place value", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "1.2", "title": "Rounding decimal numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "How tall?", "p": ["Maya's height is **1.4 m** and her dad's is **1.8 m**. A theme-park ride needs riders to be 'about 1 m or more'.", "What is each height to the nearest whole metre? Try it before you read on."]}, {"k": "recall", "t": "Rounding whole numbers", "p": ["To the nearest 10: 46 → 50 (6 rounds up); 43 → 40."], "qq": {"id": "m5u01s2t01", "type": "num", "prompt": "Round 75 to the nearest 10.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 80, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "5 rounds up.", "reason": "80."}}, {"k": "idea", "t": "Nearest whole number", "p": ["For a number with 1 decimal place, look at the **tenths** digit: **5 or more → round up**; less than 5 → round down."], "fig": {"kind": "numline", "min": 0, "max": 3, "minor": 10, "mark": 1.4}, "p2": ["1.4 is nearer 1 than 2 → **1 m**. 1.8 is nearer 2 → **2 m**."]}, {"k": "idea", "t": "Halfway and estimating", "p": ["Exactly halfway (like 2.5) rounds **up** → 3.", "Rounding helps estimate: 6.8 + 3.1 ≈ 7 + 3 = 10."]}, {"k": "try", "t": "Round", "p": [], "qq": {"id": "m5u01s2t02", "type": "num", "prompt": "Round 4.6 to the nearest whole number.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "method", "t": "How do I round to the nearest whole number?", "p": ["Step 1: Find the two whole numbers either side.", "Step 2: Look at the tenths digit.", "Step 3: 0–4 → round down; 5–9 → round up.", "Step 4: Use rounding to estimate answers."]}, {"k": "example", "t": "Round down", "p": [], "q": "Round 12.3.", "steps": [["tenths 3 → down", ""]], "a": "12"}, {"k": "example", "t": "Halfway", "p": [], "q": "Round 8.5.", "steps": [["tenths 5 → up", ""]], "a": "9"}, {"k": "example", "t": "Estimate", "p": [], "q": "Estimate 5.9 + 2.2.", "steps": [["6 + 2 = 8", ""]], "a": "about 8"}, {"k": "example", "t": "Money", "p": [], "q": "Round $19.70 to the nearest dollar.", "steps": [["tenths 7 → up", ""]], "a": "$20"}, {"k": "try", "t": "Halfway", "p": [], "qq": {"id": "m5u01s2t03", "type": "num", "prompt": "Round 0.5 to the nearest whole number.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "1."}}, {"k": "error", "t": "Rounded the wrong way", "p": ["Find the first wrong line."], "q": "Round 6.2 to the nearest whole number.", "lines": ["6.2 → 7"], "bad": 0, "why": "The tenths digit is 2 (less than 5): round down to 6.", "fix": [["6", ""]], "id": "m5u01s2t04"}, {"k": "mistake", "t": "Always rounding up", "p": ["Only 5 or more rounds up."]}, {"k": "tip", "t": "Real life", "p": ["Temperatures, heights and prices are often rounded to whole numbers."]}, {"k": "summary", "t": "What to remember", "p": ["Look at the tenths digit.", "5 or more → up; less than 5 → down.", "Halfway rounds up.", "Rounding helps estimate."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "1.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u01s2k01", "type": "num", "prompt": "Before you read on: 1.8 m to the ne