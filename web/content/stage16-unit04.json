": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1m05", "type": "num", "prompt": "2400 + 1600?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1m06", "type": "num", "prompt": "−7 + 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u04", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 4.1 notes · Positive and negative integers", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "4.2", "title": "Using letters to represent numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Mystery bag", "p": ["A bag holds an unknown number of marbles. Sam adds **5** marbles and now has **12**.", "How many were in the bag to start with? How could you write this with a letter? Think about it before you read on."]}, {"k": "recall", "t": "Missing numbers", "p": ["? + 5 = 12 → ? = 7."], "qq": {"id": "m6u04s2t01", "type": "num", "prompt": "? × 4 = 28", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7."}}, {"k": "idea", "t": "Letters for unknown numbers", "p": ["A letter can stand for an unknown number: **m + 5 = 12** means 'some number plus 5 is 12'.", "Find the value by doing the **inverse**: m = 12 − 5 = **7**."], "table": {"head": ["Equation", "Inverse", "Value"], "rows": [["m + 5 = 12", "12 − 5", "m = 7"], ["n − 8 = 20", "20 + 8", "n = 28"], ["3 × p = 24", "24 ÷ 3", "p = 8"], ["q ÷ 4 = 6", "6 × 4", "q = 24"]]}}, {"k": "idea", "t": "Two-step and checking", "p": ["2 × a + 3 = 15: undo + 3 first → 2 × a = 12 → a = 6.", "Always **check**: 2 × 6 + 3 = 15 ✓.", "In algebra, 2 × a is written **2a**."]}, {"k": "try", "t": "Find the letter", "p": [], "qq": {"id": "m6u04s2t02", "type": "num", "prompt": "x − 9 = 14. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 23, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "23."}}, {"k": "method", "t": "How do I find the value of a letter?", "p": ["Step 1: Read the equation as a sentence.", "Step 2: Undo the operations with inverses (+ ↔ −, × ↔ ÷).", "Step 3: For two steps, undo the last operation first.", "Step 4: Check by putting the value back in."]}, {"k": "example", "t": "Multiply", "p": [], "q": "5k = 45.", "steps": [["45 ÷ 5", ""]], "a": "k = 9"}, {"k": "example", "t": "Two steps", "p": [], "q": "3y − 4 = 11.", "steps": [["+ 4: 3y = 15", ""], ["÷ 3: y = 5", ""]], "a": "y = 5"}, {"k": "example", "t": "From words", "p": [], "q": "A number doubled is 34. Write and solve.", "steps": [["2n = 34", ""], ["n = 17", ""]], "a": "17"}, {"k": "example", "t": "Two letters", "p": [], "q": "a + b = 10 and a = 4. Find b.", "steps": [["4 + b = 10", ""], ["b = 6", ""]], "a": "6"}, {"k": "try", "t": "Two steps", "p": [], "qq": {"id": "m6u04s2t03", "type": "num", "prompt": "2a + 5 = 21. a?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "error", "t": "Used the wrong inverse", "p": ["Find the first wrong line."], "q": "Solve n − 8 = 20.", "lines": ["n = 20 − 8 = 12"], "bad": 0, "why": "The inverse of −8 is +8: n = 20 + 8 = 28. Check: 28 − 8 = 20 ✓.", "fix": [["n = 28", ""]], "id": "m6u04s2t04"}, {"k": "mistake", "t": "Doing the same operation instead of the inverse", "p": ["Undo: + ↔ −, × ↔ ÷."]}, {"k": "tip", "t": "Real life", "p": ["Spreadsheets and recipes use letters or cells for unknown amounts."]}, {"k": "summary", "t": "What to remember", "p": ["A letter stands for an unknown number.", "Use inverse operations.", "Undo the last operation first.", "Check your answer."]}], "video": {"