C", "ok": false, "fb": ""}]}], "prac": [{"id": "m6u04s1p01", "type": "num", "prompt": "A diver at −15 m rises 9 m. New depth (m)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1p02", "type": "num", "prompt": "? − 5 = −2", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1p03", "type": "num", "prompt": "Difference between −11 and −4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1p04", "type": "explain", "prompt": "Explain how a number line helps you work out −3 − 4.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "start at −3", "kw": ["[-−]3|start"]}, {"pt": "move left 4 → −7", "kw": ["left|[-−]7"]}], "need": 2, "model": "Start at −3 and move 4 to the left (subtracting), landing on −7.", "hint": "", "reason": "Start at −3 and move 4 to the left (subtracting), landing on −7."}, {"id": "m6u04s1p05", "type": "num", "prompt": "Lift at floor 3 goes down 5 floors. Floor?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1p06", "type": "num", "prompt": "Estimate then calculate 23 615 − 9 847.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13768, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u04s1p07", "type": "mcq", "prompt": "Order coldest first: −2, 5, −9, 0", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−9, −2, 0, 5", "ok": true, "fb": ""}, {"t": "−2, −9, 0, 5", "ok": false, "fb": ""}]}, {"id": "m6u04s1p08", "type": "num", "prompt": "Temperatures: −7