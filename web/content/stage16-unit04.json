{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 4, "stage": 16, "title": "Addition and Subtraction (1)", "strandShort": "Number", "blurb": "Adding and subtracting positive and negative numbers, and using letters to stand for unknown numbers.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u04.pdf"}, "objectives": {"O1": {"code": "6Ni.01", "sec": "4.1", "codeNote": "", "t": "Add and subtract integers, including negative numbers, using a number line."}, "O2": {"code": "6Ae.01", "sec": "4.2", "codeNote": "", "t": "Use letters to represent unknown numbers and find their values."}}, "sections": [{"id": "4.1", "title": "Positive and negative integers", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Cold night", "p": ["In a mountain town the temperature is **6 °C** at 6 pm. By midnight it has fallen by **9 degrees**. The next day it rises to **4 °C**.", "What was the temperature at midnight? By how much did it rise the next day? Think about it before you read on."]}, {"k": "recall", "t": "Large numbers", "p": ["Estimate first: 4875 + 3290 ≈ 5000 + 3000 = 8000."], "qq": {"id": "m6u04s1t01", "type": "num", "prompt": "Work out 6458 + 2735.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9193, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "9193."}}, {"k": "idea", "t": "Adding and subtracting with negatives", "p": ["Use a number line. **Adding** a positive number moves **right**; **subtracting** a positive number moves **left**.", "6 − 9: start at 6, move 9 left → **−3 °C** at midnight."], "fig": {"kind": "numline", "min": -5, "max": 7, "mark": -3}}, {"k": "idea", "t": "Difference between two integers", "p": ["The **difference** is the distance between them on the number line: from −3 to 4 is 3 steps to 0, then 4 more = **7 degrees**.", "A quick way: difference = larger − smaller = 4 − (−3) = 7."], "table": {"head": ["Calculation", "Answer"], "rows": [["−5 + 8", "3"], ["2 − 7", "−5"], ["−4 − 3", "−7"], ["difference between −6 and 2", "8"]]}}, {"k": "try", "t": "Number line", "p": [], "qq": {"id": "m6u04s1t02", "type": "num", "prompt": "Work out −2 + 7.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Start at −2, move 7 right.", "reason": "5."}}, {"k": "method", "t": "How do I add and subtract with negative numbers?", "p": ["Step 1: Draw or picture a number line.", "Step 2: Start at the first number.", "Step 3: Add → move right; subtract → move left.", "Step 4: For a difference, count the steps between the two numbers."]}, {"k": "example", "t": "Below zero", "p": [], "q": "Work out −3 − 5.", "steps": [["start at −3, move 5 left", ""]], "a": "−8"}, {"k": "example", "t": "Large integers", "p": [], "q": "Work out 12 406 − 8 759 (estimate first).", "steps": [["estimate 12 000 − 9000 = 3000", ""], ["12 406 − 8 759 = 3647", ""]], "a": "3647"}, {"k": "example", "t": "Difference", "p": [], "q": "Lowest temperature −12 °C, highest 15 °C. Difference?", "steps": [["12 to zero, then 15 more", ""]], "a": "27 degrees"}, {"k": "example", "t": "Missing number", "p": [], "q": "? + 6 = 2", "steps": [["2 − 6 = −4", ""]], "a": "−4"}, {"k": "try", "t": "Difference", "p": [], "qq": {"id": "m6u04s1t03", "type": "num", "prompt": "Difference between −5 and 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "error", "t": "Moved the wrong way", "p": ["Find the first wrong line."], "q": "Work out −4 + 6.", "lines": ["start at −4, move left 6", "−10"], "bad": 0, "why": "Adding moves RIGHT: −4 + 6 = 2.", "fix": [["move right 6 → 2", ""]], "id": "m6u04s1t04"}, {"k": "mistake", "t": "Wrong direction on the number line", "p": ["Add → right; subtract → left."]}, {"k": "tip", "t": "Real life", "p": ["Temperatures, bank balances and floors below ground (−2 for basement 2) use negative numbers."]}, {"k": "summary", "t": "What to remember", "p": ["Use a number line.", "Add → right; subtract → left.", "Difference = distance between numbers.", "Estimate large calculations first."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "4.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u04s1k01", "type": "num", "prompt": "Before you read on: midnight temperature?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "4.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u04s1k02", "type": "num", "prompt": "Rise from −3 to 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "4.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u04s1k03", "type": "num", "prompt": "−4 − 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "4.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": ""