{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 14, "stage": 14, "title": "Area and Perimeter", "strandShort": "Geometry and measure", "blurb": "Finding area by counting whole and half squares, measuring perimeter, and calculating the area and perimeter of rectangles.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u14.pdf"}, "objectives": {"O1": {"code": "4Gm.01", "sec": "14.1", "codeNote": "", "t": "Estimate and measure the area and perimeter of 2D shapes on squared paper."}, "O2": {"code": "4Gm.02", "sec": "14.2", "codeNote": "", "t": "Calculate the area and perimeter of rectangles."}}, "sections": [{"id": "14.1", "title": "Estimating and measuring area and perimeter", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Sticker sheet", "p": ["A sticker sheet is made of small squares. Some stickers are T-shaped.", "How could you compare the size of two stickers? How far is it around the edge? Think before you read on."]}, {"k": "recall", "t": "Counting squares", "p": ["A row of 4 squares has 4 squares."], "qq": {"id": "m4u14s1t01", "type": "num", "prompt": "3 rows of 4 squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Area", "p": ["**Area** is the amount of surface a shape covers. On squared paper, count the squares: each square is **1 square centimetre (1 cm²)**."], "fig": {"kind": "cells", "cells": [[0, 0], [1, 0], [2, 0], [1, 1], [1, 2]], "cols": 3, "rows": 3, "grid": true}, "p2": ["This T-shape covers **5 squares** – its area is 5 cm²."]}, {"k": "idea", "t": "Perimeter", "p": ["**Perimeter** is the distance all the way **around** the edge. Count the sides of the squares on the outside.", "For the T-shape: go round and count every edge – **12 cm**.", "To estimate the area of a curved shape, count whole squares, then pair up half squares."]}, {"k": "try", "t": "Area", "p": [], "qq": {"id": "m4u14s1t02", "type": "num", "prompt": "Area of a shape covering 9 squares (cm²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "9."}}, {"k": "method", "t": "How do I find area and perimeter on squared paper?", "p": ["Step 1: Area: count the squares inside (pair halves).", "Step 2: Perimeter: count the edges around the outside.", "Step 3: Mark where you start so you don't count twice.", "Step 4: Give units: cm² for area, cm for perimeter."]}, {"k": "example", "t": "Rectangle on a grid", "p": [], "q": "A rectangle 4 squares by 3 squares.", "steps": [["area 4 × 3 = 12", ""], ["perimeter 4 + 3 + 4 + 3 = 14", ""]], "a": "12 cm², 14 cm"}, {"k": "example", "t": "Halves", "p": [], "q": "A shape has 6 whole squares and 4 half squares.", "steps": [["4 halves = 2 wholes", ""]], "a": "about 8 cm²"}, {"k": "example", "t": "Same area, different perimeter", "p": [], "q": "A 1 × 4 strip and a 2 × 2 square.", "steps": [["both area 4", ""], ["perimeters 10 and 8", ""]], "a": "different perimeters"}, {"k": "example", "t": "Estimate", "p": [], "q": "A leaf covers about 20 whole squares and 10 part squares.", "steps": [["part squares ≈ half each → 5", ""]], "a": "about 25 cm²"}, {"k": "try", "t": "Perimeter", "p": [], "qq": {"id": "m4u14s1t03", "type": "num", "prompt": "Perimeter of a 2 × 2 square of squares (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "error", "t": "Counting squares for perimeter", "p": ["Find the first wrong line."], "q": "Perimeter of the T-shape (5 squares).", "lines": ["5 cm"], "bad": 0, "why": "That is the area. Count the outside edges: 12 cm.", "fix": [["12 cm", ""]], "id": "m4u14s1t04"}, {"k": "mistake", "t": "Mixing up area and perimeter", "p": ["Area = inside (squares); perimeter = around (edges)."]}, {"k": "tip", "t": "Real life", "p": ["Gardeners measure area to buy grass seed and perimeter to buy a fence."]}, {"k": "summary", "t": "What to remember", "p": ["Area: squares inside, cm².", "Perimeter: distance around, cm.", "Same area can have different perimeters."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "14.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u14s1k01", "type": "mcq", "prompt": "Before you read on: to compare sticker sizes, count…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the squares they cover", "ok": true, "fb": ""}, {"t": "their corners", "ok": false, "fb": ""}]}}, {"id": "14.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u14s1k02", "type": "num", "prompt": "Area of the T-shape (cm²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u14s1k03", "type": "num", "prompt": "Perimeter of the T-shape (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u14s1k04", "type": "num", "prompt": "Quick check: 6 whole + 4 half squares ≈ ? cm²", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u14s1r01", "type": "num", "prompt": "Area: 2 rows of 5 squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1r02", "type": "num", "prompt": "Perimeter: 1 single square of side 1 cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1r03", "type": "num", "prompt": "Perimeter: 1 × 3 strip of squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1r04", "type": "num", "prompt": "Area: 3 × 3 square of squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1r05", "type": "num", "prompt": "Perimeter: 3 × 3 square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1r06", "type": "num", "prompt": "Area: 7 whole + 2 half squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1r07", "type": "mcq", "prompt": "Unit for area:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm²", "ok": true, "fb": ""}, {"t": "cm", "ok": false, "fb": ""}]}, {"id": "m4u14s1r08", "type": "mcq", "prompt": "Perimeter measures…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the distance around", "ok": true, "fb": ""}, {"t": "the space inside", "ok": false, "fb": ""}]}], "prac": [{"id": "m4u14s1p01", "type": "num", "prompt": "Perimeter of a 1 × 5 strip?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1p02", "type": "num", "prompt": "Perimeter of an L-shape made of 3 squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1p03", "type": "num", "prompt": "Area of the same L-shape?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1p04", "type": "explain", "prompt": "A 1 × 6 strip and a 2 × 3 rectangle both have area 6. Do they have the same perimeter?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|different|not"]}, {"pt": "14 and 10", "kw": ["14|10"]}], "need": 2, "model": "No – the strip has perimeter 14 cm, the rectangle 10 cm.", "hint": "", "reason": "No – the strip has perimeter 14 cm, the rectangle 10 cm."}, {"id": "m4u14s1p05", "type": "num", "prompt": "A shape: 12 whole squares and 6 half squares. Area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1p06", "type": "mcq", "prompt": "Which has the smaller perimeter, area 4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2 × 2 square", "ok": true, "fb": ""}, {"t": "1 × 4 strip", "ok": false, "fb": ""}]}, {"id": "m4u14s1p07", "type": "num", "prompt": "A 4 × 3 rectangle with 1 corner square removed. Area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1p08", "type": "num", "prompt": "Same shape. Perimeter?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Removing a corner keeps it the same.", "reason": ""}], "adv": [{"id": "m4u14s1a01", "type": "explain", "prompt": "* Advanced. Describe two shapes made of 5 squares with different perimeters.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "10 and 12", "kw": ["10|12"]}], "need": 1, "model": "e.g. a 1 × 5 strip (perimeter 12) and a 2 × 2 square with one extra (perimeter 10).", "hint": "", "reason": "e.g. a 1 × 5 strip (perimeter 12) and a 2 × 2 square with one extra (perimeter 10)."}, {"id": "m4u14s1a02", "type": "num", "prompt": "* Advanced. Largest possible perimeter of a shape made of 6 squares joined edge to edge?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1a03", "type": "num", "prompt": "* Advanced. Smallest possible perimeter of a shape made of 9 squares?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "3 × 3.", "reason": ""}], "more": [{"id": "m4u14s1m01", "type": "num", "prompt": "Area: 4 squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1m02", "type": "num", "prompt": "Perimeter: 1 × 2 strip?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1m03", "type": "num", "prompt": "Area: 2 × 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1m04", "type": "num", "prompt": "Area: 2 half squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s1m05", "type": "mcq", "prompt": "Area measures…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the space inside", "ok": true, "fb": ""}, {"t": "the distance around", "ok": false, "fb": ""}]}, {"id": "m4u14s1m06", "type": "num", "prompt": "Perimeter: 2 × 2 square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u14", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 14.1 notes · Estimating and measuring area and perimeter", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "14.2", "title": "Area and perimeter of rectangles", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Classroom rug", "p": ["A rectangular rug is **4 m long** and **3 m wide**.", "How much floor does it cover? How long is the ribbon round its edge? Try it before you read on."]}, {"k": "recall", "t": "Arrays", "p": ["4 columns of 3 = 4 × 3."], "qq": {"id": "m4u14s2t01", "type": "num", "prompt": "4 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "idea", "t": "Area of a rectangle", "p": ["Instead of counting every square, **multiply**: Area = length × width."], "fig": {"kind": "cells", "cells": [[0, 0], [0, 1], [0, 2], [1, 0], [1, 1], [1, 2], [2, 0], [2, 1], [2, 2], [3, 0], [3, 1], [3, 2]], "cols": 4, "rows": 3, "grid": true}, "p2": ["Rug: 4 × 3 = **12 m²**."]}, {"k": "idea", "t": "Perimeter of a rectangle", "p": ["Add all four sides: 4 + 3 + 4 + 3 = **14 m**. Or: 2 × (length + width) = 2 × 7 = 14 m."]}, {"k": "try", "t": "Area", "p": [], "qq": {"id": "m4u14s2t02", "type": "num", "prompt": "Area of a 5 cm by 2 cm rectangle (cm²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "10."}}, {"k": "method", "t": "How do I find the area and perimeter of a rectangle?", "p": ["Step 1: Area = length × width (square units).", "Step 2: Perimeter = add all four sides.", "Step 3: Or perimeter = 2 × (length + width).", "Step 4: Check the units."]}, {"k": "example", "t": "Area", "p": [], "q": "6 cm by 4 cm.", "steps": [["6 × 4", ""]], "a": "24 cm²"}, {"k": "example", "t": "Perimeter", "p": [], "q": "6 cm by 4 cm.", "steps": [["6 + 4 + 6 + 4", ""]], "a": "20 cm"}, {"k": "example", "t": "Square", "p": [], "q": "A square of side 5 m.", "steps": [["area 5 × 5", ""], ["perimeter 4 × 5", ""]], "a": "25 m², 20 m"}, {"k": "example", "t": "Missing side", "p": [], "q": "Area 18 cm², length 6 cm. Width?", "steps": [["18 ÷ 6", ""]], "a": "3 cm"}, {"k": "try", "t": "Perimeter", "p": [], "qq": {"id": "m4u14s2t03", "type": "num", "prompt": "Perimeter of a 7 m by 2 m rectangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "18."}}, {"k": "error", "t": "Adding for area", "p": ["Find the first wrong line."], "q": "Area of a 4 m by 3 m rug.", "lines": ["4 + 3 = 7 m²"], "bad": 0, "why": "Area is length × width: 12 m².", "fix": [["12 m²", ""]], "id": "m4u14s2t04"}, {"k": "mistake", "t": "Adding instead of multiplying for area", "p": ["Area: ×. Perimeter: + all sides."]}, {"k": "tip", "t": "Real life", "p": ["Carpet is sold by the square metre; skirting board and fencing by the metre."]}, {"k": "summary", "t": "What to remember", "p": ["Area = l × w (m², cm²).", "Perimeter = l + w + l + w (m, cm).", "Square: area side × side; perimeter 4 × side."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "14.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u14s2k01", "type": "num", "prompt": "Before you read on: floor covered (m²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u14s2k02", "type": "num", "prompt": "Ribbon round the edge (m)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u14s2k03", "type": "num", "prompt": "Area of 6 cm by 4 cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "14.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u14s2k04", "type": "num", "prompt": "Quick check: area 18, length 6. Width?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u14s2r01", "type": "num", "prompt": "Area 3 cm by 2 cm?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u14s2r02"