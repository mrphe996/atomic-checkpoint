{"course": {"id": "s18", "title": "Camday – Cambridge Lower Secondary Mathematics — Stage 8", "units": [{"n": 1, "t": "Integers"}, {"n": 2, "t": "Expressions, Formulae and Equations"}, {"n": 3, "t": "Place Value and Rounding"}, {"n": 4, "t": "Decimals"}, {"n": 5, "t": "Angles and Constructions"}, {"n": 6, "t": "Collecting Data"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Shapes and Symmetry"}, {"n": 9, "t": "Sequences and Functions"}, {"n": 10, "t": "Percentages"}, {"n": 11, "t": "Graphs"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Probability"}, {"n": 14, "t": "Position and Transformation"}, {"n": 15, "t": "Distance, Area and Volume"}, {"n": 16, "t": "Interpreting and Discussing Results"}]}, "unit": {"n": 10, "stage": 18, "title": "Percentages", "strandShort": "Number", "blurb": "Increasing and decreasing amounts by a percentage, finding a change as a percentage, and using decimal multipliers.", "strand": "Number", "framework": "Cambridge Lower Secondary Mathematics (0862), Stage 8", "lesson": true, "subject": "maths", "read": "media/read/m8u10.pdf"}, "objectives": {"O1": {"code": "8Nf.11", "sec": "10.1", "codeNote": "", "t": "Increase and decrease an amount by a percentage, and express a change as a percentage."}, "O2": {"code": "8Nf.12", "sec": "10.2", "codeNote": "", "t": "Use a decimal multiplier to calculate percentage increases and decreases."}}, "sections": [{"id": "10.1", "title": "Percentage increases and decreases", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Price rise", "p": ["A concert ticket rose from **$60** to **$75**. The organiser says 'only a small rise'.", "By what percentage did the price rise? Try it before you read on."]}, {"k": "recall", "t": "Percentage of an amount", "p": ["15% of 80 = 0.15 × 80 = 12."], "qq": {"id": "m8u10s1t01", "type": "num", "prompt": "Find 35% of 240.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 84, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "84."}}, {"k": "idea", "t": "Increasing and decreasing", "p": ["**Increase** an amount by a percentage: find the percentage and **add** it. **Decrease**: find it and **subtract**."], "table": {"head": ["Task", "Working", "Answer"], "rows": [["increase $80 by 15%", "15% = $12; 80 + 12", "$92"], ["decrease 450 kg by 20%", "20% = 90; 450 − 90", "360 kg"]]}}, {"k": "idea", "t": "Change as a percentage", "p": ["**Percentage change = change ÷ original × 100%.** Always divide by the ORIGINAL amount.", "Ticket: change = 75 − 60 = $15; 15 ÷ 60 × 100 = **25% increase**.", "The actual change ($15) is the **absolute** change; 25% is the **relative** change."]}, {"k": "try", "t": "Change", "p": [], "qq": {"id": "m8u10s1t02", "type": "num", "prompt": "A plant grew from 40 cm to 52 cm. Percentage increase?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 23.08, "fb": "Divide by the ORIGINAL 40, not 52."}], "bare": true, "hint": "12 ÷ 40.", "reason": "30%."}}, {"k": "method", "t": "How do I work with percentage change?", "p": ["Step 1: Increase/decrease: find the percentage of the original, then add/subtract.", "Step 2: Percentage change: find the change (new − original).", "Step 3: Divide by the original and multiply by 100.", "Step 4: Say whether it is an increase or a decrease."]}, {"k": "example", "t": "A decrease", "p": [], "q": "A laptop costs $850. It is reduced by 12%. New price?", "steps": [["12% of 850 = 102", ""], ["850 − 102 = 748", ""]], "a": "$748"}, {"k": "example", "t": "Percentage decrease", "p": [], "q": "A town's population fell from 25 000 to 23 500. Percentage decrease?", "steps": [["change = 1500", ""], ["1500 ÷ 25 000 × 100 = 6", ""]], "a": "6% decrease"}, {"k": "example", "t": "Comparing", "p": [], "q": "Shop A: $40 → $46. Shop B: $120 → $132. Which had the bigger percentage rise?", "steps": [["A: 6/40 = 15%", ""], ["B: 12/120 = 10%", ""]], "a": "Shop A (though B rose more in dollars)"}, {"k": "example", "t": "Small percentage", "p": [], "q": "Increase $2400 by 2.5%.", "steps": [["2.5% = 0.025 × 2400 = 60", ""], ["2460", ""]], "a": "$2460"}, {"k": "try", "t": "Decrease", "p": [], "qq": {"id": "m8u10s1t03", "type": "num", "prompt": "Decrease 360 by 15%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 306, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "360 − 54 = 306."}}, {"k": "error", "t": "Dividing by the new amount", "p": ["Find the first wrong line."], "q": "A price falls from $50 to $40. Percentage decrease?", "lines": ["change = $10", "10 ÷ 40 × 100 = 25%"], "bad": 1, "why": "Divide by the ORIGINAL price ($50): 10 ÷ 50 × 100 = 20%.", "fix": [["10 ÷ 50 × 100 = 20%", ""]], "id": "m8u10s1t04"}, {"k": "mistake", "t": "Wrong 'original'", "p": ["Percentage change is always compared with the starting value."]}, {"k": "tip", "t": "Real life", "p": ["News reports often give both: 'prices up $3 (5%)'. Percentages let you compare fairly."]}, {"k": "summary", "t": "What to remember", "p": ["Increase: add the percentage; decrease: subtract it.", "Percentage change = change ÷ original × 100%.", "Absolute change vs percentage change.", "Use percentages to compare changes fairly."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "10.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m8u10s1k01", "type": "num", "prompt": "Before you read on: $60 → $75. Percentage rise?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 20, "fb": "Divide by 60, not 75."}], "bare": true, "hint": "", "reason": "25%."}}, {"id": "10.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m8u10s1k02", "type": "num", "prompt": "Increase 200 by 35%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 270, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "270."}}, {"id": "10.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m8u10s1k03", "type": "num", "prompt": "$80 → $68. Percentage decrease?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15%."}}, {"id": "10.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m8u10s1k04", "type": "num", "prompt": "Quick check: decrease 90 by 10%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 81, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "81."}}], "captions": [], "chapters": [[0, 388]], "req": [{"id": "m8u10s1r01", "type": "num", "prompt": "Increase 50 by 20%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "60."}, {"id": "m8u10s1r02", "type": "num", "prompt": "Decrease 120 by 25%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "90."}, {"id": "m8u10s1r03", "type": "num", "prompt": "Increase $360 by 5%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 378, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "378."}, {"id": "m8u10s1r04", "type": "num", "prompt": "Decrease 75 kg by 8%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 69, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "69."}, {"id": "m8u10s1r05", "type": "num", "prompt": "20 → 25. Percentage increase?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25%."}, {"id": "m8u10s1r06", "type": "num", "prompt": "200 → 170. Percentage decrease?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15%."}, {"id": "m8u10s1r07", "type": "num", "prompt": "Salary $2000 rises 3%. New salary ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2060, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2060."}, {"id": "m8u10s1r08", "type": "num", "prompt": "64 → 80. Percentage increase?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25%."}], "prac": [{"id": "m8u10s1p01", "type": "num", "prompt": "A car bought for $18 000 sold for $13 500. Percentage loss?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25%."}, {"id": "m8u10s1p02", "type": "num", "prompt": "A shop buys a coat for $40 and sells it for $58. Percentage profit?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "45%."}, {"id": "m8u10s1p03", "type": "num", "prompt": "Increase 1250 by 0.8%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1260, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "1260."}, {"id": "m8u10s1p04", "type": "num", "prompt": "Test score 48 → 54. Percentage increase?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12.5%."}, {"id": "m8u10s1p05", "type": "explain", "prompt": "Rice went from $2 to $3 and meat from $10 to $12. Which rose more? Explain two ways.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "meat more in dollars ($2 vs $1)", "kw": ["\\$2|2 dollars|meat.*more|absolute"]}, {"pt": "rice more in percent (50% vs 20%)", "kw": ["50|20|percent"]}], "need": 2, "model": "Meat rose more in dollars ($2 v $1), but rice rose more in percentage terms (50% v 20%).", "hint": "", "reason": "Meat rose more in dollars ($2 v $1), but rice rose more in percentage terms (50% v 20%)."}, {"id": "m8u10s1p06", "type": "num", "prompt": "Population 8400 → 9030. Percentage increase?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7.5%."}, {"id": "m8u10s1p07", "type": "num", "prompt": "A runner's 5 km time went from 25 min to 22 min. Percentage decrease?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "3 ÷ 25.", "reason": "12%."}, {"id": "m8u10s1p08", "type": "num", "prompt": "A phone battery drops from 80% to 68% charge. Percentage decrease of the charge?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "12 ÷ 80.", "reason": "15%."}], "adv": [{"id": "m8u10s1a01", "type": "num", "prompt": "* Advanced. A price rises 10% then falls 10%. Overall percentage change? (negative for a decrease)", "diff": "VH", "obj": "O1", "skill": "Application", "answer": -1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "1.1 × 0.9.", "reason": "−1%."}, {"id": "m8u10s1a02", "type": "num", "prompt": "* Advanced. After a 20% rise a bike costs $360. Original price?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 300, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "300."}, {"id": "m8u10s1a03", "type": "explain", "prompt": "* Advanced. Why is a 50% increase followed by a 50% decrease not back to the start?", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "second % is of a bigger amount", "kw": ["bigger|larger|new amount|different base"]}, {"pt": "75%", "kw": ["75|0\\.75|25% less"]}], "need": 2, "model": "The 50% decrease is taken from the larger amount: 100 → 150 → 75, so you end 25% lower.", "hint": "", "reason": "The 50% decrease is taken from the larger amount: 100 → 150 → 75, so you end 25% lower."}], "more": [{"id": "m8u10s1m01", "type": "num", "prompt": "Increase 80 by 10%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 88, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "88."}, {"id": "m8u10s1m02", "type": "num", "prompt": "Decrease 60 by 50%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "30."}, {"id": "m8u10s1m03", "type": "num", "prompt": "40 → 50. % increase?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25."}, {"id": "m8u10s1m04", "type": "num", "prompt": "50 → 40. % decrease?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "20."}, {"id": "m8u10s1m05", "type": "num", "prompt": "Increase 300 by 7%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 321, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "321."}, {"id": "m8u10s1m06", "type": "num", "prompt": "Decrease 250 by 4%.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 240, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "240."}], "notes": "v4", "pdf": [{"book": "c8u10", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 10.1 notes · Percentage increases and decreases", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "10.2", "title": "Using a multiplier", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Shop sale", "p": ["A shop takes **35% off** everything. A jacket costs **$120**.", "Can you find the sale price in ONE calculation? Try it before you read on."]}, {"k": "recall", "t": "Percentages as decimals", "p": ["35% = 0.35; 100% = 1."], "qq": {"id": "m8u10s2t01", "type": "num", "prompt": "Write 108% as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1.08, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "1.08."}}, {"k": "idea", "t": "Multipliers", "p": ["After a 35% decrease you pay 100% − 35% = **65%** of the price. So multiply by **0.65**: 120 × 0.65 = **$78**.", "After a 15% increase you have 115%: multiply by **1.15**."], "table": {"head": ["Change", "Percentage left", "Multiplier"], "rows": [["increase 15%", "115%", "1.15"], ["decrease 35%", "65%", "0.65"], ["increase 2.5%", "102.5%", "1.025"], ["decrease 8%", "92%", "0.92"]]}}, {"k": "idea", "t": "Why multipliers help", "p": ["One step instead of two, and they work for **repeated** changes: two 10% rises = × 1.1 × 1.1 = × 1.21 (a 21% rise, not 20%).", "Finding a percentage change from a multiplier: × 0.88 means a 12% decrease."]}, {"k": "try", "t": "Multiplier", "p": [], "qq": {"id": "m8u10s2t02", "type": "num", "prompt": "What multiplier increases an amount by 7%?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1.07, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 0.07, "fb": "That finds only 7%; add the 100%."}, {"v": 1.7, "fb": "7% = 0.07."}], "bare": true, "hint": "", "reason": "1.07."}}, {"k": "method", "t": "How do I use a multiplier?", "p": ["Step 1: Increase by r%: multiplier = 1 + r/100. Decrease by r%: 1 − r/100.", "Step 2: Multiply the original amount by the multiplier.", "Step 3: For several changes, multiply the multipliers.", "Step 4: Check: increase → answer bigger; decrease → smaller."]}, {"k": "example", "t": "Increase", "p": [], "q": "Increase $275 by 65% using a multiplier.", "steps": [["multiplier 1.65", ""], ["275 × 1.65 = 453.75", ""]], "a": "$453.75"}, {"k": "example", "t": "Decrease", "p": [], "q": "A car worth $14 000 loses 18% of its value. New value?", "steps": [["multiplier 0.82", ""], ["14 000 × 0.82 = 11 480", ""]], "a": "$11 480"}, {"k": "example", "t": "Two changes", "p": [], "q": "A price rises 20% then falls 20%. Overall?", "steps": [["× 1.2 × 0.8 = × 0.96", ""], ["4% decrease overall", ""]], "a": "a 4% decrease"}, {"k": "example", "t": "Reading a multiplier", "p": [], "q": "A value is multiplied by 1.035. What percentage change is that?", "steps": [["1.035 = 103.5%", ""], ["3.5% increase", ""]], "a": "3.5% increase"}, {"k": "try", "t": "Use it", "p": [], "qq": {"id": "m8u10s2t03", "type": "num", "prompt": "Decrease 640 by 15% using a multiplier.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 544, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× 0.85.", "reason": "544."}}, {"k": "error", "t": "Multiplier for a decrease", "p": ["Find the first wrong line."], "q": "Decrease $90 by 30%.", "lines": ["multiplier = 0.3", "90 × 0.3 = $27"], "bad": 0, "why": "0.3 finds the 30% taken OFF. You keep 70%: multiplier 0.7 → $63.", "fix": [["multiplier = 0.7", ""], ["90 × 0.7 = $63", ""]], "id": "m8u10s2t04"}, {"k": "mistake", "t": "Using the percentage itself", "p": ["A 30% decrease uses × 0.7, not × 0.3."]}, {"k": "tip", "t": "Real life", "p": ["Banks use multipliers for interest: savings grow by × 1.03 each year at 3%."]}, {"k": "summary", "t": "What to remember", "p": ["Increase r%: × (1 + r/100). Decrease r%: × (1 − r/100).", "One calculation gives the new amount.", "Repeated changes: multiply the multipliers.", "Convert a multiplier back to a percentage change."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "10.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m8u10s2k01", "type": "num", "prompt": "Before you read on: $120 with 35% off = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 78, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× 0.65.", "reason": "78."}}, {"id": "10.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m8u10s2k02", "type": "num", "prompt": "Multiplier for a 22% decrease?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.78, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.78."}}, {"id": "10.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m8u10s2k03", "type": "num", "prompt": "Increase 500 by 12% (× 1.12).", "diff": "M", "obj": "O1", "skill": "Application", "answer": 560, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "560."}}, {"id": "10.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m8u10s2k04", "type": "num", "prompt": "Quick check: × 1.1 twice is a ?% increase", "diff": "M", "obj": "O1", "skill": "Application", "answer": 21, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "21."}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m8u10s2r01", "type": "num", "prompt": "Multiplier for +25%?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 1.25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "1.25."}, {"id": "m8u10s2r02", "type": "num", "prompt": "Multiplier for −40%?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 0.6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.6."}, {"id": "m8u10s2r03", "type": "num", "prompt": "Increase 80 by 45% (multiplier).", "diff": "M", "obj": "O2", "skill": "Application", "answer": 116, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "116."}, {"id": "m8u10s2r04", "type": "num", "prompt": "Decrease 300 by 12% (multiplier).", "diff": "M", "obj": "O2", "skill": "Application", "answer": 264, "unit": "×", "units": ["×"], "