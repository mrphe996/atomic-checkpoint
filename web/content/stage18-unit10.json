], "tol": 0.005, "errs": [], "bare": true, "hint": "", "reason": "56.99."}, {"id": "m8u10s2p05", "type": "explain", "prompt": "Explain why 'decrease by 15%' uses the multiplier 0.85.", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "keep 85%", "kw": ["85|keep|left|remain"]}, {"pt": "100 − 15", "kw": ["100 ?− ?15|100 ?- ?15"]}], "need": 2, "model": "After taking 15% off you have 100% − 15% = 85% left, and 85% = 0.85.", "hint": "", "reason": "After taking 15% off you have 100% − 15% = 85% left, and 85% = 0.85."}, {"id": "m8u10s2p06", "type": "num", "prompt": "A house value falls 6% a year for 2 years from $200 000. Value ($)?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 176720, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× 0.94².", "reason": "176 720."}, {"id": "m8u10s2p07", "type": "num", "prompt": "Prices × 1.08 after a rise. Original $350. New ($)?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 378, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "378."}, {"id": "m8u10s2p08", "type": "mcq", "prompt": "Which is bigger: 25% off then 10% off, or 35% off?", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "35% off is the bigger discount", "ok": true, "fb": "0.75 × 0.9 = 0.675 → 32.5%."}, {"t": "they are the same", "ok": false, "fb": ""}]}], "adv": [{"id": "m8u10s2a01", "type": "num", "prompt": "* Advanced. After a 25% increase the price is $90. Original?", "diff": "VH", "obj": "O2", "skill": "Application", "answer": 72, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "÷ 1.25.", "reason": "72."}, {"id": "m8u10s2a02", "type": "num", "prompt": "* Advanced. After 15% off, a coat costs $68. Original?", "diff": "VH", "obj": "O2", "skill": "Application", "answer": 80, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "÷ 0.85.", "reason": "80."}, {"id": "m8u10s2a03", "t