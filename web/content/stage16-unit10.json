{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 10, "stage": 16, "title": "Multiplication and Division (1)", "strandShort": "Number", "blurb": "Multiplying whole numbers up to 4 digits by 2-digit numbers, dividing by 1- and 2-digit numbers, remainders, and tests of divisibility.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u10.pdf"}, "objectives": {"O1": {"code": "6Nc.04", "sec": "10.1", "codeNote": "", "t": "Estimate and multiply whole numbers up to 10 000 by 1-digit or 2-digit numbers."}, "O2": {"code": "6Nc.05", "sec": "10.2", "codeNote": "", "t": "Estimate and divide whole numbers up to 1000 by 1-digit or 2-digit numbers, and interpret remainders."}, "O3": {"code": "6Nc.06", "sec": "10.3", "codeNote": "", "t": "Use tests of divisibility by 3, 6 and 9 (and 2, 4, 5, 10, 100)."}}, "sections": [{"id": "10.1", "title": "Multiplication", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Stadium seats", "p": ["A stadium has **48 rows** with **1265 seats** in each row.", "Roughly how many seats is that? How could you work it out exactly? Try it before you read on."]}, {"k": "recall", "t": "Times tables and place value", "p": ["6 × 7 = 42, so 60 × 70 = 4200."], "qq": {"id": "m6u10s1t01", "type": "num", "prompt": "Work out 300 × 40.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12 000."}}, {"k": "idea", "t": "Estimate first", "p": ["Round each number to 1 significant figure: 1265 × 48 ≈ 1000 × 50 = **50 000**. A closer estimate: 1300 × 50 = 65 000.", "The exact answer should be near this – an estimate catches mistakes."]}, {"k": "idea", "t": "Long multiplication", "p": ["Split the 2-digit number into tens and ones, multiply, then add:"], "table": {"head": ["Step", "Working"], "rows": [["1265 × 8", "10 120"], ["1265 × 40", "50 600"], ["add", "60 720"]]}, "p2": ["The stadium has **60 720 seats** – close to the estimate ✓. A grid (area) method gives the same result."]}, {"k": "try", "t": "Estimate", "p": [], "qq": {"id": "m6u10s1t02", "type": "mcq", "prompt": "Best estimate of 3896 × 21?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "80 000", "ok": true, "fb": "4000 × 20."}, {"t": "8000", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I multiply large whole numbers?", "p": ["Step 1: Estimate by rounding.", "Step 2: Split the 2-digit number into tens and ones.", "Step 3: Multiply by each part (remember the 0 for the tens).", "Step 4: Add the parts; compare with the estimate."]}, {"k": "example", "t": "4-digit × 1-digit", "p": [], "q": "Work out 2347 × 6.", "steps": [["2000 × 6 = 12 000", ""], ["347 × 6 = 2082", ""], ["total 14 082", ""]], "a": "14 082"}, {"k": "example", "t": "3-digit × 2-digit", "p": [], "q": "Work out 356 × 27.", "steps": [["356 × 7 = 2492", ""], ["356 × 20 = 7120", ""], ["9612", ""]], "a": "9612"}, {"k": "example", "t": "Problem", "p": [], "q": "A school orders 24 boxes of 1150 sheets of paper.", "steps": [["1150 × 24 = 27 600", ""]], "a": "27 600 sheets"}, {"k": "example", "t": "Check with estimate", "p": [], "q": "Is 4807 × 19 = 9133 sensible?", "steps": [["estimate 5000 × 20 = 100 000", ""], ["9133 is far too small", ""]], "a": "no – the answer is 91 333"}, {"k": "try", "t": "Multiply", "p": [], "qq": {"id": "m6u10s1t03", "type": "num", "prompt": "Work out 1204 × 15.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18060, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "1204 × 10 + 1204 × 5.", "reason": "18 060."}}, {"k": "error", "t": "Forgot the zero for the tens", "p": ["Find the first wrong line."], "q": "Work out 213 × 32.", "lines": ["213 × 2 = 426", "213 × 3 = 639", "426 + 639 = 1065"], "bad": 1, "why": "The 3 is 3 tens: 213 × 30 = 6390. Total 426 + 6390 = 6816.", "fix": [["213 × 30 = 6390", ""], ["6816", ""]], "id": "m6u10s1t04"}, {"k": "mistake", "t": "Multiplying by the tens digit as if it were ones", "p": ["× 30, not × 3."]}, {"k": "tip", "t": "Real life", "p": ["Event planners, shops and factories multiply large numbers every day to order stock."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate first by rounding.", "Split the multiplier into tens and ones.", "Remember place value (× 40 = × 4 × 10).", "Compare the answer with the estimate."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "10.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u10s1k01", "type": "mcq", "prompt": "Before you read on: roughly how many seats?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "about 60 000", "ok": true, "fb": ""}, {"t": "about 6000", "ok": false, "fb": ""}]}}, {"id": "10.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u10s1k02", "type": "num", "prompt": "1265 × 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10120, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u10s1k03", "type": "num", "prompt": "356 × 27?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9612, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u10s1k04", "type": "num", "prompt": "Quick check: 25 × 40?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u10s1r01", "type": "num", "prompt": "3462 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13848, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1r02", "type": "num", "prompt": "5078 × 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35546, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1r03", "type": "num", "prompt": "243 × 16?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3888, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1r04", "type": "num", "prompt": "508 × 32?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16256, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1r05", "type": "num", "prompt": "1450 × 12?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 17400, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1r06", "type": "mcq", "prompt": "Estimate 6102 × 49:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "300 000", "ok": true, "fb": ""}, {"t": "30 000", "ok": false, "fb": ""}]}, {"id": "m6u10s1r07", "type": "num", "prompt": "2500 × 40?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1r08", "type": "num", "prompt": "999 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2997, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m6u10s1p01", "type": "num", "prompt": "A cinema sells 365 tickets a day for 28 days. Tickets?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10220, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1p02", "type": "num", "prompt": "A bike costs $1275. A club buys 18. Cost ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 22950, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1p03", "type": "num", "prompt": "4096 × 25?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 102400, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1p04", "type": "explain", "prompt": "Explain how an estimate shows 2896 × 31 = 8976 must be wrong.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "estimate 3000 × 30 = 90 000", "kw": ["90 ?000|3000|90000"]}, {"pt": "much bigger", "kw": ["too small|much bigger|wrong|far"]}], "need": 2, "model": "3000 × 30 = 90 000, so the answer should be near 90 000; 8976 is far too small.", "hint": "", "reason": "3000 × 30 = 90 000, so the answer should be near 90 000; 8976 is far too small."}, {"id": "m6u10s1p05", "type": "num", "prompt": "Missing digit: 2?4 × 6 = 1704. ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "284 × 6.", "reason": ""}, {"id": "m6u10s1p06", "type": "num", "prompt": "A lorry carries 1200 kg 37 times. Total (kg)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 44400, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1p07", "type": "num", "prompt": "723 × 45?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 32535, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1p08", "type": "mcq", "prompt": "Which is bigger: 2345 × 18 or 4690 × 9?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "equal", "ok": true, "fb": "4690 × 9 = 2345 × 18."}, {"t": "2345 × 18", "ok": false, "fb": ""}]}], "adv": [{"id": "m6u10s1a01", "type": "num", "prompt": "* Advanced. Use 125 × 8 = 1000 to work out 125 × 72.", "diff": "H", "obj": "O1", "skill": "Application", "answer": 9000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1a02", "type": "num", "prompt": "* Advanced. A heart beats about 72 times a minute. Beats in one day?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 103680, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "72 × 60 × 24.", "reason": ""}, {"id": "m6u10s1a03", "type": "explain", "prompt": "* Advanced. Using digits 2, 4, 6, 8 once each, make a 3-digit × 1-digit product as large as possible. Explain.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "642 × 8 or 862 × 4", "kw": ["642|862|8 ?×|× ?8"]}], "need": 1, "model": "642 × 8 = 5136 is the largest – put the biggest digit as the multiplier.", "hint": "", "reason": "642 × 8 = 5136 is the largest – put the biggest digit as the multiplier."}], "more": [{"id": "m6u10s1m01", "type": "num", "prompt": "1000 × 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1m02", "type": "num", "prompt": "120 × 11?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1320, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1m03", "type": "num", "prompt": "45 × 20?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 900, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1m04", "type": "num", "prompt": "302 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1510, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1m05", "type": "num", "prompt": "64 × 25?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1600, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s1m06", "type": "num", "prompt": "1111 × 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9999, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u10", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 10.1 notes · Multiplication", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "10.2", "title": "Division", "objs": ["O2"], "lesson": [{"k": "hook", "t": "School trip", "p": ["**847 students** go on a trip. Each coach holds **35 students**.", "How many coaches are needed? What happens to the students who don't fill a coach? Try it before you read on."]}, {"k": "recall", "t": "Division facts", "p": ["56 ÷ 7 = 8, so 560 ÷ 7 = 80."], "qq": {"id": "m6u10s2t01", "type": "num", "prompt": "Work out 720 ÷ 8.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "90."}}, {"k": "idea", "t": "Estimating and short division", "p": ["Estimate: 847 ÷ 35 ≈ 800 ÷ 40 = 20 (a bit more, as 35 < 40).", "Short division by a 1-digit number: 945 ÷ 7: 9 ÷ 7 = 1 r 2 → 24 ÷ 7 = 3 r 3 → 35 ÷ 7 = 5 → **135**."]}, {"k": "idea", "t": "Dividing by a 2-digit number", "p": ["Use chunking (subtract multiples of the divisor):"], "table": {"head": ["Step", "Working", "Remaining"], "rows": [["20 × 35 = 700", "847 − 700", "147"], ["4 × 35 = 140", "147 − 140", "7"], ["total", "24 r 7", ""]]}, "p2": ["24 coaches hold 840; 7 students are left, so **25 coaches** are needed. **Interpret the remainder** in context: here round **up**."]}, {"k": "try", "t": "Short division", "p": [], "qq": {"id": "m6u10s2t02", "type": "num", "prompt": "Work out 672 ÷ 6.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 112, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "112."}}, {"k": "method", "t": "How do I divide large numbers?", "p": ["Step 1: Estimate first.", "Step 2: 1-digit divisor: short division, carrying remainders.", "Step 3: 2-digit divisor: subtract chunks (10×, 20×, …) of the divisor.", "Step 4: Interpret any remainder: round up, round down, or write as a fraction/decimal."]}, {"k": "example", "t": "Remainder", "p": [], "q": "Work out 500 ÷ 9.", "steps": [["9 × 55 = 495", ""], ["55 r 5", ""]], "a": "55 r 5"}, {"k": "example", "t": "2-digit divisor", "p": [], "q": "Work out 936 ÷ 24.", "steps": [["24 × 30 = 720 → 216 left", ""], ["24 × 9 = 216", ""], ["39", ""]], "a": "39"}, {"k": "example", "t": "Round down", "p": [], "q": "How many $15 tickets can you buy with $200?", "steps": [["200 ÷ 15 = 13 r 5", "can't buy part of a ticket"]], "a": "13 tickets"}, {"k": "example", "t": "Remainder as a fraction", "p": [], "q": "Cut 43 m of rope into 4 equal pieces.", "steps": [["43 ÷ 4 = 10 r 3 = 10¾", ""]], "a": "10¾ m (10.75 m)"}, {"k": "try", "t": "Context", "p": [], "qq": {"id": "m6u10s2t03", "type": "num", "prompt": "Eggs come in boxes of 12. Boxes needed for 150 eggs?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "150 ÷ 12 = 12 r 6 → round up.", "reason": "13."}}, {"k": "error", "t": "Ignored the context", "p": ["Find the first wrong line."], "q": "How many 35-seat coaches for 847 students?", "lines": ["847 ÷ 35 = 24 r 7", "24 coaches"], "bad": 1, "why": "7 students would be left behind – you need 25 coaches.", "fix": [["round up: 25 coaches", ""]], "id": "m6u10s2t04"}, {"k": "mistake", "t": "Rounding the wrong way", "p": ["Ask what the remainder means in the story."]}, {"k": "tip", "t": "Real life", "p": ["Planning buses, packing boxes and sharing costs all need division with sensible remainders."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate first.", "Short division for 1-digit divisors; chunking for 2-digit.", "Remainders: round up, round down, or as a fraction.", "Check by multiplying back."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "10.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u10s2k01", "type": "num", "prompt": "Before you read on: coaches needed?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u10s2k02", "type": "num", "prompt": "945 ÷ 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 135, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u10s2k03", "type": "num", "prompt": "936 ÷ 24?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 39, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u10s2k04", "type": "num", "prompt": "Quick check: $15 tickets with $200?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "