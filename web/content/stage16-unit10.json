tion", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "1000 ÷ 24 = 41 r 16.", "reason": ""}], "adv": [{"id": "m6u10s2a01", "type": "num", "prompt": "* Advanced. A number divided by 13 gives 47 r 5. The number?", "diff": "H", "obj": "O2", "skill": "Application", "answer": 616, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s2a02", "type": "num", "prompt": "* Advanced. Smallest number that leaves remainder 1 when divided by 2, 3, 4 and 5?", "diff": "VH", "obj": "O2", "skill": "Application", "answer": 61, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "60 + 1.", "reason": ""}, {"id": "m6u10s2a03", "type": "explain", "prompt": "* Advanced. How can multiplication check that 936 ÷ 24 = 39?", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "39 × 24 = 936", "kw": ["39 ?× ?24|24 ?× ?39|936"]}], "need": 1, "model": "Multiply back: 39 × 24 = 936, so the division is correct.", "hint": "", "reason": "Multiply back: 39 × 24 = 936, so the division is correct."}], "more": [{"id": "m6u10s2m01", "type": "num", "prompt": "96 ÷ 3?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 32, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s2m02", "type": "num", "prompt": "500 ÷ 5?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s2m03", "type": "num", "prompt": "144 ÷ 12?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s2m04", "type": "num", "prompt": "250 ÷ 10?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u10s2m05", "type":