{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 12, "stage": 13, "title": "Measure", "strandShort": "Geometry and measure", "blurb": "Measuring mass in grams and kilograms, capacity in millilitres and litres, and temperature in degrees Celsius, reading scales.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u12.pdf"}, "objectives": {"O1": {"code": "3Gm.04", "sec": "12.1", "codeNote": "", "t": "Estimate and measure mass in grams and kilograms, and read scales."}, "O2": {"code": "3Gm.05", "sec": "12.2", "codeNote": "", "t": "Estimate and measure capacity in millilitres and litres."}, "O3": {"code": "3Gm.06", "sec": "12.3", "codeNote": "", "t": "Read temperatures in degrees Celsius on a thermometer."}}, "sections": [{"id": "12.1", "title": "Mass", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Shopping bag", "p": ["A shopping bag holds a bag of rice, an apple and a bag of potatoes.", "Which is heaviest? Would you measure them in grams or kilograms? Think before you read on."]}, {"k": "recall", "t": "Heavier and lighter", "p": ["A brick is heavier than a feather."], "qq": {"id": "m3u12s1t01", "type": "mcq", "prompt": "Heavier: a book or a pencil?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a book", "ok": true, "fb": ""}, {"t": "a pencil", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Grams and kilograms", "p": ["**Mass** is how heavy something is. Light things are measured in **grams (g)**, heavy things in **kilograms (kg)**."], "table": {"head": ["Object", "About"], "rows": [["paper clip", "1 g"], ["apple", "150 g"], ["bag of rice", "1 kg"], ["bag of potatoes", "2 kg"]]}, "p2": ["**1000 g = 1 kg**. Half a kilogram is 500 g."]}, {"k": "idea", "t": "Reading scales", "p": ["Work out what each small mark is worth: if 0 to 100 g has 10 marks, each mark is **10 g**."], "fig": {"kind": "numline", "min": 0, "max": 10, "mark": 7}, "p2": ["On a scale labelled 0, 100, 200 … each whole step here is 100 g, so the arrow shows 700 g."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m3u12s1t02", "type": "num", "prompt": "Grams in 2 kg?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2000."}}, {"k": "method", "t": "How do I measure mass?", "p": ["Step 1: Choose grams for light things, kilograms for heavy things.", "Step 2: Work out what each mark on the scale is worth.", "Step 3: Read where the pointer is.", "Step 4: 1000 g = 1 kg."]}, {"k": "example", "t": "Unit", "p": [], "q": "A bag of flour.", "steps": [["heavy-ish", ""]], "a": "kilograms"}, {"k": "example", "t": "Convert", "p": [], "q": "3000 g in kg.", "steps": [["÷ 1000", ""]], "a": "3 kg"}, {"k": "example", "t": "Scale", "p": [], "q": "Marks go up in 50 g; the pointer is 3 marks after 200 g.", "steps": [["200 + 150", ""]], "a": "350 g"}, {"k": "example", "t": "Compare", "p": [], "q": "Heavier: 900 g or 1 kg?", "steps": [["1 kg = 1000 g", ""]], "a": "1 kg"}, {"k": "try", "t": "Unit", "p": [], "qq": {"id": "m3u12s1t03", "type": "mcq", "prompt": "A mouse is best measured in…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "g", "ok": true, "fb": ""}, {"t": "kg", "ok": false, "fb": ""}], "fixed": true}}, {"k": "error", "t": "Comparing different units", "p": ["Find the first wrong line."], "q": "Heavier: 800 g or 2 kg?", "lines": ["800 > 2, so 800 g is heavier"], "bad": 0, "why": "2 kg = 2000 g, which is heavier.", "fix": [["2 kg", ""]], "id": "m3u12s1t04"}, {"k": "mistake", "t": "Comparing numbers without units", "p": ["Change to the same unit first."]}, {"k": "tip", "t": "Real life", "p": ["Recipes, parcels at the post office and weighing babies use grams and kilograms."]}, {"k": "summary", "t": "What to remember", "p": ["g light, kg heavy.", "1000 g = 1 kg.", "Work out the scale step first."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "12.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u12s1k01", "type": "mcq", "prompt": "Before you read on: heaviest?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "bag of potatoes", "ok": true, "fb": ""}, {"t": "apple", "ok": false, "fb": ""}]}}, {"id": "12.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u12s1k02", "type": "num", "prompt": "Grams in 1 kg?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u12s1k03", "type": "num", "prompt": "3000 g in kg?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u12s1k04", "type": "mcq", "prompt": "Quick check: heavier?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2 kg", "ok": true, "fb": ""}, {"t": "