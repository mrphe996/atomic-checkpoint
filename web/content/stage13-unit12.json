: "num", "prompt": "1 kg 200 g in g?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1200, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1p02", "type": "num", "prompt": "How many 250 g packs make 1 kg?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1p03", "type": "num", "prompt": "A 2 kg bag; 700 g used. Left (g)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1300, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1p04", "type": "explain", "prompt": "Explain how to read a scale where 0 to 100 g has 5 marks.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "each mark 20", "kw": ["20"]}], "need": 1, "model": "100 ÷ 5 = 20, so each mark is 20 g.", "hint": "", "reason": "100 ÷ 5 = 20, so each mark is 20 g."}, {"id": "m3u12s1p05", "type": "mcq", "prompt": "Best estimate for a bag of sugar:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1 kg", "ok": true, "fb": ""}, {"t": "1 g", "ok": false, "fb": ""}, {"t": "100 kg", "ok": false, "fb": ""}]}, {"id": "m3u12s1p06", "type": "num", "prompt": "Marks every 10 g; pointer 6 marks after 300 g. Mass?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 360, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1p07", "type": "mcq", "prompt": "Order lightest first: 1 kg, 500 g, 1500 g", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "500 g, 1 kg, 1500 g", "ok": true, "fb": ""}, {"t": "1 kg, 500 g, 1500 g", "ok": false, "fb": ""}]}, {"id": "m3u12s1p08", "type": "num", "prompt": "3 apples of 150 g each (g)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 450, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m3u12s1a01", "type": "num", "prompt": "* Advanced. How many 200 g bars weigh 1 kg?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1a02", "type": "num", "prompt": "* Advanced. 2 kg − 350 g (in g)?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 1650, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1a03", "type": "explain", "prompt": "* Advanced. A cat weighs 4 kg; a kitten 900 g. How much heavier is the cat?", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "3100 g / 3 kg 100 g", "kw": ["3100|3 ?kg ?100"]}], "need": 1, "model": "4000 − 900 = 3100 g (3 kg 100 g).", "hint": "", "reason": "4000 − 900 = 3100 g (3 kg 100 g)."}], "more": [{"id": "m3u12s1m01", "type": "num", "prompt": "Grams in 1 kg?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1m02", "type": "num", "prompt": "2000 g in kg?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1m03", "type": "mcq", "prompt": "A car is measured in…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "g", "ok": false, "fb": ""}, {"t": "kg", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u12s1m04", "type": "mcq", "prompt": "A coin is measured in…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "g", "ok": true, "fb": ""}, {"t": "kg", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u12s1m05", "type": "num", "prompt": "100 g + 100 g?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 200, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u12s1m06", "type": "mcq", "prompt": "Mass tells us how…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "heavy", "ok": true, "fb": ""}, {"t": "long", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c3u12", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 12.1 notes · Mass", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "12.2", "title": "Capacity", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Filling a bath", "p": ["A cup holds a little water, a bucket holds a lot, and a bath holds even more.", "How do we measure how much a container holds? Think before you read on."]}, {"k": "recall", "t": "More and less", "p": ["A bucket holds more than a cup."], "qq": {"id": "m3u12s2t01", "type": "mcq", "prompt": "Holds more: a jug or a spoon?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a jug", "ok": true, "fb": ""}, {"t": "a spoon", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Millilitres and litres", "p": ["**Capacity** is how much a container can hold. Small amounts use **millilitres (ml)**, larger amounts **litres (l)**."], "table": {"head": ["Container", "About"], "rows": [["teaspoon", "5 ml"], ["cup", "250 ml"], ["juice carton", "1 l"], ["bucket", "10 l"]]}, "p2": ["**1000 ml = 1 l**. Half a litre is 500 ml."]}, {"k": "idea", "t": "Reading a measuring jug", "p": ["Find what each mark is worth, then read the level at the **top of the liquid**. A jug marked every 100 ml with water at the 3rd mark above 200 ml holds **500 ml**."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m3u12s2t02", "type": "num", "prompt": "ml in 3 l?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "3000."}}, {"k": "method", "t": "How do I measure capacity?", "p": ["Step 1: ml for small amounts, l for large.", "Step 2: Work out the step between marks.", "Step 3: Read at the level of the liquid.", "Step 4: 1000 ml = 1 l."]}, {"k": "example", "t": "Unit", "p": [], "q": "A swimming pool.", "steps": [["huge", ""]], "a": "litres"}, {"k": "example", "t": "Convert", "p": [], "q": "2500 ml.", "steps": [["2000 ml = 2 l", ""]], "a": "2 l 500 ml"}, {"k": "example", "t": "Cups", "p": [], "q": "How many 250 ml cups from 1 l?", "steps": [["1000 ÷ 250", ""]], "a": "4"}, {"k": "example", "t": "Compare", "p": [], "q": "More: 1 l or 750 ml?", "steps": [["1 l = 1000 ml", ""]], "a": "1 l"}, {"k": "try", "t": "Cups", "p": [], "qq": {"id": "m3u12s2t03", "type": "num", "prompt": "How many 500 ml bottles in 2 l?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "error", "t": "Reading from the wrong place", "p": ["Find the first wrong line."], "q": "Water reaches the 300 ml mark on a jug.", "lines": ["The jug holds 1000 ml, so there are 1000 ml of water."], "bad": 0, "why": "Read the level of the water: 300 ml.", "fix": [["300 ml", ""]], "id": "m3u12s2t04"}, {"k": "mistake", "t": "Confusing how much a jug holds with how much is in it", "p": ["Read the level of the liquid."]}, {"k": "tip", "t": "Real life", "p": ["Drinks, medicine spoons, fuel and recipes all use ml and l."]}, {"k": "summary", "t": "What to remember", "p": ["ml small, l large.", "1000 ml = 1 l.", "Read at the liquid level."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "12.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u12s2k01", "type": "mcq", "prompt": "Before you read on: holds most?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a bath", "ok": true, "fb": ""}, {"t": "a cup", "ok": false, "fb