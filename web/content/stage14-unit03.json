{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 3, "stage": 14, "title": "Addition and Subtraction of Whole Numbers", "strandShort": "Number", "blurb": "Using a symbol for a missing number or operation, adding and subtracting numbers with up to 3 digits, and rules about odd and even numbers.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u03.pdf"}, "objectives": {"O1": {"code": "4Ae.01", "sec": "3.1", "codeNote": "", "t": "Use a symbol to represent a missing number or operation in a number sentence."}, "O2": {"code": "4Nc.01", "sec": "3.2", "codeNote": "", "t": "Estimate, add and subtract whole numbers with up to three digits."}, "O3": {"code": "4Nc.02", "sec": "3.3", "codeNote": "", "t": "Use the properties of odd and even numbers to generalise about sums and differences."}}, "sections": [{"id": "3.1", "title": "Using a symbol to represent a missing number or operation", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Mystery box", "p": ["Leo puts some marbles in a box. He already has **18** marbles outside, and altogether there are **45**.", "How many are in the box? How could you write this as a number sentence? Try it before you read on."]}, {"k": "recall", "t": "Addition facts", "p": ["18 + 27 = 45."], "qq": {"id": "m4u03s1t01", "type": "num", "prompt": "45 − 18?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 27, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "27."}}, {"k": "idea", "t": "Symbols for missing numbers", "p": ["We can use a **symbol** such as ☐ or ★ for a number we do not know: **18 + ☐ = 45**.", "Addition and subtraction are **inverse** operations: to find ☐, work out 45 − 18 = **27**."]}, {"k": "idea", "t": "Missing operations", "p": ["A symbol can stand for a missing **operation**: 12 ○ 5 = 7. Which sign makes it true? 12 − 5 = 7, so ○ is **−**."], "table": {"head": ["Number sentence", "Use the inverse", "Answer"], "rows": [["☐ + 15 = 40", "40 − 15", "25"], ["☐ − 9 = 31", "31 + 9", "40"], ["60 − ☐ = 22", "60 − 22", "38"], ["8 ○ 6 = 14", "8 + 6 = 14", "+"]]}}, {"k": "try", "t": "Missing number", "p": [], "qq": {"id": "m4u03s1t02", "type": "num", "prompt": "☐ + 23 = 50", "diff": "M", "obj": "O1", "skill": "Application", "answer": 27, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "50 − 23.", "reason": "27."}}, {"k": "method", "t": "How do I find a missing number?", "p": ["Step 1: Read the number sentence.", "Step 2: Use the inverse: + ↔ −.", "Step 3: Calculate.", "Step 4: Put your answer back in to check."]}, {"k": "example", "t": "Addition", "p": [], "q": "34 + ★ = 70.", "steps": [["70 − 34", ""]], "a": "36"}, {"k": "example", "t": "Subtraction (missing first number)", "p": [], "q": "☐ − 16 = 25.", "steps": [["25 + 16", ""]], "a": "41"}, {"k": "example", "t": "Subtraction (missing second number)", "p": [], "q": "90 − ☐ = 55.", "steps": [["90 − 55", ""]], "a": "35"}, {"k": "example", "t": "Missing sign", "p": [], "q": "100 ○ 37 = 63.", "steps": [["100 − 37 = 63", ""]], "a": "−"}, {"k": "try", "t": "Sign", "p": [], "qq": {"id": "m4u03s1t03", "type": "mcq", "prompt": "25 ○ 25 = 50. ○ is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "+", "ok": true, "fb": ""}, {"t": "−", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Using the wrong inverse", "p": ["Find the first wrong line."], "q": "☐ − 16 = 25", "lines": ["☐ = 25 − 16 = 9"], "bad": 0, "why": "Undo − 16 by adding: 25 + 16 = 41. Check: 41 − 16 = 25 ✓.", "fix": [["41", ""]], "id": "m4u03s1t04"}, {"k": "mistake", "t": "Not checking the answer", "p": ["Put it back into the number sentence."]}, {"k": "tip", "t": "Real life", "p": ["Working out change, scores still needed and missing pieces in a set all use missing-number sentences."]}, {"k": "summary", "t": "What to remember", "p": ["A symbol can stand for a missing number or sign.", "Inverse: + undoes −, − undoes +.", "Always check by substituting."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "3.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u03s1k01", "type": "num", "prompt": "Before you read on: marbles in the box?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 27, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u03s1k02", "type": "num", "prompt": "☐ + 15 = 40", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u03s1k03", "type": "num", "prompt": "☐ − 16 = 25", "diff": "M", "obj": "O1", "skill": "Application", "answer": 41, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u03s1k04", "type": "num", "prompt": "Quick 