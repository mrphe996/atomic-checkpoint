], "adv": [{"id": "m4u03s1a01", "type": "num", "prompt": "* Advanced. ☐ + 20 = 60 − ☐ (both ☐ the same)", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Try numbers: 20 + 20 = 40 and 60 − 20 = 40.", "reason": ""}, {"id": "m4u03s1a02", "type": "explain", "prompt": "* Advanced. Write a story for ☐ − 45 = 30.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "story with 75 / take away", "kw": ["75|spent|gave|lost|left|ate|sold"]}], "need": 1, "model": "e.g. I had some stickers, gave away 45 and had 30 left – I had 75.", "hint": "", "reason": "e.g. I had some stickers, gave away 45 and had 30 left – I had 75."}, {"id": "m4u03s1a03", "type": "num", "prompt": "* Advanced. ★ + ★ + 14 = 50. ★?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m4u03s1m01", "type": "num", "prompt": "☐ + 5 = 12", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u03s1m02", "type": "num", "prompt": "20 − ☐ = 13", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u03s1m03", "type": "num", "prompt": "☐ − 4 = 10", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u03s1m04", "type": "num", "prompt": "30 + ☐ = 50", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u03s1m05", "type": "mcq", "prompt": "9 ○ 3 = 6. ○?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−", "ok": true, "fb": ""}, {"t": "+", "ok": false, "fb": ""}]}, {"id": "m4u03s1m06", "type": "num", "prompt": "☐ + 50 = 100", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u03", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 3.1 notes · Using a symbol to represent a missing number or operation", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "3.2", "title": "Addition and subtraction of whole numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Library books", "p": ["A library has **486** picture books and **357** story books. **129** books are out on loan today.", "How many books does the library own? How many are on the shelves? Estimate first."]}, {"k": "recall", "t": "Rounding", "p": ["486 ≈ 500."], "qq": {"id": "m4u03s2t01", "type": "num", "prompt": "357 to the nearest hundred?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 400, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "400."}}, {"k": "idea", "t": "Estimate, then add", "p": ["Estimate: 500 + 400 = 900. Then use **columns**, lining up hundreds, tens and ones and carrying when a column makes 10 or more."], "table": {"head": ["", "H", "T", "O"], "rows": [["", "4", "8", "6"], ["+", "3", "5", "7"], ["", "8", "4", "3"]]}, "p2": ["6 + 7 = 13 (write 3, carry 1); 8 + 5 + 1 = 14 (write 4, carry 1); 4 + 3 + 1 = 8. Total **843** – close to 900 ✓."]}, {"k": "idea", "t": "Subtracting", "p": ["843 − 129: estimate 800 − 100 = 700. Ones: 3 − 9 can't – **exchange** a ten: 13 − 9 = 4; tens 3 − 2 = 1; hundreds 8 − 1 = 7 → **714** on the shelves.", "Check by adding: 714 + 129 = 843 ✓."]}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m4u03s2t02", "type": "num", "prompt": "268 + 145?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 413, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "413."}}, {"k": "method", "t": "How do I add and subtract 3-digit numbers?", "p": ["Step 1: Estimate by rounding.", "Step 2: Line up the digits in columns.", "Step 3: Add (carry) or subtract (exchange) from the ones.", "Step 4: Check with the estimate or the inverse."]}, {"k": "example", "t": "Add", "p": [], "q": "375 + 248.", "steps": [["5 + 8 = 13 (carry 1)", ""], ["7 + 4 + 1 = 12 (carry 1)", ""], ["3 + 2 + 1 = 6", ""]], "a": "623"}, {"k": "example", "t": "Subtract", "p": [], "q": "652 − 317.", "steps": [["12 − 7 = 5 (exchange)", ""], ["4 − 1 = 3", ""], ["6 − 3 = 3", ""]], "a": "335"}, {"k": "example", "t": "Across zero", "p": [], "q": "500 − 163.", "steps": [["exchange: 4 hundreds, 9 tens, 10 ones", ""], ["10 − 3 = 7, 9 − 6 = 3, 4 − 1 = 3", ""]], "a": "337"}, {"k": "example", "t": "Mental", "p": [], "q": "399 + 245.", "steps": [["400 + 245 = 645", ""], ["− 1", ""]], "a": "644"}, {"k": "try", "t": "Subtract", "p": [], "qq": {"id": "m4u03s2t03", "type": "num", "prompt": "730 − 285?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 445, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "445."}}, {"k": "error", "t": "Subtracting the smaller digit from the bigger", "p": ["Find the first wrong line."], "q": "652 − 317", "lines": ["ones: 7 − 2 = 5", "345"], "bad": 0, "why": "You can't swap: exchange a ten, 12 − 7 = 5, tens 4 − 1 = 3 → 335.", "fix": [["335", ""]], "id": "m4u03s2t04"}, {"k": "mistake", "t": "Taking the smaller digit from the bigger one", "p": ["Top minus bottom – exchange when you need to."]}, {"k": "tip", "t": "Real life", "p": ["Shop stock counts, money in a savings jar and distances on a trip all need adding and subtracting."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate first.", "Line up place values.", "Carry when adding; exchange when subtracting.", "Check with the inverse."]}], "video": {"src