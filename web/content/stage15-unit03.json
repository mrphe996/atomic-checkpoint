"reason": ""}, {"id": "m5u03s1p07", "type": "num", "prompt": "Rule 'add 6', 5th term 30. First term?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1p08", "type": "mcq", "prompt": "Which is linear?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "7, 11, 15, 19", "ok": true, "fb": ""}, {"t": "1, 4, 9, 16", "ok": false, "fb": ""}]}], "adv": [{"id": "m5u03s1a01", "type": "num", "prompt": "* Advanced. Rule 'add 0.4'. How many steps from 1.2 to 5.2?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1a02", "type": "num", "prompt": "* Advanced. 3rd term 11, 6th term 20 (linear). First term?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Step 3.", "reason": ""}, {"id": "m5u03s1a03", "type": "explain", "prompt": "* Advanced. Will 50 be in the sequence 3, 7, 11, 15, …? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|not"]}, {"pt": "47, 51", "kw": ["47|51|4"]}], "need": 2, "model": "No – the terms go …, 43, 47, 51, so 50 is skipped.", "hint": "", "reason": "No – the terms go …, 43, 47, 51, so 50 is skipped."}], "more": [{"id": "m5u03s1m01", "type": "num", "prompt": "Next: 2, 4, 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1m02", "type": "num", "prompt": "Next: 0.1, 0.2, 0.3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1m03", "type": "num", "prompt": "Next: 10, 8, 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1m04", "type": "num", "prompt": "Next: −2, −1, 0?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1m05", "type": "num", "prompt": "Next: 1.5, 3, 4.5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u03s1m06", "type": "num", "prompt": "Missing: 2, ?, 6, 8", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u03", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 3.1 notes · Counting and sequences", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "3.2", "title": "Square and triangular numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Bowling pins", "p": ["Ten-pin bowling pins stand in a triangle: 1 in the front row, then 2, then 3, then 4. That's 1, 3, 6, 10 pins in total.", "How many pins would 5 rows need? Are there other numbers that make neat shapes? Try it before you read on."]}, {"k": "recall", "t": "Times tables", "p": ["6 × 6 = 36; 7 × 7 = 49."], "qq": {"id": "m5u03s2t01", "type": "num", "prompt": "4 × 4 = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "16."}}, {"k": "idea", "t": "Square numbers", "p": ["A **square number** makes a square pattern of dots: 1, 4, 9, 16, 25, 36, 49, 64, 81, 100. It is a number multiplied by itself."], "fig": {"kind": "cells", "cells": [[0, 0], [2, 0], [2, 1], [3, 0], [3, 1], [5, 0], [5, 1], [5, 2], [6, 0], [6, 1], [6, 2], [7, 0], [7, 1], [7, 2], [9, 0], [9, 1], [9, 2], [9, 3], [10, 0], [10, 1], [10, 2], [10, 3], [11, 0], [11, 1], [11, 2], [11, 3], [12, 0], [12, 1], [12, 2], [12, 3]], "cols": 13, "rows": 4}}, {"k": "idea", "t": "Triangular numbers", "p": ["A **triangular number** makes a triangle pattern: add 1, then 2, then 3 …"], "table": {"head": ["Rows", "1", "2", "3", "4", "5", "6"], "rows": [["Triangular number", "1", "3", "6", "10", "15", "21"]]}, "p2": ["5 rows of pins: 10 + 5 = **15**. Fun fact: two neighbouring triangular numbers add to a square number (6 + 10 = 16)."]}, {"k": "try", "t": "Triangular", "p": [], "qq": {"id": "m5u03s2t02", "type": "num", "prompt": "The 7th triangular number?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 28, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "21 + 7.", "reason": "28."}}, {"k": "method", "t": "How do I find square and triangular numbers?", "p": ["Step 1: Square: multiply the number by itself.", "Step 2: Triangular: add the next counting number each time (1, +2, +3, …).", "Step 3: Draw dot patterns to check.", "Step 4: Learn the first ten of each."]}, {"k": "example", "t": "Square", "p": [], "q": "The 9th square number.", "steps": [["9 × 9 = 81", ""]], "a": "81"}, {"k": "example", "t": "Is it square?", "p": [], "q": "Is 50 a square number?", "steps": [["7 × 7 = 49, 8 × 8 = 64", ""]], "a": "no"}, {"k": "example", "t": "Both", "p": [], "q": "Which number below 40 is both square and triangular (other than 1)?", "steps": [["triangular: 3, 6, 10, 15, 21, 28, 36", ""], ["36 = 6 × 6", ""]], "a": "36"}, {"k": "example", "t": "Sum", "p": [], "q": "6 + 10 = ?", "steps": [["16, a square number", ""]], "a": "16"}, {"k": "try", "t": "Square", "p": [], "qq": {"id": "m5u03s2t03", "type": "num", "prompt": "The 5th square number?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25."}}, {"k": "error", 