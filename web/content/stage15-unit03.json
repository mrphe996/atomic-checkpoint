{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 3, "stage": 15, "title": "Numbers and Sequences", "strandShort": "Number", "blurb": "Counting on and back in steps, including through zero, linear sequences, square and triangular numbers, and prime and composite numbers.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u03.pdf"}, "objectives": {"O1": {"code": "5Ns.01", "sec": "3.1", "codeNote": "", "t": "Count on and back in steps of constant size, including through zero, and continue linear sequences."}, "O2": {"code": "5Ns.02", "sec": "3.2", "codeNote": "", "t": "Recognise and use square numbers and triangular numbers."}, "O3": {"code": "5Ns.03", "sec": "3.3", "codeNote": "", "t": "Recognise prime and composite numbers and find factors of numbers up to 100."}}, "sections": [{"id": "3.1", "title": "Counting and sequences", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Saving up", "p": ["Leo has **$3.50** in his money box and adds **$0.75** every week.", "How much will he have after 4 weeks? Can you count on without adding one week at a time? Try it before you read on."]}, {"k": "recall", "t": "Counting in steps", "p": ["Count on in 25s from 0: 25, 50, 75, 100."], "qq": {"id": "m5u03s1t01", "type": "num", "prompt": "Count on in 0.5s: 1, 1.5, 2, … next?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2.5."}}, {"k": "idea", "t": "Counting on and back", "p": ["You can count in any step size: whole numbers, fractions or decimals – forwards or backwards."], "table": {"head": ["Start", "Step", "Sequence"], "rows": [["3.5", "+ 0.75", "3.5, 4.25, 5, 5.75, 6.5"], ["10", "− 1.5", "10, 8.5, 7, 5.5, 4"], ["0", "+ ¼", "0, ¼, ½, ¾, 1"]]}, "p2": ["After 4 weeks Leo has **$6.50**."]}, {"k": "idea", "t": "Term-to-term rules", "p": ["A **linear sequence** goes up or down by the **same amount** each time. The **term-to-term rule** says what that amount is: 'add 0.75'.", "Negative numbers can appear: 5, 2, −1, −4 … (rule: subtract 3).", "To find a missing term, use the rule forwards or backwards."]}, {"k": "try", "t": "Rule", "p": [], "qq": {"id": "m5u03s1t02", "type": "mcq", "prompt": "Rule for 4, 7, 10, 13?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "add 3", "ok": true, "fb": ""}, {"t": "add 4", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I work with a linear sequence?", "p": ["Step 1: Find the difference between neighbouring terms.", "Step 2: Check it is the same each time (linear).", "Step 3: Write the term-to-term rule.", "Step 4: Use it to find the next or missing terms."]}, {"k": "example", "t": "Decimals", "p": [], "q": "Next two terms: 2.4, 2.8, 3.2, …", "steps": [["rule: add 0.4", ""], ["3.6, 4.0", ""]], "a": "3.6, 4"}, {"k": "example", "t": "Backwards", "p": [], "q": "Next two terms: 6, 3.5, 1, …", "steps": [["rule: subtract 2.5", ""], ["−1.5, −4", ""]], "a": "−1.5, −4"}, {"k": "example", "t": "Missing term", "p": [], "q": "12, ?, 20, 24", "steps": [["rule: add 4", ""], ["16", ""]], "a": "16"}, {"k": "example", "t": "Fractions", "p": [], "q": "Next: ½, 1, 1½, …", "steps": [["add ½", ""]], "a": "2"}, {"k": "try", "t": "Next", "p": [], "qq": {"id": "m5u03s1t03", "type": "num", "prompt": "Next term: 9, 7.5, 6, …?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Subtract 1.5.", "reason": "4.5."}}, {"k": "error", "t": "Wrong step", "p": ["Find the first wrong line."], "q": "Continue 1.2, 1.4, 1.6.", "lines": ["next is 1.7"], "bad": 0, "why": "The step is 0.2: next is 1.8.", "fix": [["1.8", ""]], "id": "m5u03s1t04"}, {"k": "mistake", "t": "Using the wrong step size", "p": ["Work out the difference carefully."]}, {"k": "tip", "t": "Real life", "p": ["Savings, fitness plans ('run 0.5 km more each week') and timetables form sequences."]}, {"k": "summary", "t": "What to remember", "p": ["Count in any step: wholes, fractions, decimals.", "Linear: same step each time.", "Term-to-term rule: e.g. 'add 0.75'.", "Use the rule forwards or backwards."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "3.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u03s1k01", "type": "num", "prompt": "Before you read on: money after 4 weeks ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u03s1k02", "type": "num", "prompt": "10, 8.5, 7, … next?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u03s1k03", "type": "mcq", "prompt": "5, 2, −1, −4 rule?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "subtract 3", "ok": true, "fb": ""}, {"t": "add 3", "ok"