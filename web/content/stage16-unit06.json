: "M", "obj": "O1", "skill": "Application", "answer": 2000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1p08", "type": "mcq", "prompt": "Bigger: ⅗ of 50 or ¾ of 40?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "they are equal (30)", "ok": true, "fb": ""}, {"t": "⅗ of 50", "ok": false, "fb": ""}]}], "adv": [{"id": "m6u06s1a01", "type": "num", "prompt": "* Advanced. ¾ of a class are girls; 6 are boys. Class size?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1a02", "type": "num", "prompt": "* Advanced. ⅓ of ¾ of 48?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1a03", "type": "explain", "prompt": "* Advanced. Is ⅗ of 40 the same as 40 × 3 ÷ 5? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "yes", "kw": ["\\byes\\b|same"]}, {"pt": "both 24", "kw": ["24"]}], "need": 2, "model": "Yes – both give 24; you can multiply first or divide first.", "hint": "", "reason": "Yes – both give 24; you can multiply first or divide first."}], "more": [{"id": "m6u06s1m01", "type": "num", "prompt": "½ of 18?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1m02", "type": "num", "prompt": "⅓ of 21?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1m03", "type": "num", "prompt": "⅔ of 21?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1m04", "type": "num", "prompt": "1 ÷ 3? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.3333333333333333, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1m05", "type": "num", "prompt": "¾ of 100?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 75, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u06s1m06", "type": "mcq", "prompt": "5 ÷ 2?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2½", "ok": true, "fb": ""}, {"t": "2/5", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c6u06", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 6.1 notes · Understanding fractions", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "6.2", "title": "Percentages", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Sale!", "p": ["A shop has a sign: **'30% off everything'**. A pair of trainers costs **$60**.", "How much do you save? How much do you pay? Try it before you read on."]}, {"k": "recall", "t": "Per cent", "p": ["Per cent means 'out of 100': 25% = 25/100 = ¼."], "qq": {"id": "m6u06s2t01", "type": "num", "prompt": "What is 50% of 80?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "40."}}, {"k": "idea", "t": "Finding percentages of amounts", "p": ["Use **10%** as a building block: 10% = ÷ 10."], "table": {"head": ["%", "How", "Of $60"], "rows": [["10%", "÷ 10", "$6"], ["30%", "3 × 10%", "$18"], ["5%", "half of 10%", "$3"], ["1%", "÷ 100", "$0.60"], ["25%", "÷ 4", "$15"]]}, "p2": ["Saving 30% = **$18**, so you pay 60 − 18 = **$42**."]}, {"k": "idea", "t": "Percentages of shapes", "p": ["A 10 × 10 grid has 100 squares, so each square is 1%. On a grid of 20 squares, each square is 5%."], "fig": {"kind": "waffle", "n": 30}, "p2": ["The grid shows 30% shaded."]}, {"k": "try", "t": "Building blocks", "p": [], "qq": {"id": "m6u06s2t02", "type": "num", "prompt": "Find 15% of 40.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "10% + 5% = 4 + 2.", "reason": "6."}}, {"k": "method", "t": "How do I find a percentage of an amount?", "p": ["Step 1: Find 10% (÷ 10) and/or 1% (÷ 100).", "Step 2: Build the percentage you need from these (e.g. 35% = 3 × 10% + 5%).", "Step 3: Use 50% = ½, 25% = ¼ as shortcuts.", "Step 4: Check: is the answer sensible?"]}, {"k": "example", "t": "Build up", "p": [], "q": "Find 35% of 80.", "steps": [["10% = 8", ""], ["30% = 24, 5% = 4", ""], ["35% = 28", ""]], "a": "28"}, {"k": "example", "t": "75%", "p": [], "q": "Find 75% of 48.", "steps": [["¾ of 48", ""], ["48 ÷ 4 × 3 = 36", ""]], "a": "36"}, {"k": "example", "t": "Shape", "p": [], "q": "A grid of 20 squares has 7 shaded. What percentage?", "steps": [["each square = 5%", ""], ["7 × 5 = 35", ""]], "a": "35%"}, {"k": "example", "t": "1%", "p": [], "q": "Find 4% of 250.", "steps": [["1% = 2.5", ""], ["4% = 10", ""]], "a": "10"}, {"k": "try", "t": "Sale", "p": [], "qq": {"id": "m6u06s2t03", "type": "num", "prompt": "A $50 game has 20% off. New price ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "40."}}, {"k": "error", "t": "Divided by the percentage", "p": ["Find the first wrong line."], "q": "Find 20% of 60.", "lines": ["60 ÷ 20 = 3"], "bad": 0, "why": "20% = 2 × 10%: 10% of 60 = 6, so 20% = 12.", "fix": [["10% = 6", ""], ["20% = 12", ""]], "id": "m6u06s2t04"}, {"k": "mistake", "t": "Dividing by the percentage number", "p": ["Use 10% (÷ 10) and build up."]}, {"k": "tip", "t": "Real life", "p": ["Sales, tips, phone battery levels and test scores are