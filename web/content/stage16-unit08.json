{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 8, "stage": 16, "title": "Addition and Subtraction (2)", "strandShort": "Number", "blurb": "Adding and subtracting decimals with up to two decimal places, and adding and subtracting fractions with different denominators.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u08.pdf"}, "objectives": {"O1": {"code": "6Nc.01", "sec": "8.1", "codeNote": "", "t": "Estimate, add and subtract numbers with the same or different number of decimal places."}, "O2": {"code": "6Nf.04", "sec": "8.2", "codeNote": "", "t": "Add and subtract fractions with different denominators, including mixed numbers."}}, "sections": [{"id": "8.1", "title": "Adding and subtracting decimal numbers", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Long jump", "p": ["In a long-jump contest Zara jumps **3.465 m** and Kim jumps **3.58 m**.", "Who jumped further, and by how much? Try it before you read on."]}, {"k": "recall", "t": "Column addition", "p": ["Line up place values: 245 + 38 = 283."], "qq": {"id": "m6u08s1t01", "type": "num", "prompt": "Work out 4.6 + 2.7.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7.3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7.3."}}, {"k": "idea", "t": "Line up the decimal points", "p": ["Write the numbers in columns with the **decimal points in line**. Fill empty places with **zeros**."], "table": {"head": ["", "Ones", ".", "Tenths", "Hundredths", "Thousandths"], "rows": [["Kim", "3", ".", "5", "8", "0"], ["Zara", "3", ".", "4", "6", "5"], ["Difference", "0", ".", "1", "1", "5"]]}, "p2": ["Kim jumped **0.115 m** further (11.5 cm)."]}, {"k": "idea", "t": "Composing, decomposing and regrouping", "p": ["Split numbers into parts to calculate mentally: 6.35 + 2.8 = 6.35 + 2 + 0.8 = 8.35 + 0.8 = **9.15**.", "Regroup when needed: 5 − 1.37 → 5.00 − 1.37 = **3.63** (exchange 1 one for 10 tenths, then 1 tenth for 10 hundredths).", "Estimate first: 3.58 − 3.465 ≈ 3.6 − 3.5 = 0.1 ✓."]}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m6u08s1t02", "type": "num", "prompt": "Work out 2.45 + 1.375.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3.825, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Line up: 2.450 + 1.375.", "reason": "3.825."}}, {"k": "method", "t": "How do I add and subtract decimals?", "p": ["Step 1: Estimate first.", "Step 2: Line up the decimal points; fill gaps with zeros.", "Step 3: Add or subtract column by column from the right, carrying or exchanging.", "Step 4: Put the decimal point in the answer, then check with the estimate."]}, {"k": "example", "t": "Add", "p": [], "q": "Work out 12.7 + 0.486.", "steps": [["12.700 + 0.486", ""], ["13.186", ""]], "a": "13.186"}, {"k": "example", "t": "Subtract from a whole", "p": [], "q": "Work out 8 − 2.65.", "steps": [["8.00 − 2.65", ""], ["5.35", ""]], "a": "5.35"}, {"k": "example", "t": "Money", "p": [], "q": "You buy items costing $4.85 and $7.40, paying with $20. Change?", "steps": [["4.85 + 7.40 = 12.25", ""], ["20 − 12.25 = 7.75", ""]], "a": "$7.75"}, {"k": "example", "t": "Missing number", "p": [], "q": "3.6 + ? = 5.04", "steps": [["5.04 − 3.60 = 1.44", ""]], "a": "1.44"}, {"k": "try", "t": "Subtract", "p": [], "qq": {"id": "m6u08s1t03", "type": "num", "prompt": "Work out 6 − 1.08.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4.92, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4.92."}}, {"k": "error", "t": "Decimal points not lined up", "p": ["Find the first wrong line."], "q": "Work out 4.5 + 2.36.", "lines": ["digits lined up on the right: 45 + 236 = 281, so 2.81"], "bad": 0, "why": "Line up the DECIMAL POINTS: 4.50 + 2.36 = 6.86.", "fix": [["4.50 + 2.36 = 6.86", ""]], "id": "m6u08s1t04"}, {"k": "mistake", "t": "Lining up digits on the right", "p": ["Line up the decimal points, not the last digits."]}, {"k": "tip", "t": "Real life", "p": ["Shopping totals, race times and measurements all need careful decimal addition and subtraction."]}, {"k": "summary", "t": "What to remember", "p": ["Decimal points in line.", "Fill gaps with zeros.", "Regroup across the decimal point when needed.", "Estimate to check."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "8.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u08s1k01", "type": "num", "prompt": "Before you read on: how much further did Kim jump (m)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.115, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "8.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u08s1k02", "type": "num", "prompt": "6.35 + 2.8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9.15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "8.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u08s1k03", "type": "num", "prompt": "5 − 1.37?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3.63, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hin