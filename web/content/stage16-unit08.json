: {"head": ["Calculation", "Common denominator", "Answer"], "rows": [["½ + ⅓", "6", "3/6 + 2/6 = 5/6"], ["¾ − ⅖", "20", "15/20 − 8/20 = 7/20"], ["⅚ − ¼", "12", "10/12 − 3/12 = 7/12"]]}}, {"k": "idea", "t": "Mixed numbers", "p": ["Add the whole numbers, then the fractions: 2½ + 1⅓ = 3 + (3/6 + 2/6) = **3⅚**.", "If the fraction part is more than 1, regroup: 1¾ + 2½ = 3 + 5/4 = **4¼**.", "Simplify answers where possible."]}, {"k": "try", "t": "Add", "p": [], "qq": {"id": "m6u08s2t02", "type": "num", "prompt": "Work out ½ + ⅖. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.9, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "Common denominator 10.", "reason": "9/10."}}, {"k": "method", "t": "How do I add or subtract fractions?", "p": ["Step 1: Find a common multiple of the denominators.", "Step 2: Change each fraction to an equivalent fraction with that denominator.", "Step 3: Add or subtract the numerators (denominators stay the same).", "Step 4: Simplify; for mixed numbers deal with wholes and fractions."]}, {"k": "example", "t": "Subtract", "p": [], "q": "⅞ − ⅓.", "steps": [["common denominator 24", ""], ["21/24 − 8/24 = 13/24", ""]], "a": "13/24"}, {"k": "example", "t": "Answer more than 1", "p": [], "q": "⅗ + ½.", "steps": [["6/10 + 5/10 = 11/10", ""], ["= 1 1/10", ""]], "a": "1 1/10"}, {"k": "example", "t": "Mixed numbers", "p": [], "q": "3¾ − 1⅓.", "steps": [["3 − 1 = 2", ""], ["¾ − ⅓ = 9/12 − 4/12 = 5/12", ""]], "a": "2 5/12"}, {"k": "example", "t": "Simplify", "p": [], "q": "⅙ + ½.", "steps": [["1/6 + 3/6 = 4/6", ""], ["= 2/3", ""]], "a": "2/3"}, {"k": "try", "t": "Subtract", "p": [], "qq": {"id": "m6u08s2t03", "type": "num", "prompt": "Work out ¾ − ⅙. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5833333333333334, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", 