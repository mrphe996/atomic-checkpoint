{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 8, "stage": 16, "title": "Addition and Subtraction (2)", "strandShort": "Number", "blurb": "Adding and subtracting decimals with up to two decimal places, and adding and subtracting fractions with different denominators.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u08.pdf"}, "objectives": {"O1": {"code": "6Nc.01", "sec": "8.1", "codeNote": "", "t": "Estimate, add and subtract numbers with the same or different number of decimal places."}, "O2": {"code": "6Nf.04", "sec": "8.2", "codeNote": "", "t": "Add and subtract fractions with different denominators, including mixed numbers."}}, "sections": [{"id": "8.1", "title": "Adding and subtracting decimal numbers", "objs": ["O1"], "lesson": [{"k": "idea", "t": "How do I add and subtract decimals?", "p": ["Use the **column method** and **line up the decimal points** so tenths are under tenths and hundredths under hundredths.", "If the numbers have different numbers of decimal places, fill the gaps with **zeros**: 5.3 + 2.48 → 5.30 + 2.48.", "Then add or subtract as with whole numbers, carrying or exchanging when needed, and put the decimal point in the answer directly below the others."]}, {"k": "idea", "t": "Why should I estimate first?", "p": ["An **estimate** is a rough answer. Round each number to the nearest whole number (or ten) and calculate.", "For 18.7 + 6.42 the estimate is 19 + 6 = 25. If your exact answer is 82.5 you know something has gone wrong."]}, {"k": "method", "t": "How do I use the column method with decimals?", "p": ["Step 1: Estimate the answer.", "Step 2: Write the numbers in columns with the decimal points in a line.", "Step 3: Fill empty places with 0 so every number has the same number of decimal places.", "Step 4: Add or subtract from the right, carrying or exchanging.", "Step 5: Put the decimal point in the answer and compare with your estimate."]}, {"k": "example", "t": "Adding", "p": [], "q": "Work out 18.7 + 6.42.", "steps": [["Estimate 19 + 6 = 25", ""], ["18.70 + 6.42", "fill with 0"], ["0 + 2 = 2; 7 + 4 = 11 → 1 carry 1; 8 + 6 + 1 = 15 → 5 carry 1; 1 + 1 = 2", ""], ["25.12", "close to 25 ✓"]], "a": "25.12"}, {"k": "example", "t": "Exam-style: change", "p": [], "q": "Ana pays with $20 for items costing $7.85 and $4.60. How much change does she get?", "steps": [["Total: 7.85 + 4.60 = 12.45", ""], ["Change: 20.00 − 12.45 = 7.55", "write 20 as 20.00 and exchange"]], "a": "$7.55"}, {"k": "mistake", "t": "Lining up the digits instead of the points", "p": ["5.3 + 2.48 is not 7.51. Line up the **decimal points**: 5.30 + 2.48 = 7.78."]}, {"k": "tip", "t": "Show your estimate", "p": ["Write the estimate next to the sum. It earns credit for checking and catches place value slips."]}], "video": {"src": null, "offset": 0, "dur": 300, "range": ""}, "stops": [{"id": "8.1-k1", "t": 1, "after": 1, "review": [0, 0], "note": "", "q": {"id": "m6u08s1k01", "type": "num", "prompt": "Work out 4.6 + 2.35.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6.95, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}}, {"id": "8.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u08s1k02", "type": "mcq", "prompt": "Before you read on: what is 3.5 + 1.25?", "diff": "M", "obj": "O1", "skill": "Reasoning", "options": [{"t": "4.75", "ok": true, "fb": "Correct."}, {"t": "4.30", "ok": false, "fb": "Line up the decimal points: 3.50 + 1.25."}, {"t": "1.60", "ok": false, "fb": "Line up the points, not the last digits."}]}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u08s1r01", "type": "num", "prompt": "Sara buys one of each item in the price list. How much does she spend altogether?", "diff": "M", "obj": "O1", "skill": "Data", "answer": 17.84, "unit": "$", "units": ["$", "dollars"], "tol": 0, "errs": [], "data": {"head": ["Item", "pen", "ruler", "notebook"], "rows": [["Price ($)", "3.12", "6.23", "8.49"]]}}, {"id": "m6u08s1r02", "type": "table", "prompt": "Complete the table.", "diff": "M", "obj": "O1", "skill": "Data", "head": ["", "Answer"], "rows": [["3.68 + 3.28", {"ans": 6.96}], ["3.68 − 3.28", {"ans": 0.4}]]}, {"id": "m6u08s1r03", "type": "num", "prompt": "Work out 30.3 + 6.73.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 37.03, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m6u08s1r04", "type": "num", "prompt": "Work out 16.4 − 1.57.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14.83, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m6u08s1r05", "type": "num", "prompt": "Work out 25 − 3.16.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 21.84, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m6u08s1r06", "type": "mcq", "prompt": "Which is the best estimate for 48.7 + 40.58?", "diff": "M", "obj": "O1", "skill": "Reasoning", "options": [{"t": "90", "ok": true, "fb": "Correct."}, {"t": "80", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "100", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "900", "ok": false, "fb": "Not quite – work through the method again."}]}, {"id": "m6u08s1r07", "type": "mcq", "prompt": "Sam writes 3.6 + 1.25 = 1.61. What is the right answer?", "diff": "H", "obj": "O1", "skill": "Reasoning", "reason": "3.60 + 1.25 = 4.85.", "options": [{"t": "5.85", "ok": false, "fb": "Check by estimating."}, {"t": "1.61", "ok": false, "fb": "He lined up the last digits instead of the decimal points."}, {"t": "4.85", "ok": true, "fb": "Correct."}]}, {"id": "m6u08s1r08", "type": "explain", "prompt": "Explain how to work out 7 − 2.45.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "write 7 as 7.00", "kw": ["7\\.00|zeros"]}, {"pt": "7.00 − 2.45 = 4.55", "kw": ["4\\.55"]}], "model": "Write 7 as 7.00 so the decimal places line up, then subtract: 7.00 − 2.45 = 4.55.", "need": 1, "reason": "Write 7 as 7.00 so the decimal places line up, then subtract: 7.00 − 2.45 = 4.55."}], "prac": [{"id": "m6u08s1p01", "type": "num", "prompt": "Sara buys one of each item in the price list. How much does she spend altogether?", "diff": "M", "obj": "O1", "skill": "Data", "answer": 12.63, "unit": "$", "units": ["$", "dollars"], "tol": 0, "errs": [], "data": {"head": ["Item", "pen", "ruler", "notebook"], "rows": [["Price ($)", "4.01", "6.83", "1.79"]]}}, {"id": "m6u08s1p02", "type": "table", "prompt": "Complete the table.", "diff": "M", "obj": "O1", "skill": "Data", "head": ["", "Answer"], "rows": [["6.63 + 2.49", {"ans": 9.12}], ["6.63 − 2.49", {"ans": 4.14}]]}, {"id": "m6u08s1p03", "type": "num", "prompt": "Work out 43.8 + 2.03.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45.83, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m6u08s1p04", "type": "num", "prompt": "Work out 34.9 − 3.78.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 31.12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m6u08s1p05", "type": "num", "prompt": "Work out 23 − 3.66.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 19.34, "unit": "×", "units": ["×"], "tol": 0, "errs": []