, "diff": "M", "obj": "O1", "skill": "Application", "answer": 962, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1p02", "type": "num", "prompt": "58 × 43?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2494, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1p03", "type": "num", "prompt": "A cinema has 18 rows of 32 seats. Seats?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 576, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1p04", "type": "explain", "prompt": "Sara says 41 × 39 = 599. Use an estimate to show she is wrong.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "estimate 1600", "kw": ["1600|40 ?[×x*] ?40"]}, {"pt": "599 too small", "kw": ["small|far|wrong|not close"]}], "need": 2, "model": "40 × 40 = 1600, so 599 is far too small (it is 1599).", "hint": "", "reason": "40 × 40 = 1600, so 599 is far too small (it is 1599)."}, {"id": "m5u11s1p05", "type": "num", "prompt": "Tickets cost $15. 64 tickets?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 960, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1p06", "type": "num", "prompt": "785 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3140, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1p07", "type": "mcq", "prompt": "Best estimate for 72 × 19:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1400", "ok": true, "fb": ""}, {"t": "140", "ok": false, "fb": ""}, {"t": "14 000", "ok": false, "fb": ""}]}, {"id": "m5u11s1p08", "type": "num", "prompt": "99 × 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 594, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "100 × 6 − 6.", "reason": ""}], "adv": [{"id": "m5u11s1a01", "type": "num", "prompt": "* Advanced. A number × 23 = 552. The number?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Try 20 × 23 = 460, then add.", "reason": ""}, {"id": "m5u11s1a02", "type": "explain", "prompt": "* Advanced. Use the digits 2, 4, 6, 8 to make two 2-digit numbers with the largest product.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "82 × 64 or 84 × 62", "kw": ["82.{0,5}64|64.{0,5}82|84.{0,5}62|62.{0,5}84"]}], "need": 1, "model": "82 × 64 = 5248 (largest).", "hint": "", "reason": "82 × 64 = 5248 (largest)."}, {"id": "m5u11s1a03", "type": "num", "prompt": "* Advanced. 25 × 36 (hint: 25 × 4 = 100)?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 900, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "25 × 4 × 9.", "reason": ""}], "more": [{"id": "m5u11s1m01", "type": "num", "prompt": "112 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 448, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1m02", "type": "num", "prompt": "250 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 750, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1m03", "type": "num", "prompt": "11 × 15?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 165, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1m04", "type": "num", "prompt": "20 × 34?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 680, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1m05", "type": "num", "prompt": "Estimate 31 × 19 (nearest 10).", "diff": "M", "obj": "O1", "skill": "Application", "answer": 600, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u11s1m06", "type": "num", "prompt": "13 × 13?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 169, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u11", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 11.1 notes · Multiplication", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "11.2", "title": "Division", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Egg boxes", "p": ["A farm collects **152 eggs**. Each box holds **6 eggs**.", "How many boxes can be filled? What about the eggs left over – how many boxes are needed to pack every egg? Decide before you read on."]}, {"k": "recall", "t": "Times tables", "p": ["6 × 25 = 150."], "qq": {"id": "m5u11s2t01", "type": "num", "prompt": "48 ÷ 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "idea", "t": "Estimate and divide", "p": ["Estimate: 152 ÷ 6 ≈ 150 ÷ 6 = 25. Then divide in chunks: 6 × 20 = 120, 152 − 120 = 32; 6 × 5 = 30, 32 − 30 = 2. So **152 ÷ 6 = 25 r 2**.", "Short division works place by place: 15 tens ÷ 6 = 2 tens r 3 tens; 32 ÷ 6 = 5 r 2."]}, {"k": "idea", "t": "What to do with the remainder", "p": ["The **context** decides:"], "table": {"head": ["Question", "Answer"], "rows": [["How many full boxes?", "25 (round down)"], ["How many boxes for all eggs?", "26 (round up)"], ["Share $152 between 6 people", "$25.33… or $25 each, $2 left"]]}}, {"k": "try", "t": "Remainder", "p": [], "qq": {"id": "m5u11s2t02", "type": "num", "prompt": "How many full boxes of 6 from 152 eggs?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25."}}, {"k": "method", "t": "How do I divide and use remainders?", "p": ["Step 1: Estimate with a nearby multiple.", "Step 2: Divide (chunks or short division).", "Step 3: Write the remainder.", "Step 4: Decide: round down, round up, or keep the remainder."]}, {"k": "example", "t": "Short division", "p": [], "q": "378 ÷ 3.", "steps": [["3 ÷ 3 = 1", ""], ["7 ÷ 3 = 2 r 1", ""], ["18 ÷ 3 = 6", ""]], "a": "126"}, {"k": "example", "t": "Remainder", "p": [], "q": "245 ÷ 4.", "steps": [["4 × 60 = 240", ""], ["5 − 4 = 1", ""]], "a": "61 r 1"}, {"k": "example", "t": "Round up", "p": [], "q": "130 children, 8 per minibus. Minibuses?", "steps": [["130 ÷ 8 = 16 r 2", ""], ["2 children need a seat", ""]], "a": "17 minibuses"}, {"k": "example", "t": "Round down", "p": [], "q": "$75, books cost $9. How many books?", "steps": [["75 ÷ 9 = 8 r 3", ""]], "a": "8 books"}, {"k": "try", "t": "Round up", "p": [], "qq": {"id": "m5u11s2t03", "type": "num", "prompt": "50 people, 4 per car. Cars needed?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "50 ÷ 4 = 12 r 2.", "reason": "13."}}, {"k": "error", "t": "Ignoring the context", "p": ["Find the first wrong line."], "q": "100 pupils, 30 per bus. Buses needed?", "lines": ["100 ÷ 30 = 3 r 10, so 3 buses"], "bad": 0, "why": "10 pupils would be left behind – round up to 4 buses.", "fix": [["4 buses", ""]], "id": "m5u11s2t04"}, {"k": "mistake", "t": "Always rounding down", "p": ["Ask: does every item need a place? Then round up."]}, {"k": "tip", "t": "Real life", "p": ["Event planners divide guests by table size and always round up the number of tables."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate with a nearby multiple.", "Divide in chunks or by short division.", "Remainder: round down, round up or keep it – the context decides."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "11.2-k1", "t": 1, "after": 0, "review":