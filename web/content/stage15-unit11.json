{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 11, "stage": 15, "title": "Multiplication and Division", "strandShort": "Number", "blurb": "Multiplying 3-digit numbers by 1-digit numbers and 2-digit by 2-digit numbers, dividing with remainders, and tests of divisibility by 2, 4, 5, 10, 25, 50 and 100.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u11.pdf"}, "objectives": {"O1": {"code": "5Nc.04", "sec": "11.1", "codeNote": "", "t": "Estimate and multiply whole numbers up to 1000 by 1-digit numbers, and 2-digit numbers by 2-digit numbers."}, "O2": {"code": "5Nc.05", "sec": "11.2", "codeNote": "", "t": "Estimate and divide whole numbers up to 1000 by 1-digit numbers, and decide what to do with remainders."}, "O3": {"code": "5Nc.06", "sec": "11.3", "codeNote": "", "t": "Use tests of divisibility by 2, 4, 5, 10, 25, 50 and 100."}}, "sections": [{"id": "11.1", "title": "Multiplication", "objs": ["O1"], "lesson": [{"k": "hook", "t": "School trip", "p": ["**34 buses** each carry **47 pupils**.", "Roughly how many pupils is that? Can you then work out the exact number? Try it before you read on."]}, {"k": "recall", "t": "Times tables", "p": ["7 × 8 = 56."], "qq": {"id": "m5u11s1t01", "type": "num", "prompt": "6 × 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 54, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "54."}}, {"k": "idea", "t": "Estimate first", "p": ["Round each number to make an easy calculation: 34 × 47 ≈ 30 × 50 = **1500**. The exact answer should be near this."]}, {"k": "idea", "t": "Multiplying", "p": ["**3-digit × 1-digit** – the grid method: 347 × 6 = 300×6 + 40×6 + 7×6 = 1800 + 240 + 42 = **2082**.", "**2-digit × 2-digit** – split one number: 34 × 47 = 30 × 47 + 4 × 47 = 1410 + 188 = **1598** (close to 1500 ✓)."], "table": {"head": ["×", "40", "7"], "rows": [["30", "1200", "210"], ["4", "160", "28"]]}, "p2": ["Add all the parts: 1200 + 210 + 160 + 28 = 1598."]}, {"k": "try", "t": "Grid", "p": [], "qq": {"id": "m5u11s1t02", "type": "num", "prompt": "214 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 642, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "200×3 + 14×3.", "reason": "642."}}, {"k": "method", "t": "How do I multiply larger numbers?", "p": ["Step 1: Estimate by rounding.", "Step 2: Split the numbers into tens and ones (a grid).", "Step 3: Multiply each part.", "Step 4: Add the parts and compare with the estimate."]}, {"k": "example", "t": "3-digit × 1-digit", "p": [], "q": "526 × 4.", "steps": [["500×4 = 2000", ""], ["20×4 = 80", ""], ["6×4 = 24", ""]], "a": "2104"}, {"k": "example", "t": "2-digit × 2-digit", "p": [], "q": "23 × 15.", "steps": [["20×15 = 300", ""], ["3×15 = 45", ""]], "a": "345"}, {"k": "example", "t": "Estimate", "p": [], "q": "Estimate 68 × 21.", "steps": [["70 × 20", ""]], "a": "about 1400"}, {"k": "example", "t": "Problem", "p": [], "q": "A box holds 24 pens. How many pens in 36 boxes?", "steps": [["24 × 36 = 720 + 144", ""]], "a": "864 pens"}, {"k": "try", "t": "2-digit", "p": [], "qq": {"id": "m5u11s1t03", "type": "num", "prompt": "12 × 25?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 300, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "300."}}, {"k": "error", "t": "Forgetting a part", "p": ["Find the first wrong line."], "q": "34 × 47", "lines": ["30 × 40 = 1200", "4 × 7 = 28", "1200 + 28 = 1228"], "bad": 2, "why": "Missing 30 × 7 and 4 × 40: the answer is 1598.", "fix": [["1598", ""]], "id": "m5u11s1t04"}, {"k": "mistake", "t": "Only multiplying tens by tens and ones by ones", "p": ["Every part multiplies every part – use a grid."]}, {"k": "tip", "t": "Real life", "p": ["Event planners multiply seats per row by rows; shops multiply price by quantity."]}, {"k": "summary", "t": "What to remember", "p": ["Estimate first.", "Grid method: split into parts.", "Add all the parts.", "Check against the estimate."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "11.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u11s1k01", "type": "num", "prompt": "Before you read on: estimate 30 × 50.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1500, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u11s1k02", "type": "num", "prompt": "300 × 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1800, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u11s1k03", "type": "num", "prompt": "23 × 15?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 345, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u11s1k04", "type": "num", "prompt": "Quick check: 34 × 47?", "diff": "M", "obj": "O1", "skill": "Applicati