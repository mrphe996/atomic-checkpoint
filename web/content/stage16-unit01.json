unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u01s1m03", "type": "num", "prompt": "Value of 2 in 1.725?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.02, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u01s1m04", "type": "num", "prompt": "0.015 × 1000?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u01s1m05", "type": "mcq", "prompt": "Bigger?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "0.6", "ok": true, "fb": ""}, {"t": "0.59", "ok": false, "fb": ""}]}, {"id": "m6u01s1m06", "type": "num", "prompt": "3 + 0.4 + 0.05?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3.45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u01", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 1.1 notes · Place value", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "1.2", "title": "Rounding decimal numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Shopping total", "p": ["A shopping receipt totals **$23.68**. Dad says 'about $24'; the shop's loyalty app says 'about $23.70'.", "Who is right? How do you decide which way to round? Think about it before you read on."]}, {"k": "recall", "t": "Rounding whole numbers", "p": ["To the nearest 10: 347 → 350 (7 rounds up)."], "qq": {"id": "m6u01s2t01", "type": "num", "prompt": "Round 862 to the nearest 100.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 900, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "900."}}, {"k": "idea", "t": "Rounding to the nearest whole number", "p": ["Look at the **tenths** digit: **5 or more → round up**; less than 5 → round down."], "table": {"head": ["Number", "Tenths digit", "Nearest whole"], "rows": [["23.68", "6", "24"], ["7.45", "4", "7"], ["12.5", "5", "13"]]}, "p2": ["So Dad's 'about $24' is correct to the nearest dollar."]}, {"k": "idea", "t": "Rounding to the nearest tenth (1 decimal place)", "p": ["Look at the **hundredths** digit: 23.68 → hundredths 8 → round the 6 tenths up to **23.7**.", "Both are right – they rounded to different accuracies. A number line helps: 23.68 lies between 23.6 and 23.7, nearer 23.7."]}, {"k": "try", "t": "Nearest whole", "p": [], "qq": {"id": "m6u01s2t02", "type": "num", "prompt": "Round 18.49 to the nearest whole number.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Tenths digit 4.", "reason": "18."}}, {"k": "method", "t": "How do I round a decimal?", "p": ["Step 1: Decide the place you are rounding to (whole number or tenth).", "Step 2: Look at the digit just to its right.", "Step 3: 5 or more → round up; 4 or less → stay.", "Step 4: Drop the digits after the rounding place."]}, {"k": "example", "t": "Nearest tenth", "p": [], "q": "Round 5.34 to the nearest tenth.", "steps": [["hundredths digit 4 → round down", ""]], "a": "5.3"}, {"k": "example", "t": "Rounding up through 9", "p": [], "q": "Round 2.96 to the nearest tenth.", "steps": [["hundredths 6 → round up", ""], ["2.9 → 3.0", ""]], "a": "3.0"}, {"k": "example", "t": "Estimate", "p": [], "q": "Estimate 4.82 + 7.19 by rounding to whole numbers.", "steps": [["5 + 7 = 12", ""]], "a": "about 12"}, {"k": "example", "t": "Which numbers?", "p": [], "q": "Which of 6.45, 6.54, 6.49 round to 6.5 (nearest tenth)?", "steps": [["6.45 → 6.5", "5 rounds up"], ["6.54 → 6.5", ""], ["6.49 → 6.5", ""]], "a": "all three"}, {"k": "try", "t": "Tenth", "p": [], "qq": {"id": "m6u01s2t03", "type": "num", "prompt": "Round 9.87 to the nearest tenth.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9.9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "9.9."}}, {"k": "error", "t": "Looked at the wrong digit", "p": ["Find the first wrong line."], "q": "Round 4.38 to the nearest whole number.", "lines": ["hundredths digit 8 → round up", "5"], "bad": 0, "why": "For the nearest whole number look at the TENTHS digit (3) → round down: 4.", "fix": [["tenths digit 3 → 4", ""]], "id": "m6u01s2t04"}, {"k": "mistake", "t": "Looking at the wrong digit", "p": ["Look at the digit just right of the place you are rounding to."]}, {"k": "tip", "t": "Real life", "p": ["Prices, times and distances are often rounded: a 42.195 km marathon is 'about 42 km'."]}, {"k": "summary", "t": "What to remember", "p": ["Nearest whole → look at tenths.", "Nearest tenth → look at hundredths.", "5 or more rounds up.", "Rounding is used for estimates."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "1.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u01s2k01", "type": "mcq", "prompt": "Before you read on: who is right?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "both – different accuracy", "ok": true, "fb": ""}, {"t": "only Dad", "ok": false, "fb": ""}]}}, {"id": "1.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u01s2k02", "type": "num", "prompt": "Round 7.45 to the nearest whole number.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "1.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u01s2k03", "type": "num", "prompt": "Round 2.96 to the nearest tenth.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "3.0", "reason": ""}}, {"id": "1.2-k4", "t": 4, "after": 14, "review": [0, 0], 