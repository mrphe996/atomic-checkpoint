{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 3, "stage": 16, "title": "Averages", "strandShort": "Statistics and probability", "blurb": "Finding the mode, median, mean and range of a set of data, and choosing which average to use.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u03.pdf"}, "objectives": {"O1": {"code": "6Ss.03", "sec": "3.1", "codeNote": "", "t": "Find and interpret the mode, median, mean and range of a set of data."}, "O2": {"code": "6Ss.04", "sec": "3.1", "codeNote": "", "t": "Compare two sets of data using an average and the range."}}, "sections": [{"id": "3.1", "title": "Mode, median, mean and range", "objs": ["O1", "O2"], "lesson": [{"k": "hook", "t": "Picking a player", "p": ["A coach must choose one basketball player for the final. In their last five games, **Ana** scored 8, 12, 10, 12, 8 points and **Bo** scored 2, 20, 4, 18, 6 points.", "Who is the better choice? How could numbers help you decide? Think about it before you read on."]}, {"k": "recall", "t": "Ordering numbers", "p": ["Put 12, 8, 10, 8, 12 in order: 8, 8, 10, 12, 12."], "qq": {"id": "m6u03s1t01", "type": "num", "prompt": "Middle number of 3, 9, 5, 7, 4 (after ordering)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "3, 4, 5, 7, 9.", "reason": "5."}}, {"k": "idea", "t": "Three averages", "p": ["An **average** is one number that represents a set of data."], "table": {"head": ["Average", "How to find it", "Ana", "Bo"], "rows": [["mode", "the most common value", "8 and 12", "none"], ["median", "the middle value in order", "10", "6"], ["mean", "total ÷ how many", "50 ÷ 5 = 10", "50 ÷ 5 = 10"]]}, "fig": {"kind": "barchart", "labels": ["Game 1", "Game 2", "Game 3", "Game 4", "Game 5"], "values": [8, 12, 10, 12, 8], "ymax": 20, "step": 4, "ylabel": "Ana's points"}}, {"k": "idea", "t": "The range", "p": ["The **range** shows how **spread out** the data is: **largest − smallest**.", "Ana: 12 − 8 = **4**. Bo: 20 − 2 = **18**.", "Both have mean 10, but Ana's small range shows she is **more consistent** – a safer choice. Bo sometimes scores big but is less reliable."]}, {"k": "try", "t": "Mean", "p": [], "qq": {"id": "m6u03s1t02", "type": "num", "prompt": "Mean of 4, 7, 9, 12?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "32 ÷ 4.", "reason": "8."}}, {"k": "method", "t": "How do I find the averages and range?", "p": ["Step 1: Put the data in order.", "Step 2: Mode: most common. Median: middle (or halfway between the two middle values).", "Step 3: Mean: add all the values, divide by how many there are.", "Step 4: Range: largest − smallest; use it to compare how consistent sets are."]}, {"k": "example", "t": "Even number of values", "p": [], "q": "Median of 3, 8, 5, 10, 6, 2.", "steps": [["order: 2, 3, 5, 6, 8, 10", ""], ["middle two: 5 and 6", ""], ["halfway: 5.5", ""]], "a": "5.5"}, {"k": "example", "t": "Mean with decimals", "p": [], "q": "Mean of 2.5, 3, 4.5.", "steps": [["total 10", ""], ["10 ÷ 3 = 3.33…", ""]], "a": "about 3.3"}, {"k": "example", "t": "Missing value", "p": [], "q": "Four numbers have a mean of 6. Three are 5, 7, 4. The fourth?", "steps": [["total = 6 × 4 = 24", ""], ["24 − 16 = 8", ""]], "a": "8"}, {"k": "example", "t": "Compare", "p": [], "q": "Class A: mean 7, range 3. Class B: mean 7, range 9 (quiz marks).", "steps": [["same average", ""], ["A more consistent", ""]], "a": "A's marks are more alike"}, {"k": "try", "t": "Range", "p": [], "qq": {"id": "m6u03s1t03", "type": "num", "prompt": "Range of 15, 4, 22, 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "18."}}, {"k": "error", "t": "Forgot to order", "p": ["Find the first wrong line."], "q": "Median of 9, 2, 7, 4, 5.", "lines": ["middle value is 7"], "bad": 0, "why": "Order first: 2, 4, 5, 7, 9 → median 5.", "fix": [["2, 4, 5, 7, 9", ""], ["median 5", ""]], "id": "m6u03s1t04"}, {"k": "mistake", "t": "Finding the median without ordering", "p": ["Always put the data in order first."]}, {"k": "tip", "t": "Real life", "p": ["Coaches, teachers and weather reporters use averages and ranges to compare players, classes and cities."]}, {"k": "summary", "t": "What to remember", "p": ["Mode: most common. Median: middle. Mean: total ÷ number.", "Range: largest − smallest.", "Order the data first.", "Same average + smaller range = more consistent."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "3.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u03s1k01", "type": "mcq", "prompt": "Before you read on: who is more reliable?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Ana", "ok": true, "fb": ""}, {"t": "Bo", "ok": false, "fb": ""}]}}, {"id": "3.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u03s1k02", "type": "num", "prompt": "Bo's median?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u03s1k03", "type": "num", "prompt": "Bo's range?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "3.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u03s1k04", "type": "num", "prompt": "Quick check: mean of 6, 8, 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 312]], "req": [{"id": "m6u03s1r01", "type": "num", "prompt": "Mode of 3, 5, 5, 6, 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r02", "type": "num", "prompt": "Median of 1, 4, 6, 8, 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r03", "type": "num", "prompt": "Mean of 5, 6, 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r04", "type": "num", "prompt": "Range of 12, 30, 18?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r05", "type": "num", "prompt": "Median of 2, 4, 6, 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r06", "type": "num", "prompt": "Mean of 10, 20, 30, 40?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r07", "type": "num", "prompt": "Mode of 7, 2, 7, 3, 2, 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1r08", "type": "num", "prompt": "Range of 0.5, 2.5, 1.5?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m6u03s1p01", "type": "num", "prompt": "Five numbers have mean 9. Total?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1p02", "type": "num", "prompt": "Mean 6 for 3, 5, x. x?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1p03", "type": "num", "prompt": "Median of 12, 3, 8, 15, 9, 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1p04", "type": "explain", "prompt": "Two runners both average 15 s for 100 m. Ali's range is 1 s, Ben's is 4 s. Who would you choose for a relay and why?", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "Ali", "kw": ["ali"]}, {"pt": "more consistent / smaller range", "kw": ["consistent|reliable|smaller range|less spread"]}], "need": 2, "model": "Ali – same average but a smaller range, so his times are more consistent.", "hint": "", "reason": "Ali – same average but a smaller range, so his times are more consistent."}, {"id": "m6u03s1p05", "type": "num", "prompt": "Temperatures −2, 3, 5, −1 °C. Range?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1p06", "type": "num", "prompt": "Temperatures −2, 3, 5, −1 °C. Mean?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1.25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1p07", "type": "mcq", "prompt": "Shoe sizes in a shop – best average to order stock?", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "mode", "ok": true, "fb": ""}, {"t": "mean", "ok": false, "fb": ""}]}, {"id": "m6u03s1p08", "type": "num", "prompt": "A set has range 10 and smallest value 4. Largest?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m6u03s1a01", "type": "explain", "prompt": "* Advanced. Write five numbers with mode 3, median 4 and mean 5.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "example", "kw": ["\\d.*\\d"]}], "need": 1, "model": "e.g. 3, 3, 4, 6, 9 (total 25).", "hint": "", "reason": "e.g. 3, 3, 4, 6, 9 (total 25)."}, {"id": "m6u03s1a02", "type": "num", "prompt": "* Advanced. The mean of 4 numbers is 7. A fifth number makes the mean 8. Fifth number?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "40 − 28.", "reason": ""}, {"id": "m6u03s1a03", "type": "mcq", "prompt": "* Advanced. Pocket money 2, 3, 3, 4, 40 ($). Best average to describe it?", "diff": "H", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "median (3)", "ok": true, "fb": "The mean (10.4) is pulled up by 40."}, {"t": "mean", "ok": false, "fb": ""}]}], "more": [{"id": "m6u03s1m01", "type": "num", "prompt": "Mode of 1, 1, 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1m02", "type": "num", "prompt": "Median of 5, 6, 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1m03", "type": "num", "prompt": "Mean of 2, 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1m04", "type": "num", "prompt": "Range of 3, 9?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1m05", "type": "num", "prompt": "Mean of 1, 2, 3, 4, 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u03s1m06", "type": "num", "prompt": "Median of 10, 2, 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u03", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 3.1 notes · Mode, median, mean and range", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}], "segments": {"O1": ["3.1", 0, 312, "Mode, median, mean and range"], "O2": ["3.1", 0, 312, "Mode, median, mean and range"]}, "sources": [], "tests": {"A": [{"id": "m6u03v3Aq01", "type": "num", "prompt": "Find the median of 39, 24, 26, 20, 32.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u03v3Aq02", "type": "num", "prompt": "Find the range of 33, 21, 14, 16, 4, 31.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u03v3Aq03", "type": "num", "prompt": "The table shows how many books each child read. Find the mean number of books.", "diff": "M", "obj": "O1", "skill": "Data", "pts": 1, "data": {"head": ["Child", "Ava", "Eli", "Ben", "Gita", "Hugo"], "rows": [["Books", "5", "10", "3", "15", "7"]]}, "sec": "A · Fluency", "unit": "books", "units": ["books"]}, {"id": "m6u03v3Aq04", "type": "short", "prompt": "The bar chart shows favourite colours. What is the mode?", "diff": "M", "obj": "O1", "skill": "Figure", "pts": 1, "fig": {"kind": "barchart", "labels": ["Red", "Blue", "Green", "Yellow"], "values": [3, 7, 11, 9], "ymax": 12, "step": 2, "ylabel": "Children"}, "sec": "A · Fluency"}, {"id": "m6u03v3Aq05", "type": "num", "prompt": "Find the mean of 19, 1, 17, 11, 17.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u03v3Aq06", "type": "num", "prompt": "Find the mode of 1, 25, 2, 25, 22.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u03v3Aq07", "type": "mcq", "prompt": "Team A scored 28, 22, 17, 14, 15. Team B scored 18, 23, 20, 22, 25. Which team's scores are more consistent?", "diff": "H", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "Team B"}, {"t": "Team A"}]}, {"id": "m6u03v3Aq08", "type": "num", "prompt": "Find the median of 11, 25, 29, 5.", "diff": "H", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u03v3Aq09", "type": "table", "prompt": "Complete the table for the data 17, 5, 9, 13.", "diff": "M", "obj": "O1", "skill": "Data", "pts": 2, "sec": "B · Methods", "head": ["Statistic", "Value"], "rows": [["Mean", {"blank": true}], ["Range", {"blank": true}]]}, {"id": "m6u03v3Aq10", "type": "num", "prompt": "The mean of 4 numbers is 6. What is their total?", "diff": "H", "obj": "O1", "skill": "Application", "pts": 1, "sec"