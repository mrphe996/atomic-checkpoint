{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 10, "stage": 15, "title": "Angles", "strandShort": "Geometry and measure", "blurb": "Acute, right and obtuse angles, estimating and measuring with a protractor, and angles on a straight line.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u10.pdf"}, "objectives": {"O1": {"code": "5Gg.05", "sec": "10.1", "codeNote": "", "t": "Classify, estimate and measure angles in degrees, including acute, right and obtuse angles."}, "O2": {"code": "5Gg.06", "sec": "10.2", "codeNote": "", "t": "Know that angles on a straight line add up to 180° and use this to find missing angles."}}, "sections": [{"id": "10.1", "title": "Estimating and measuring angles", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Laptop screen", "p": ["You open a laptop a little, then wider, then flat on the table.", "How could you describe how far it is open using numbers? Think about it before you read on."]}, {"k": "recall", "t": "Right angles", "p": ["A square corner is a right angle."], "qq": {"id": "m5u10s1t01", "type": "num", "prompt": "How many right angles make a full turn?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "idea", "t": "Degrees and types of angle", "p": ["Angles are measured in **degrees (°)**. A full turn is 360°, a right angle is 90°."], "table": {"head": ["Type", "Size", "Example"], "rows": [["acute", "less than 90°", "a slightly open laptop (30°)"], ["right", "exactly 90°", "corner of a book"], ["obtuse", "between 90° and 180°", "a laptop opened wide (120°)"], ["straight", "180°", "the laptop flat"]]}, "fig": {"kind": "anglept", "angles": [40], "start": 0, "labels": ["40°"]}}, {"k": "idea", "t": "Estimating and measuring", "p": ["**Estimate** first: compare with a right angle. Is it smaller (acute) or bigger (obtuse)? About half a right angle is 45°.", "**Measure** with a **protractor**: put the centre on the vertex, line 0° up with one arm, read the scale that starts at 0° on that arm."]}, {"k": "try", "t": "Type", "p": [], "qq": {"id": "m5u10s1t02", "type": "mcq", "prompt": "An angle of 135° is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": false, "fb": ""}, {"t": "right", "ok": false, "fb": ""}, {"t": "obtuse", "ok": true, "fb": ""}, {"t": "straight", "ok": false, "fb": ""}], "fixed": true}}, {"k": "method", "t": "How do I measure an angle?", "p": ["Step 1: Estimate: acute or obtuse?", "Step 2: Place the protractor centre on the vertex.", "Step 3: Line 0° up with one arm.", "Step 4: Read the scale starting from that 0°; check against your estimate."]}, {"k": "example", "t": "Classify", "p": [], "q": "Classify 72°, 90°, 150°.", "steps": [["72 < 90", ""], ["90 exactly", ""], ["150 between 90 and 180", ""]], "a": "acute, right, obtuse"}, {"k": "example", "t": "Estimate", "p": [], "q": "An angle looks a little bigger than half a right angle.", "steps": [["half a right angle = 45°", ""]], "a": "about 50°"}, {"k": "example", "t": "Which scale?", "p": [], "q": "One arm is on 0° of the inner scale; the other arm crosses 65 (inner) and 115 (outer).", "steps": [["start from inner 0°", ""], ["acute angle", ""]], "a": "65°"}, {"k": "example", "t": "Turning", "p": [], "q": "A clock's minute hand moves from 12 to 3.", "steps": [["¼ turn", ""]], "a": "90°"}, {"k": "try", "t": "Estimate", "p": [], "qq": {"id": "m5u10s1t03", "type": "mcq", "prompt": "Best estimate for an angle a bit less than a right angle:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "80°", "ok": true, "fb": ""}, {"t": "120°", "ok": false, "fb": ""}, {"t": "30°", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Reading the wrong scale", "p": ["Find the first wrong line."], "q": "An obtuse angle is measured.", "lines": ["The protractor shows 60 and 120; the answer is 60°."], "bad": 0, "why": "An obtuse angle is more than 90°, so it is 120°.", "fix": [["120°", ""]], "id": "m5u10s1t04"}, {"k": "mistake", "t": "Reading the wrong scale", "p": ["Estimate first – it tells you which number is sensible."]}, {"k": "tip", "t": "Real life", "p": ["Skateboard ramps, ladders against walls and road signs all depend on angles."]}, {"k": "summary", "t": "What to remember", "p": ["acute < 90°; right = 90°; obtuse 90°–180°; straight = 180°.", "Estimate before measuring.", "Protractor: centre on vertex, 0° on one arm."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "10.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u10s1k01", "type": "mcq", "prompt": "Before you read on: angles are measured in…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "degrees", "ok": true, "fb": ""}, {"t": "centimetres", "ok": false, "fb": ""}]}}, {"id": "10.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u10s1k02", "type": "mcq", "prompt": "40° is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t":