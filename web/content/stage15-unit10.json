}, {"id": "m5u10s1p04", "type": "explain", "prompt": "Explain why estimating first helps when using a protractor.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "choose the right scale / check", "kw": ["scale|check|sensible|which number|right number"]}], "need": 1, "model": "It tells you whether the angle is acute or obtuse, so you read the correct scale and can check the answer.", "hint": "", "reason": "It tells you whether the angle is acute or obtuse, so you read the correct scale and can check the answer."}, {"id": "m5u10s1p05", "type": "mcq", "prompt": "Order smallest first: obtuse, acute, right", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute, right, obtuse", "ok": true, "fb": ""}, {"t": "right, acute, obtuse", "ok": false, "fb": ""}]}, {"id": "m5u10s1p06", "type": "num", "prompt": "How many 30° angles make a right angle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s1p07", "type": "mcq", "prompt": "Best estimate for a wide-open door (just under straight):", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "160°", "ok": true, "fb": ""}, {"t": "100°", "ok": false, "fb": ""}]}, {"id": "m5u10s1p08", "type": "mcq", "prompt": "The angle between clock hands at 4 o'clock (120°) is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": false, "fb": ""}, {"t": "right", "ok": false, "fb": ""}, {"t": "obtuse", "ok": true, "fb": ""}, {"t": "straight", "ok": false, "fb": ""}], "fixed": true}], "adv": [{"id": "m5u10s1a01", "type": "num", "prompt": "* Advanced. Angle between clock hands at 2 o'clock?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s1a02", "type": "num", "prompt": "* Advanced. Smaller angle between clock hands at 5 o'clock?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 150, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s1a03", "type": "explain", "prompt": "* Advanced. Can a triangle have two obtuse angles? Explain.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|cannot|can't"]}, {"pt": "over 180", "kw": ["180|too big|more than"]}], "need": 2, "model": "No – two obtuse angles already add to more than 180°, and a triangle's angles total 180°.", "hint": "", "reason": "No – two obtuse angles already add to more than 180°, and a triangle's angles total 180°."}], "more": [{"id": "m5u10s1m01", "type": "mcq", "prompt": "60° is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": true, "fb": ""}, {"t": "right", "ok": false, "fb": ""}, {"t": "obtuse", "ok": false, "fb": ""}, {"t": "straight", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u10s1m02", "type": "mcq", "prompt": "100° is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": false, "fb": ""}, {"t": "right", "ok": false, "fb": ""}, {"t": "obtuse", "ok": true, "fb": ""}, {"t": "straight", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u10s1m03", "type": "num", "prompt": "Degrees in a right angle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s1m04", "type": "num", "prompt": "Two right angles?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s1m05", "type": "mcq", "prompt": "An angle of 10° is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "acute", "ok": true, "fb": ""}, {"t": "right", "ok": false, "fb": ""}, {"t": "obtuse", "ok": false, "fb": ""}, {"t": "straight", "ok": false, "fb": ""}], "fixed": true}, {"id": "m5u10s1m06", "type": "mcq", "prompt": "We measure angles with a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "protractor", "ok": true, "fb": ""}, {"t": "ruler", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c5u10", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 10.1 notes · Estimating and measuring angles", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "10.2", "title": "Angles on a straight line", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Bent straw", "p": ["A straight straw is bent so one part makes a **65°** angle with the table.", "What is the other angle on the table side? Think about it before you read on."]}, {"k": "recall", "t": "Straight angle", "p": ["A straight line is a half turn."], "qq": {"id": "m5u10s2t01", "type": "num", "prompt": "Degrees on a straight line?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "180°."}}, {"k": "idea", "t": "Angles on a straight line add to 180°", "p": ["Angles that meet at a point on a straight line **add up to 180°**."], "fig": {"kind": "anglept", "angles": [65, 115], "start": 0, "labels": ["65°", "?"], "line": true}, "p2": ["Straw: 180° − 65° = **115°**."]}, {"k": "idea", "t": "More than two angles", "p": ["With three angles on a line, add the known ones and subtract from 180°: 40° + 70° + ? = 180° → ? = 70°."]}, {"k": "try", "t": "Missing", "p": [], "qq": {"id": "m5u10s2t02", "type": "num", "prompt": "One angle on a straight line is 30°. The other?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 150, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "150°."}}, {"k": "method", "t": "How do I find a missing angle on a straight line?", "p": ["Step 1: Check the angles are on one straight line.", "Step 2: Add the known angles.", "Step 3: Subtract from 180°.", "Step 4: Check: all angles add to 180°."]}, {"k": "example", "t": "Two angles", "p": [], "q": "One angle is 108°.", "steps": [["180 − 108", ""]], "a": "72°"}, {"k": "example", "t": "Three angles", "p": [], "q": "Angles 35°, 90° and ?.", "steps": [["35 + 90 = 125", ""], ["180 − 125", ""]], "a": "55°"}, {"k": "example", "t": "Equal angles", "p": [], "q": "Two equal angles on a straight line.", "steps": [["180 ÷ 2", ""]], "a": "90° each"}, {"k": "example", "t": "Check", "p": [], "q": "Do 75°, 50°, 60° lie on a straight line?", "steps": [["75 + 50 + 60 = 185", ""]], "a": "no (not 180°)"}, {"k": "try", "t": "Three", "p": [], "qq": {"id": "m5u10s2t03", "type": "num", "prompt": "Angles 20°, 100°, ? on a straight line.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "60°."}}, {"k": "error", "t": "Subtracting from 360°", "p": ["Find the first wrong line."], "q": "One angle on a straight line is 140°.", "lines": ["360 − 140 = 220°"], "bad": 0, "why": "A straight line is 180°: 180 − 140 = 40°.", "fix": [["40°", ""]], "id": "m5u10s2t04"}, {"k": "mistake", "t": "Using 360° instead of 180°", "p": ["Straight line = half turn = 180°."]}, {"k": "tip", "t": "Real life", "p": ["Carpenters check cuts on a straight plank: the two angles must make 180°."]}, {"k": "summary", "t": "What to remember", "p": ["Angles on a straight line add to 180°.", "Missing angle = 180° − known angles.", "Check your total."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "10.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u10s2k01", "type": "num", "prompt": "Before you read on: the other angle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 115, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u10s2k02", "type": "num", "prompt": "180 − 65?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 115, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u10s2k03", "type": "num", "prompt": "180 − 108?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 72, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u10s2k04", "type": "num", "prompt": "Quick check: 90° and ? on a straight line.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u10s2r01", "type": "num", "prompt": "One angle 50°. Other?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 130, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s2r02", "type": "num", "prompt": "One angle 120°. Other?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s2r03", "type": "num", "prompt": "One angle 45°. Other?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 135, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u10s2r04", "type": "num", "prompt": "One angle 90°. Other?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {