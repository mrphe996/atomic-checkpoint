{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 15, "stage": 16, "title": "Data", "strandShort": "Statistics and probability", "blurb": "Reading and drawing bar charts, dot plots, waffle diagrams and pie charts, grouped frequency diagrams, line graphs and scatter graphs.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u15.pdf"}, "objectives": {"O1": {"code": "6Ss.01", "sec": "15.1", "codeNote": "", "t": "Represent and interpret categorical data in bar charts, dot plots, waffle diagrams and pie charts."}, "O2": {"code": "6Ss.02", "sec": "15.2", "codeNote": "", "t": "Represent and interpret grouped data in frequency diagrams, and data that changes over time in line graphs; read scatter graphs."}}, "sections": [{"id": "15.1", "title": "Bar charts, dot plots, waffle diagrams and pie charts", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Class pets survey", "p": ["A class of **20** voted for a class pet: fish 8, hamster 5, rabbit 4, stick insect 3.", "How could you show this so everyone sees the favourite at a glance? Is there more than one good way? Think about it before you read on."]}, {"k": "recall", "t": "Tally and frequency", "p": ["Frequency = how many times something happens."], "qq": {"id": "m6u15s1t01", "type": "num", "prompt": "Total votes for hamster and rabbit?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "9."}}, {"k": "idea", "t": "Bar charts and dot plots", "p": ["A **bar chart** shows each category as a bar; the height is the frequency. A **dot plot** shows one dot per vote above each category."], "fig": {"kind": "barchart", "labels": ["fish", "hamster", "rabbit", "stick insect"], "values": [8, 5, 4, 3], "ymax": 10, "step": 2, "ylabel": "Votes"}, "p2": ["Bars make it easy to compare: fish is clearly the favourite."]}, {"k": "idea", "t": "Waffle diagrams and pie charts", "p": ["A **waffle diagram** is a 10 × 10 grid: each square is 1%. Fish = 8/20 = 40% → 40 squares.", "A **pie chart** shows each category as a slice of a circle – good for showing **proportions** of the whole: fish is 40% of the circle."], "fig": {"kind": "pie", "labels": ["fish", "hamster", "rabbit", "stick insect"], "values": [8, 5, 4, 3]}}, {"k": "try", "t": "Proportion", "p": [], "qq": {"id": "m6u15s1t02", "type": "num", "prompt": "Percentage of votes for hamster?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "5/20.", "reason": "25%."}}, {"k": "method", "t": "How do I read and draw these charts?", "p": ["Step 1: Bar chart / dot plot: read heights or count dots.", "Step 2: Waffle: count squares – each is 1%.", "Step 3: Pie chart: compare slice sizes; fractions of the whole.", "Step 4: Always give a title and labels."]}, {"k": "example", "t": "Read a bar chart", "p": [], "q": "How many more voted fish than rabbit?", "steps": [["8 − 4 = 4", ""]], "a": "4"}, {"k": "example", "t": "Waffle", "p": [], "q": "Rabbit is 4 out of 20. Squares to shade?", "steps": [["4/20 = 20%", ""], ["20 squares", ""]], "a": "20"}, {"k": "example", "t": "Pie chart fraction", "p": [], "q": "A pie chart slice is a quarter of the circle. Total 60 children. How many?", "steps": [["¼ of 60", ""]], "a": "15"}, {"k": "example", "t": "Choose", "p": [], "q": "Which chart shows 'fish is 40% of all votes' best?", "steps": [["a pie chart or waffle diagram", "proportion of a whole"]], "a": "pie chart / waffle"}, {"k": "try", "t": "Pie", "p": [], "qq": {"id": "m6u15s1t03", "type": "num", "prompt": "Half a pie chart shows 'walk' for 36 children. How many walk?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "18."}}, {"k": "error", "t": "Read pie chart sizes as numbers", "p": ["Find the first wrong line."], "q": "Two pie charts both have a 'fish' slice of a quarter.", "lines": ["so the same number of children chose fish in both classes"], "bad": 0, "why": "Pie charts show proportions. If the classes have different sizes, the numbers differ.", "fix": [["same fraction, maybe different numbers", ""]], "id": "m6u15s1t04"}, {"k": "mistake", "t": "Treating pie slices as amounts", "p": ["Pie charts show fractions of a whole."]}, {"k": "tip", "t": "Real life", "p": ["News, sports and school reports use bar charts, pie charts and waffle diagrams to share survey results."]}, {"k": "summary", "t": "What to remember", "p": ["Bar chart/dot plot: compare frequencies.", "Waffle: 100 squares, 1% each.", "Pie chart: proportions of a whole.", "Title and labels always."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "15.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u15s1k01", "type": "mcq", "prompt": "Before you read on: a good way to show it?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a bar chart", "ok": true, "fb": ""}, {"t": "a list of names", "ok": false, "fb": ""}]}}, {"id": "15.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u15s1k02", "type": "num", "prompt": "Fish votes as a percentage?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "15.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u15s1k03", "type": "num", "prompt": "Waffle squares for rabbit?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "15.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u15s1k04", "type": "num", "prompt": "Quick check: stick insect %?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u15s1r01", "type": "num", "prompt": "Total votes (8, 5, 4, 3)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1r02", "type": "num", "prompt": "Fish − hamster?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1r03", "type": "num", "prompt": "A waffle has 35 squares shaded. Percentage?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1r04", "type": "num", "prompt": "Pie: quarter of 40 people?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1r05", "type": "mcq", "prompt": "Best for comparing amounts in categories?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "bar chart", "ok": true, "fb": ""}, {"t": "line graph", "ok": false, "fb": ""}]}, {"id": "m6u15s1r06", "type": "num", "prompt": "Dot plot: 7 dots above 'red'. Votes for red?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1r07", "type": "num", "prompt": "Pie: half of 50?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1r08", "type": "mcq", "prompt": "Each square in a waffle diagram is …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1%", "ok": true, "fb": ""}, {"t": "10%", "ok": false, "fb": ""}]}], "prac": [{"id": "m6u15s1p01", "type": "num", "prompt": "30 children; a pie chart slice is ⅓. How many?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1p02", "type": "num", "prompt": "Waffle: 60% shaded for 'yes' out of 40 people. 'Yes' people?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1p03", "type": "mcq", "prompt": "A bar chart's scale goes up in 2s. A bar halfway between 6 and 8 shows …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "7", "ok": true, "fb": ""}, {"t": "6.5", "ok": false, "fb": ""}]}, {"id": "m6u15s1p04", "type": "explain", "prompt": "Explain when a pie chart is better than a bar chart.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "showing parts of a whole / proportions", "kw": ["whole|proportion|fraction|share|percent"]}], "need": 1, "model": "When you want to show how a whole is split into parts (proportions), e.g. 'fish is 40% of all votes'.", "hint": "", "reason": "When you want to show how a whole is split into parts (proportions), e.g. 'fish is 40% of all votes'."}, {"id": "m6u15s1p05", "type": "num", "prompt": "Waffle: blue 45, red 30, rest green. Green %?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1p06", "type": "num", "prompt": "Pie chart of 80 people: 'car' is ⅜. How many?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1p07", "type": "mcq", "prompt": "A dot plot is most like a …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "bar chart made of dots", "ok": true, "fb": ""}, {"t": "pie chart", "ok": false, "fb": ""}]}, {"id": "m6u15s1p08", "type": "num", "prompt": "Bar chart: 12, 9, 15, 4. Range?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m6u15s1a01", "type": "explain", "prompt": "* Advanced. Class A (20 pupils) and class B (40 pupils) both have a ¼ 'football' slice. Compare the numbers.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "A 5, B 10", "kw": ["5.*10|10.*5"]}], "need": 1, "model": "Class A: ¼ of 20 = 5; class B: ¼ of 40 = 10 – same fraction, different numbers.", "hint": "", "reason": "Class A: ¼ of 20 = 5; class B: ¼ of 40 = 10 – same fraction, different numbers."}, {"id": "m6u15s1a02", "type": "num", "prompt": "* Advanced. A pie chart has slices of ½, ¼ and ⅛; the rest is 'other' with 6 people. Total people?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 48, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Other = ⅛.", "reason": ""}, {"id": "m6u15s1a03", "type": "mcq", "prompt": "* Advanced. A bar chart's vertical axis starts at 50 – this can …", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "make differences look bigger", "ok": true, "fb": ""}, {"t": "never mislead", "ok": false, "fb": ""}]}], "more": [{"id": "m6u15s1m01", "type": "num", "prompt": "Bars 3, 6, 2. Total?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1m02", "type": "num", "prompt": "Waffle 50 squares shaded. %?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1m03", "type": "num", "prompt": "Pie: quarter of 20?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1m04", "type": "num", "prompt": "Dot plot 4 dots. Votes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s1m05", "type": "mcq", "prompt": "Pie charts show …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "proportions", "ok": true, "fb": ""}, {"t": "change over time", "ok": false, "fb": ""}]}, {"id": "m6u15s1m06", "type": "num", "prompt": "Waffle 100% squares?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u15", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 15.1 notes · Bar charts, dot plots, waffle diagrams and pie charts", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "15.2", "title": "Frequency diagrams, line graphs and scatter graphs", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Growing sunflower", "p": ["A class measures their sunflower's height every week, and also records each pupil's height and arm span.", "Which kind of graph would show the sunflower growing? Which could show whether taller pupils have longer arms? Think about it before you read on."]}, {"k": "recall", "t": "Reading scales", "p": ["On a scale going up in 5s, halfway between 20 and 25 is 22.5."], "qq": {"id": "m6u15s2t01", "type": "num", "prompt": "Halfway between 40 and 50?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "45."}}, {"k": "idea", "t": "Frequency diagrams and line graphs", "p": ["A **frequency diagram** groups measured data (e.g. heights 130–140 cm) with bars touching.", "A **line graph** shows how something **changes over time**: plot points and join them with lines."], "fig": {"kind": "linegraph", "x": {"min": 0, "max": 6, "step": 1, "label": "Week"}, "y": {"min": 0, "max": 120, "step": 20, "label": "Height (cm)"}, "series": [{"pts": [[0, 10], [1, 22], [2, 40], [3, 60], [4, 82], [5, 100], [6, 112]]}]}, "p2": ["The sunflower grew fastest between weeks 3 and 4 (22 cm)."]}, {"k": "idea", "t": "Scatter graphs", "p": ["A **scatter graph** plots pairs of data (height, arm span) as crosses. If the crosses go **up together**, there is a relationship: taller pupils tend to have longer arms.", "Don't join the crosses on a scatter graph."]}, {"k": "try", "t": "Read", "p": [], "qq": {"id": "m6u15s2t02", "type": "num", "prompt": "Sunflower height at week 2 (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "40."}}, {"k": "method", "t": "How do I choose and read these graphs?", "p": ["Step 1: Change over time → line graph.", "Step 2: Grouped measurements → frequency diagram (bars touching).", "Step 3: Two measurements for each person/thing → scatter graph.", "Step 4: Read scales carefully; give titles and labels."]}, {"k": "example", "t": "Growth", "p": [], "q": "Growth from week 1 to week 5?", "steps": [["100 − 22 = 78", ""]], "a": "78 cm"}, {"k": "example", "t": "Between points", "p": [], "q": "Estimate the height at week 3½.", "steps": [["halfway between 60 and 82", ""], ["about 71", ""]], "a": "about 71 cm"}, {"k": "example", "t": "Frequency diagram", "p": [], "q": "Heights: 120–130: 4, 130–140: 9, 140–150: 6. Most common group?", "steps": [["130–140", ""]], "a": "130–140 cm"}, {"k": "example", "t": "Scatter", "p": [], "q": "Crosses for 'hours of TV' and 'test score' go down from left to right.", "steps": [["more TV → lower scores (in this data)", ""]], "a": "as one goes up, the other goes down"}, {"k": "try", "t": "Total", "p": [], "qq": {"id": "m6u15s2t03", "type": "num", "prompt": "Frequency diagram groups 4, 9, 6. Pupils?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 19, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "19."}}, {"k": "error", "t": "Joined scatter points", "p": ["Find the first wrong line."], "q": "Draw a scatter graph of height and arm span.", "lines": ["plot the crosses and join them in order"], "bad": 0, "why": "Scatter graph crosses are NOT joined – each cross is a separate person.", "fix": [["plot crosses only", ""]], "id": "m6u15s2t04"}, {"k": "mistake", "t": "Joining points on a scatter graph", "p": ["Only line graphs join points."]}, {"k": "tip", "t": "Real life", "p": ["Doctors plot children's growth on line graphs; scientists use scatter graphs to look for links."]}, {"k": "summary", "t": "What to remember", "p": ["Line graph: change over time.", "Frequency diagram: grouped data, bars touching.", "Scatter graph: pairs of data, crosses not joined.", "Read scales carefully."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "15.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u15s2k01", "type": "mcq", "prompt": "Before you read on: sunflower growth needs …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a line graph", "ok": true, "fb": ""}, {"t": "a pie chart", "ok": false, "fb": ""}]}}, {"id": "15.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u15s2k02", "type": "num", "prompt": "Growth from week 3 to 4 (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 22, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "15.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u15s2k03", "type": "mcq", "prompt": "Height and arm span → …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "scatter graph", "ok": true, "fb": ""}, {"t": "line graph", "ok": false, "fb": ""}]}}, {"id": "15.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u15s2k04", "type": "num", "prompt": "Quick check: height at week 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 112, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u15s2r01", "type": "num", "prompt": "Sunflower height at week 0?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s2r02", "type": "num", "prompt": "Height at week 5?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s2r03", "type": "num", "prompt": "Growth from week 0 to week 6?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 102, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s2r04", "type": "mcq", "prompt": "Temperature each hour of a day → …", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "line graph", "ok": true, "fb": ""}, {"t": "scatter graph", "ok": false, "fb": ""}]}, {"id": "m6u15s2r05", "type": "mcq", "prompt": "Bars in a frequency diagram for measurements …", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "touch", "ok": true, "fb": ""}, {"t": "have gaps", "ok": false, "fb": ""}]}, {"id": "m6u15s2r06", "type": "num", "prompt": "Groups 3, 7, 5, 1. Total?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u15s2r07", "type": "mcq", "prompt": "Scatter crosses going up together show …", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "as one increases, so does the other", "ok": true, "fb": ""}, {"t": "no link", "ok": false, "fb": ""}]}, {"id": "m6u15s2r08", "type": "num", "prompt": "Halfway between 82 and 100?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 91, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m6u15s2p01", "type": "num", "prompt": "Biggest one-week growth for the sunflower (cm)?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 22, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Weeks 3–4.", "reason": ""}, {"id": "m6u15s2p02", "type": "mcq", "prompt": "When did growth slow down most?", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "weeks 5–6 (12 cm)", "ok": true, "fb": ""}, {"t": "weeks 0–1", "ok": false, "fb": ""}]}, {"id": "m6u15s2p03", "type": "mcq", "prompt": "Heights grouped 120–130, 130–140 … are shown with …", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t":