rt", "prompt": "The bar chart shows favourite fruits. What is the mode?", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["mango", "Mango"], "fig": {"kind": "barchart", "labels": ["apple", "banana", "mango", "orange"], "values": [5, 6, 8, 4], "ymax": 10, "step": 2, "ylabel": "Children"}}, {"id": "m5u04s1m02", "type": "num", "prompt": "The table shows shoe sizes in a group. What is the modal shoe size?", "diff": "M", "obj": "O1", "skill": "Data", "answer": 26, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "data": {"head": ["Size", "22", "24", "26", "28", "30"], "rows": [["Children", "1", "4", "6", "5", "3"]]}, "bare": true}, {"id": "m5u04s1m03", "type": "num", "prompt": "Find the mode of 14, 15, 14, 14, 1, 18.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m5u04s1m04", "type": "mcq", "prompt": "What is the mode of 2, 23, 22, 7, 6?", "diff": "M", "obj": "O1", "skill": "Reasoning", "options": [{"t": "there is no mode", "ok": true, "fb": "Correct."}, {"t": "2", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "23", "ok": false, "fb": "Not quite – work through the method again."}]}, {"id": "m5u04s1m05", "type": "table", "prompt": "Dice scores: 3, 5, 6, 2, 4, 3, 2, 1, 2, 4. Complete the tally table.", "diff": "M", "obj": "O1", "skill": "Data", "head": ["Score", "1", "2", "3", "4", "5", "6"], "rows": [["Frequency", {"ans": 1}, {"ans": 3}, {"ans": 2}, {"ans": 2}, {"ans": 1}, {"ans": 1}]]}, {"id": "m5u04s1m06", "type": "short", "prompt": "The table shows how many goals were scored in some matches. What is the modal number of goals?", "diff": "M", "obj": "O1", "skill": "Data", "accept": ["2"], "data": {"head": ["Goals", "0", "1", "2", "3", "4"], "rows": [["Matches", "6", "5", "8", "3", "2"]]}}, {"id": "m5u04s1m07", "type": "mcq", "prompt": "What are the modes of 19, 6, 7, 7, 6?", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "6 only", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "there is no mode", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "6 and 7", "ok": true, "fb": "Correct."}, {"t": "19", "ok": false, "fb": "Not quite – work through the method again."}]}, {"id": "m5u04s1m08", "type": "num", "prompt": "The numbers 2, 9, 2, 8, 3 have mode 2. Which number could you add so that 2 is still the only mode?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m5u04s1m09", "type": "short", "prompt": "The bar chart shows favourite fruits. What is the mode?", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["mango", "Mango"], "fig": {"kind": "barchart", "labels": ["apple", "banana", "mango", "orange"], "values": [3, 7, 8, 4], "ymax": 10, "step": 2, "ylabel": "Children"}}, {"id": "m5u04s1m10", "type": "num", "prompt": "The table shows shoe sizes in a group. What is the modal shoe size?", "diff": "M", "obj": "O1", "skill": "Data", "answer": 28, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "data": {"head": ["Size", "22", "24", "26", "28", "30"], "rows": [["Children", "1", "2", "3", "6", "4"]]}, "bare": true}, {"id": "m5u04s1m11", "type": "num", "prompt": "Find the mode of 9, 6, 14, 14, 1, 14.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}, {"id": "m5u04s1m12", "type": "mcq", "prompt": "What is the mode of 23, 27, 24, 1, 8?", "diff": "M", "obj": "O1", "skill": "Reasoning", "options": [{"t": "there is no mode", "ok": true, "fb": "Correct."}, {"t": "23", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "27", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "1", "ok": false, "fb": "Not quite – work through the method again."}]}, {"id": "m5u04s1m13", "type": "table", "prompt": "Dice scores: 4, 2, 2, 6, 5, 4, 3, 6, 4, 4. Comp