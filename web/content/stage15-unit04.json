, {"k": "example", "t": "Odd number of values", "p": [], "q": "Find the median of 12, 7, 15, 9, 10.", "steps": [["In order: 7, 9, 10, 12, 15", ""], ["Middle: 10", ""]], "a": "10"}, {"k": "example", "t": "Even number of values", "p": [], "q": "Find the median of 8, 3, 11, 6.", "steps": [["In order: 3, 6, 8, 11", ""], ["Halfway between 6 and 8", ""]], "a": "7"}, {"k": "mistake", "t": "Forgetting to order", "p": ["The median of 9, 2, 5 is 5 (2, 5, 9), not 2."]}, {"k": "tip", "t": "Cross off from both ends", "p": ["Crossing off pairs from each end is a reliable way to find the middle."]}], "video": {"src": null, "offset": 0, "dur": 300, "range": ""}, "stops": [{"id": "4.2-k2", "t": 2, "after": -1, "review": [0, 0], "note": "", "q": {"id": "m5u04s2k02", "type": "mcq", "prompt": "Before you read on: what is the median of 9, 2, 6?", "diff": "M", "obj": "O2", "skill": "Reasoning", "options": [{"t": "2", "ok": false, "fb": "Put the numbers in order first: 2, 6, 9."}, {"t": "9", "ok": false, "fb": "The median is the middle value."}, {"t": "6", "ok": true, "fb": "Correct."}]}}, {"id": "4.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u04s2k01", "type": "num", "prompt": "Find the median of 7, 1, 4, 9, 5.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u04s2r01", "type": "num", "prompt": "The table shows children's heights in cm. Find the median height.", "diff": "M", "obj": "O2", "skill": "Data", "answer": 127, "unit": "cm", "units": ["cm"], "tol": 0, "errs": [], "data": {"head": ["Name", "Ana", "Cai", "Gia", "Finn", "Dev"], "rows": [["Height (cm)", "128", "122", "127", "147", "125"]]}}, {"id": "m5u04s2r02", "type": "num", "prompt": "The bar chart shows how many books were borrowed each day. Find the median.", "diff": "M", "obj": "O2", "skill": "Figure", "answer": 14, "unit": "books", "units": ["books"], "tol": 0