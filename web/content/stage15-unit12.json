{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 12, "stage": 15, "title": "Data", "strandShort": "Statistics and probability", "blurb": "Tally charts, frequency tables, bar charts, dot plots and pictograms, frequency diagrams for grouped data, and line graphs showing change.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u12.pdf"}, "objectives": {"O1": {"code": "5Ss.01", "sec": "12.1", "codeNote": "", "t": "Record, organise, represent and interpret data in tables, bar charts, dot plots and pictograms."}, "O2": {"code": "5Ss.02", "sec": "12.2", "codeNote": "", "t": "Represent and interpret grouped data in frequency diagrams and data that changes over time in line graphs."}}, "sections": [{"id": "12.1", "title": "Representing and interpreting data", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Lunch choices", "p": ["The school kitchen asks **40 pupils** what they want for lunch: pasta, rice, soup or salad.", "How could the cook show the answers so they are easy to read at a glance? Think about it before you read on."]}, {"k": "recall", "t": "Tally and frequency", "p": ["𝍸 ||| = 8."], "qq": {"id": "m5u12s1t01", "type": "num", "prompt": "𝍸 𝍸 | = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 11, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "11."}}, {"k": "idea", "t": "Tables and bar charts", "p": ["Record data in a **frequency table**, then draw a **bar chart**: bars of equal width, a labelled scale, gaps between bars for categories."], "table": {"head": ["Lunch", "Frequency"], "rows": [["pasta", "14"], ["rice", "10"], ["soup", "6"], ["salad", "10"]]}, "fig": {"kind": "barchart", "labels": ["pasta", "rice", "soup", "salad"], "values": [14, 10, 6, 10], "ymax": 16, "step": 2, "ylabel": "Pupils"}, "p2": ["Pasta is the **mode** (most popular). 14 + 10 + 6 + 10 = 40 ✓."]}, {"k": "idea", "t": "Pictograms and dot plots", "p": ["A **pictogram** uses a symbol with a **key**, e.g. ● = 4 pupils, so ●●◐ = 10 (half a symbol = 2).", "A **dot plot** puts one dot above a number line for each value – good for small numbers like shoe sizes."]}, {"k": "try", "t": "Read it", "p": [], "qq": {"id": "m5u12s1t02", "type": "num", "prompt": "How many more pupils chose pasta than soup?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "14 − 6.", "reason": "8."}}, {"k": "method", "t": "How do I represent and read data?", "p": ["Step 1: Collect with tallies; total each group.", "Step 2: Choose a chart: bar chart, pictogram (with key) or dot plot.", "Step 3: Label axes and choose a sensible scale.", "Step 4: Read values carefully; compare and total."]}, {"k": "example", "t": "Pictogram", "p": [], "q": "Key ★ = 6 books. Row: ★★★ and half a star.", "steps": [["3 × 6 = 18", ""], ["half = 3", ""]], "a": "21 books"}, {"k": "example", "t": "Scale", "p": [], "q": "Bar chart scale goes up in 4s. A bar ends halfway between 20 and 24.", "steps": [["each gap is 4, half of 4 is 2", ""], ["20 + 2", ""]], "a": "22"}, {"k": "example", "t": "Total", "p": [], "q": "Frequencies 7, 12, 9, 2.", "steps": [["7 + 12 + 9 + 2", ""]], "a": "30"}, {"k": "example", "t": "Dot plot", "p": [], "q": "Shoe sizes: 3 dots above 4, 5 above 5, 2 above 6. Mode?", "steps": [["tallest column", ""]], "a": "size 5"}, {"k": "try", "t": "Key", "p": [], "qq": {"id": "m5u12s1t03", "type": "num", "prompt": "Key ● = 4. ●●●● = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "16."}}, {"k": "error", "t": "Ignoring the key", "p": ["Find the first wrong line."], "q": "Key ■ = 5 cars. Row: ■■■", "lines": ["3 cars"], "bad": 0, "why": "Each symbol is 5 cars: 3 × 5 = 15.", "fix": [["15 cars", ""]], "id": "m5u12s1t04"}, {"k": "mistake", "t": "Ignoring the key or the scale", "p": ["Always check what one symbol or one square stands for."]}, {"k": "tip", "t": "Real life", "p": ["Canteens, shops and sports teams use charts to decide what to buy and plan."]}, {"k": "summary", "t": "What to remember", "p": ["Frequency table → bar chart, pictogram, dot plot.", "Check keys and scales.", "Mode = most common.", "Totals check your work."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "12.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u12s1k01", "type": "mcq", "prompt": "Before you read on: a good way to show the choices?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a bar chart", "ok": true, "fb": ""}, {"t": "a long list of names", "ok": false, "fb": ""}]}}, {"id": "12.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u12s1k02", "type": "num", "prompt": "Pupils who chose rice or salad?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u12s1k03", "type": "num", "prompt": "★ = 6. ★★★ and a half = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 21, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u12s1k04", "type": "num", "prompt": "Quick check: ■ = 5. ■■■ = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u12s1r01", "type": "num", "prompt": "Frequencies 5, 8, 3. Total?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1r02", "type": "num", "prompt": "Key ◆ = 2. ◆◆◆◆◆ = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1r03", "type": "num", "prompt": "Key ◆ = 10. ◆◆ and half a ◆ = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1r04", "type": "mcq", "prompt": "Mode of: red 6, blue 9, green 4?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "blue", "ok": true, "fb": ""}, {"t": "green", "ok": false, "fb": ""}]}, {"id": "m5u12s1r05", "type": "num", "prompt": "Bar chart: football 12, tennis 7. Difference?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1r06", "type": "mcq", "prompt": "A pictogram must have a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "key", "ok": true, "fb": ""}, {"t": "line", "ok": false, "fb": ""}]}, {"id": "m5u12s1r07", "type": "num", "prompt": "Dot plot: 4 dots above 7. How many 7s?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1r08", "type": "num", "prompt": "Tally 𝍸 𝍸 𝍸 ||| = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m5u12s1p01", "type": "num", "prompt": "Key ● = 8. How many symbols for 20?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1p02", "type": "num", "prompt": "40 pupils; 14 pasta, 10 rice, 6 soup. Salad?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1p03", "type": "explain", "prompt": "Why should bars in a bar chart all be the same width?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "fair comparison / height shows value", "kw": ["fair|compare|height|mislead|same"]}], "need": 1, "model": "So only the height shows the frequency – wider bars would look bigger and mislead.", "hint": "", "reason": "So only the height shows the frequency – wider bars would look bigger and mislead."}, {"id": "m5u12s1p04", "type": "mcq", "prompt": "Scale goes up in 4s. A bar is halfway between 8 and 12. Value?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "10", "ok": true, "fb": ""}, {"t": "9", "ok": false, "fb": ""}]}, {"id": "m5u12s1p05", "type": "num", "prompt": "Votes: cat 9, dog 11, fish 4, other 6. How many voted?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1p06", "type": "num", "prompt": "Same data: how many did NOT vote dog?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 19, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1p07", "type": "mcq", "prompt": "Best chart for shoe sizes of 15 children?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "dot plot", "ok": true, "fb": ""}, {"t": "line graph", "ok": false, "fb": ""}]}, {"id": "m5u12s1p08", "type": "num", "prompt": "Key ■ = 4. Show 14 – how many symbols?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m5u12s1a01", "type": "explain", "prompt": "* Advanced. Choose a key for a pictogram showing 30, 45 and 60. Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "15 or 5 etc", "kw": ["\\b(5|15)\\b"]}], "need": 1, "model": "e.g. 1 symbol = 15 (2, 3, 4 symbols) – all are multiples of 15.", "hint": "", "reason": "e.g. 1 symbol = 15 (2, 3, 4 symbols) – all are multiples of 15."}, {"id": "m5u12s1a02", "type": "num", "prompt": "* Advanced. A bar chart shows A 12, B twice A, C half of B. Total?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 48, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "12 + 24 + 12.", "reason": ""}, {"id": "m5u12s1a03", "type": "mcq", "prompt": "* Advanced. A chart's scale starts at 50 instead of 0. What is the danger?", "diff": "VH", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "small differences look big", "ok": true, "fb": ""}, {"t": "nothing", "ok": false, "fb": ""}]}], "more": [{"id": "m5u12s1m01", "type": "num", "prompt": "Frequencies 2, 3, 5. Total?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1m02", "type": "num", "prompt": "Key ▲ = 3. ▲▲▲ = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1m03", "type": "mcq", "prompt": "Mode of: A 4, B 2, C 7?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "C", "ok": true, "fb": ""}, {"t": "A", "ok": false, "fb": ""}]}, {"id": "m5u12s1m04", "type": "num", "prompt": "Tally 𝍸 || = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1m05", "type": "num", "prompt": "Bars 6 and 9. Difference?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u12s1m06", "type": "num", "prompt": "Key ● = 2. ●● = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u12", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 12.1 notes · Representing and interpreting data", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "12.2", "title": "Frequency diagrams and line graphs", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Plant growth", "p": ["A class measures a sunflower every week and records the heights of 30 seedlings on one day.", "Which needs a graph that shows change over time, and which needs groups? Think about it before you read on."]}, {"k": "recall", "t": "Reading scales", "p": ["A scale in 10s: halfway between 40 and 50 is 45."], "qq": {"id": "m5u12s2t01", "type": "num", "prompt": "Halfway between 20 and 40?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "30."}}, {"k": "idea", "t": "Grouped data and frequency diagrams", "p": ["When data has many different values, put it into **equal groups** (classes) like 0–9, 10–19, 20–29. A **frequency diagram** is a bar chart of the groups with **no gaps** between bars."], "table": {"head": ["Height (cm)", "Frequency"], "rows": [["0–9", "4"], ["10–19", "11"], ["20–29", "12"], ["30–39", "3"]]}, "fig": {"kind": "barchart", "labels": ["0–9", "10–19", "20–29", "30–39"], "values": [4, 11, 12, 3], "ymax": 14, "step": 2, "ylabel": "Seedlings", "gap": false}}, {"k": "idea", "t": "Line graphs", "p": ["A **line graph** shows how something **changes over time**. Plot points and join them; read between points to estimate."], "fig": {"kind": "linegraph", "x": {"min": 0, "max": 6, "step": 1, "label": "Week"}, "y": {"min": 0, "max": 100, "step": 20, "label": "Height (cm)"}, "series": [{"pts": [[0, 5], [1, 12], [2, 25], [3, 42], [4, 60], [5, 74], [6, 85]]}]}, "p2": ["The fastest growth was between weeks 3 and 4 (+18 cm)."]}, {"k": "try", "t": "Group", "p": [], "qq": {"id": "m5u12s2t02", "type": "num", "prompt": "How many seedlings were 10–29 cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 23, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "11 + 12.", "reason": "23."}}, {"k": "method", "t": "How do I use frequency diagrams and line graphs?", "p": ["Step 1: Lots of different values → group them equally; draw bars with no gaps.", "Step 2: Change over time → line graph with time on the horizontal axis.", "Step 3: Read the scale carefully.", "Step 4: Describe trends: rising, falling, steady."]}, {"k": "example", "t": "Group a value", "p": [], "q": "A seedling is 19 cm. Which group?", "steps": [["10–19 includes 19", ""]], "a": "10–19"}, {"k": "example", "t": "Read the line graph", "p": [], "q": "Height at week 2?", "steps": [["point at 25", ""]], "a": "25 cm"}, {"k": "example", "t": "Change", "p": [], "q": "Growth from week 4 to week 6?", "steps": [["85 − 60", ""]], "a": "25 cm"}, {"k": "example", "t": "Estimate between points", "p": [], "q": "Height at week 2½?", "steps": [["between 25 and 42", ""]], "a": "about 33 cm"}, {"k": "try", "t": "Graph", "p": [], "qq": {"id": "m5u12s2t03", "type": "num", "prompt": "Height at week 5 (cm)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 74, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "74."}}, {"k": "error", "t": "Overlapping groups", "p": ["Find the first wrong line."], "q": "Groups for ages: 0–10, 10–20, 20–30.", "lines": ["A 10-year-old goes in 0–10 or 10–20."], "bad": 0, "why": "Groups must not overlap: use 0–9, 10–19, 20–29.", "fix": [["0–9, 10–19, 20–29", ""]], "id": "m5u12s2t04"}, {"k": "mistake", "t": "Overlapping groups", "p": ["Each value must fit in exactly one group."]}, {"k": "tip", "t": "Real life", "p": ["Doctors plot children's growth on line graphs; weather services show temperature through the day."]}, {"k": "summary", "t": "What to remember", "p": ["Equal, non-overlapping groups; no gaps in frequency diagrams.", "Line graphs show change over time.", "Read scales carefully; describe the trend."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "12.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u12s2k01", "type": "mcq", "prompt": "Before you read on: weekly heights of one plant need a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "line graph", "ok": true, "fb": ""}, {"t": "pictogram", "ok": false, "fb": ""}]}}, {"id": "12.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u12s2k02", "type": "num", "prompt": "Seedlings in all groups?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.2-k3", "t": 3, "after": 9, "review": [0, 0], "not