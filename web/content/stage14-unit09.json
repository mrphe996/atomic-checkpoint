, "accept": ["1050, 1500, 1505", "/^\\s*1050\\s*[,; ]\\s*1500\\s*[,; ]\\s*1505\\s*$/"], "hint": "", "reason": ""}], "prac": [{"id": "m4u09s1p01", "type": "num", "prompt": "9950 to the nearest 100?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1p02", "type": "num", "prompt": "4995 to the nearest 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1p03", "type": "short", "prompt": "Order from largest: 7203, 7230, 7023, 7320. Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["7320, 7230, 7203, 7023", "/^\\s*7320\\s*[,; ]\\s*7230\\s*[,; ]\\s*7203\\s*[,; ]\\s*7023\\s*$/"], "hint": "", "reason": ""}, {"id": "m4u09s1p04", "type": "explain", "prompt": "Explain why 3449 rounds to 3000 (nearest 1000), not 4000.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "hundreds digit 4", "kw": ["4|hundred"]}, {"pt": "round down", "kw": ["down|less than 5|under 5|below"]}], "need": 2, "model": "The hundreds digit is 4, which is less than 5, so we round down to 3000.", "hint": "", "reason": "The hundreds digit is 4, which is less than 5, so we round down to 3000."}, {"id": "m4u09s1p05", "type": "num", "prompt": "Smallest whole number that rounds to 600 (nearest 100)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 550, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1p06", "type": "num", "prompt": "Largest whole number that rounds to 600 (nearest 100)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 649, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1p07", "type": "mcq", "prompt": "A crowd of 2847. Nearest 1000?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3000", "ok": true, "fb": ""}, {"t": "2000", "ok": false, "fb": ""}]}, {"id": "m4u09s1p08", "type": "mcq", "prompt": "Which is true?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "6010 > 6001", "ok": true, "fb": ""}, {"t": "6010 < 6001", "ok": false, "fb": ""}]}], "adv": [{"id": "m4u09s1a01", "type": "explain", "prompt": "* Advanced. A number rounds to 4000 (nearest 1000) and 4500 (nearest 100). Give one possible number.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "between 4450 and 4499", "kw": ["44[5-9]\\d"]}], "need": 1, "model": "Any whole number from 4450 to 4499, e.g. 4460.", "hint": "", "reason": "Any whole number from 4450 to 4499, e.g. 4460."}, {"id": "m4u09s1a02", "type": "num", "prompt": "* Advanced. Using 5, 0, 7, 2 once each: the largest number below 6000?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 5720, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1a03", "type": "num", "prompt": "* Advanced. How many whole numbers round to 70 (nearest 10)?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "65 to 74.", "reason": ""}], "more": [{"id": "m4u09s1m01", "type": "num", "prompt": "23 to the nearest 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1m02", "type": "num", "prompt": "350 to the nearest 100?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 400, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1m03", "type": "num", "prompt": "1200 to the nearest 1000?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1m04", "type": "mcq", "prompt": "2000 ☐ 1999", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": ">", "ok": true, "fb": ""}, {"t": "<", "ok": false, "fb": ""}]}, {"id": "m4u09s1m05", "type": "num", "prompt": "85 to the nearest 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u09s1m06", "type": "mcq", "prompt": "Bigger: 3456 or 3465?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3465", "ok": true, "fb": ""}, {"t": "3456", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c4u09", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 9.1 notes · Rounding, ordering and comparing whole numbers", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "9.2", "title": "Division of 2-digit numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Football teams", "p": ["**58 children** want to play football. Each team needs **5 players**.", "How many full teams can be made? How many children are left over? Try it before you read on."]}, {"k": "recall", "t": "Division facts", "p": ["50 ÷ 5 = 10."], "qq": {"id": "m4u09s2t01", "type": "num", "prompt": "45 ÷ 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "9."}}, {"k": "idea", "t": "Dividing by chunking", "p": ["Take away **chunks** you know: 58 − 50 (10 teams) = 8; 8 − 5 (1 team) = 3. So 58 ÷ 5 = **11 r 3** – 11 teams and 3 children left.", "A **remainder** is what is left over. It is always smaller than the number you divide by."]}, {"k": "idea", "t": "Partitioning", "p": ["Split the number into parts that divide easily: 84 ÷ 4 = 80 ÷ 4 + 4 ÷ 4 = 20 + 1 = **21**."], "table": {"head": ["Division", "Split", "Answer"], "rows": [["69 ÷ 3", "60 ÷ 3 + 9 ÷ 3", "23"], ["76 ÷ 4", "40 ÷ 4 + 36 ÷ 4", "19"], ["47 ÷ 6", "42 ÷ 6 = 7, 5 left", "7 r 5"]]}}, {"k": "try", "t": "Divide", "p": [], "qq": {"id": "m4u09s2t02", "type": "num", "prompt": "96 ÷ 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 32, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "90 ÷ 3 + 6 ÷ 3.", "reason": "32."}}, {"k": "method", "t": "How do I divide a 2-digit number?", "p": ["Step 1: Find a big multiple you know (like 10 lots).", "Step 2: Take it away and keep going.", "Step 3: Count the lots; what is left is the remainder.", "Step 4: Check: answer × divisor + remainder = start number."]}, {"k": "example", "t": "Exact", "p": [], "q": "72 ÷ 6.", "steps": [["60 ÷ 6 = 10", ""], ["12 ÷ 6 = 2", ""]], "a": "12"}, {"k": "example", "t": "Remainder", "p": [], "q": "38 ÷ 4.", "steps": [["36 ÷ 4 = 9", ""], ["2 left", ""]], "a": "9 r 2"}, {"k": "example", "t": "Check", "p": [], "q": "Check 38 ÷ 4 = 9 r 2.", "steps": [["9 × 4 = 36", ""], ["36 + 2 = 38 ✓", ""]], "a": "correct"}, {"k": "example", "t": "Story", "p": [], "q": "50 pencils, 8 per pot. Full pots?", "steps": [["50 ÷ 8 = 6 r 2", ""]], "a": "6 full pots"}, {"k": "try", "t": "Remainder", "p": [], "qq": {"id": "m4u09s2t03", "type": "short", "prompt": "29 ÷ 3? Write it like 7 r 2.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["9 r 2", "/^\\s*9\\s*r(em(ainder)?)?\\s*2\\s*$/i"], "hint": "", "reason": "9 r 2."}}, {"k": "error", "t": "Remainder too big", "p": ["Find the first wrong line."], "q": "58 ÷ 5", "lines": ["10 r 8"], "bad": 0, "why": "8 is more than 5, so another 5 fits: 11 r 3.", "fix": [["11 r 3", ""]], "id": "m4u09s2t04"}, {"k": "mistake", "t": "Leaving a remainder bigger than the divisor", "p": ["The remainder must be smaller than the number you divide by."]}, {"k": "tip", "t": "Real life", "p": ["Making teams, packing boxes and sharing sweets all use d