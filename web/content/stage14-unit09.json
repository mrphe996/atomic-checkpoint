{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 9, "stage": 14, "title": "Comparing, Rounding and Dividing", "strandShort": "Number", "blurb": "Rounding to the nearest 10, 100 and 1000, ordering and comparing 4-digit numbers, and dividing 2-digit numbers by 1-digit numbers with remainders.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u09.pdf"}, "objectives": {"O1": {"code": "4Np.02", "sec": "9.1", "codeNote": "", "t": "Round numbers to the nearest 10, 100 or 1000, and order and compare 4-digit numbers."}, "O2": {"code": "4Nc.05", "sec": "9.2", "codeNote": "", "t": "Divide 2-digit numbers by 1-digit numbers, including answers with remainders."}}, "sections": [{"id": "9.1", "title": "Rounding, ordering and comparing whole numbers", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Mountain heights", "p": ["Two mountains are **3478 m** and **3487 m** tall. A sign says one is 'about 3500 m'.", "Which is taller? Could both be 'about 3500 m'? Think before you read on."]}, {"k": "recall", "t": "Place value", "p": ["In 3478, the 4 is worth 400."], "qq": {"id": "m4u09s1t01", "type": "num", "prompt": "Value of the 8 in 3487?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 80, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "80."}}, {"k": "idea", "t": "Comparing and ordering", "p": ["Compare digits from the **left**: 3478 and 3487 – thousands 3 = 3, hundreds 4 = 4, tens **7 < 8**. So **3478 < 3487**.", "Use < (less than) and > (greater than). Order by comparing place by place."]}, {"k": "idea", "t": "Rounding", "p": ["To round, look at the digit to the **right** of the place you are rounding to: **5 or more → round up**; **4 or less → round down**."], "table": {"head": ["Number", "Nearest 10", "Nearest 100", "Nearest 1000"], "rows": [["3478", "3480", "3500", "3000"], ["3487", "3490", "3500", "3000"], ["6250", "6250", "6300", "6000"]]}, "p2": ["Both mountains are about 3500 m to the nearest 100."]}, {"k": "try", "t": "Round", "p": [], "qq": {"id": "m4u09s1t02", "type": "num", "prompt": "2763 to the nearest 100?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2800, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2800."}}, {"k": "method", "t": "How do I round a number?", "p": ["Step 1: Find the digit in the place you are rounding to.", "Step 2: Look at the digit to its right.", "Step 3: 5 or more: round up. 4 or less: round down.", "Step 4: Replace the digits to the right with zeros."]}, {"k": "example", "t": "Nearest 10", "p": [], "q": "4326.", "steps": [["ones digit 6 → up", ""]], "a": "4330"}, {"k": "example", "t": "Nearest 1000", "p": [], "q": "7499.", "steps": [["hundreds digit 4 → down", ""]], "a": "7000"}, {"k": "example", "t": "Order", "p": [], "q": "Order 5302, 5032, 5320.", "steps": [["hundreds: 3, 0, 3", ""], ["tens: 0 vs 2", ""]], "a": "5032, 5302, 5320"}, {"k": "example", "t": "Halfway", "p": [], "q": "850 to the nearest 100.", "steps": [["tens digit 5 → up", ""]], "a": "900"}, {"k": "try", "t": "Compare", "p": [], "qq": {"id": "m4u09s1t03", "type": "mcq", "prompt": "6049 ☐ 6094", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": true, "fb": ""}, {"t": ">", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Rounding down at 5", "p": ["Find the first wrong line."], "q": "Round 2650 to the nearest 100.", "lines": ["tens digit 5 → round down → 2600"], "bad": 0, "why": "5 rounds UP: 2700.", "fix": [["2700", ""]], "id": "m4u09s1t04"}, {"k": "mistake", "t": "Rounding 5 down", "p": ["5 or more rounds up."]}, {"k": "tip", "t": "Real life", "p": ["News reports round crowd sizes ('about 4000 fans'), and shops round prices to compare."]}, {"k": "summary", "t": "What to remember", "p": ["Compare from the left.", "< less than, > greater than.", "Round: 5 or more up, 4 or less down."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "9.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u09s1k01", "type": "mcq", "prompt": "Before you read on: taller?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3487 m", "ok": true, "fb": ""}, {"t": "3478 m", "ok": false, "fb": ""}]}}, {"id": "9.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u09s1k02", "type": "num", "prompt": "3478 to the nearest 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3480, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "9.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u09s1k03", "type": "num", "prompt": "7499 to the nearest 1000?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7000, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "9.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u09s1k04", "type": "num", "prompt": "Quick check: 2650 to the nearest 100?", "diff":