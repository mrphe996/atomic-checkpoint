{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 7, "stage": 14, "title": "Fractions", "strandShort": "Number", "blurb": "Fractions as parts of a whole and as division, unit and non-unit fractions, and finding fractions of numbers and quantities.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u07.pdf"}, "objectives": {"O1": {"code": "4Nf.01", "sec": "7.1", "codeNote": "", "t": "Understand fractions as parts of a whole and as the result of a division."}, "O2": {"code": "4Nf.02", "sec": "7.2", "codeNote": "", "t": "Use fractions as operators to find fractions of numbers and quantities."}}, "sections": [{"id": "7.1", "title": "Understanding fractions", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Sharing pizza", "p": ["**3 pizzas** are shared equally by **4 friends**.", "How much pizza does each friend get? Is it more or less than one whole pizza? Think before you read on."]}, {"k": "recall", "t": "Halves and quarters", "p": ["A whole cut into 4 equal parts gives quarters."], "qq": {"id": "m4u07s1t01", "type": "num", "prompt": "How many quarters make a whole?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "idea", "t": "Parts of a whole", "p": ["A **fraction** shows equal parts of a whole. In ¾ the **denominator** (4) says how many equal parts; the **numerator** (3) says how many we have."], "table": {"head": ["Fraction", "Meaning"], "rows": [["1/2", "1 of 2 equal parts"], ["3/4", "3 of 4 equal parts"], ["2/5", "2 of 5 equal parts"], ["5/8", "5 of 8 equal parts"]]}, "p2": ["The parts must be **equal** – otherwise it is not a fraction."]}, {"k": "idea", "t": "Fractions as division", "p": ["A fraction is also a **division**: 3 ÷ 4 = **¾**. Each friend gets ¾ of a pizza – less than one whole.", "In the same way 1 ÷ 2 = ½, 2 ÷ 5 = ⅖."]}, {"k": "try", "t": "Division", "p": [], "qq": {"id": "m4u07s1t02", "type": "num", "prompt": "2 cakes shared by 3 people. Each gets? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6666666666666666, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "2/3."}}, {"k": "method", "t": "How do I name a fraction?", "p": ["Step 1: Check the parts are equal.", "Step 2: Count all the parts → denominator.", "Step 3: Count the parts you want → numerator.", "Step 4: Sharing: things ÷ people = fraction each."]}, {"k": "example", "t": "Shaded", "p": [], "q": "A bar has 5 equal parts; 2 are shaded.", "steps": [["2 of 5", ""]], "a": "2/5"}, {"k": "example", "t": "Not shaded", "p": [], "q": "8 equal parts; 3 shaded. Fraction not shaded?", "steps": [["8 − 3 = 5", ""]], "a": "5/8"}, {"k": "example", "t": "Sharing", "p": [], "q": "1 chocolate bar shared by 6 children.", "steps": [["1 ÷ 6", ""]], "a": "1/6 each"}, {"k": "example", "t": "Whole", "p": [], "q": "4/4 of a cake.", "steps": [["all 4 parts", ""]], "a": "1 whole"}, {"k": "try", "t": "Name", "p": [], "qq": {"id": "m4u07s1t03", "type": "num", "prompt": "10 equal parts, 7 shaded. Fraction shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.7, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "7/10."}}, {"k": "error", "t": "Unequal parts", "p": ["Find the first wrong line."], "q": "A circle is cut into 4 pieces of different sizes. One piece is shaded.", "lines": ["One of 4 pieces is shaded, so ¼."], "bad": 0, "why": "The pieces are not equal, so it is not ¼.", "fix": [["not ¼ – parts are not equal", ""]], "id": "m4u07s1t04"}, {"k": "mistake", "t": "Forgetting the parts must be equal", "p": ["Fractions only work with equal parts."]}, {"k": "tip", "t": "Real life", "p": ["Sharing pizza, cutting cake and reading recipes (½ cup) all use fractions."]}, {"k": "summary", "t": "What to remember", "p": ["Denominator: equal parts in the whole.", "Numerator: parts we have.", "a ÷ b = a/b."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "7.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u07s1k01", "type": "mcq", "prompt": "Before you read on: each friend gets…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "¾ of a pizza", "ok": true, "fb": ""}, {"t": "more than 1 pizza", "ok": false, "fb": ""}]}}, {"id": "7.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u07s1k02", "type": "num", "prompt": "The denominator of 5/8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u07s1k03", "type": "num", "prompt": "8 parts, 3 shaded. Not shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.625, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u07s1k04", "type": "num", "prompt": "Quick check: 1 ÷ 6? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.16666666666666666, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u07s1r01", "type": "num", "prompt": "4 equal parts, 1 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r02", "type": "num", "prompt": "3 equal parts, 2 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6666666666666666, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r03", "type": "num", "prompt": "6 equal parts, 5 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.8333333333333334, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r04", "type": "num", "prompt": "Numerator of 3/7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r05", "type": "num", "prompt": "1 ÷ 3? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.3333333333333333, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r06", "type": "num", "prompt": "3 ÷ 5? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r07", "type": "num", "prompt": "5 equal parts, 1 not shaded. Shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.8, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1r08", "type": "num", "prompt": "How many fifths make a whole?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m4u07s1p01", "type": "num", "prompt": "3 pies shared by 5 people. Each? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1p02", "type": "num", "prompt": "A week. What fraction are weekend days? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.2857142857142857, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1p03", "type": "mcq", "prompt": "Which is bigger: ⅓ or ⅕ of the same pizza?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "⅓", "ok": true, "fb": "Fewer, bigger pieces."}, {"t": "⅕", "ok": false, "fb": ""}]}, {"id": "m4u07s1p04", "type": "explain", "prompt": "Explain what ⅝ means.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "8 equal parts", "kw": ["8|eight"]}, {"pt": "5 of them", "kw": ["5|five"]}], "need": 2, "model": "The whole is split into 8 equal parts and we have 5 of them.", "hint": "", "reason": "The whole is split into 8 equal parts and we have 5 of them."}, {"id": "m4u07s1p05", "type": "num", "prompt": "12 eggs; 5 are brown. Fraction brown? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.4166666666666667, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1p06", "type": "num", "prompt": "Fraction of an hour is 15 minutes? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1p07", "type": "mcq", "prompt": "Is 3 ÷ 4 more or less than 1?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "less", "ok": true, "fb": ""}, {"t": "more", "ok": false, "fb": ""}]}, {"id": "m4u07s1p08", "type": "num", "prompt": "4 friends share 1 melon. Each? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m4u07s1a01", "type": "mcq", "prompt": "* Advanced. 5 pizzas shared by 4 friends. Each gets…", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "more than 1 pizza (5/4)", "ok": true, "fb": ""}, {"t": "less than 1", "ok": false, "fb": ""}]}, {"id": "m4u07s1a02", "type": "explain", "prompt": "* Advanced. Is ½ of a small cake the same amount as ½ of a big cake? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|not|different"]}, {"pt": "whole differs", "kw": ["whole|size|bigger|smaller"]}], "need": 2, "model": "No – a fraction depends on the size of the whole.", "hint": "", "reason": "No – a fraction depends on the size of the whole."}, {"id": "m4u07s1a03", "type": "num", "prompt": "* Advanced. 30 children; 12 walk to school. Fraction who do NOT walk? Give your answer as a fraction in its simplest form.", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 0.6, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "18/30.", "reason": ""}], "more": [{"id": "m4u07s1m01", "type": "num", "prompt": "2 equal parts, 1 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1m02", "type": "num", "prompt": "4 equal parts, 3 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.75, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1m03", "type": "num", "prompt": "Denominator of 2/9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1m04", "type": "num", "prompt": "1 ÷ 5? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.2, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1m05", "type": "num", "prompt": "How many thirds make a whole?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u07s1m06", "type": "num", "prompt": "10 equal parts, 1 shaded? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.1, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u07", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 7.1 notes · Understanding fractions", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "7.2", "title": "Fractions as operators", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Class trip", "p": ["There are **24 children** in a class. **⅓** go on the museum trip; **¾** have packed lunch.", "How many go on the trip? How many have packed lunch? Try it before you read on."]}, {"k": "recall", "t": "Dividing", "p": ["24 ÷ 3 = 8."], "qq": {"id": "m4u07s2t01", "type": "num", "prompt": "24 ÷ 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "idea", "t": "Unit fractions of amounts", "p": ["To find a **unit fraction** (numerator 1) of an amount, **divide** by the denominator: ⅓ of 24 = 24 ÷ 3 = **8** children on the trip."]}, {"k": "idea", "t": "Non-unit fractions of amounts", "p": ["For ¾, find ¼ first, then **multiply** by 3: ¼ of 24 = 6, so ¾ of 24 = 6 × 3 = **18** children."], "table": {"head": ["Fraction", "Divide by denominator", "Multiply by numerator", "Answer"], "rows": [["⅖ of 20", "20 ÷ 5 = 4", "4 × 2", "8"], ["⅚ of 30", "30 ÷ 6 = 5", "5 × 5", "25"], ["⅜ of 40", "40 ÷ 8 = 5", "5 × 3", "15"]]}}, {"k": "try", "t": "Unit", "p": [], "qq": {"id": "m4u07s2t02", "type": "num", "prompt": "⅕ of 35?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "35 ÷ 5.", "reason": "7."}}, {"k": "method", "t": "How do I find a fraction of an amount?", "p": ["Step 1: Divide the amount by the denominator.", "Step 2: Multiply by the numerator.", "Step 3: Check: the answer should be less than the amount (for fractions under 1).", "Step 4: Include units."]}, {"k": "example", "t": "Unit fraction", "p": [], "q": "¼ of 48 m.", "steps": [["48 ÷ 4", ""]], "a": "12 m"}, {"k": "example", "t": "Non-unit", "p": [], "q": "⅔ of 27.", "steps": [["27 ÷ 3 = 9", ""], ["9 × 2", ""]], "a": "18"}, {"k": "example", "t": "Money", "p": [], "q": "¾ of $60.", "steps": [["60 ÷ 4 = 15", ""], ["15 × 3", ""]], "a": "$45"}, {"k": "example", "t": "Time", "p": [], "q": "½ of an hour.", "steps": [["60 ÷ 2", ""]], "a": "30 minutes"}, {"k": "try", "t": "Non-unit", "p": [], "qq": {"id": "m4u07s2t03", "type": "num", "prompt": "⅗ of 25?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "25 ÷ 5 × 3.", "reason": "15."}}, {"k": "error", "t": "Dividing by the numerator", "p": ["Find the first wrong line."], "q": "¾ of 24", "lines": ["24 ÷ 3 = 8"], "bad": 0, "why": "Divide by the denominator (4) first: 6, then × 3 = 18.", "fix": [["18", ""]], "id": "m4u07s2t04"}, {"k": "mistake", "t": "Dividing by the numerator", "p": ["Divide by the bottom, multiply by the top."]}, {"k": "tip", "t": "Real life", "p": ["Sales ('⅓ off'), recipes and sharing prizes use fractions of amounts."]}, {"k": "summary", "t": "What to remember", "p": ["Unit fraction: ÷ denominator.", "Non-unit: ÷ denominator, × numerator.", "Check the answer makes sense."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "7.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u07s2k01", "type": "num", "prompt": "Before you read on: children on the trip?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u07s2k02", "type": "num", "prompt": "¾ of 24?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u07s2k03", "type": "num", "prompt": "⅔ of 27?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×