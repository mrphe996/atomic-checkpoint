{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 11, "stage": 16, "title": "3D Shapes", "strandShort": "Geometry and measure", "blurb": "Faces, edges and vertices of 3D shapes, nets of cubes, prisms and pyramids, and the difference between capacity and volume.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u11.pdf"}, "objectives": {"O1": {"code": "6Gg.05", "sec": "11.1", "codeNote": "", "t": "Identify and describe 3D shapes by their faces, edges and vertices, and recognise their nets."}, "O2": {"code": "6Gg.06", "sec": "11.2", "codeNote": "", "t": "Understand the difference between capacity and volume, and find the volume of cuboids by counting cubes."}}, "sections": [{"id": "11.1", "title": "Shapes and nets", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Gift box", "p": ["You want to make a box for a present by cutting **one flat piece of card** and folding it up.", "What shape should the flat piece be? Is there only one way? Think about it before you read on."]}, {"k": "recall", "t": "3D shapes", "p": ["A cube has 6 square faces, 12 edges and 8 vertices."], "qq": {"id": "m6u11s1t01", "type": "num", "prompt": "How many faces does a cuboid have?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "idea", "t": "Nets", "p": ["A **net** is a flat shape that folds up to make a 3D shape. A cube has **11 different nets** – for example a cross shape."], "table": {"head": ["Shape", "Faces in the net"], "rows": [["cube", "6 squares"], ["cuboid", "6 rectangles (3 pairs)"], ["triangular prism", "2 triangles + 3 rectangles"], ["square-based pyramid", "1 square + 4 triangles"]]}, "fig": {"kind": "cells", "cells": [[1, 0], [0, 1], [1, 1], [2, 1], [3, 1], [1, 2]], "cols": 4, "rows": 3, "grid": true}}, {"k": "idea", "t": "Nets and surface area", "p": ["The **surface area** of a 3D shape is the total area of its net.", "A cube with edges 3 cm: each face 9 cm², 6 faces → **54 cm²** of card.", "**Compound** 3D shapes are made by joining simple ones (e.g. a cuboid with a pyramid on top, like a house)."]}, {"k": "try", "t": "Net", "p": [], "qq": {"id": "m6u11s1t02", "type": "mcq", "prompt": "A net with 1 square and 4 triangles makes a …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "square-based pyramid", "ok": true, "fb": ""}, {"t": "cube", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I check a net?", "p": ["Step 1: Count the faces – does it match the 3D shape?", "Step 2: Check opposite faces will not overlap when folded.", "Step 3: Imagine folding one face at a time around a base.", "Step 4: Surface area = total area of all faces in the net."]}, {"k": "example", "t": "Cuboid surface area", "p": [], "q": "Cuboid 4 cm × 3 cm × 2 cm.", "steps": [["2 × (12 + 8 + 6)", ""], ["2 × 26 = 52", ""]], "a": "52 cm²"}, {"k": "example", "t": "Not a net", "p": [], "q": "Six squares in a 2 × 3 rectangle.", "steps": [["folding makes faces overlap; no lid/base pair", ""]], "a": "not a net of a cube"}, {"k": "example", "t": "Prism", "p": [], "q": "A triangular prism net has how many faces?", "steps": [["