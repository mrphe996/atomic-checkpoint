1.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u11s1k03", "type": "num", "prompt": "Cube edge 3 cm: surface area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 54, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "11.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u11s1k04", "type": "num", "prompt": "Quick check: square pyramid faces?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u11s1r01", "type": "num", "prompt": "Vertices of a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u11s1r02", "type": "num", "prompt": "Edges of a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u11s1r03", "type": "num", "prompt": "Faces of a triangular prism?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u11s1r04", "type": "num", "prompt": "Triangles in a square-based pyramid net?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u11s1r05", "type": "num", "prompt": "Surface area of a cube with edge 4 cm?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 96, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u11s1r06", "type": "num", "prompt": "Cuboid 2 × 2 × 5. Surface area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 48, "unit": "×", "units": ["