{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 16, "stage": 15, "title": "Time", "strandShort": "Geometry and measure", "blurb": "Finding time intervals in hours and minutes using 12-hour and 24-hour clocks and timetables, and comparing times in different time zones.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u16.pdf"}, "objectives": {"O1": {"code": "5Gt.01", "sec": "16.1", "codeNote": "", "t": "Find time intervals in seconds, minutes and hours, using 12- and 24-hour clocks and timetables."}, "O2": {"code": "5Gt.02", "sec": "16.2", "codeNote": "", "t": "Understand time zones and work out the time in another place."}}, "sections": [{"id": "16.1", "title": "Time intervals", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Train journey", "p": ["A train leaves at **09:45** and arrives at **13:20**.", "How long is the journey? Try it before you read on."]}, {"k": "recall", "t": "Units of time", "p": ["60 seconds = 1 minute; 60 minutes = 1 hour; 24 hours = 1 day."], "qq": {"id": "m5u16s1t01", "type": "num", "prompt": "How many minutes in 2 hours?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 120, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "120."}}, {"k": "idea", "t": "12-hour and 24-hour clocks", "p": [], "table": {"head": ["12-hour", "24-hour"], "rows": [["7:15 a.m.", "07:15"], ["12:00 noon", "12:00"], ["3:40 p.m.", "15:40"], ["11:05 p.m.", "23:05"]]}, "p2": ["For p.m. times (after noon), add 12 to the hour."]}, {"k": "idea", "t": "Finding a time interval", "p": ["Count on in steps on a time line: 09:45 → 10:00 (**15 min**) → 13:00 (**3 h**) → 13:20 (**20 min**).", "Total: 3 h + 15 min + 20 min = **3 h 35 min**.", "Do not subtract times like ordinary numbers – there are 60 minutes in an hour, not 100."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m5u16s1t02", "type": "mcq", "prompt": "4:25 p.m. in 24-hour time?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "16:25", "ok": true, "fb": ""}, {"t": "14:25", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I find a time interval?", "p": ["Step 1: Write both times in the same clock (24-hour is easiest).", "Step 2: Count on to the next o'clock.", "Step 3: Count on whole hours, then the minutes left.", "Step 4: Add the parts."]}, {"k": "example", "t": "Short interval", "p": [], "q": "10:50 to 11:25.", "steps": [["10:50 → 11:00 = 10 min", ""], ["11:00 → 11:25 = 25 min", ""]], "a": "35 min"}, {"k": "example", "t": "Across noon", "p": [], "q": "11:30 a.m. to 2:15 p.m.", "steps": [["11:30 → 12:00 = 30 min", ""], ["12:00 → 14:00 = 2 h", ""], ["+ 15 min", ""]], "a": "2 h 45 min"}, {"k": "example", "t": "End time", "p": [], "q": "A film starts 18:40 and lasts 1 h 55 min.", "steps": [["18:40 + 2 h = 20:40", ""], ["− 5 min", ""]], "a": "20:35"}, {"k": "example", "t": "Seconds", "p": [], "q": "A runner takes 135 seconds.", "steps": [["120 s = 2 min", ""]], "a": "2 min 15 s"}, {"k": "try", "t": "Interval", "p": [], "qq": {"id": "m5u16s1t03", "type": "num", "prompt": "Minutes from 08:20 to 09:05?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "40 + 5 min.", "reason": "45 min."}}, {"k": "error", "t": "Subtracting like decimals", "p": ["Find the first wrong line."], "q": "From 09:45 to 13:20.", "lines": ["13.20 − 9.45 = 3.75, so 3 h 75 min"], "bad": 0, "why": "Time is not base 10. Count on: 3 h 35 min.", "fix": [["3 h 35 min", ""]], "id": "m5u16s1t04"}, {"k": "mistake", "t": "Subtracting times as if 100 minutes = 1 hour", "p": ["Count on using a time line."]}, {"k": "tip", "t": "Real life", "p": ["Timetables, cooking times and sports results are all time intervals."]}, {"k": "summary", "t": "What to remember", "p": ["p.m. → add 12 for 24-hour time.", "Count on: to the next hour, whole hours, then minutes.", "60 s = 1 min; 60 min = 1 h."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "16.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u16s1k01", "type": "mcq", "prompt": "Before you read on: journey time?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3 h 35 min", "ok": true, "fb": ""}, {"t": "3 h 75 min", "ok": false, "fb": ""}]}}, {"id": "16.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u16s1k02", "type": "mcq", "prompt": "11:05 p.m. is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "23:05", "ok": true, "fb": ""}, {"t": "13:05", "ok": false, "fb": ""}]}}, {"id": "16.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u16s1k03", "type": "num", "prompt": "10:50 to 11:25 in minutes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "16.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u16s1k04", "type": "short", "prompt": "Quick check: 18:40 + 1 h 55 min? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["20:35", "/^\\s*0?20\\s*[:.]\\s*35\\s*$/"], "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u16s1r01", "type": "short", "prompt": "2:30 p.m. in 24-hour time? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["14:30", "/^\\s*0?14\\s*[:.]\\s*30\\s*$/"], "hint": "", "reason": ""}, {"id": "m5u16s1r02", "type": "short", "prompt": "9:10 p.m. in 24-hour time? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["21:10", "/^\\s*0?21\\s*[:.]\\s*10\\s*$/"], "hint": "", "reason": ""}, {"id": "m5u16s1r03", "type": "mcq", "prompt": "17:45 in 12-hour time?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "5:45 p.m.", "ok": true, "fb": ""}, {"t": "7:45 p.m.", "ok": false, "fb": ""}]}, {"id": "m5u16s1r04", "type": "num", "prompt": "Minutes from 14:15 to 14:50?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1r05", "type": "num", "prompt": "Minutes from 07:40 to 08:10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1r06", "type": "short", "prompt": "From 10:00 to 12:30? Write it like 2 h 15 min.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["2 h 30 min", "/^\\s*2\\s*(h|hours?|hrs?)\\s*(and\\s*)?30\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "", "reason": ""}, {"id": "m5u16s1r07", "type": "num", "prompt": "Seconds in 3 minutes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1r08", "type": "short", "prompt": "45 minutes after 13:30? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["14:15", "/^\\s*0?14\\s*[:.]\\s*15\\s*$/"], "hint": "", "reason": ""}], "prac": [{"id": "m5u16s1p01", "type": "short", "prompt": "From 08:35 to 11:10? Write it like 2 h 15 min.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["2 h 35 min", "/^\\s*2\\s*(h|hours?|hrs?)\\s*(and\\s*)?35\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "", "reason": ""}, {"id": "m5u16s1p02", "type": "short", "prompt": "From 10:45 a.m. to 3:20 p.m.? Write it like 2 h 15 min.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["4 h 35 min", "/^\\s*4\\s*(h|hours?|hrs?)\\s*(and\\s*)?35\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "", "reason": ""}, {"id": "m5u16s1p03", "type": "short", "prompt": "A bus leaves 16:50; journey 1 h 25 min. Arrives? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["18:15", "/^\\s*0?18\\s*[:.]\\s*15\\s*$/"], "hint": "", "reason": ""}, {"id": "m5u16s1p04", "type": "explain", "prompt": "Explain why 14:20 − 13:50 is not 70 minutes.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "60 minutes in an hour", "kw": ["60"]}, {"pt": "30 min", "kw": ["30"]}], "need": 2, "model": "An hour is 60 minutes, not 100. 13:50 → 14:00 is 10 min, then 20 min more: 30 min.", "hint": "", "reason": "An hour is 60 minutes, not 100. 13:50 → 14:00 is 10 min, then 20 min more: 30 min."}, {"id": "m5u16s1p05", "type": "short", "prompt": "A lesson ends at 11:15 after 55 minutes. Start? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["10:20", "/^\\s*0?10\\s*[:.]\\s*20\\s*$/"], "hint": "", "reason": ""}, {"id": "m5u16s1p06", "type": "num", "prompt": "A race: 2 min 40 s. In seconds?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 160, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1p07", "type": "short", "prompt": "Timetable: Town 07:55, City 10:20. Journey? Write it like 2 h 15 min.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["2 h 25 min", "/^\\s*2\\s*(h|hours?|hrs?)\\s*(and\\s*)?25\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "", "reason": ""}, {"id": "m5u16s1p08", "type": "mcq", "prompt": "Which is longer?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1 h 20 min", "ok": true, "fb": ""}, {"t": "75 min", "ok": false, "fb": ""}]}], "adv": [{"id": "m5u16s1a01", "type": "short", "prompt": "* Advanced. A night flight: 22:40 to 05:15 the next day. Write it like 2 h 15 min.", "diff": "VH", "obj": "O1", "skill": "Application", "accept": ["6 h 35 min", "/^\\s*6\\s*(h|hours?|hrs?)\\s*(and\\s*)?35\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "22:40 → 00:00 = 1 h 20 min.", "reason": ""}, {"id": "m5u16s1a02", "type": "num", "prompt": "* Advanced. A tap drips every 15 seconds. Drips in 1 hour?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 240, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1a03", "type": "explain", "prompt": "* Advanced. Three activities: 35 min, 1 h 10 min, 50 min. Can they fit between 13:00 and 15:30? Explain.", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "total 2 h 35 min", "kw": ["2 ?h ?35|155"]}, {"pt": "no", "kw": ["\\bno\\b|not|too long|5 min"]}], "need": 2, "model": "Total 2 h 35 min, but only 2 h 30 min is available – no (5 min short).", "hint": "", "reason": "Total 2 h 35 min, but only 2 h 30 min is available – no (5 min short)."}], "more": [{"id": "m5u16s1m01", "type": "short", "prompt": "1:00 p.m. in 24-hour? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["13:00", "/^\\s*0?13\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": ""}, {"id": "m5u16s1m02", "type": "num", "prompt": "Minutes from 09:00 to 09:40?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 40, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1m03", "type": "num", "prompt": "Minutes in 1½ hours?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u16s1m04", "type": "short", "prompt": "30 minutes after 10:45? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["11:15", "/^\\s*0?11\\s*[:.]\\s*15\\s*$/"], "hint": "", "reason": ""}, {"id": "m5u16s1m05", "type": "short", "prompt": "From 12:00 to 15:20? Write it like 2 h 15 min.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["3 h 20 min", "/^\\s*3\\s*(h|hours?|hrs?)\\s*(and\\s*)?20\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "", "reason": ""}, {"id": "m5u16s1m06", "type": "num", "prompt": "Hours in 2 days?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 48, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c5u16", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 16.1 notes · Time intervals", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "16.2", "title": "Time zones", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Video call", "p": ["Lan in Hanoi wants to call her cousin in London at **19:00** Hanoi time. Hanoi is **7 hours ahead** of London.", "What time will it be in London? Is that a good time to call? Decide before you read on."]}, {"k": "recall", "t": "Adding and subtracting hours", "p": ["19:00 − 3 h = 16:00."], "qq": {"id": "m5u16s2t01", "type": "short", "prompt": "08:00 + 5 h? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["13:00", "/^\\s*0?13\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": "13:00."}}, {"k": "idea", "t": "Time zones", "p": ["The Earth turns, so it is day in some places and night in others. The world is split into **time zones**.", "If a place is **ahead**, its clock shows a **later** time; if it is **behind**, an **earlier** time."], "table": {"head": ["City", "Difference from London"], "rows": [["Hanoi", "+7 h (ahead)"], ["Dubai", "+4 h"], ["London", "0"], ["New York", "−5 h (behind)"]]}, "p2": ["19:00 in Hanoi − 7 h = **12:00** in London – lunchtime, a good time to call."]}, {"k": "idea", "t": "Using the differences", "p": ["Going east usually means ahead (add); going west means behind (subtract). Cross midnight carefully: 03:00 − 5 h = 22:00 **the day before**.", "(Differences can change by 1 hour when some countries change their clocks in summer.)"]}, {"k": "try", "t": "Ahead", "p": [], "qq": {"id": "m5u16s2t02", "type": "short", "prompt": "London 10:00. Dubai (+4 h)? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["14:00", "/^\\s*0?14\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": "14:00."}}, {"k": "method", "t": "How do I find the time in another zone?", "p": ["Step 1: Find the difference between the two places.", "Step 2: Ahead → add; behind → subtract.", "Step 3: Check if you cross midnight (change the day).", "Step 4: Give the time in 24-hour clock."]}, {"k": "example", "t": "Behind", "p": [], "q": "London 15:00. New York (−5 h)?", "steps": [["15 − 5", ""]], "a": "10:00"}, {"k": "example", "t": "Between two cities", "p": [], "q": "Dubai 09:00. Hanoi?", "steps": [["Hanoi is 3 h ahead of Dubai", ""]], "a": "12:00"}, {"k": "example", "t": "Crossing midnight", "p": [], "q": "Hanoi 02:00 on Tuesday. London?", "steps": [["02:00 − 7 h", ""]], "a": "19:00 on Monday"}, {"k": "example", "t": "Flight", "p": [], "q": "Leave London 10:00, fly 7 h to Dubai.", "steps": [["London time on arrival 17:00", ""], ["+4 h", ""]], "a": "21:00 Dubai time"}, {"k": "try", "t": "Behind", "p": [], "qq": {"id": "m5u16s2t03", "type": "short", "prompt": "London 20:00. New York? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["15:00", "/^\\s*0?15\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": "15:00."}}, {"k": "error", "t": "Adding instead of subtracting", "p": ["Find the first wrong line."], "q": "Hanoi 19:00. London (7 h behind Hanoi)?", "lines": ["19:00 + 7 h = 02:00"], "bad": 0, "why": "London is behind, so subtract: 12:00.", "fix": [["12:00", ""]], "id": "m5u16s2t04"}, {"k": "mistake", "t": "Adding when the place is behind", "p": ["Behind → earlier → subtract."]}, {"k": "tip", "t": "Real life", "p": ["Online gamers, pilots and families living abroad check time zones before calling or flying."]}, {"k": "summary", "t": "What to remember", "p": ["Ahead → add; behind → subtract.", "Watch for changing day at midnight.", "Flights: add journey time, then the time difference."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "16.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u16s2k01", "type": "short", "prompt": "Before you read on: London time? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["12:00", "/^\\s*0?12\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": ""}}, {"id": "16.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u16s2k02", "type": "short", "prompt": "London 15:00. New York? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["10:00", "/^\\s*0?10\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": ""}}, {"id": "16.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u16s2k03", "type": "short", "prompt": "Dubai 09:00. Hanoi? Use the 24-hour clock, like 09:30.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["12:00", "/^\\s*0?12\\s*[:.]\\s*00\\s*$/"], "hint": "", "reason": ""}}, {"id": "16.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id