{"course": {"id": "s15", "title": "Camday – Cambridge Primary Mathematics — Stage 5", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "2D Shapes"}, {"n": 3, "t": "Numbers and Sequences"}, {"n": 4, "t": "Averages"}, {"n": 5, "t": "Addition and Subtraction (1)"}, {"n": 6, "t": "3D Shapes"}, {"n": 7, "t": "Fractions, Decimals and Percentages"}, {"n": 8, "t": "Probability"}, {"n": 9, "t": "Addition and Subtraction (2)"}, {"n": 10, "t": "Angles"}, {"n": 11, "t": "Multiplication and Division"}, {"n": 12, "t": "Data"}, {"n": 13, "t": "Ratio and Proportion"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Multiplying and Dividing Fractions and Decimals"}, {"n": 16, "t": "Time"}, {"n": 17, "t": "Number and the Laws of Arithmetic"}, {"n": 18, "t": "Position and Direction"}]}, "unit": {"n": 7, "stage": 15, "title": "Fractions, Decimals and Percentages", "strandShort": "Number", "blurb": "Fractions of shapes and amounts, fractions as division, percentages as parts of 100, and comparing fractions, decimals and percentages.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 5", "lesson": true, "subject": "maths", "read": "media/read/m5u07.pdf"}, "objectives": {"O1": {"code": "5Nf.01", "sec": "7.1", "codeNote": "", "t": "Understand that a fraction can be a part of a whole or a division, and find unit and non-unit fractions of amounts."}, "O2": {"code": "5Nf.02", "sec": "7.2", "codeNote": "", "t": "Understand percentages as parts of 100 and recognise percentages, decimals and fractions with the same value."}, "O3": {"code": "5Nf.03", "sec": "7.3", "codeNote": "", "t": "Recognise equivalent fractions and compare and order fractions and decimals."}}, "sections": [{"id": "7.1", "title": "Understanding fractions", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Chocolate bar", "p": ["A chocolate bar has **12 pieces**. Tom eats **3 pieces** and Ana eats **¼ of the bar**.", "Who ate more? How can the same amount have two names? Try it before you read on."]}, {"k": "recall", "t": "Fractions", "p": ["¾ means 3 of 4 equal parts."], "qq": {"id": "m5u07s1t01", "type": "num", "prompt": "What fraction of 12 pieces is 3 pieces? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/12 = 1/4."}}, {"k": "idea", "t": "Equivalent fractions", "p": ["**Equivalent** fractions are equal in value: 3/12 = 1/4 = 2/8. Multiply or divide the top and bottom by the **same** number."], "table": {"head": ["Fraction", "× 2", "× 3", "÷"], "rows": [["1/4", "2/8", "3/12", "–"], ["6/8", "12/16", "18/24", "3/4 (÷ 2)"]]}, "p2": ["Tom and Ana ate the **same amount**."]}, {"k": "idea", "t": "Mixed numbers and improper fractions", "p": ["An **improper fraction** has a numerator bigger than the denominator: 7/4. As a **mixed number**: 7/4 = 1¾ (4 quarters make 1 whole, 3 quarters left).", "A fraction can also be a division: 3 ÷ 4 = ¾; 7 ÷ 4 = 1¾."]}, {"k": "try", "t": "Mixed", "p": [], "qq": {"id": "m5u07s1t02", "type": "mcq", "prompt": "9/4 as a mixed number?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2¼", "ok": true, "fb": ""}, {"t": "4/9", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I work with fractions?", "p": ["Step 1: Equivalent: × or ÷ top and bottom by the same number.", "Step 2: Improper → mixed: how many wholes? what's left?", "Step 3: Mixed → improper: wholes × denominator + numerator.", "Step 4: Draw bars or circles to check."]}, {"k": "example", "t": "Equivalent", "p": [], "q": "Complete 2/5 = ?/20.", "steps": [["5 × 4 = 20", ""], ["2 × 4 = 8", ""]], "a": "8/20"}, {"k": "example", "t": "Improper to mixed", "p": [], "q": "11/3.", "steps": [["3 thirds in each whole: 3 wholes = 9/3", ""], ["2 left", ""]], "a": "3⅔"}, {"k": "example", "t": "Mixed to improper", "p": [], "q": "2⅗.", "steps": [["2 × 5 + 3 = 13", ""]], "a": "13/5"}, {"k": "example", "t": "Simplify", "p": [], "q": "Simplify 10/15.", "steps": [["÷ 5", ""]], "a": "2/3"}, {"k": "try", "t": "Equivalent", "p": [], "qq": {"id": "m5u07s1t03", "type": "num", "prompt": "3/4 = ?/16", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× 4.", "reason": "12."}}, {"k": "error", "t": "Changed only the bottom", "p": ["Find the first wrong line."], "q": "Write 1/3 with denominator 6.", "lines": ["1/6"], "bad": 0, "why": "Multiply top AND bottom by 2: 2/6.", "fix": [["2/6", ""]], "id": "m5u07s1t04"}, {"k": "mistake", "t": "Changing only one part", "p": ["Do the same to the numerator and denominator."]}, {"k": "tip", "t": "Real life", "p": ["Pizzas, chocolate and measuring cups show that 2/8 and 1/4 are the same amount."]}, {"k": "summary", "t": "What to remember", "p": ["Equivalent fractions: same value.", "× or ÷ top and bottom by the same number.", "Improper ↔ mixed numbers.", "A fraction is a division."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "7.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u07s1k01", "type": "mcq", "prompt": "Before you read on: who ate more?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the same", "ok": true, "fb": ""}, {"t": "Tom", "ok": false, "fb": ""}]}}, {"id": "7.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u07s1k02", "type": "num", "prompt": "6/8 = ?/4", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u07s1k03", "type": "mcq", "prompt": "11/3 = ?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3⅔", "ok": true, "fb": ""}, {"t": "3⅓", "ok": false, "fb": ""}]}}, {"id": "7.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u07s1k04", "type": "num", "prompt": "Quick check: simplify 4/8. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u07s1r01", "type": "num", "prompt": "1/2 = ?/10", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1r02", "type": "num", "prompt": "2/3 = ?/12", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1r03", "type": "num", "prompt": "Simplify 6/9. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6666666666666666, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1r04", "type": "num", "prompt": "Simplify 5/20. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1r05", "type": "mcq", "prompt": "7/2 = ?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3½", "ok": true, "fb": ""}, {"t": "2½", "ok": false, "fb": ""}]}, {"id": "m5u07s1r06", "type": "num", "prompt": "1½ as an improper fraction? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1r07", "type": "num", "prompt": "4 ÷ 5 as a fraction? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.8, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1r08", "type": "mcq", "prompt": "Equivalent to 3/5?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "6/10", "ok": true, "fb": ""}, {"t": "5/3", "ok": false, "fb": ""}]}], "prac": [{"id": "m5u07s1p01", "type": "num", "prompt": "2¾ as an improper fraction? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2.75, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1p02", "type": "mcq", "prompt": "17/5 = ?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3⅖", "ok": true, "fb": ""}, {"t": "3⅗", "ok": false, "fb": ""}]}, {"id": "m5u07s1p03", "type": "num", "prompt": "4/7 = 12/?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 21, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1p04", "type": "explain", "prompt": "Explain why 2/4 and 3/6 are equal.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "both a half", "kw": ["half|1/2|½"]}, {"pt": "simplify / same", "kw": ["simplify|divide|same"]}], "need": 2, "model": "Both simplify to ½ (2/4 ÷ 2, 3/6 ÷ 3) – they are the same amount.", "hint": "", "reason": "Both simplify to ½ (2/4 ÷ 2, 3/6 ÷ 3) – they are the same amount."}, {"id": "m5u07s1p05", "type": "num", "prompt": "Simplify 12/18. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6666666666666666, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1p06", "type": "mcq", "prompt": "Which is NOT equal to ½?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3/5", "ok": true, "fb": ""}, {"t": "4/8", "ok": false, "fb": ""}, {"t": "5/10", "ok": false, "fb": ""}]}, {"id": "m5u07s1p07", "type": "num", "prompt": "7 sweets shared by 2. Each gets? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3.5, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "3½.", "reason": ""}, {"id": "m5u07s1p08", "type": "num", "prompt": "How many quarters in 3¼?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 13, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m5u07s1a01", "type": "num", "prompt": "* Advanced. A fraction equivalent to 2/3 has numerator 14. The fraction? Give your answer as a fraction in its simplest form.", "diff": "H", "obj": "O1", "skill": "Application", "answer": 0.6666666666666666, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1a02", "type": "explain", "prompt": "* Advanced. Find three fractions equivalent to 3/4.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "three examples", "kw": ["6/8|9/12|12/16|15/20|30/40"]}], "need": 1, "model": "e.g. 6/8, 9/12, 12/16.", "hint": "", "reason": "e.g. 6/8, 9/12, 12/16."}, {"id": "m5u07s1a03", "type": "mcq", "prompt": "* Advanced. 23/6 = ?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3⅚", "ok": true, "fb": ""}, {"t": "4⅙", "ok": false, "fb": ""}]}], "more": [{"id": "m5u07s1m01", "type": "num", "prompt": "1/2 = ?/4", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1m02", "type": "num", "prompt": "1/3 = ?/9", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1m03", "type": "num", "prompt": "Simplify 2/10. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.2, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1m04", "type": "mcq", "prompt": "5/4 = ?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1¼", "ok": true, "fb": ""}, {"t": "1½", "ok": false, "fb": ""}]}, {"id": "m5u07s1m05", "type": "num", "prompt": "1 ÷ 4? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m5u07s1m06", "type": "mcq", "prompt": "Improper fraction?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "8/3", "ok": true, "fb": ""}, {"t": "3/8", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c5u07", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 7.1 notes · Understanding fractions", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "7.2", "title": "Percentages, decimals and fractions", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Phone battery", "p": ["A phone battery shows **50%**. Another shows **0.25** full in an app, and a third is '**¾** charged'.", "Which phone has the most charge? Think about it before you read on."]}, {"k": "recall", "t": "Hundredths", "p": ["0.25 = 25 hundredths."], "qq": {"id": "m5u07s2t01", "type": "num", "prompt": "How many hundredths is 0.7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "70."}}, {"k": "idea", "t": "Per cent", "p": ["**Per cent (%)** means 'out of 100'. 50% = 50/100 = ½."], "fig": {"kind": "waffle", "n": 75}, "p2": ["A 10 × 10 grid with 75 squares shaded shows 75% = 75/100 = ¾ = 0.75."]}, {"k": "idea", "t": "Same amount, three ways", "p": [], "table": {"head": ["Fraction", "Decimal", "Percentage"], "rows": [["1/2", "0.5", "50%"], ["1/4", "0.25", "25%"], ["3/4", "0.75", "75%"], ["1/10", "0.1", "10%"], ["1/100", "0.01", "1%"], ["7/10", "0.7", "70%"]]}, "p2": ["Battery: 50%, 25%, 75% → the '¾ charged' phone has the most."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m5u07s2t02", "type": "num", "prompt": "0.35 as a percentage?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "35%."}}, {"k": "method", "t": "How do I change between fractions, decimals and percentages?", "p": ["Step 1: Percentage → fraction: write it over 100, then simplify.", "Step 2: Decimal → percentage: × 100 (0.45 → 45%).", "Step 3: Percentage → decimal: ÷ 100 (60% → 0.6).", "Step 4: Learn the key ones: ½, ¼, ¾, 1/10."]}, {"k": "example", "t": "Percentage to fraction", "p": [], "q": "20% as a fraction.", "steps": [["20/100", ""], ["= 1/5", ""]], "a": "1/5"}, {"k": "example", "t": "Fraction to percentage", "p": [], "q": "3/10 as a percentage.", "steps": [["30/100", ""]], "a": "30%"}, {"k": "example", "t": "Decimal to fraction", "p": [], "q": "0.9 as a fraction.", "steps": [["9/10", ""]], "a": "9/10"}, {"k": "example", "t": "Waffle", "p": [], "q": "A grid of 100 has 42 squares shaded.", "steps": [["42/100 = 0.42 = 42%", ""]], "a": "42%"}, {"k": "try", "t": "Fraction", "p": [], "qq": {"id": "m5u07s2t03", "type": "num", "prompt": "25% as a fraction? Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "1/4."}}, {"k": "error", "t": "Wrong decimal", "p": ["Find the first wrong line."], "q": "Write 5% as a decimal.", "lines": ["0.5"], "bad": 0, "why": "5% = 5/100 = 0.05 (0.5 is 50%).", "fix": [["0.05", ""]], "id": "m5u07s2t04"}, {"k": "mistake", "t": "5% written as 0.5", "p": ["Percent means hundredths: 5% = 0.05."]}, {"k": "tip", "t": "Real life", "p": ["Battery levels, test scores and sale signs use percentages; prices use decimals."]}, {"k": "summary", "t": "What to remember", "p": ["% means out of 100.", "½ = 0.5 = 50%; ¼ = 0.25 = 25%; ¾ = 0.75 = 75%.", "× 100 for decimal → %; ÷ 100 for % → decimal.", "Simplify fractions from %."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "7.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m5u07s2k01", "type": "mcq", "prompt": "Before you read on: most charge?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "¾ charged", "ok": true, "fb": ""}, {"t": "50%", "ok": false, "fb": ""}]}}, {"id": "7.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m5u07s2k02", "type": "num", "prompt": "¾ as a percentage?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 75, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m5u07s2k03", "type": "num", "prompt": "60% as a decimal?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m5u07s2k04", "type": "num", "prompt": "Quick check: 1/10 as a %?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m5u07s2r01", "type": "num", "prompt": "½ as a %?", "diff": "M", "obj":