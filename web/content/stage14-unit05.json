{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 5, "stage": 14, "title": "Multiplication, Multiples and Factors", "strandShort": "Number", "blurb": "Times tables to 10 × 10, multiples and factors, and multiplying 2-digit numbers by 1-digit numbers and by 10 and 100.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u05.pdf"}, "objectives": {"O1": {"code": "4Nc.03", "sec": "5.1", "codeNote": "", "t": "Know times tables to 10 × 10 and find multiples and factors."}, "O2": {"code": "4Nc.04", "sec": "5.2", "codeNote": "", "t": "Estimate and multiply 2-digit numbers by 1-digit numbers, and multiply by 10 and 100."}}, "sections": [{"id": "5.1", "title": "Tables, multiples and factors", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Chairs in rows", "p": ["A teacher has **24 chairs** to put in equal rows for a class show.", "How many different ways can she arrange them? Try a few before you read on."]}, {"k": "recall", "t": "Times tables", "p": ["6 × 4 = 24."], "qq": {"id": "m4u05s1t01", "type": "num", "prompt": "8 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "24."}}, {"k": "idea", "t": "Multiples", "p": ["A **multiple** of a number is in its times table: multiples of 6 are 6, 12, 18, 24, 30, …", "Multiples go on for ever. 24 is a multiple of 1, 2, 3, 4, 6, 8, 12 and 24."]}, {"k": "idea", "t": "Factors", "p": ["A **factor** divides a number exactly. Find them in **pairs**: 24 = 1 × 24 = 2 × 12 = 3 × 8 = 4 × 6."], "table": {"head": ["Rows", "Chairs in each row"], "rows": [["1", "24"], ["2", "12"], ["3", "8"], ["4", "6"], ["6", "4"], ["8", "3"], ["12", "2"], ["24", "1"]]}, "p2": ["Factors of 24: **1, 2, 3, 4, 6, 8, 12, 24** – 8 ways to arrange the chairs."]}, {"k": "try", "t": "Multiple", "p": [], "qq": {"id": "m4u05s1t02", "type": "mcq", "prompt": "Which is a multiple of 7?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "49", "ok": true, "fb": ""}, {"t": "45", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I find factors?", "p": ["Step 1: Start with 1 × the number.", "Step 2: Try 2, 3, 4, … in order.", "Step 3: Write each pair that works.", "Step 4: Stop when the pairs start to repeat."]}, {"k": "example", "t": "Factors of 18", "p": [], "q": "Find all factors of 18.", "steps": [["1 × 18, 2 × 9, 3 × 6", ""], ["4 and 5 don't work; 6 repeats", ""]], "a": "1, 2, 3, 6, 9, 18"}, {"k": "example", "t": "Multiples", "p": [], "q": "First five multiples of 9.", "steps": [["9 × 1 to 9 × 5", ""]], "a": "9, 18, 27, 36, 45"}, {"k": "example", "t": "Common multiple", "p": [], "q": "A number that is a multiple of both 4 and 6.", "steps": [["4: 4, 8, 12 …", ""], ["6: 6, 12 …", ""]], "a": "12"}, {"k": "example", "t": "Facts", "p": [], "q": "Use 7 × 8 = 56 to find 56 ÷ 7.", "steps": [["inverse", ""]], "a": "8"}, {"k": "try", "t": "Factor", "p": [], "qq": {"id": "m4u05s1t03", "type": "mcq", "prompt": "Is 5 a factor of 32?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "no", "ok": true, "fb": ""}, {"t": "yes", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Mixing up factors and multiples", "p": ["Find the first wrong line."], "q": "List the factors of 10.", "lines": ["10, 20, 30, 40"], "bad": 0, "why": "Those are multiples. Factors divide 10: 1, 2, 5, 10.", "fix": [["1, 2, 5, 10", ""]], "id": "m4u05s1t04"}, {"k": "mistake", "t": "Confusing factors with multiples", "p": ["Factors go INTO the number; multiples come OUT of the times table."]}, {"k": "tip", "t": "Real life", "p": ["Arranging seats, packing eggs into boxes and sharing sweets fairly all use factors and multiples."]}, {"k": "summary", "t": "What to remember", "p": ["Multiples: in the times table (go on for ever).", "Factors: divide exactly; find them in pairs.", "Know tables to 10 × 10."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "5.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u05s1k01", "type": "num", "prompt": "Before you read on: chairs in each row if there are 4 rows?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u05s1k02", "type": "num", "prompt": "How many factors does 24 have?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "5.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u05s1k03", "type": "short", "prompt": "Factors of 18? Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["1, 2, 3, 6, 9, 18", "/^\\s*1\\s*[,; ]\\s*2\\s*[,; ]\\s*3\\s*[,; ]\\s*6\\s*[,; ]\\s*9\\s*[,; ]\\s*18\\s*$/"], "hint": "", "reason": ""}}, {"id": "5.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": 