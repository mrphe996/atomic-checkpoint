"unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u05s1p08", "type": "mcq", "prompt": "Common factor of 12 and 18 (other than 1)?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "6", "ok": true, "fb": ""}, {"t": "4", "ok": false, "fb": ""}]}], "adv": [{"id": "m4u05s1a01", "type": "num", "prompt": "* Advanced. I am a multiple of 7 and of 2, between 30 and 50. What am I?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 42, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u05s1a02", "type": "explain", "prompt": "* Advanced. Why do square numbers like 36 have an odd number of factors?", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "pair with itself", "kw": ["itself|same|6 ?[×x] ?6|pair"]}], "need": 1, "model": "One factor pairs with itself (6 × 6), so it is only counted once.", "hint": "", "reason": "One factor pairs with itself (6 × 6), so it is only counted once."}, {"id": "m4u05s1a03", "type": "num", "prompt": "* Advanced. Smallest number with factors 2, 3, 4 and 5?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "more": [{"id": "m4u05s1m01", "type": "num", "prompt": "5 × 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u05s1m02", "type": "num", "prompt": "3 × 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 27, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u05s1m03", "type": "num", "prompt": "40 ÷ 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u05s1m04", "type": "mcq", "prompt": "Multiple of 5?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "35", "ok": true, "fb": ""}, {"t": "32", "ok": false, "fb": ""}]}, {"id": "m4u05s1m05", "type": "mcq", "prompt": "Factor of 9?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "3", "ok": true, "fb": ""}, {"t": "2", "ok": false, "fb": ""}]}, {"id": "m4u05s1m06", "type": "short", "prompt": "Factors of 6? Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["1, 2, 3, 6", "/^\\s*1\\s*[,; ]\\s*2\\s*[,; ]\\s*3\\s*[,; ]\\s*6\\s*$/"], "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c4u05", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 5.1 notes · Tables, multiples and factors", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "5.2", "title": "Multiplication", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Football stickers", "p": ["A sticker pack has **36 stickers**. Kim buys **7 packs**.", "About how many stickers is that? Can you find the exact number? Try it before you read on."]}, {"k": "recall", "t": "Tables", "p": ["7 × 6 = 42."], "qq": {"id": "m4u05s2t01", "type": "num", "prompt": "7 × 30?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 210, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "7 × 3 = 21, × 10.", "reason": "210."}}, {"k": "idea", "t": "Multiplying by 10 and 100", "p": ["× 10: digits move one place left: 36 × 10 = 360. × 100: two places: 36 × 100 = 3600.", "Use it: 7 × 30 = 7 × 3 × 10 = 210."]}, {"k": "idea", "t": "2-digit × 1-digit", "p": ["Estimate: 36 × 7 ≈ 40 × 7 = 280. **Partition** 36 into 30 + 6:"], "table": {"head": ["×", "30", "6"], "rows": [["7", "210", "42"]]}, "p2": ["210 + 42 = **252** stickers – close to 280 ✓."]}, {"k": "try", "t": "Grid", "p": [], "qq": {"id": "m4u05s2t02", "type": "num", "prompt": "24 × 3?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 72, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "20 × 3 + 4 × 3.", "reason": "72."}}, {"k": "method", "t": "How do I multiply a 2-digit number by a 1-digit number?", "p": ["Step 1: Estimate by rounding.", "Step 2: Split the 2-digit number into tens and ones.", "Step 3: Multiply each part.", "Step 4: Add the parts; compare with your estimate."]}, {"k": "example", "t": "Grid", "p": [], "q": "43 × 5.", "steps": [["40 × 5 = 200", ""], ["3 × 5 = 15", ""]], "a": "215"}, {"k": "example", "t": "Estimate", "p": [], "q": "Estimate 68 × 4.", "steps": [["70 × 4", ""]], "a": "about 280"}, {"k": "example", "t": "× 10 and × 100", "p": [], "q": "52 × 100.", "steps": [["two places left", ""]], "a": "5200"}, {"k": "example", "t": "Problem", "p": [], "q": "Tickets cost $9. 26 children go.", "steps": [["20 × 9 = 180", ""], ["6 × 9 = 54", ""]], "a": "$234"}, {"k": "try", "t": "Estimate", "p": [], "qq": {"id": "m4u05s2t03", "type": "mcq", "prompt": "Best estimate for 49 × 6:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "300", "ok": true, "fb": ""}, {"t": "30", "ok": false, "fb": ""}, {"t": "3000", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Forgetting to multiply the tens", "p": ["Find the first wrong line."], "q": "36 × 7", "lines": ["30 + 6 × 7 = 30 + 42 = 72"], "bad": 0, "why": "Multiply both parts: 30 × 7 = 210, 6 × 7 = 42 → 252.", "fix": [["252", ""]], "id": "m4u05s2t04"}, {"k": "mistake", "t": "Multiplying only the ones", "p": ["Both the tens and the ones must be multiplied."]}, {"k": "tip", "t": "Real life", "p": ["Working out the cost of several items or the number of seats in rows uses multiplication."]}, {"k": "summary", "t": "What to remember", "p": ["× 10 / × 100: digits move left.", "Split into tens and ones, multiply both.", "Estimate first and check."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "s