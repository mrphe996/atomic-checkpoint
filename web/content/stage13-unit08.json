{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 8, "stage": 13, "title": "Time", "strandShort": "Geometry and measure", "blurb": "Reading analogue and digital clocks to five minutes, a.m. and p.m., and units of time: seconds, minutes, hours, days, weeks, months and years.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u08.pdf"}, "objectives": {"O1": {"code": "3Gt.01", "sec": "8.1", "codeNote": "", "t": "Read and record time to five minutes on analogue and digital 12-hour clocks, using a.m. and p.m."}, "O2": {"code": "3Gt.02", "sec": "8.2", "codeNote": "", "t": "Know the units of time and use a calendar."}}, "sections": [{"id": "8.1", "title": "Telling the time", "objs": ["O1"], "lesson": [{"k": "idea", "t": "How do I read an analogue clock?", "p": ["The **short hand** shows the **hour**. The **long hand** shows the **minutes**.", "Each number on the clock is **5 minutes** for the long hand.", "The clock shown has the short hand just before 4 and the long hand on 9: **quarter to 4** (3:45)."], "fig": {"kind": "clock", "h": 3, "m": 45}}, {"k": "idea", "t": "How do digital clocks show time?", "p": ["A **digital clock** shows the hour, then a colon, then the minutes: **4:15**."], "table": {"head": ["Words", "Digital"], "rows": [["o'clock", ":00"], ["quarter past", ":15"], ["half past", ":30"], ["quarter to", ":45"]]}}, {"k": "method", "t": "How do I read the minutes?", "p": ["Step 1: Look where the long hand points.", "Step 2: Count in fives from 12.", "Step 3: Write the hour, then the minutes."]}, {"k": "example", "t": "Read", "p": [], "q": "The short hand is between 2 and 3. The long hand is on 3. What time is it?", "steps": [["Long hand on 3 → 15 minutes", ""]], "a": "2:15 (quarter past 2)"}, {"k": "example", "t": "Write", "p": [], "q": "Write quarter to 9 on a digital clock.", "steps": [["Quarter to = :45 of the hour before", ""]], "a": "8:45"}, {"k": "mistake", "t": "Quarter to", "p": ["Quarter to 9 is 8:45, not 9:45. It is before 9 o'clock."]}, {"k": "tip", "t": "Count in fives", "p": ["The numbers 1 to 12 go 5, 10, 15, 20 … for the minute hand."]}], "video": {"src": null, "offset": 0, "dur": 300, "range": ""}, "stops": [{"id": "8.1-k2", "t": 2, "after": -1, "review": [0, 0], "note": "", "q": {"id": "m3u08s1k02", "type": "mcq", "prompt": "Before you read on: the minute hand points at 6. How many minutes past the hour is it?", "diff": "M", "obj": "O1", "skill": "Reasoning", "options": [{"t": "30 minutes", "ok": true, "fb": "Correct."}, {"t": "60 minutes", "ok": false, "fb": "6 × 5 = 30."}, {"t": "6 minutes", "ok": false, "fb": "Each number on the clock is 5 minutes."}]}}, {"id": "8.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u08s1k01", "type": "short", "prompt": "What time is half past 7 on a digital clock?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["7:30"]}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u08s1r01", "type": "short", "prompt": "What time does the clock show? Write it like 4:35.", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["12:40"], "fig": {"kind": "clock", "h": 12, "m": 40}}, {"id": "m3u08s1r02", "type": "short", "prompt": "What time is 15 minutes after 8:15?", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["8:30"], "fig": {"kind": "clock", "h": 8, "m": 15}}, {"id": "m3u08s1r03", "type": "short", "prompt": "Write half past 9 as a digital time, like 4:35.", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["9:30"]}, {"id": "m3u08s1r04", "type": "num", "prompt": "The long hand points to the 4. How many minutes past the hour is that?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "minutes", "units": ["minutes", "min"], "tol": 0, "errs": []}, {"id": "m3u08s1r05", "type": "grid", "prompt": "Is each event usually a.m. or p.m.?", "diff": "M", "obj": "O1", "skill": "Data", "cols": ["p.m.", "a.m."], "rows": [{"l": "watching the sunset", "a": ["p.m."]}, {"l": "eating breakfast", "a": ["a.m."]}, {"l": "waking up", "a": ["a.m."]}, {"l": "eating dinner", "a": ["p.m."]}], "mode": "classify"}, {"id": "m3u08s1r06", "type": "short", "prompt": "What time is 1 hour after 8:30?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["9:30"]}, {"id": "m3u08s1r07", "type": "num", "prompt": "A TV show starts at 1:00 and ends at 1:30. How many minutes long is it?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "minutes", "units": ["minutes", "min"], "tol": 0, "errs": []}, {"id": "m3u08s1r08", "type": "explain", "prompt": "Explain how to read the minutes on an analogue clock.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "look at the long hand", "kw": ["long hand|minute hand"]}, {"pt": "count in fives from the 12", "kw": ["fives|5|count"]}], "model": "Look at the long hand. Each number it passes is 5 minutes, so count in fives from the 12 to where it points.", "need": 1, "reason": "Look at the long hand. Each number it passes is 5 minutes, so count in fives from the 12 to where it points."}], "prac": [{"id": "m3u08s1p01", "type": "short", "prompt": "What time does the clock show? Write it like 4:35.", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["9:35"], "fig": {"kind": "clock", "h": 9, "m": 35}}, {"id": "m3u08s1p02", "type": "short", "prompt": "What time is 15 minutes after 1:30?", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["1:45"], "fig": {"kind": "clock", "h": 1, "m": 30}}, {"id": "m3u08s1p03", "type": "short", "prompt": "Write quarter past 4 as a digital time, like 4:35.", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["4:15"]}, {"id": "v2_m3u08_8_1_01", "type": "mcq", "prompt": "The minute hand points to 9 and the hour hand is nearly at 5. Sam says the time is 9:05. What is the right time?", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "quarter to 5 (4:45)", "ok": true, "fb": "The short hand is still before 5 and the long hand on 9 means 45 minutes."}, {"t": "9:05", "ok": false, "fb": "He swapped the hands."}, {"t": "5:45", "ok": false, "fb": "The hour hand has not reached 5 yet, so it is still 4 o'clock something."}], "hint": "", "reason": ""}, {"id": "v2_m3u08_8_1_02", "type": "grid", "prompt": "Is each statement always, sometimes or never true?", "diff": "H", "obj": "O1", "skill": "Reasoning", "cols": ["Always true", "Sometimes true", "Never true"], "rows": [{"l": "At 6 o'clock the hands point in opposite directions", "a": ["Always true"]}, {"l": "The minute hand is longer than the hour hand", "a": ["Always true"]}, {"l": "The two hands point to the same number", "a": ["Sometimes true"]}], "hint": "", "reason": "At 6:00 the hands point to 12 and 6. Clocks use a long minute hand. The hands overlap at 12:00 and about 1:05, but not most of the time."}, {"id": "m3u08s1p04", "type": "num", "prompt": "The long hand points to the 9. How many minutes past the hour is that?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "minutes", "units": ["minutes", "min"], "tol": 0, "errs": []}, {"id": "m3u08s1p05", "type": "grid", "prompt": "Is each event usually a.m. or p.m.?", "diff": "M", "obj": "O1", "skill": "Data", "cols": ["a.m.", "p.m."], "rows": [{"l": "waking up", "a": ["a.m."]}, {"l": "eating breakfast", "a": ["a.m."]}, {"l": "eating dinner", "a": ["p.m."]}, {"l": "going to school", "a": ["a.m."]}], "mode": "classify"}, {"id": "m3u08s1p06", "type": "short", "prompt": "What time is 1 hour after 10:20?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["11:20"]}, {"id": "m3u08s1p07", "type": "num", "prompt": "A TV show starts at 1:00 and ends at 1:15. How many minutes long is it?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "minutes", "units": ["minutes", "min"], "tol": 0, "errs": []}, {"id": "m3u08s1p08", "type": "mcq", "prompt": "Which time does the clock show?", "diff": "H", "obj": "O1", "skill": "Figure", "fig": {"kind": "clock", "h": 6, "m": 55}, "options": [{"t": "11:30", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "7:55", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "6:55", "ok": true, "fb": "Correct."}]}], "adv": [{"id": "m3u08s1a01", "type": "short", "prompt": "* Advanced. What time does the clock show? Write it like 4:35.", "diff": "M", "obj": "O1", "skill": "Figure", "accept": ["8:40"], "fig": {"kind": "clock", "h": 8, "m": 40}}, {"id": "m3u08s1a02", "type": "short", "prompt": "* Advanced. Write quarter to 12 as a digital time, like 4:35.", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["11:45"]}, {"id": "m3u08s1a03", "type": "grid", "prompt": "* Advanced. Is each event usually a.m. or p.m.?", "diff": "M", "obj": "O1", "skill": "Data", "cols": ["a.m.", "p.m."], "rows": [{"l": "waking up", "a": ["a.m."]}, {"l": "eating breakfast", "a": ["a.m."]}, {"l": "going to bed", "a": ["p.m."]}, {"l": "going to school", "a": ["a.m."]}], "mode": "classify"}, {"id": "m3u08s1a04", "type": "num", "prompt": "* Advanced. A TV show starts at 9:00 and ends at 9:15. How many minutes long is it?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "m