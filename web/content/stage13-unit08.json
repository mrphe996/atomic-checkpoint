 "diff": "M", "obj": "O1", "skill": "Data", "cols": ["p.m.", "a.m."], "rows": [{"l": "eating dinner", "a": ["p.m."]}, {"l": "waking up", "a": ["a.m."]}, {"l": "eating breakfast", "a": ["a.m."]}, {"l": "going to bed", "a": ["p.m."]}], "mode": "classify"}, {"id": "m3u08s1m14", "type": "short", "prompt": "What time is 1 hour after 6:15?", "diff": "M", "obj": "O1", "skill": "Knowledge", "accept": ["7:15"]}, {"id": "m3u08s1m15", "type": "num", "prompt": "A TV show starts at 2:00 and ends at 2:20. How many minutes long is it?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "minutes", "units": ["minutes", "min"], "tol": 0, "errs": []}, {"id": "m3u08s1m16", "type": "mcq", "prompt": "Which time does the clock show?", "diff": "H", "obj": "O1", "skill": "Figure", "fig": {"kind": "clock", "h": 7, "m": 30}, "options": [{"t": "8:30", "ok": false, "fb": "Not quite – work through the method again."}, {"t": "7:30", "ok": true, "fb": "Correct."}, {"t": "6:35", "ok": false, "fb": "Not quite – work through the method again."}]}], "notes": "v3"}, {"id": "8.2", "title": "Days, weeks, months and years", "objs": ["O2"], "lesson": [{"k": "idea", "t": "What units of time do we use?", "p": ["**7 days = 1 week.** **12 months = 1 year.**", "There are **365 days** in a year (366 in a leap year)."]}, {"k": "idea", "t": "How many days are in each month?", "p": [], "table": {"head": ["Days", "Months"], "rows": [["31", "January, March, May, July, August, October, December"], ["30", "April, June, September, November"], ["28 or 29", "February"]]}}, {"k": "method", "t": "How do I count days on a calendar?", "p": ["Step 1: Find the start date.", "Step 2: Count on one day at a time (or a week at a time).", "Step 3: Stop at the end date."]}, {"k": "example", "t": "Weeks", "p": [], "q": "How many days are in 3 weeks?", "steps": [["3 × 7 = 21", ""]], "a": "21 days"}, {"k": "example", "t": "Month", "p": [], "q": "It is 28 April. What is the date 3 days later?", "steps": [["April has