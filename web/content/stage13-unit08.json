{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 8, "stage": 13, "title": "Time", "strandShort": "Geometry and measure", "blurb": "Reading analogue and digital clocks to five minutes, a.m. and p.m., and units of time: seconds, minutes, hours, days, weeks, months and years.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u08.pdf"}, "objectives": {"O1": {"code": "3Gt.01", "sec": "8.1", "codeNote": "", "t": "Read and record time to five minutes on analogue and digital 12-hour clocks, using a.m. and p.m."}, "O2": {"code": "3Gt.02", "sec": "8.2", "codeNote": "", "t": "Know the units of time and use a calendar."}}, "sections": [{"id": "8.1", "title": "Telling the time", "objs": ["O1"], "lesson": [{"k": "hook", "t": "School bell", "p": ["The school bell rings when the minute hand points to **5** and the hour hand is just past **9**.", "What time is it? Is it morning or evening? Think before you read on."]}, {"k": "recall", "t": "O'clock and half past", "p": ["Half past 3 is 3:30."], "qq": {"id": "m3u08s1t01", "type": "num", "prompt": "Minutes in half an hour?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "30."}}, {"k": "idea", "t": "Reading to 5 minutes", "p": ["The **minute hand** (long) counts in 5s: each number is 5 more minutes. The **hour hand** (short) shows the hour."], "fig": {"kind": "clock", "h": 9, "m": 25}, "p2": ["Minute hand on 5 → 25 minutes; hour hand just past 9 → **9:25** (twenty-five past nine)."]}, {"k": "idea", "t": "a.m. and p.m.", "p": ["**a.m.** is from midnight to midday (morning). **p.m.** is from midday to midnight (afternoon and evening).", "School starts at 9:25 a.m.; you might eat dinner at 6:30 p.m."]}, {"k": "try", "t": "Read", "p": [], "qq": {"id": "m3u08s1t02", "type": "short", "prompt": "Minute hand on 4, hour hand just past 2. Time? Write it like 4:05.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["2:20", "/^\\s*0?2\\s*[:.]\\s*20\\s*(a\\.?m\\.?|p\\.?m\\.?)?\\s*$/i"], "hint": "4 × 5 = 20.", "reason": "2:20."}}, {"k": "method", "t": "How do I read a clock?", "p": ["Step 1: Find the hour hand: which hour has it passed?", "Step 2: Count the minute hand in 5s from 12.", "Step 3: Write hours:minutes (e.g. 9:25).", "Step 4: Decide a.m. or p.m."]}, {"k": "example", "t": "Past", "p": [], "q": "Minute hand on 3, hour hand past 7.", "steps": [["3 × 5 = 15", ""]], "a": "7:15 (quarter past 7)"}, {"k": "example", "t": "To", "p": [], "q": "Minute hand on 9, hour hand nearly 4.", "steps": [["9 × 5 = 45", ""]], "a": "3:45 (quarter to 4)"}, {"k": "example", "t": "Words", "p": [], "q": "Twenty to six.", "steps": [["60 − 20 = 40 minutes past 5", ""]], "a": "5:40"}, {"k": "example", "t": "a.m. or p.m.", "p": [], "q": "Eating breakfast at 7:30.", "steps": [["morning", ""]], "a": "7:30 a.m."}, {"k": "try", "t": "Words", "p": [], "qq": {"id": "m3u08s1t03", "type": "short", "prompt": "Ten past eleven? Write it like 4:05.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["11:10", "/^\\s*0?11\\s*[:.]\\s*10\\s*(a\\.?m\\.?|p\\.?m\\.?)?\\s*$/i"], "hint": "", "reason": "11:10."}}, {"k": "error", "t": "Reading the hands the wrong way", "p": ["Find the first wrong line."], "q": "Minute hand on 2, hour hand just past 10.", "lines": ["2:50"], "bad": 0, "why": "Short hand = hour (10), long hand on 2 = 10 minutes: 10:10.", "fix": [["10:10", ""]], "id": "m3u08s1t04"}, {"k": "mistake", "t": "Mixing up the hands", "p": ["Short hand = hours; long hand = minutes."]}, {"k": "tip", "t": "Real life", "p": ["Bus times, TV shows and school bells all need us to read the time."]}, {"k": "summary", "t": "What to remember", "p": ["Minute hand counts in 5s.", "Hour hand shows the hour it has passed.", "a.m. morning; p.m. afternoon/evening."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "8.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u08s1k01", "type": "short", "prompt": "Before you read on: the time? Write it like 4:05.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["9:25", "/^\\s*0?9\\s*[:.]\\s*25\\s*(a\\.?m\\.?|p\\.?m\\.?)?\\s*$/i"], "hint": "", "reason": ""}}, {"id": "8.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u08s1k02", "type": "mcq", "prompt": "School at 9:25 is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a.m.", "ok": true, "fb": ""}, {"t": "p.m.", "ok": false, "fb": ""}]}}, {"id": "8.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u08s1k03", "type": "short", "prompt": "Twenty to six? Write it like 4:05.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["5:40", "/^\\s*0?5\\s*[:.]\\s*40\\s*(a\\.?m\\.?|p\\.?m\\.?)?\\s*$/i"], "hint": "", "reason": ""}}, {"id": "8.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u08s1k04", "type": "short", "prompt": "Quick check: minute hand on 2, hour hand past 10? Write it like 4:05.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["10:10", "/^\\s*0?10\\s*[:.]\\s*10\\s*(a\\.?m\\.?|p\\.?m\\.?)?\\s*$