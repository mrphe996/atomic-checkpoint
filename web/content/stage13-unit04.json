le", "ok": true, "fb": ""}, {"t": "square", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "3D shapes around us", "p": ["**3D shapes** are solid – they have length, width and height."], "table": {"head": ["Object", "3D shape"], "rows": [["ball", "sphere"], ["dice", "cube"], ["cereal box", "cuboid"], ["tin", "cylinder"], ["party hat", "cone"], ["tent", "triangular prism"], ["Egyptian pyramid", "square-based pyramid"]]}}, {"k": "idea", "t": "Prisms and pyramids", "p": ["A **prism** has the same shape all the way through, with two matching ends (a triangular prism has triangle ends)."], "fig": {"kind": "solid", "solid": "triprism", "a": "", "b": "", "c": ""}, "p2": ["A **pyramid** has a base and triangle faces that meet at a point (the **apex**)."]}, {"k": "try", "t": "Name", "p": [], "qq": {"id": "m3u04s1t02", "type": "mcq", "prompt": "A tin of soup is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cylinder", "ok": true, "fb": ""}, {"t": "cone", "ok": false, "fb": ""}, {"t": "cube", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I name a 3D shape?", "p": ["Step 1: Look at the faces: flat or curved?", "Step 2: Look at the shape of the faces.", "Step 3: Same shape all the way through? → prism.", "Step 4: Faces meeting at a point? → pyramid or cone."]}, {"k": "example", "t": "Name", "p": [], "q": "A football.", "steps": [["round all over", ""]], "a": "sphere"}, {"k": "example", "t": "Name", "p": [], "q": "An ice-cream cone.", "steps": [["circle base, point", ""]], "a": "cone"}, {"k": "example", "t": "Name", "p": [], "q": "A shoe box.", "steps": [["6 rectangle faces", ""]], "a": "cuboid"}, {"k": "example", "t": "Sort", "p": [], "q": "Which roll: cube, sphere, cylinder?", "steps": [["curved faces roll", ""]], "a": "sphere and cylinder"}, {"k": "try", "t": "Prism", "p": [], "qq": {"id": "m3u04s1t03", "type": "mcq", "prompt": "A tent shape with triangle ends is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hi