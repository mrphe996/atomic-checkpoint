{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 6, "stage": 14, "title": "2D Shapes", "strandShort": "Geometry and measure", "blurb": "Naming and describing polygons by their sides and angles, regular and irregular shapes, tessellation, and lines of symmetry.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u06.pdf"}, "objectives": {"O1": {"code": "4Gg.01", "sec": "6.1", "codeNote": "", "t": "Identify, describe and sort 2D shapes, including regular and irregular polygons, and recognise shapes that tessellate."}, "O2": {"code": "4Gg.02", "sec": "6.2", "codeNote": "", "t": "Identify lines of symmetry in 2D shapes and patterns, and complete symmetrical shapes."}}, "sections": [{"id": "6.1", "title": "2D shapes and tessellation", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Honeycomb", "p": ["Bees build honeycomb from **hexagons** that fit together with **no gaps**.", "Why hexagons and not circles? Which other shapes fit together like this? Think before you read on."]}, {"k": "recall", "t": "Sides and corners", "p": ["A triangle has 3 sides and 3 vertices (corners)."], "qq": {"id": "m4u06s1t01", "type": "num", "prompt": "How many sides does a pentagon have?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "idea", "t": "Polygons", "p": ["A **polygon** is a flat shape with straight sides. A **regular** polygon has all sides equal and all angles equal; an **irregular** one does not."], "table": {"head": ["Sides", "Name"], "rows": [["3", "triangle"], ["4", "quadrilateral"], ["5", "pentagon"], ["6", "hexagon"], ["8", "octagon"]]}, "fig": {"kind": "shape", "pts": [[2, 0], [4, 0], [5, 1.73], [4, 3.46], [2, 3.46], [1, 1.73]]}}, {"k": "idea", "t": "Tessellation", "p": ["Shapes **tessellate** when copies fit together with **no gaps and no overlaps**. Squares, equilateral triangles and regular hexagons tessellate; regular pentagons and circles do not.", "Circles leave gaps – hexagons don't, which is why bees use them."]}, {"k": "try", "t": "Name", "p": [], "qq": {"id": "m4u06s1t02", "type": "mcq", "prompt": "A shape with 8 sides is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "octagon", "ok": true, "fb": ""}, {"t": "hexagon", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I describe and sort 2D shapes?", "p": ["Step 1: Count the sides and vertices.", "Step 2: Check if sides and angles are all equal (regular or irregular).", "Step 3: Look for right angles and parallel sides.", "Step 4: Test tessellation: do copies fit with no gaps?"]}, {"k": "example", "t": "Name", "p": [], "q": "A shape has 6 sides of different lengths.", "steps": [["6 sides → hexagon", ""], ["not equal → irregular", ""]], "a": "irregular hexagon"}, {"k": "example", "t": "Regular", "p": [], "q": "A square.", "steps": [["4 equal sides, 4 right angles", ""]], "a": "regular quadrilateral"}, {"k": "example", "t": "Sorting", "p": [], "q": "Triangle, square, rectangle, pentagon. Which have 4 sides?", "steps": [["quadrilaterals", ""]], "a": "square and rectangle"}, {"k": "example", "t": "Tessellate?", "p": [], "q": "Rectangles (like bricks in a wall).", "steps": [["fit with no gaps", ""]], "a": "yes"}, {"k": "try", "t": "Tessellate", "p": [], "qq": {"id": "m4u06s1t03", "type": "mcq", "prompt": "Do circles tessellate?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "no", "ok": true, "fb": ""}, {"t": "yes", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Thinking only regular shapes are hexagons", "p": ["Find the first wrong line."], "q": "A shape has 6 sides of different lengths.", "lines": ["It is not a hexagon because the sides are not equal."], "bad": 0, "why": "Any 6-sided polygon is a hexagon – this is an irregular hexagon.", "fix": [["irregular hexagon", ""]], "id": "m4u06s1t04"}, {"k": "mistake", "t": "Thinking a shape must be regular to have its name", "p": ["The name comes from the number of sides."]}, {"k": "tip", "t": "Real life", "p": ["Floor tiles, brick walls and honeycomb are tessellations."]}, {"k": "summary", "t": "What to remember", "p": ["Polygon names: 3 triangle, 4 quadrilateral, 5 pentagon, 6 hexagon, 8 octagon.", "Regular: all sides and angles equal.", "Tessellate: no gaps, no overlaps."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "6.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u06s1k01", "type": "mcq", "prompt": "Before you read on: why hexagons?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "they fit with no gaps", "ok": true, "fb": ""}, {"t": "they are round", "ok": false, "fb": ""}]}}, {"id": "6.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u06s1k02", "type": "num", "prompt": "Sides of a hexagon?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hin