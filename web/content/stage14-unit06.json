ill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "idea", "t": "Lines of symmetry", "p": ["A **line of symmetry** (mirror line) splits a shape into two halves that are **mirror images**."], "table": {"head": ["Shape", "Lines of symmetry"], "rows": [["rectangle", "2"], ["square", "4"], ["equilateral triangle", "3"], ["regular hexagon", "6"], ["circle", "infinitely many"]]}, "p2": ["A regular polygon has as many lines of symmetry as sides."]}, {"k": "idea", "t": "Completing symmetrical shapes", "p": ["Each square on one side has a partner the **same distance** from the mirror line on the other side."], "fig": {"kind": "cells", "cells": [[0, 0], [1, 0], [1, 1], [2, 2], [5, 0], [4, 0], [4, 1], [3, 2]], "cols": 6, "rows": 3, "grid": true, "mirror": {"x": 3}}, "p2": ["The pattern matches on both sides of the dashed mirror line."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m4u06s2t02", "type": "num", "prompt": "Lines of symmetry in a square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "method", "t": "How do I find lines of symmetry?", "p": ["Step 1: Imagine folding the shape.", "Step 2: Check the two halves match exactly.", "Step 3: Try vertical, horizontal and diagonal lines.", "Step 4: Count every line that works."]}, {"k": "example", "t": "Letter A", "p": [], "q": "Lines of symmetry in the capital letter A.", "steps": [["a vertical line works", ""], ["horizontal doesn't", ""]], "a": "1"}, {"k": "example", "t": "Rectangle", "p": [], "q": "Do diagonals work?", "steps": [["folding along a diagonal doesn't match", ""]], "a": "no – only 2 lines"}, {"k": "example", "t": "Complete", "p": [], "q": "A shaded square is 2 squares left of a vertical mirror line.", "steps": [["same distance on the other side", ""]], "a": "2 squares right of the line"}, {"k": "example", "t": "No symmetry", "p": [], "q": "The letter F.", "steps": [["no fold matches", ""]], "a": "0 lines"}, {"k": "try", "t": "Letter", "p": [], "qq": {"id": "m4u06s2t03", "type": "num", "prompt": "Lines of symmetry in the letter H?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2."}}, {"k": "error", "t": "Counting diagonals in a rectangle", "p": ["Find the first wrong line."], "q": "Lines of symmetry in a rectangle.", "lines": ["2 + 2 diagonals = 4"], "bad": 0, "why": "Diagonals of a rectangle are not lines of symmetry: only 2.", "fix": [["2", ""]], "id": "m4u06s2t04"}, {"k": "mistake", "t": "Assuming diagonals are always lines of symmetry", "p": ["Imagine folding – check the halves really match."]}, {"k": "tip", "t": "Real life", "p": ["Logos, buildings, leaves and faces often have a line of symmetry."]}, {"k": "summary", "t": "What to remember", "p": ["Line of symmetry: halves are mirror images.", "Regular polygon: lines = sides.", "Reflected squares are the same distance from the line."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "6.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u06s2k01", "type": "num", "prompt": "Before you read on: lines of symmetry in a square?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "6.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u06s2k02", "type": "num", "prompt": "Lines in an equilateral triangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "6.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u06s2k03", "type": "num", "prompt": "Lines in the letter A?", "diff": "M", "obj": "O1", "skill":