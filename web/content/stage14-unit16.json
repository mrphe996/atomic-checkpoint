, "prompt": "Scale in 10s. Bar ends at the 7th line above 0. Value?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "prac": [{"id": "m4u16s1p01", "type": "num", "prompt": "Key ● = 10. ●●●● and half a ● = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1p02", "type": "num", "prompt": "Key ● = 4. How many symbols show 18?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1p03", "type": "num", "prompt": "Difference between Tuesday and Wednesday?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1p04", "type": "explain", "prompt": "Why might a scale go up in 10s instead of 1s?", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "big numbers / fits", "kw": ["big|large|fit|space|room|long"]}], "need": 1, "model": "With big numbers, a scale in 1s would be far too tall; 10s keeps the chart a sensible size.", "hint": "", "reason": "With big numbers, a scale in 1s would be far too tall; 10s keeps the chart a sensible size."}, {"id": "m4u16s1p05", "type": "mcq", "prompt": "Best key for values 20, 35, 50?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1 symbol = 5", "ok": true, "fb": ""}, {"t": "1 symbol = 3", "ok": false, "fb": ""}]}, {"id": "m4u16s1p06", "type": "num", "prompt": "Mean books per day (total ÷ 5)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "100 ÷ 5.", "reason": ""}, {"id": "m4u16s1p07", "type": "mcq", "prompt": "Which two days together equal Thursday?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Monday and Friday", "ok": true, "fb": ""}, {"t": "Tuesday and Wednesday", "ok": false, "fb": ""}]}, {"id": "m4u16s1p08", "type": "num", "prompt": "Scale in 2s. Bar halfway between 14 and 16?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m4u16s1a01", "type": "num", "prompt": "* Advanced. If next week has double Thursday's books on Saturday, how many on Saturday?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1a02", "type": "explain", "prompt": "* Advanced. Choose a key for a pictogram of 12, 18 and 30. Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "6 or 3 or 2", "kw": ["\\b(2|3|6)\\b"]}], "need": 1, "model": "e.g. 1 symbol = 6 (2, 3 and 5 symbols) – all are multiples of 6.", "hint": "", "reason": "e.g. 1 symbol = 6 (2, 3 and 5 symbols) – all are multiples of 6."}, {"id": "m4u16s1a03", "type": "mcq", "prompt": "* Advanced. A bar chart scale starts at 10, not 0. A bar for 15 looks…", "diff": "VH", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "much shorter than it should", "ok": true, "fb": ""}, {"t": "correct", "ok": false, "fb": ""}]}], "more": [{"id": "m4u16s1m01", "type": "num", "prompt": "Key ⭐ = 5. ⭐⭐ = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1m02", "type": "num", "prompt": "Key ⭐ = 2. ⭐⭐⭐ = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1m03", "type": "num", "prompt": "Books on Tuesday?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1m04", "type": "num", "prompt": "Books on Thursday?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1m05", "type": "num", "prompt": "Scale in 10s. Halfway between 20 and 30?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u16s1m06", "type": "mcq", "prompt": "A pictogram needs a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "key", "ok": true, "fb": ""}, {"t": "protractor", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c4u16", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 16.1 notes · Pictograms and bar charts", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "16.2", "title": "Dot plots and interpreting data", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Shoe sizes", "p": ["A shoe shop wants to know which children's size to order most of. They record the shoe sizes of 15 children.", "How could they show the sizes quickly, and which size should they order most of? Think before you read on."]}, {"k": "recall", "t": "Most common", "p": ["In 2, 3, 3, 5 the 3 appears most."], "qq": {"id": "m4u16s2t01", "type": "num", "prompt": "Most common in 4, 6, 6, 6, 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "idea", "t": "Dot plots", "p": ["A **dot plot** puts one dot above a number line for each value."], "fig": {"kind": "dotplot", "labels": ["2", "3", "4", "5", "6"], "counts": [1, 3, 6, 4, 1], "xlabel": "Shoe size"}, "p2": ["Size 4 has the tallest column – order most size 4 shoes."]}, {"k": "idea", "t": "The mode", "p": ["The **mode** is the value that appears **most often**. It helps describe and compare data.", "Class A mode 4; Class B mode 5 → Class B tends to have bigger feet."]}, {"k": "try", "t": "Mode", "p": [], "qq": {"id": "m4u16s2t02", "type": "num", "prompt": "Mode of the shoe sizes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "method", "t": "How do I draw a dot plot and find the mode?", "p": ["Step 1: Draw a number line covering all values.", "Step 2: Put one dot above the value for each item.", "Step 3: Stack dots neatly.", "Step 4: Mode = tallest column."]}, {"k": "example", "t": "Count", "p": [], "q": "How many children wear size 5?", "steps": [["4 dots above 5", ""]], "a": "4"}, {"k": "example", "t": "Total", "p": [], "q": "How many children altogether?", "steps": [["1 + 3 + 6 + 4 + 1", ""]], "a": "15"}, {"k": "example", "t": "Mode from a list", "p": [], "q": "Goals: 0, 2, 1, 2, 3, 2, 1.", "steps": [["2 appears 3 times", ""]], "a": "2"}, {"k": "example", "t": "Compare", "p": [], "q": "Spelling scores: Group A mode 7, Group B mode 9.", "steps": [["B's most common score is higher", ""]], "a": "B usually scored higher"}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m4u16s2t03", "type": "num", "prompt": "Children with size 3 or smaller?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "1 + 3.", "reason": "4."}}, {"k": "error", "t": "Giving the count, not the value", "p": ["Find the first wrong line."], "q": "Mode of the shoe sizes.", "lines": ["6 (the tallest column has 6 dots)"], "bad": 0, "why": "The mode is the value, not how many: size 4.", "fix": [["4", ""]], "id": "m4u16s2t04"}, {"k": "mistake", "t": "Giving the frequency in