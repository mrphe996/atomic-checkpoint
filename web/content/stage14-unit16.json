{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 16, "stage": 14, "title": "Data Display and Interpretation", "strandShort": "Statistics and probability", "blurb": "Reading and drawing pictograms and bar charts with scales, dot plots, and using the mode to describe data.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u16.pdf"}, "objectives": {"O1": {"code": "4Ss.03", "sec": "16.1", "codeNote": "", "t": "Represent and interpret data in pictograms and bar charts with scales in 2s, 5s and 10s."}, "O2": {"code": "4Ss.04", "sec": "16.2", "codeNote": "", "t": "Represent data in dot plots and use the mode to describe and compare data."}}, "sections": [{"id": "16.1", "title": "Pictograms and bar charts", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Books read", "p": ["In one month a class read: **Mon 10, Tue 25, Wed 15, Thu 30, Fri 20** library books.", "How could you show this so the busiest day jumps out? Think before you read on."]}, {"k": "recall", "t": "Counting in 5s", "p": ["5, 10, 15, 20, 25."], "qq": {"id": "m4u16s1t01", "type": "num", "prompt": "Count in 5s: 25, 30, ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "35."}}, {"k": "idea", "t": "Pictograms", "p": ["In a **pictogram** one symbol stands for several items. Check the **key**."], "table": {"head": ["Day", "Books (📕 = 5 books)"], "rows": [["Mon", "📕📕"], ["Tue", "📕📕📕📕📕"], ["Wed", "📕📕📕"], ["Thu", "📕📕📕📕📕📕"], ["Fri", "📕📕📕📕"]]}, "p2": ["Thursday has the most symbols: 6 × 5 = 30 books."]}, {"k": "idea", "t": "Bar charts", "p": ["A **bar chart** has a scale that can go up in 2s, 5s or 10s. Read where the top of each bar meets the scale."], "fig": {"kind": "barchart", "labels": ["Mon", "Tue", "Wed", "Thu", "Fri"], "values": [10, 25, 15, 30, 20], "ymax": 30, "step": 5, "ylabel": "Books"}, "p2": ["Scale in 5s: Tuesday's bar reaches 25."]}, {"k": "try", "t": "Read", "p": [], "qq": {"id": "m4u16s1t02", "type": "num", "prompt": "How many more books on Thursday than Monday?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "20."}}, {"k": "method", "t": "How do I read pictograms and bar charts?", "p": ["Step 1: Read the key or the scale step.", "Step 2: Count symbols × key, or read the bar top.", "Step 3: Halfway between lines = half a step.", "Step 4: Compare and total to answer questions."]}, {"k": "example", "t": "Key", "p": [], "q": "📕 = 4. Row: 📕📕📕 and half a 📕.", "steps": [["3 × 4 = 12", ""], ["half of 4 = 2", ""]], "a": "14 books"}, {"k": "example", "t": "Scale in 2s", "p": [], "q": "A bar halfway between 8 and 10.", "steps": [["half of 2 is 1", ""]], "a": "9"}, {"k": "example", "t": "Total", "p": [], "q": "Total books in the week.", "steps": [["10 + 25 + 15 + 30 + 20", ""]], "a": "100"}, {"k": "example", "t": "Fewest", "p": [], "q": "Which day had the fewest books?", "steps": [["shortest bar", ""]], "a": "Monday"}, {"k": "try", "t": "Scale", "p": [], "qq": {"id": "m4u16s1t03", "type": "num", "prompt": "Scale in 10s. A bar ends halfway between 40 and 50. Value?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "45."}}, {"k": "error", "t": "Ignoring the key", "p": ["Find the first wrong line."], "q": "📕 = 5 books. Wednesday has 📕📕📕.", "lines": ["3 books"], "bad": 0, "why": "Each symbol is 5 books: 3 × 5 = 15.", "fix": [["15 books", ""]], "id": "m4u16s1t04"}, {"k": "mistake", "t": "Ignoring the key or scale", "p": ["Always check what one symbol or one gap is worth."]}, {"k": "tip", "t": "Real life", "p": ["Schools, sports clubs and shops use charts to show what is popular."]}, {"k": "summary", "t": "What to remember", "p": ["Pictogram: symbols × key.", "Bar chart: read the scale (2s, 5s, 10s).", "Halfway = half a step."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "16.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u16s1k01", "type": "mcq", "prompt": "Before you read on: a good way to show it?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "a bar chart or pictogram", "ok": true, "fb": ""}, {"t": "a list of words", "ok": false, "fb": ""}]}}, {"id": "16.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u16s1k02", "type": "num", "prompt": "📕 = 5. Friday has 4 symbols. Books?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "16.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u16s1k03", "type": "num", "prompt": "Scale in 2s: halfway between 8 and 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "16.1-k4", "t": 4, 