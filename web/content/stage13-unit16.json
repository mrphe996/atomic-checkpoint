{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 16, "stage": 13, "title": "Chance", "strandShort": "Statistics and probability", "blurb": "Using words such as 'will happen', 'might happen' and 'will not happen' to describe chance, and doing simple chance experiments.", "strand": "Statistics and probability", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u16.pdf"}, "objectives": {"O1": {"code": "3Sp.01", "sec": "16.1", "codeNote": "", "t": "Use the language of chance: will happen, might happen, will not happen."}, "O2": {"code": "3Sp.02", "sec": "16.2", "codeNote": "", "t": "Carry out simple chance experiments and record the results."}}, "sections": [{"id": "16.1", "title": "Describing chance", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Tomorrow's weather", "p": ["Will it rain tomorrow? Will the sun rise tomorrow? Will a dinosaur walk past your school?", "Which of these will happen, might happen or will not happen? Think before you read on."]}, {"k": "recall", "t": "Days", "p": ["After Monday comes Tuesday."], "qq": {"id": "m3u16s1t01", "type": "mcq", "prompt": "The day after Friday is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Saturday", "ok": true, "fb": ""}, {"t": "Sunday", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Words for chance", "p": [], "table": {"head": ["Words", "Meaning", "Example"], "rows": [["will happen (certain)", "it must happen", "the sun will rise tomorrow"], ["might happen (possible)", "it may or may not happen", "it might rain tomorrow"], ["will not happen (impossible)", "it can't happen", "a dinosaur walks past school"]]}}, {"k": "idea", "t": "Using what you know", "p": ["Look at what is possible. A bag with only red balls: picking red **will happen**; picking blue **will not happen**. A bag of red and blue: red **might happen**."]}, {"k": "try", "t": "Choose", "p": [], "qq": {"id": "m3u16s1t02", "type": "mcq", "prompt": "Rolling a 6 on a 1–6 dice:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}}, {"k": "method", "t": "How do I describe chance?", "p": ["Step 1: Ask: can it happen at all?", "Step 2: Must it happen every time?", "Step 3: Can't → will not happen. Must → will happen.", "Step 4: Otherwise → might happen."]}, {"k": "example", "t": "Dice", "p": [], "q": "Rolling a 9 on a 1–6 dice.", "steps": [["no 9 on the dice", ""]], "a": "will not happen"}, {"k": "example", "t": "Coin", "p": [], "q": "A coin lands heads.", "steps": [["heads or tails", ""]], "a": "might happen"}, {"k": "example", "t": "Bag", "p": [], "q": "Picking a green ball from a bag of only green balls.", "steps": [["all green", ""]], "a": "will happen"}, {"k": "example", "t": "Day", "p": [], "q": "It will be your birthday tomorrow.", "steps": [["only one day a year", ""]], "a": "might happen (unlikely)"}, {"k": "try", "t": "Bag", "p": [], "qq": {"id": "m3u16s1t03", "type": "mcq", "prompt": "Picking yellow from a bag of only blue:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}}, {"k": "error", "t": "Mixing 'might' and 'will'", "p": ["Find the first wrong line."], "q": "A bag has 9 red balls and 1 blue. Picking red.", "lines": ["will happen"], "bad": 0, "why": "Blue is possible too, so red only might happen (very likely).", "fix": [["might happen", ""]], "id": "m3u16s1t04"}, {"k": "mistake", "t": "Saying 'will happen' when something is only very likely", "p": ["'Will happen' means every single time."]}, {"k": "tip", "t": "Real life", "p": ["Weather reports and games use words like 'might' and 'certain'."]}, {"k": "summary", "t": "What to remember", "p": ["will happen = certain.", "might happen = possible.", "will not happen = impossible."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "16.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u16s1k01", "type": "mcq", "prompt": "Before you read on: the sun rises tomorrow…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}}, {"id": "16.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u16s1k02", "type": "mcq", "prompt": "A dinosaur walks past school…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}}, {"id": "16.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u16s1k03", "type": "mcq", "prompt": "A coin lands heads…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}}, {"id": "16.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u16s1k04", "type": "mcq", "prompt": "Quick check: 9 red, 1 blue – picking red…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u16s1r01", "type": "mcq", "prompt": "It will be dark at midnight:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1r02", "type": "mcq", "prompt": "A cat will fly:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u16s1r03", "type": "mcq", "prompt": "You will have pasta for dinner:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1r04", "type": "mcq", "prompt": "Rolling a 3 on a 1–6 dice:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1r05", "type": "mcq", "prompt": "Rolling a 0 on a 1–6 dice:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u16s1r06", "type": "mcq", "prompt": "Rolling a number less than 7 on a 1–6 dice:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1r07", "type": "mcq", "prompt": "Picking red from 5 red and 5 blue:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1r08", "type": "mcq", "prompt": "Next month has at least 28 days:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}], "prac": [{"id": "m3u16s1p01", "type": "mcq", "prompt": "A spinner of all yellow lands on yellow:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1p02", "type": "mcq", "prompt": "A spinner of red and blue lands on green:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u16s1p03", "type": "mcq", "prompt": "Which is more likely from 8 red and 2 blue?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "red", "ok": true, "fb": ""}, {"t": "blue", "ok": false, "fb": ""}]}, {"id": "m3u16s1p04", "type": "explain", "prompt": "Explain why rolling a 6 on a dice 'might happen'.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "possible but not certain", "kw": ["possible|could|maybe|not every|other numbers|may"]}], "need": 1, "model": "It can happen, but other numbers can come up too – it is not certain.", "hint": "", "reason": "It can happen, but other numbers can come up too – it is not certain."}, {"id": "m3u16s1p05", "type": "mcq", "prompt": "Christmas will be in December:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1p06", "type": "mcq", "prompt": "Your teacher will be 200 years old:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u16s1p07", "type": "mcq", "prompt": "Change a bag so picking red 'will happen'.", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "only put red balls in", "ok": true, "fb": ""}, {"t": "add blue balls", "ok": false, "fb": ""}]}, {"id": "m3u16s1p08", "type": "mcq", "prompt": "It will snow tomorrow (in winter):", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}], "adv": [{"id": "m3u16s1a01", "type": "explain", "prompt": "* Advanced. Make a bag of 6 balls where red 'might happen' and green 'will not happen'.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "red and another colour, no green", "kw": ["red"]}], "need": 1, "model": "e.g. 3 red and 3 blue – no green.", "hint": "", "reason": "e.g. 3 red and 3 blue – no green."}, {"id": "m3u16s1a02", "type": "mcq", "prompt": "* Advanced. Two dice: a total of 12…", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}]}, {"id": "m3u16s1a03", "type": "mcq", "prompt": "* Advanced. Two dice: a total of 1…", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will not happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}]}], "more": [{"id": "m3u16s1m01", "type": "mcq", "prompt": "Tomorrow comes after today:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1m02", "type": "mcq", "prompt": "A fish will climb a tree:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}, {"id": "m3u16s1m03", "type": "mcq", "prompt": "You will see a bird today:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1m04", "type": "mcq", "prompt": "A coin lands tails:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": true, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1m05", "type": "mcq", "prompt": "Picking blue from only blue:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": true, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": false, "fb": ""}], "fixed": true}, {"id": "m3u16s1m06", "type": "mcq", "prompt": "Picking blue from only red:", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "will happen", "ok": false, "fb": ""}, {"t": "might happen", "ok": false, "fb": ""}, {"t": "will not happen", "ok": true, "fb": ""}], "fixed": true}], "notes": "v4", "pdf": [{"book": "c3u16", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 16.1 notes · Describing chance", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "16.2", "title": "Chance experiments", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Coin challenge", "p": ["Ben says 'If I flip a coin 10 times, I'll get exactly 5 heads.'", "Is he right? How could you find out? Think before you read on."]}, {"k": "recall", "t": "Tally marks", "p": ["𝍸 = 5."], "qq": {"id": "m3u16s2t01", "type": "num", "prompt": "𝍸 ||| = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "idea", "t": "Doing an experiment", "p": ["In a **chance experiment** we try something many times and **record** each result with a tally."], "table": {"head": ["Result", "Tally", "Total"], "rows": [["heads", "𝍸 |", "6"], ["tails", "||||", "4"]]}, "p2": ["10 flips: 6 heads, 4 tails. Not exactly 5 – results **vary** each time."]}, {"k": "idea", "t": "Results change", "p": ["Do it again and you might get 4 heads or 7 heads. With **more** flips, heads and tails usually get closer to half each."]}, {"k": "try", "t": "Total", "p": [], "qq": {"id": "m3u16s2t02", "type": "num", "prompt": "Heads 6 + tails 4 = how man