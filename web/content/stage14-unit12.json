{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 12, "stage": 14, "title": "Investigating 3D Shapes and Nets", "strandShort": "Geometry and measure", "blurb": "Faces, edges and vertices of prisms and pyramids, and nets that fold to make cubes, cuboids, prisms and pyramids.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u12.pdf"}, "objectives": {"O1": {"code": "4Gg.06", "sec": "12.1", "codeNote": "", "t": "Identify, describe and sort 3D shapes by their faces, edges and vertices."}, "O2": {"code": "4Gg.07", "sec": "12.2", "codeNote": "", "t": "Identify and sketch nets of cubes, cuboids, prisms and pyramids."}}, "sections": [{"id": "12.1", "title": "The properties of 3D shapes", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Packing a lunch box", "p": ["Your lunch box is a **cuboid**, your drink can is a **cylinder** and your orange is a **sphere**.", "Which ones can stack neatly? Which can roll? Why? Think before you read on."]}, {"k": "recall", "t": "2D shapes", "p": ["A square has 4 equal sides."], "qq": {"id": "m4u12s1t01", "type": "num", "prompt": "How many sides does a rectangle have?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}}, {"k": "idea", "t": "Faces, edges and vertices", "p": ["A **face** is a flat or curved surface. An **edge** is where two faces meet. A **vertex** is a corner (plural **vertices**)."], "fig": {"kind": "solid", "solid": "cuboid", "a": "", "b": "", "c": ""}, "p2": ["A cuboid has **6 faces, 12 edges, 8 vertices**."]}, {"k": "idea", "t": "Common 3D shapes", "p": [], "table": {"head": ["Shape", "Faces", "Edges", "Vertices"], "rows": [["cube", "6", "12", "8"], ["cuboid", "6", "12", "8"], ["square-based pyramid", "5", "8", "5"], ["triangular prism", "5", "9", "6"], ["cylinder", "3 (2 flat, 1 curved)", "2", "0"], ["sphere", "1 curved", "0", "0"]]}, "p2": ["Flat faces let shapes stack; curved faces let them roll."]}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m4u12s1t02", "type": "num", "prompt": "Vertices on a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "method", "t": "How do I describe a 3D shape?", "p": ["Step 1: Count the faces (flat and curved).", "Step 2: Count the edges.", "Step 3: Count the vertices.", "Step 4: Name the shapes of the faces."]}, {"k": "example", "t": "Pyramid", "p": [], "q": "Faces of a square-based pyramid.", "steps": [["1 square base", ""], ["4 triangles", ""]], "a": "5 faces"}, {"k": "example", "t": "Prism", "p": [], "q": "Edges of a triangular prism.", "steps": [["3 + 3 on the ends", ""], ["3 joining them", ""]], "a": "9 edges"}, {"k": "example", "t": "Sort", "p": [], "q": "Which of cube, sphere, cylinder can roll?", "steps": [["curved face", ""]], "a": "sphere and cylinder"}, {"k": "example", "t": "Cube vs cuboid", "p": [], "q": "Difference?", "steps": [["cube: all faces squares", ""]], "a": "a cube's faces are all equal squares"}, {"k": "try", "t": "Edges", "p": [], "qq": {"id": "m4u12s1t03", "type": "num", "prompt": "Edges on a cuboid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12."}}, {"k": "error", "t": "Counting edges as faces", "p": ["Find the first wrong line."], "q": "Faces on a cube.", "lines": ["12"], "bad": 0, "why": "12 is the number of edges. A cube has 6 faces.", "fix": [["6", ""]], "id": "m4u12s1t04"}, {"k": "mistake", "t": "Mixing up faces, edges and vertices", "p": ["Face = surface, edge = line, vertex = corner."]}, {"k": "tip", "t": "Real life", "p": ["Boxes are cuboids so they stack in lorries; cans are cylinders so they are strong and easy to hold."]}, {"k": "summary", "t": "What to remember", "p": ["Face, edge, vertex.", "Cube/cuboid: 6, 12, 8.", "Curved faces roll; flat faces stack."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "12.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u12s1k01", "type": "mcq", "prompt": "Before you read on: which can roll?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the orange (sphere)", "ok": true, "fb": ""}, {"t": "the lunch box", "ok": false, "fb": ""}]}}, {"id": "12.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u12s1k02", "type": "num", "prompt": "Faces on a cuboid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u12s1k03", "type": "num", "prompt": "Faces on a square-based pyramid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "12.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u12s1k04", "type": "num", "prompt": "Quick check: faces on a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m4u12s1r01", "type": "num", "prompt": "Faces on a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1r02", "type": "num", "prompt": "Edges on a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1r03", "type": "num", "prompt": "Vertices on a square-based pyramid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1r04", "type": "num", "prompt": "Faces on a triangular prism?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1r05", "type": "num", "prompt": "Vertices on a cylinder?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1r06", "type": "mcq", "prompt": "A football is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "sphere", "ok": true, "fb": ""}, {"t": "cylinder", "ok": false, "fb": ""}]}, {"id": "m4u12s1r07", "type": "mcq", "prompt": "A tin of beans is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cylinder", "ok": true, "fb": ""}, {"t": "cone", "ok": false, "fb": ""}]}, {"id": "m4u12s1r08", "type": "mcq", "prompt": "Which has only flat faces?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cuboid", "ok": true, "fb": ""}, {"t": "cylinder", "ok": false, "fb": ""}]}], "prac": [{"id": "m4u12s1p01", "type": "num", "prompt": "Vertices on a triangular prism?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1p02", "type": "num", "prompt": "Edges on a square-based pyramid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1p03", "type": "mcq", "prompt": "Faces of a triangular prism are…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2 triangles and 3 rectangles", "ok": true, "fb": ""}, {"t": "5 triangles", "ok": false, "fb": ""}]}, {"id": "m4u12s1p04", "type": "explain", "prompt": "Explain why a cylinder can roll but a cube cannot.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "curved face", "kw": ["curve|round"]}, {"pt": "cube flat", "kw": ["flat|corner|edge"]}], "need": 2, "model": "A cylinder has a curved face; a cube has only flat faces and corners.", "hint": "", "reason": "A cylinder has a curved face; a cube has only flat faces and corners."}, {"id": "m4u12s1p05", "type": "mcq", "prompt": "I have 6 square faces. I am a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cube", "ok": true, "fb": ""}, {"t": "pyramid", "ok": false, "fb": ""}]}, {"id": "m4u12s1p06", "type": "mcq", "prompt": "I have 1 curved face and no edges. I am a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "sphere", "ok": true, "fb": ""}, {"t": "cylinder", "ok": false, "fb": ""}]}, {"id": "m4u12s1p07", "type": "num", "prompt": "Total faces on 2 cubes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1p08", "type": "mcq", "prompt": "Which has an apex (point on top)?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "pyramid", "ok": true, "fb": ""}, {"t": "prism", "ok": false, "fb": ""}]}], "adv": [{"id": "m4u12s1a01", "type": "num", "prompt": "* Advanced. Faces on a pentagonal prism?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "2 pentagons + 5 rectangles.", "reason": ""}, {"id": "m4u12s1a02", "type": "num", "prompt": "* Advanced. Vertices on a hexagonal prism?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1a03", "type": "explain", "prompt": "* Advanced. For a cube, faces + vertices − edges = ? Is it the same for a pyramid?", "diff": "VH", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "2", "kw": ["\\b2\\b|two"]}, {"pt": "yes same", "kw": ["yes|same|also"]}], "need": 2, "model": "Cube: 6 + 8 − 12 = 2. Pyramid: 5 + 5 − 8 = 2 – yes, the same.", "hint": "", "reason": "Cube: 6 + 8 − 12 = 2. Pyramid: 5 + 5 − 8 = 2 – yes, the same."}], "more": [{"id": "m4u12s1m01", "type": "num", "prompt": "Faces on a cuboid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1m02", "type": "num", "prompt": "Vertices on a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1m03", "type": "mcq", "prompt": "A dice is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cube", "ok": true, "fb": ""}, {"t": "sphere", "ok": false, "fb": ""}]}, {"id": "m4u12s1m04", "type": "mcq", "prompt": "A corner is a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "vertex", "ok": true, "fb": ""}, {"t": "face", "ok": false, "fb": ""}]}, {"id": "m4u12s1m05", "type": "num", "prompt": "Edges on a sphere?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u12s1m06", "type": "mcq", "prompt": "Which can roll?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cylinder", "ok": true, "fb": ""}, {"t": "cube", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c4u12", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 12.1 notes · The properties of 3D shapes", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "12.2", "title": "Nets of 3D shapes", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Gift box", "p": ["A gift box comes flat in the post. You fold it up along the lines to make a cube.", "What did the flat shape look like? How many squares did it have? Think before you read on."]}, {"k": "recall", "t": "Faces", "p": ["A cube has 6 square faces."], "qq": {"id": "m4u12s2t01", "type": "num", "prompt": "Faces on a cube?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "6."}}, {"k": "idea", "t": "Nets", "p": ["A **net** is a flat shape that folds to make a 3D shape. Each face of the 3D shape is one part of the net."], "fig": {"kind": "cells", "cells": [[1, 0], [0, 1], [1, 1], [2, 1], [3, 1], [1, 2]], "cols": 4, "rows": 3}, "p2": ["This cross shape of 6 squares folds into a **cube**."]}, {"k": "idea", "t": "Nets of other shapes", "p": [], "table": {"head": ["3D shape", "Net has"], "rows": [["cuboid", "6 rectangles (in 3 matching pairs)"], ["square-based pyramid", "1 square + 4 triangles"], ["triangular prism", "2 triangles + 3 rectangles"]]}, "p2": ["Not every arrangement works: 6 squares in a straight line will not fold into a cube."]}, {"k": "try", "t": "Net", "p": [], "qq": {"id": "m4u12s2t02", "type": "mcq", "prompt": "A net with 1 square and 4 triangles makes a…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "square-based pyramid", "ok": true, "fb": ""}, {"t": "cube", "ok": false, "fb": ""}]}}, {"k": "method", "t": "How do I check a net?", "p": ["Step 1: Count the faces – do they match the 3D shape?", "Step 2: Check the face shapes.", "Step 3: Imagine folding: pick one face as the base.", "Step 4: Make sure no two faces land on the same side."]}, {"k": "example", "t": "Cube net?", "p": [], "q": "A row of 4 squares with one above and one below the second square.", "steps": [["4 around, 1 top, 1 bottom", ""]], "a": "yes"}, {"k": "example", "t": "Not a net", "p": [], "q": "6 squares in a straight line.", "steps": [["ends overlap when folded", ""]], "a": "no"}, {"k": "example", "t": "Prism", "p": [], "q": "Faces in a triangular prism net.", "steps": [["2 + 3", ""]], "a": "5"}, {"k": "example", "t": "Cuboid", "p": [], "q": "A net of a 4 cm × 2 cm × 1 cm cuboid.", "steps": [["pairs: 4 × 2, 4 × 1, 2 × 1", ""]], "a": "6 rectangles in 3 pairs"}, {"k": "try", "t": "Count", "p": [], "qq": {"id": "m4u12s2t03", "type": "num", "prompt": "Shapes in the net of a square-based pyramid?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}}, {"k": "error", "t": "Thinking any 6 squares make a cube", "p": ["Find the first wrong line."], "q": "6 squares in a 2 × 3 rectangle.", "lines": ["6 squares, so it folds into a cube."], "bad": 0, "why": "Folding it, faces overlap and the cube can't close – it is not a net.", "fix": [["not a ne