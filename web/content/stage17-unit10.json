ntage over 100% gives an answer bigger than the starting amount."]}],"video":{"src":null,"offset":0,"dur":300,"range":""},"stops":[{"id":"10.2-k1","t":1,"after":1,"review":[0,0],"note":"","q":{"id":"m7u10s2k01","type":"num","prompt":"Find 15% of 60.","diff":"M","obj":"O2","skill":"Application","answer":9,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true}},{"id":"10.2-k2","t":2,"after":2,"review":[0,0],"note":"","q":{"id":"m7u10s2k02","type":"mcq","prompt":"Before you read on: is 120% of 50 more or less than 50?","diff":"M","obj":"O2","skill":"Reasoning","options":[{"t":"Less: 40","ok":false,"fb":"More than 100% means more than the whole."},{"t":"The same","ok":false,"fb":"100% would be the same."},{"t":"More: 60","ok":true,"fb":"Correct."}]}}],"captions":[],"chapters":[[0,300]],"req":[{"id":"m7u10s2r01","type":"table","prompt":"Find percentages of 150.","diff":"M","obj":"O2","skill":"Data","head":["Percentage","Value"],"rows":[["10%",{"ans":15}],["5%",{"ans":7.5}],["15%",{"ans":22.5}],["1%",{"ans":1.5}]]},{"id":"m7u10s2r02","type":"grid","prompt":"Find each value.","diff":"M","obj":"O2","skill":"Data","cols":["10","15","6","8","12","4"],"rows":[{"l":"25% of 40","a":["10"]},{"l":"50% of 30","a":["15"]},{"l":"1% of 600","a":["6"]},{"l":"10% of 80","a":["8"]}],"mode":"classify"},{"id":"m7u10s2r03","type":"num","prompt":"Find 60% of 740.","diff":"M","obj":"O2","skill":"Application","answer":444,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m7u10s2r04","type":"num","prompt":"Find 200% of 112.","diff":"H","obj":"O2","skill":"Application","answer":224,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m7u10s2r05","type":"num","prompt":"Find 0.25% of 1600.","diff":"H","obj":"O2","skill":"Application","answer":4,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m7u10s2r06","type":"num","prompt":"Find 5% of 40 by building it from 10%, 5% and 1%.","diff":"H","obj":"O2","skill":"Application","answer":2,"unit":"×","units":["×"],"tol