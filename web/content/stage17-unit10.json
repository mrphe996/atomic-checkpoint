{"course": {"id": "s17", "title": "Camday – Cambridge Lower Secondary Mathematics — Stage 7", "units": [{"n": 1, "t": "Integers"}, {"n": 2, "t": "Expressions, Formulae and Equations"}, {"n": 3, "t": "Place Value and Rounding"}, {"n": 4, "t": "Decimals"}, {"n": 5, "t": "Angles and Constructions"}, {"n": 6, "t": "Collecting Data"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Shapes and Symmetry"}, {"n": 9, "t": "Sequences and Functions"}, {"n": 10, "t": "Percentages"}, {"n": 11, "t": "Graphs"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Probability"}, {"n": 14, "t": "Position and Transformation"}, {"n": 15, "t": "Shapes, Area and Volume"}, {"n": 16, "t": "Interpreting and Discussing Results"}]}, "unit": {"n": 10, "stage": 17, "title": "Percentages", "strandShort": "Number", "blurb": "Converting between fractions, decimals and percentages, finding percentages of amounts, and percentages greater than 100% and less than 1%.", "strand": "Number", "framework": "Cambridge Lower Secondary Mathematics (0862), Stage 7", "lesson": true, "subject": "maths", "read": "media/read/m7u10.pdf"}, "objectives": {"O1": {"code": "7Nf.11", "sec": "10.1", "codeNote": "", "t": "Recognise and convert between fractions, decimals and percentages, and compare them."}, "O2": {"code": "7Nf.12", "sec": "10.2", "codeNote": "", "t": "Find percentages of amounts, including percentages greater than 100% and less than 1%."}}, "sections": [{"id": "10.1", "title": "Fractions, decimals and percentages", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Battery levels", "p": ["Mia's phone shows **0.35** of its battery left, Leo's shows **3/8**, and Sam's says **36%**.", "Whose phone has the most charge left? Try it before you read on."]}, {"k": "recall", "t": "Per cent", "p": ["Per cent means 'out of 100': 45% = 45/100."], "qq": {"id": "m7u10s1t01", "type": "num", "prompt": "Write 7/100 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Out of 100.", "reason": "7%."}}, {"k": "idea", "t": "Three ways to write the same amount", "p": [], "table": {"head": ["Fraction", "Decimal", "Percentage"], "rows": [["1/2", "0.5", "50%"], ["1/4", "0.25", "25%"], ["3/4", "0.75", "75%"], ["1/5", "0.2", "20%"], ["1/10", "0.1", "10%"], ["1/8", "0.125", "12.5%"], ["1/3", "0.333…", "33 1/3%"]]}, "p2": ["Learn the common ones – they make comparing quick."]}, {"k": "idea", "t": "Converting", "p": [], "table": {"head": ["From → to", "Method", "Example"], "rows": [["% → decimal", "÷ 100", "36% = 0.36"], ["decimal → %", "× 100", "0.35 = 35%"], ["% → fraction", "over 100, then simplify", "36% = 36/100 = 9/25"], ["fraction → decimal", "numerator ÷ denominator", "3/8 = 3 ÷ 8 = 0.375"], ["fraction → %", "make it out of 100, or via the decimal", "3/8 = 0.375 = 37.5%"]]}, "p2": ["Battery: 0.35 = 35%, 3/8 = 37.5%, 36%. Leo's phone (3/8) has the most charge."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m7u10s1t02", "type": "num", "prompt": "Write 0.08 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 80, "fb": "0.08 × 100 = 8, not 80."}, {"v": 0.8, "fb": "Multiply by 100."}], "bare": true, "hint": "× 100.", "reason": "8%."}}, {"k": "method", "t": "How do I compare fractions, decimals and percentages?", "p": ["Step 1: Choose one form – usually percentages or decimals.", "Step 2: Convert each number using the methods in the table.", "Step 3: Compare (line up decimal points, or compare percentages).", "Step 4: Write the answer using the original numbers."]}, {"k": "example", "t": "Percentage to fraction", "p": [], "q": "Write 45% as a fraction in its simplest form.", "steps": [["45% = 45/100", "per cent = out of 100"], ["÷ 5 top and bottom", "HCF of 45 and 100 is 5"], ["= 9/20", ""]], "a": "9/20", "check": "9 ÷ 20 = 0.45 = 45%. ✓"}, {"k": "example", "t": "Fraction to percentage", "p": [], "q": "Write 7/20 as a percentage.", "steps": [["× 5 top and bottom → 35/100", "make the denominator 100"], ["35%", ""]], "a": "35%"}, {"k": "example", "t": "An awkward fraction", "p": [], "q": "Write 5/16 as a decimal and as a percentage.", "steps": [["5 ÷ 16 = 0.3125", "short division with zeros"], ["0.3125 × 100 = 31.25%", ""]], "a": "0.3125 = 31.25%"}, {"k": "example", "t": "Ordering mixed forms", "p": [], "q": "Order, smallest first: 2/5, 0.38, 41%, 3/8.", "steps": [["2/5 = 40%, 0.38 = 38%, 41%, 3/8 = 37.5%", "all as percentages"], ["37.5% < 38% < 40% < 41%", ""]], "a": "3/8, 0.38, 2/5, 41%"}, {"k": "try", "t": "Compare", "p": [], "qq": {"id": "m7u10s1t03", "type": "mcq", "prompt": "Which is largest?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "Make them all percentages.", "reason": "0.7.", "options": [{"t": "0.7", "ok": true, "fb": "70%."}, {"t": "2/3", "ok": false, "fb": "66.7%."}, {"t": "69%", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Moving the point the wrong way", "p": ["Find the first wrong line."], "q": "Write 0.6 as a percentage.", "lines": ["0.6 = 6%"], "bad": 0, "why": "0.6 × 100 = 60, so 0.6 = 60%. 6% would be 0.06.", "fix": [["0.6 × 100 = 60%", ""]], "id": "m7u10s1t04"}, {"k": "mistake", "t": "0.6 = 6%?", "p": ["No: multiply by 100. 0.6 = 60%, 0.06 = 6%."]}, {"k": "tip", "t": "Real life", "p": ["Phones show percentages, recipes use fractions and prices use decimals – being able to switch is useful every day."]}, {"k": "summary", "t": "What to remember", "p": ["% → decimal: ÷ 100; decimal → %: × 100.", "% → fraction: over 100, then simplify.", "Fraction → decimal: divide the numerator by the denominator.", "To compare, put everything in the same form."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "10.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m7u10s1k01", "type": "mcq", "prompt": "Before you read on: who has the most charge: 0.35, 3/8 or 36%?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "Make them all percentages.", "reason": "3/8.", "options": [{"t": "3/8 (Leo)", "ok": true, "fb": "37.5%."}, {"t": "36% (Sam)", "ok": false, "fb": ""}, {"t": "0.35 (Mia)", "ok": false, "fb": ""}]}}, {"id": "10.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m7u10s1k02", "type": "num", "prompt": "Write 3/5 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "60%."}}, {"id": "10.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m7u10s1k03", "type": "num", "prompt": "Write 15% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.15, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/20."}}, {"id": "10.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m7u10s1k04", "type": "num", "prompt": "Quick check: write 1/8 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "12.5%."}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m7u10s1r01", "type": "num", "prompt": "Write 0.42 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 42, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "42%."}, {"id": "m7u10s1r02", "type": "num", "prompt": "Write 9% as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.09, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.09."}, {"id": "m7u10s1r03", "type": "num", "prompt": "Write 40% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.4, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "2/5."}, {"id": "m7u10s1r04", "type": "num", "prompt": "Write 3/4 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 75, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "75%."}, {"id": "m7u10s1r05", "type": "num", "prompt": "Write 7/25 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 28, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "28%."}, {"id": "m7u10s1r06", "type": "num", "prompt": "Write 3/8 as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.375, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.375."}, {"id": "m7u10s1r07", "type": "mcq", "prompt": "Which is smallest?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "0.19", "ok": true, "fb": ""}, {"t": "1/5", "ok": false, "fb": "20%"}, {"t": "21%", "ok": false, "fb": ""}]}, {"id": "m7u10s1r08", "type": "num", "prompt": "Write 0.85 as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.85, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "17/20."}], "prac": [{"id": "m7u10s1p01", "type": "mcq", "prompt": "Smallest first: 0.6, 5/8, 61%", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "0.6, 61%, 5/8", "ok": true, "fb": "60, 61, 62.5."}, {"t": "5/8, 61%, 0.6", "ok": false, "fb": ""}]}, {"id": "m7u10s1p02", "type": "num", "prompt": "Write 11/40 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 27.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "27.5%."}, {"id": "m7u10s1p03", "type": "num", "prompt": "Write 62.5% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.625, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "5/8."}, {"id": "m7u10s1p04", "type": "mcq", "prompt": "In a test Ana scored 17/20 and Ben scored 84%. Who did better?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Ana", "ok": true, "fb": "85%."}, {"t": "Ben", "ok": false, "fb": ""}]}, {"id": "m7u10s1p05", "type": "num", "prompt": "Write 1/3 as a percentage to 1 decimal place.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 33.3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "33.3%."}, {"id": "m7u10s1p06", "type": "explain", "prompt": "Explain why 0.5 and 50% and 1/2 are the same.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "50 out of 100", "kw": ["100|hundred"]}, {"pt": "half", "kw": ["half|1/2"]}], "need": 2, "model": "50% means 50 out of 100, which is a half; 0.5 is 5 tenths, also a half.", "hint": "", "reason": "50% means 50 out of 100, which is a half; 0.5 is 5 tenths, also a half."}, {"id": "m7u10s1p07", "type": "num", "prompt": "28 out of 40 students walk. What percentage?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "70%."}, {"id": "m7u10s1p08", "type": "mcq", "prompt": "Which is NOT equal to 0.2?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2%", "ok": true, "fb": ""}, {"t": "1/5", "ok": false, "fb": ""}, {"t": "20%", "ok": false, "fb": ""}]}], "adv": [{"id": "m7u10s1a01", "type": "num", "prompt": "* Advanced. Write 7/12 as a percentage to 1 decimal place.", "diff": "H", "obj": "O1", "skill": "Application", "answer": 58.3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "58.3%."}, {"id": "m7u10s1a02", "type": "mcq", "prompt": "* Advanced. Which fraction is between 30% and 35%?", "diff": "H", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "1/3", "ok": true, "fb": "33.3%."}, {"t": "2/7", "ok": false, "fb": "28.6%."}, {"t": "3/8", "ok": false, "fb": "37.5%."}]}, {"id": "m7u10s1a03", "type": "num", "prompt": "* Advanced. A fraction with denominator 8 is between 60% and 70%. What is its numerator?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5/8 = 62.5%."}], "more": [{"id": "m7u10s1m01", "type": "num", "prompt": "Write 0.07 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7%."}, {"id": "m7u10s1m02", "type": "num", "prompt": "Write 65% as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.65, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.65."}, {"id": "m7u10s1m03", "type": "num", "prompt": "Write 25% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.25, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "1/4."}, {"id": "m7u10s1m04", "type": "num", "prompt": "Write 9/10 as a percentage.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 90, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "90%."}, {"id": "m7u10s1m05", "type": "num", "prompt": "Write 1/8 as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.125, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.125."}, {"id": "m7u10s1m06", "type": "mcq", "prompt": "Largest: 0.45, 4/9, 44%?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "0.45", "ok": true, "fb": ""}, {"t": "4/9", "ok": false, "fb": "44.4%"}, {"t": "44%", "ok": false, "fb": ""}]}], "notes": "v4", "pdf": [{"book": "c7u10", "p0": 2, "p1": 6, "label": "pages 2–6", "title": "Lesson 10.1 notes · Fractions, decimals and percentages", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}], "lv": {"src": "media/mv/s7/10-1.mp4", "poster": "media/mv/s7/10-1_poster.jpg", "srt": "media/mv/s7/10-1.srt", "dur": 313.04, "captions": [[7.88, "3 friends compare their phones."], [10.34, "Mia's phone shows 0.35 of its battery left."], [13.75, "Leo's shows 3 eighths."], [15.49, "And Sam's shows 36 per cent."], [18.26, "Whose phone has the most charge left?"], [20.81, "Pause the video and work it out."], [24.41, "To compare them, write all 3 in the same form."], [28.27, "0.35 is 35 per cent."], [30.49, "3 divided by 8 is 0.375, which is 37.5 per cent."], [35.97, "So Leo has 37.5 per cent, Sam has 36 per cent, and Mia has 35 per cent."], [41.61, "Leo has the most charge."], [44.06, "Remember: per cent means out of 100."], [47.49, "45 per cent is 45 out of 100."], [50.8, "A fraction, a decimal and a percentage can all show the same amount."], [55.79, "One half is 0.5, and it is 50 per cent."], [59.2, "One quarter is 0.25, or 25 per cent."], [62.66, "3 quarters is 0.75, or 75 per cent."], [66.57, "One fifth is 0.2, or 20 per cent."], [69.22, "And one tenth is 0.1, or 10 per cent."], [72.19, "These are worth learning by heart."], [75.46, "To change a percentage to a decimal, divide by 100."], [80.05, "36 per cent is 0.36."], [82.4, "To change a decimal to a percentage, multiply by 100."], [86.9, "0.07 is 7 per cent."], [89.06, "To change a percentage to a fraction, write it over 100, then simplify."], [95.32, "36 per cent is 36 over 100, which is 9 over 25."], [100.02, "To change a fraction to a decimal, divide the top by the bottom."], [104.91, "3 divided by 8 is 0.375."], [107.29, "Your turn."], [108.01, "Write 3 fifths as a percentage."], [110.23, "Pause the video and try it."], [113.56, "Make the denominator 100."], [115.83, "Multiply the top and the bottom by 20."], [119.3, "3 fifths is 60 over 100, which is 60 per cent."], [124.04, "Here is the method for comparing fractions, decimals and percentages."], [129.04, "Step 1: choose one form."], [130.77, "Percentages or decimals are usually easiest."], [134.51, "Step 2: convert every number to that form."], [138.12, "Step 3: compare them."], [140.65, "Step 4: write your answer using the original numbers."], [145.02, "Write 65 per cent as a fraction in its simplest form."], [149.51, "65 per cent is 65 over 100."], [152.05, "Divide the top and the bottom by 5."], [155.35, "That gives 13 over 20."], [157.97, "Your turn."], [158.69, "Write 15 per cent as a fraction in its simplest form."], [162.53, "Pause the video and try it."], [165.88, "15 per cent is 15 over 100."], [168.36, "Divide the top and the bottom by 5."], [171.57, "The answer is 3 over 20."], [174.32, "Write 11 over 25 as a percentage."], [177.85, "4 times 25 is 100."], [179.53, "So multiply the top and the bottom by 4."], [183.25, "That gives 44 over 100, which is 44 per cent."], [187.99, "Write 7 over 16 as a decimal, and as a percentage."], [192.16, "16 does not go into 100, so divide."], [195.62, "7 divided by 16 is 0.4375."], [199.57, "Multiply by 100."], [201.24, "That is 43.75 per cent."], [204.19, "Put these in order, smallest first: 3 fifths, 0.58, 61 per cent, and 5 eighths."], [211.27, "Write them all as percentages."], [213.96, "3 fifths is 60 per cent."], [216.12, "0.58 is 58 per cent."], [217.92, "5 eighths is 62.5 per cent."], [220.89, "In order: 58, 60, 61, 62.5."], [223.61, "So the answer is 0.58, 3 fifths, 61 per cent, 5 eighths."], [229.79, "Write 0.4 as a percentage."], [231.76, "Here is Zoe's working."], [233.42, "Is it right?"], [234.88, "Line 1 is wrong."], [236.32, "To change a decimal to a percentage, multiply by 100."], [241.08, "0.4 times 100 is 40."], [243.43, "So 0.4 is 40 per cent."], [245.61, "4 per cent would be 0.04."], [248.63, "Shops, doctors and scientists use all 3 forms."], [252.08, "A half price sale is 50 per cent off."], [254.86, "It is the same as multiplying the price by 0.5."], [258.94, "About 60 per cent of an adult's body is water."], [262.28, "That is about 3 fifths."], [264.5, "And a basketball player who scores 17 free throws out of 20 has scored 85 per cent of them."], [272.34, "One last question."], [273.64, "Write 1 eighth as a percentage."], [275.87, "Pause the video and work it out."], [279.58, "1 divided by 8 is 0.125."], [282.1, "Multiply by 100."], [283.78, "1 eighth is 12.5 per cent."], [287.06, "To remember: percentage to decimal, divide by 100."], [291.2, "Decimal to percentage, multiply by 100."], [294.99, "Percentage to fraction: write it over 100, then simplify."], [300.07, "Fraction to decimal: divide the top by the bottom."], [304.02, "To compare, put everything in the same form."], [307.59, "Great work! Now practise lesson 10.1 on Camday."]], "times": {"10.1-k1": 23.36, "10.1-k2": 112.51, "10.1-k3": 164.83, "10.1-k4": 278.53}}}, {"id": "10.2", "title": "Percentages large and small", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Bigger than 100%?", "p": ["A town had **8000** people. Ten years later its population is **150%** of what it was. A bank pays **0.5%** interest per year.", "How many people live in the town now? How much interest would $600 earn in a year? Try it before you read on."]}, {"k": "recall", "t": "10% and 1%", "p": ["10% of an amount = ÷ 10; 1% = ÷ 100. Build other percentages from these."], "qq": {"id": "m7u10s2t01", "type": "num", "prompt": "Find 30% of 240.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 72, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "10% = 24.", "reason": "3 × 24 = 72."}}, {"k": "idea", "t": "Percentages greater than 100%", "p": ["100% is the whole amount. More than 100% means more than the whole."], "table": {"head": ["Percentage", "Decimal", "Fraction", "Meaning"], "rows": [["100%", "1", "1", "the whole amount"], ["150%", "1.5", "1 1/2", "one and a half times"], ["200%", "2", "2", "double"], ["125%", "1.25", "1 1/4", "a quarter more"]]}, "p2": ["150% of 8000 = 1.5 × 8000 = **12 000** people."]}, {"k": "idea", "t": "Percentages less than 1%", "p": ["Less than 1% is less than one hundredth: 0.5% = 0.005 = 5/1000 = **1/200**.", "0.5% of $600 = 0.005 × 600 = **$3** (or: 1% of 600 = 6, so 0.5% = 3)."], "table": {"head": ["Percentage", "Decimal", "Fraction"], "rows": [["0.5%", "0.005", "1/200"], ["0.1%", "0.001", "1/1000"], ["17.5%", "0.175", "7/40"]]}}, {"k": "try", "t": "Large percentage", "p": [], "qq": {"id": "m7u10s2t02", "type": "num", "prompt": "Find 120% of 45.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 54, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 5.4, "fb": "120% is more than the whole: 1.2 × 45."}, {"v": 9, "fb": "That is only 20%."}], "bare": true, "hint": "100% + 20%.", "reason": "45 + 9 = 54."}}, {"k": "method", "t": "How do I find a percentage of an amount?", "p": ["Step 1: Convert the percentage to a decimal (÷ 100) and multiply – or build it from 100%, 10%, 1%.", "Step 2: For > 100%: the answer is bigger than the amount.", "Step 3: For < 1%: the answer is smaller than 1% of the amount.", "Step 4: Check the size with an estimate."]}, {"k": "example", "t": "Building a percentage", "p": [], "q": "Find 135% of 60.", "steps": [["100% = 60", ""], ["10% = 6, so 30% = 18", ""], ["5% = 3", "half of 10%"], ["135% = 60 + 18 + 3 = 81", ""]], "a": "81", "check": "1.35 × 60 = 81. ✓"}, {"k": "example", "t": "A small percentage", "p": [], "q": "Find 0.3% of 5000.", "steps": [["1% = 50", "÷ 100"], ["0.1% = 5", "÷ 10"], ["0.3% = 15", "× 3"]], "a": "15"}, {"k": "example", "t": "Converting a decimal percentage", "p": [], "q": "Write 2.4% as a decimal and as a fraction.", "steps": [["2.4 ÷ 100 = 0.024", ""], ["0.024 = 24/1000", ""], ["= 3/125", "÷ 8"]], "a": "0.024 = 3/125"}, {"k": "example", "t": "A real problem", "p": [], "q": "A puppy weighed 3 kg. Now it weighs 240% of that. What does it weigh?", "steps": [["240% = 2.4", ""], ["2.4 × 3 = 7.2", ""]], "a": "7.2 kg"}, {"k": "try", "t": "Small percentage", "p": [], "qq": {"id": "m7u10s2t03", "type": "num", "prompt": "Find 0.5% of 1400.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 70, "fb": "That is 5%."}, {"v": 700, "fb": "0.5% is less than 1%."}], "bare": true, "hint": "1% = 14.", "reason": "7."}}, {"k": "error", "t": "Too big", "p": ["Find the first wrong line."], "q": "Find 0.2% of 900.", "lines": ["0.2% = 0.2", "0.2 × 900 = 180"], "bad": 0, "why": "0.2% means 0.2 out of 100, which is 0.002. 180 would be 20%.", "fix": [["0.2% = 0.002", ""], ["0.002 × 900 = 1.8", ""]], "id": "m7u10s2t04"}, {"k": "mistake", "t": "Forgetting to divide by 100", "p": ["0.2% is 0.002, not 0.2. Always divide the percentage by 100 first."]}, {"k": "tip", "t": "Real life", "p": ["Population growth, price rises and bank interest use percentages above 100% or below 1%."]}, {"k": "summary", "t": "What to remember", "p": ["Percentage → decimal: ÷ 100 (150% = 1.5, 0.5% = 0.005).", "Over 100% gives more than the amount; under 1% gives less than one hundredth.", "Build percentages from 100%, 10%, 1%.", "Check the size of your answer."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "10.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m7u10s2k01", "type": "num", "prompt": "Before you read on: 150% of 8000 people = ?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12000, "unit": "×", "units": ["×"], "tol": 0, "errs": [{"v": 4000, "fb": "That is 50%. 150% is more than the whole."}], "bare": true, "hint": "", "reason": "12 000."}}, {"id": "10.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m7u10s2k02", "type": "num", "prompt": "Write 175% as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1.75, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "1.75."}}, {"id": "10.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m7u10s2k03", "type": "num", "prompt": "Find 0.1% of 3000.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "3."}}, {"id": "10.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m7u10s2k04", "type": "num", "prompt": "Quick check: 200% of 7.5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15."}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m7u10s2r01", "type": "num", "prompt": "Find 110% of 50.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 55, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "55."}, {"id": "m7u10s2r02", "type": "num", "prompt": "Find 250% of 40.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 100, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "100."}, {"id": "m7u10s2r03", "type": "num", "prompt": "Find 0.5% of 800.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "4."}, {"id": "m7u10s2r04", "type": "num", "prompt": "Write 0.7% as a decimal.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 0.007, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.007."}, {"id": "m7u10s2r05", "type": "num", "prompt": "Write 1.6 as a percentage.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 160, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "160%."}, {"id": "m7u10s2r06", "type": "num", "prompt": "Write 0.5% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 0.005, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "1/200."}, {"id": "m7u10s2r07", "type": "num", "prompt": "Find 12.5% of 64.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "1/8.", "reason": "8."}, {"id": "m7u10s2r08", "type": "num", "prompt": "Find 300% of 2.5.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 7.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7.5."}], "prac": [{"id": "m7u10s2p01", "type": "num", "prompt": "Find 0.25% of 2000.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "5."}, {"id": "m7u10s2p02", "type": "num", "prompt": "Find 145% of 80.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 116, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "116."}, {"id": "m7u10s2p03", "type": "num", "prompt": "A $250 bike now costs 130% of its old price. New price ($)?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 325, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "$325."}, {"id": "m7u10s2p04", "type": "num", "prompt": "A bank pays 0.8% interest per year on $1500. Interest ($)?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "$12."}, {"id": "m7u10s2p05", "type": "num", "prompt": "Write 37.5% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 0.375, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "3/8."}, {"id": "m7u10s2p06", "type": "mcq", "prompt": "Which is greater than 6?", "diff": "M", "obj": "O2", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "150% of 5", "ok": true, "fb": "7.5"}, {"t": "0.5% of 600", "ok": false, "fb": "3"}, {"t": "90% of 6", "ok": false, "fb": "5.4"}]}, {"id": "m7u10s2p07", "type": "explain", "prompt": "Can a test score be 120%? Can a price increase be 120%? Explain.", "diff": "H", "obj": "O2", "skill": "Reasoning", "rubric": [{"pt": "test no – can't score more than full marks", "kw": ["test|marks|full|maximum|can.?t|not"]}, {"pt": "price yes – can more than double", "kw": ["price|yes|more than|double|increase"]}], "need": 2, "model": "A test score can't be over 100% because you can't get more than full marks. A price can rise by 120% – it would become 220% of the old price.", "hint": "", "reason": "A test score can't be over 100% because you can't get more than full marks. A price can rise by 120% – it would become 220% of the old price."}, {"id": "m7u10s2p08", "type": "num", "prompt": "A tree was 1.2 m tall. Now it is 225% of that height. Height now (m)?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 2.7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "2.7 m."}], "adv": [{"id": "m7u10s2a01", "type": "num", "prompt": "* Advanced. 0.6% of a number is 9. What is the number?", "diff": "H", "obj": "O2", "skill": "Application", "answer": 1500, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "1% is 15.", "reason": "1500."}, {"id": "m7u10s2a02", "type": "num", "prompt": "* Advanced. 140% of a number is 84. What is the number?", "diff": "H", "obj": "O2", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "84 ÷ 1.4 = 60."}, {"id": "m7u10s2a03", "type": "num", "prompt": "* Advanced. Write 0.04% as a fraction. Give your answer as a fraction in its simplest form.", "diff": "H", "obj": "O2", "skill": "Application", "answer": 0.0004, "unit": "×", "units": ["×"], "tol": 1e-06, "errs": [], "bare": true, "hint": "", "reason": "1/2500."}], "more": [{"id": "m7u10s2m01", "type": "num", "prompt": "Find 120% of 30.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 36, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "36."}, {"id": "m7u10s2m02", "type": "num", "prompt": "Find 0.5% of 200.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "1."}, {"id": "m7u10s2m03", "type": "num", "prompt": "Write 2.5 as a percentage.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 250, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "250%."}, {"id": "m7u10s2m04", "type": "num", "prompt": "Write 0.3% as a decimal.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 0.003, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "0.003."}, {"id": "m7u10s2m05", "type": "num", "prompt": "Find 175% of 20.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "35."}, {"id": "m7u10s2m06", "type": "num", "prompt": "Find 0.1% of 45 000.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "45."}], "notes": "v4", "pdf": [{"book": "c7u10", "p0": 7, "p1": 11, "label": "pages 7–11", "title": "Lesson 10.2 notes · Percentages large and small", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}], "lv": {"src": "media/mv/s7/10-2.mp4", "poster": "media/mv/s7/10-2_poster.jpg", "srt": "media/mv/s7/10-2.srt", "dur": 331.2, "captions": [[7.25, "A town had 8,000 people."], [9.31, "10 years later, its population is 150 per cent of what it was."], [15.2, "How many people live in the town now?"], [17.71, "Pause the video and work it out."], [21.28, "100 per cent is the whole amount: 8,000 people."], [25.81, "50 per cent is half of that: 4,000."], [29.72, "150 per cent is 8,000 plus 4,000."], [33.54, "The town now has 12,000 people."], [37.67, "Remember: to find 10 per cent, divide by 10."], [41.47, "To find 1 per cent, divide by 100."], [44.95, "You can build other percentages from these."], [48.79, "10 per cent of 320 is 32, so 30 per cent is 3 times 32, which is 96."], [55.41, "100 per cent is the whole amount."], [58.13, "More than 100 per cent means more than the whole."], [62.72, "150 per cent is 1.5 as a decimal."], [65.3, "It means one and a half times the amount."], [69.06, "200 per cent is 2: double the amount."], [72.57, "And 250 per cent is 2.5."], [75.39, "The rule is the same as before: to change a percentage to a decimal, divide by 100."], [82.0, "Your turn."], [82.76, "Write 175 per cent as a decimal."], [85.2, "Pause the video and try it."], [88.67, "175 divided by 100 is 1.75."], [91.25, "The digits move 2 places to the right."], [95.45, "A percentage can also be very small."], [97.98, "Less than 1 per cent is less than one hundredth."], [101.92, "0.5 per cent is half of 1 per cent."], [105.25, "As a decimal, 0.5 divided by 100 is 0.005."], [109.81, "A bank pays 0.5 per cent interest on 600 dollars."], [114.22, "1 per cent of 600 is 6, so 0.5 per cent is 3 dollars."], [119.54, "Your turn."], [120.4, "Find 0.1 per cent of 3,000."], [122.72, "Pause the video and try it."], [126.44, "1 per cent of 3,000 is 30."], [128.78, "0.1 per cent is one tenth of that, which is 3."], [133.46, "Here is the method."], [134.93, "Step 1: change the percentage to a decimal and multiply."], [139.26, "Or build it from 100 per cent, 10 per cent and 1 per cent."], [144.29, "Step 2: more than 100 per cent gives an answer bigger than the amount."], [150.34, "Step 3: less than 1 per cent gives an answer smaller than one hundredth of the amount."], [156.99, "Step 4: check that the size of your answer makes sense."], [161.43, "Find 145 per cent of 80."], [164.59, "100 per cent is 80."], [166.32, "10 per cent is 8, so 40 per cent is 32."], [169.88, "And 5 per cent is half of 10 per cent, which is 4."], [174.99, "Add them: 80 plus 32 plus 4 is 116."], [179.37, "Check the size."], [180.67, "145 per cent is more than the whole, and 116 is more than 80."], [185.91, "Good."], [186.89, "Find 0.4 per cent of 2,500."], [190.35, "1 per cent is 25."], [191.85, "0.1 per cent is one tenth of that: 2.5."], [195.84, "0.4 per cent is 4 times 2.5, which is 10."], [200.37, "Write 3.6 per cent as a decimal, and as a fraction."], [204.7, "First, the decimal."], [206.71, "3.6 divided by 100 is 0.036."], [210.22, "0.036 is 36 thousandths."], [212.47, "Divide the top and the bottom by 4."], [215.75, "That is 9 over 250."], [218.08, "A kitten weighed 0.8 kilograms."], [220.51, "Now it weighs 350 per cent of that."], [223.26, "What does it weigh now?"], [225.62, "350 per cent is 3.5 as a decimal."], [229.22, "3.5 times 0.8 is 2.8."], [231.18, "The kitten now weighs 2.8 kilograms."], [235.1, "Find 0.3 per cent of 700."], [237.12, "Here is Raj's working."], [238.9, "Which line goes wrong first?"], [241.72, "Line 1 is wrong."], [243.27, "0.3 per cent means 0.3 out of 100, which is 0.003."], [248.11, "An answer of 210 would be 30 per cent."], [252.35, "0.003 times 700 is 2.1."], [254.45, "That is a sensible size for such a small percentage."], [259.75, "Big percentages describe growth."], [262.24, "The population of India today is about 400 per cent of what it was in 1950."], [268.06, "That is about 4 times as many people."], [271.49, "Small percentages matter too."], [273.66, "Carbon dioxide is only about 0.04 per cent of the air."], [278.25, "That is 4 parts in every 10,000."], [280.85, "But even that small amount helps to keep our planet warm."], [286.01, "One last question."], [287.44, "What is 200 per cent of 7.5?"], [289.66, "Pause the video and answer."], [293.2, "200 per cent means double."], [295.91, "2 times 7.5 is 15."], [298.34, "To remember: to change any percentage to a decimal, divide by 100."], [304.29, "150 per cent is 1.5, and 0.5 per cent is 0.005."], [309.08, "Over 100 per cent gives more than the amount."], [313.2, "Under 1 per cent gives less than one hundredth of it."], [317.53, "Build percentages from 100 per cent, 10 per cent and 1 per cent, and check the size of your answer."], [325.75, "Great work! Now practise lesson 10.2 on Camday."]], "times": {"10.2-k1": 20.23, "10.2-k2": 87.62, "10.2-k3": 125.39, "10.2-k4": 292.15}}}], "segments": {"O1": ["10.1", 0, 300, "Fractions, decimals and percentages"], "O2": ["10.2", 0, 300, "Percentages large and small"]}, "sources": [], "tests": {"A": [{"id": "m7u10v3Aq01", "type": "num", "prompt": "A jacket costs $88. There is 25% off. How much is taken off the price?", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "$", "units": ["$"]}, {"id": "m7u10v3Aq02", "type": "num", "prompt": "Write 80% as a decimal.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m7u10v3Aq03", "type": "num", "prompt": "A school has 250 students. 30% of them have a pet. How many students have a pet?", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "data": {"head": ["", "Students", "With a pet"], "rows": [["School", "250", "30%"]]}, "sec": "A · Fluency", "unit": "students", "units": ["students"]}, {"id": "m7u10v3Aq04", "type": "short", "prompt": "Write 20% as a fraction in its simplest form.", "diff": "M", "obj": "O1", "skill": "Knowledge", "pts": 1, "sec": "A · Fluency"}, {"id": "m7u10v3Aq05", "type": "num", "prompt": "Write 0.35 as a percentage.", "diff": "M", "obj": "O1", "skill": "Applicati