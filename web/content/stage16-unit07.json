, "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "cm²", "ok": true, "fb": ""}, {"t": "cm", "ok": false, "fb": ""}]}], "prac": [{"id": "m6u07s1p01", "type": "num", "prompt": "A triangle sail: base 3.5 m, height 4 m. Area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1p02", "type": "num", "prompt": "Square 10 cm cut along a diagonal. Area of one triangle?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1p03", "type": "num", "prompt": "Rectangle 8 × 6 with a triangle (base 8, height 6) cut away. Area left?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1p04", "type": "explain", "prompt": "Explain why the area of a triangle is half of base × height.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "rectangle around it", "kw": ["rectangle"]}, {"pt": "two equal halves", "kw": ["half|two|double"]}], "need": 2, "model": "A triangle fits inside a rectangle of base × height, and it takes up exactly half of it.", "hint": "", "reason": "A triangle fits inside a rectangle of base × height, and it takes up exactly half of it."}, {"id": "m6u07s1p05", "type": "num", "prompt": "Grid triangle: 14 whole squares and 8 half squares. Estimated area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1p06", "type": "num", "prompt": "Two identical triangles (base 6, height 5) make a rectangle. Rectangle area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1p07", "type": "num", "prompt": "A triangular garden: base 20 m, height 15 m. Seed for 1 m² costs $2. Cost ($)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 300, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1p08", "type": "mcq", "prompt": "Triangles with base 6, height 4 and base 4, height 6 have …", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "the same area", "ok": true, "fb": ""}, {"t": "different areas", "ok": false, "fb": ""}]}], "adv": [{"id": "m6u07s1a01", "type": "num", "prompt": "* Advanced. A triangle and a square have the same area. Triangle base 8, height 9. Square side?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Area 36.", "reason": ""}, {"id": "m6u07s1a02", "type": "explain", "prompt": "* Advanced. Draw two different triangles with area 12 cm². Give their bases and heights.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "two pairs multiplying to 24", "kw": ["6.*4|8.*3|12.*2|24.*1"]}], "need": 1, "model": "e.g. base 6, height 4; base 8, height 3 (base × height = 24).", "hint": "", "reason": "e.g. base 6, height 4; base 8, height 3 (base × height = 24)."}, {"id": "m6u07s1a03", "type": "num", "prompt": "* Advanced. A kite has diagonals 10 cm and 6 cm. Area (split into two triangles)?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": 30, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "Two triangles base 10, height 3.", "reason": ""}], "more": [{"id": "m6u07s1m01", "type": "num", "prompt": "Base 4, height 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1m02", "type": "num", "prompt": "Base 10, height 10?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 50, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1m03", "type": "num", "prompt": "Rectangle 5 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1m04", "type": "num", "prompt": "Base 3, height 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1m05", "type": "num", "prompt": "Area 15, base 5. Height?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u07s1m06", "type": "num", "prompt": "Base 1, height 1?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 0.5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u07", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 7.1 notes · Rectangles and triangles", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "7.2", "title": "Time", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Film length", "p": ["A streaming app says a film lasts **2.25 hours**. Another says **2 h 25 min**.", "Are these the same? Which is longer? Think about it before you read on."]}, {"k": "recall", "t": "Time facts", "p": ["1 hour = 60 minutes; 1 minute = 60 seconds."], "qq": {"id": "m6u07s2t01", "type": "num", "prompt": "How many minutes in 3 hours?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "180."}}, {"k": "idea", "t": "Decimal hours to hours and minutes", "p": ["A decimal of an hour is a fraction of **60 minutes**:"], "table": {"head": ["Decimal", "Fraction", "Minutes"], "rows": [["0.5 h", "½ h", "30 min"], ["0.25 h", "¼ h", "15 min"], ["0.75 h", "¾ h", "45 min"], ["0.1 h", "1/10 h", "6 min"], ["0.2 h", "1/5 h", "12 min"]]}, "p2": ["2.25 h = 2 h 15 min, so **2 h 25 min is longer** (by 10 min)."]}, {"k": "idea", "t": "Hours and minutes to decimal hours", "p": ["Divide the minutes by 60: 1 h 30 min = 1.5 h; 3 h 12 min = 3 + 12/60 = **3.2 h**.", "Decimal minutes work the same way: 2.5 min = 2 min 30 s."]}, {"k": "try", "t": "Convert", "p": [], "qq": {"id": "m6u07s2t02", "type": "short", "prompt": "Write 1.75 hours in hours and minutes. Write it like 2 h 15 min.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["1 h 45 min", "/^\\s*1\\s*(h|hours?|hrs?)\\s*(and\\s*)?45\\s*(min|mins|minutes?|m)\\s*$/i"], "hint": "0.75 × 60.", "reason": "1 h 45 min."}}, {"k": "method", "t": "How do I convert between decimal and mixed time units?", "p": ["Step 1: Separate the whole hours from the decimal part.", "Step 2: Decimal → minutes: × 60.", "Step 3: Minutes → decimal: ÷ 60.", "Step 4: Check: 0.5 h is 30 min, not 50 min."]}, {"k": "example", "t": "Decimal to mixed", "p": [], "q": "3.4 hours.", "steps": [["0.4 × 60 = 24", ""]], "a": "3 h 24 min"}, {"k": "example", "t": "Mixed to decimal", "p": [], "q": "4 h 45 min.", "steps": [["45 ÷ 60 = 0.75", ""]], "a": "4.75 h"}, {"k": "example", "t": "Seconds", "p": [], "q": "4.2 minutes in minutes and seconds.", "steps": [["0.2 × 60 = 12 s", ""]], "a": "4 min 12 s"}, {"k": "example", "t": "Pay", "p": [], "q": "Paid $12 per hour for 2 h 30 min.", "steps": [["2.5 h × 12 = 30", ""]], "a": "$30"}, {"k": "try", "t": "Decimal", "p": [], "qq": {"id": "m6u07s2t03", "type": "num", "prompt": "Write 1 h 6 min as a decimal number of hours.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1.1, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "6 ÷ 60.", "reason": "1.1."}}, {"k": "error", "t": "Treated the decimal as minutes", "p": ["Find the first wrong line."], "q": "Write 1.5 hours in hours and minutes.", "lines": ["1 h 50 min"], "bad": 0, "why": "0.5 of an hour is half of 60 minutes = 30 minutes: 1 h 30 min.", "fix": [["0.5 × 60 = 30", ""], ["1 h 30 min", ""]], "id": "m6u07s2t04"}, {"k": "mistake", "t": "Reading 1.5 h as 1 h 50 min", "p": ["An hour has 60 minutes, not 100."]}, {"k": "tip", "t": "Real life", "p": ["Timesheets, apps and sports results often use decimal hours or minutes."]}, {"k": "summary", "t": "What to remember", "p": ["1 h = 60 min.", "Decimal → minutes: × 60.", "Minutes → decimal: ÷ 60.", "0.5 h = 30 min, 0.25 h = 15 min, 0.1 h = 6 min."]}], "video": {"src": null, "offset": 0, "dur": 720, "range": ""}, "stops": [{"id": "7.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u07s2k01", "type": "mcq", "prompt": "Before you read on: longer?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "2 h 25 min", "ok": true, "fb": ""}, {"t": "2.25 h", "ok": false, "fb": ""}]}}, {"id": "7.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u07s2k02", "type": "num", "prompt": "0.1 h in minutes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u07s2k03", "type": "num", "prompt": "3 h 12 min as decimal hours?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 3.2, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u07s2k04", "type": "num", "prompt": "Quick check: 0.75 h in minutes?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 45, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "