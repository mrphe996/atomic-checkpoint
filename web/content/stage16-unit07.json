{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 7, "stage": 16, "title": "Exploring Measures", "strandShort": "Geometry and measure", "blurb": "Area and perimeter of rectangles, compound shapes and right-angled triangles, and working with time, including the 24-hour clock and timetables.", "strand": "Geometry and measure", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u07.pdf"}, "objectives": {"O1": {"code": "6Gg.04", "sec": "7.1", "codeNote": "", "t": "Find the area and perimeter of rectangles and compound shapes, and the area of right-angled triangles."}, "O2": {"code": "6Gt.01", "sec": "7.2", "codeNote": "", "t": "Use 12- and 24-hour clocks, convert between units of time and find time intervals, including with timetables."}}, "sections": [{"id": "7.1", "title": "Rectangles and triangles", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Sail design", "p": ["A boat's sail is a **right-angled triangle**: 4 m along the bottom and 6 m up the mast.", "How much sail cloth is needed? Could a rectangle help you work it out? Think about it before you read on."]}, {"k": "recall", "t": "Area of a rectangle", "p": ["Area = length × width; units cm², m²."], "qq": {"id": "m6u07s1t01", "type": "num", "prompt": "Area of a rectangle 7 cm by 5 cm (cm²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "35."}}, {"k": "idea", "t": "Triangles are half a rectangle", "p": ["Draw a rectangle round a right-angled triangle: the triangle is exactly **half** of it.", "Sail: rectangle 4 × 6 = 24 m², so the sail is **12 m²**."], "fig": {"kind": "shape", "pts": [[0, 0], [4, 0], [0, 6]], "s": ["4 m", "", "6 m"], "right": [0]}}, {"k": "idea", "t": "Any triangle", "p": ["This works for any triangle: **area = ½ × base × height**, where the **height** is measured at right angles to the base (from the base up to the top corner).", "Estimate areas on squared paper by counting whole squares and pairing up part squares."]}, {"k": "try", "t": "Triangle", "p": [], "qq": {"id": "m6u07s1t02", "type": "num", "prompt": "Triangle base 10 cm, height 3 cm. Area (cm²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "15."}}, {"k": "method", "t": "How do I find the area of a triangle?", "p": ["Step 1: Find the base and the height (at right angles to the base).", "Step 2: Picture the rectangle base × height.", "Step 3: Halve it.", "Step 4: Write square units."]}, {"k": "example", "t": "Not right-angled", "p": [], "q": "Triangle base 8 cm, height 5 cm.", "steps": [["rectangle 8 × 5 = 40", ""], ["half = 20", ""]], "a": "20 cm²"}, {"k": "example", "t": "Find the height", "p": [], "q": "A triangle has area 18 cm² and base 6 cm. Height?", "steps": [["rectangle would be 36 cm²", ""], ["36 ÷ 6 = 6", ""]], "a": "6 cm"}, {"k": "example", "t": "Estimate", "p": [], "q": "On a grid a triangle covers 9 whole squares and 6 half squares.", "steps": [["9 + 3 = 12", ""]], "a": "about 12 squares"}, {"k": "example", "t": "Compound", "p": [], "q": "A house-shaped sign: rectangle 6 × 4 with a triangle (base 6, height 3) on top.", "steps": [["24 + 9 = 33", ""]], "a": "33"}, {"k": "try", "t": "Height", "p": [], "qq": {"id": "m6u07s1t03", "type": "num", "prompt": "Area 20 cm², base 5 cm. Height?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8 cm."}}, {"k": "error", "t": "Forgot to halve", "p": ["Find the first wrong line."], "q": "Triangle base 9 m, height 4 m.", "lines": ["9 × 4 = 36 m²"], "bad": 0, "why": "A triangle is half the rectangle: 36 ÷ 2 = 18 m².", "fix": [["½ × 9 × 4 = 18 m²", ""]], "id": "m6u07s1t04"}, {"k": "mistake", "t": "Forgetting the half", "p": ["Triangle = half of base × height."]}, {"k": "tip", "t": "Real life", "p": ["Sails, roofs, garden beds and road signs use triangle areas to work out materials."]}, {"k": "summary", "t": "What to remember", "p": ["Rectangle: length × width.", "Triangle: ½ × base × height.", "Height is at right angles to the base.", "Square units."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "7.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u07s1k01", "type": "num", "prompt": "Before you read on: sail area (m²)?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 12, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "7.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u07s1k02", "type": "mcq", "prompt": "A triangle is … of its rectangle", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "half", "ok": true, "fb": ""}, {"t": "a quarter", "ok": false, "fb": ""}]}}, {"id": "7.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u07s1k03", "type": "num", "prompt": "Base 8, height 5. Area?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 20, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "