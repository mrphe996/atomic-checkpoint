{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 10, "stage": 13, "title": "More Multiplication and Division", "strandShort": "Number", "blurb": "Times-table facts for 2, 3, 4, 5, 6, 8, 9 and 10, odd and even numbers, multiplying by 10, and multiplying a 2-digit number by a 1-digit number.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u10.pdf"}, "objectives": {"O1": {"code": "3Nc.09", "sec": "10.1", "codeNote": "", "t": "Recall multiplication and division facts for the 2, 3, 4, 5, 6, 8, 9 and 10 times tables."}, "O2": {"code": "3Nc.10", "sec": "10.2", "codeNote": "", "t": "Recognise odd and even numbers and patterns in multiples."}, "O3": {"code": "3Nc.11", "sec": "10.3", "codeNote": "", "t": "Multiply by 10 and multiply 2-digit numbers by 1-digit numbers."}}, "sections": [{"id": "10.1", "title": "Revisiting multiplication and division", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Times-table race", "p": ["In a class game, Ana says '7 × 5 is 35, so 35 ÷ 5 must be 7!'", "Is she right? How does knowing one fact give you others? Think before you read on."]}, {"k": "recall", "t": "Counting in steps", "p": ["5, 10, 15, 20, 25, 30, 35."], "qq": {"id": "m3u10s1t01", "type": "num", "prompt": "7 × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "35."}}, {"k": "idea", "t": "Fact families", "p": ["One fact gives four: **7 × 5 = 35, 5 × 7 = 35, 35 ÷ 5 = 7, 35 ÷ 7 = 5**. Ana is right."], "table": {"head": ["Table", "Fact", "Division fact"], "rows": [["2×", "8 × 2 = 16", "16 ÷ 2 = 8"], ["3×", "6 × 3 = 18", "18 ÷ 3 = 6"], ["4×", "9 × 4 = 36", "36 ÷ 4 = 9"], ["5×", "7 × 5 = 35", "35 ÷ 5 = 7"], ["10×", "6 × 10 = 60", "60 ÷ 10 = 6"]]}}, {"k": "idea", "t": "Using what you know", "p": ["Don't know 6 × 4? Use 6 × 2 = 12 and double: 24. Don't know 9 × 5? Use 10 × 5 = 50 and take 5: 45."]}, {"k": "try", "t": "Divide", "p": [], "qq": {"id": "m3u10s1t02", "type": "num", "prompt": "40 ÷ 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "10."}}, {"k": "method", "t": "How do I recall and use table facts?", "p": ["Step 1: Say the times table or count in steps.", "Step 2: Use the fact family to divide.", "Step 3: Use doubles and near facts.", "Step 4: Check by multiplying."]}, {"k": "example", "t": "Fact family", "p": [], "q": "From 8 × 3 = 24.", "steps": [["3 × 8 = 24", ""], ["24 ÷ 3 = 8, 24 ÷ 8 = 3", ""]], "a": "four facts"}, {"k": "example", "t": "Near fact", "p": [], "q": "9 × 10 to find 9 × 9.", "steps": [["90 − 9", ""]], "a": "81"}, {"k": "example", "t": "Divide", "p": [], "q": "54 ÷ 6.", "steps": [["6 × 9 = 54", ""]], "a": "9"}, {"k": "example", "t": "Story", "p": [], "q": "45 pencils in boxes of 5.", "steps": [["45 ÷ 5", ""]], "a": "9 boxes"}, {"k": "try", "t": "Story", "p": [], "qq": {"id": "m3u10s1t03", "type": "num", "prompt": "32 children in teams of 4. Teams?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "8."}}, {"k": "error", "t": "Wrong fact family", "p": ["Find the first wrong line."], "q": "From 6 × 4 = 24, a division fact.", "lines": ["24 ÷ 6 = 3"], "bad": 0, "why": "24 ÷ 6 = 4 (and 24 ÷ 4 = 6).", "fix": [["24 ÷ 6 = 4", ""]], "id": "m3u10s1t04"}, {"k": "mistake", "t": "Mixing numbers in a fact family", "p": ["The same three numbers appear in every fact."]}, {"k": "tip", "t": "Real life", "p": ["Sharing sweets, counting money in 5s and 10s, packing boxes."]}, {"k": "summary", "t": "What to remember", "p": ["One fact → four facts.", "Division undoes multiplication.", "Use doubles and near facts."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "10.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u10s1k01", "type": "mcq", "prompt": "Before you read on: is Ana right?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "yes", "ok": true, "fb": ""}, {"t": "no", "ok": false, "fb": ""}]}}, {"id": "10.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u10s1k02", "type": "num", "prompt": "36 ÷ 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u10s1k03", "type": "num", "prompt": "9 × 9?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 81, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "10.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u10s1k04", "type": "num", "prompt": "Quick check: 24 ÷ 6?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u10s1r01", "type": "num", "prompt": "6 × 5?", "diff": "M", "obj": "O1", "skill": "Application",