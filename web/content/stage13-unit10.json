p.","Subtract to find the remainder; it must be smaller than the divisor."],"v2p":true},{"k":"mistake","t":"Not just adding 10","p":["36 × 10 is 360, not 46."]}],"video":{"src":null,"offset":0,"dur":300,"range":""},"stops":[{"id":"10.3-k1","t":1,"after":0,"review":[0,0],"note":"","q":{"id":"m3u10s3k01","type":"num","prompt":"Work out 45 × 10.","diff":"M","obj":"O3","skill":"Application","answer":450,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true}},{"id":"10.3-k2","t":2,"after":0,"review":[0,0],"note":"","q":{"id":"m3u10s3k02","type":"mcq","prompt":"Before you read on: what is 3 × 20?","diff":"M","obj":"O3","skill":"Reasoning","options":[{"t":"60","ok":true,"fb":"Correct."},{"t":"600","ok":false,"fb":"3 × 2 = 6, so 3 × 20 = 60."},{"t":"23","ok":false,"fb":"3 groups of 20."}]}}],"captions":[],"chapters":[[0,300]],"req":[{"id":"m3u10s3r01","type":"table","prompt":"Complete the grid to work out 38 × 2.","diff":"M","obj":"O3","skill":"Data","head":["×","30","8"],"rows":[["2",{"ans":60},{"ans":16}]]},{"id":"m3u10s3r02","type":"num","prompt":"How much do 5 rulers cost, in cents?","diff":"M","obj":"O3","skill":"Data","answer":110,"unit":"cents","units":["cents"],"tol":0,"errs":[],"data":{"head":["Item","pen","ruler","rubber"],"rows":[["Price (cents)","16","22","20"]]}},{"id":"m3u10s3r03","type":"num","prompt":"Work out 60 × 10.","diff":"M","obj":"O3","skill":"Application","answer":600,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m3u10s3r04","type":"num","prompt":"Work out 44 × 4.","diff":"M","obj":"O3","skill":"Application","answer":176,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m3u10s3r05","type":"num","prompt":"Work out 590 ÷ 10.","diff":"M","obj":"O3","skill":"Application","answer":59,"unit":"×","units":["×"],"tol":0,"errs":[],"bare":true},{"id":"m3u10s3r06","type":"num","prompt":"A box holds 21 crayons. How many crayons are in 2 boxes?","diff":"M","obj":"O3","skill":"Application","answer":42,"unit":"crayons","units":["crayon