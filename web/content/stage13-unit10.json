hint": "", "reason": ""}, {"id": "m3u10s1p03", "type": "num", "prompt": "56 ÷ 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 8, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u10s1p04", "type": "explain", "prompt": "Write the fact family for 4 × 9 = 36.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "9 × 4", "kw": ["9 ?[×x] ?4"]}, {"pt": "36 ÷", "kw": ["36 ?÷"]}], "need": 2, "model": "4 × 9 = 36, 9 × 4 = 36, 36 ÷ 4 = 9, 36 ÷ 9 = 4.", "hint": "", "reason": "4 × 9 = 36, 9 × 4 = 36, 36 ÷ 4 = 9, 36 ÷ 9 = 4."}, {"id": "m3u10s1p05", "type": "num", "prompt": "? × 6 = 42", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u10s1p06", "type": "num", "prompt": "72 ÷ ? = 8", "diff": "M", "obj": "O1", "skill": "Application", "answer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u10s1p07", "type": "num", "prompt": "Socks come in pairs. Socks in 9 pairs?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 18, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u10s1p08", "type": "num", "prompt": "$60 shared by 6. Each?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m3u10s1a01", "type": "num", "prompt": "* Advanced. 6 × 8 + 6 × 2?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 60, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "6 × 10.", "reason": ""}, {"id": "m3u10s1a02", "type": "explain", "prompt": "* Advanced. Find two different ways to make 24 by multiplying two numbers.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "pairs", "kw": ["3.{0,5}8|4.{0,5}6|2.{0,5}12|1.{0,