esson": [{"k": "hook", "t": "Pairs for a dance", "p": ["The class lines up in pairs for a dance. With 24 children nobody is left out; with 25, one child has no partner.", "Which numbers can always be put in pairs? Think before you read on."]}, {"k": "recall", "t": "Odd and even", "p": ["Even numbers end in 0, 2, 4, 6, 8."], "qq": {"id": "m3u10s2t01", "type": "mcq", "prompt": "Is 25 odd or even?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "odd", "ok": true, "fb": ""}, {"t": "even", "ok": false, "fb": ""}], "fixed": true}}, {"k": "idea", "t": "Odd and even", "p": ["**Even** numbers can be split into pairs (multiples of 2). **Odd** numbers always have **one left over**.", "Look at the **last digit**: 24 even, 25 odd, 130 even, 347 odd."]}, {"k": "idea", "t": "Patterns in multiples", "p": [], "table": {"head": ["Multiples of", "Pattern in the last digit"], "rows": [["2", "0, 2, 4, 6, 8"], ["5", "0 or 5"], ["10", "always 0"], ["4", "always even"]]}, "p2": ["Every multiple of 10 is also a multiple of 5 and of 2."]}, {"k": "try", "t": "Odd or even", "p": [], "qq": {"id": "m3u10s2t02", "type": "mcq", "prompt": "Is 138 odd or even?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "odd", "ok": false, "fb": ""}, {"t": "even", "ok": true, "fb": ""}], "fixed": true}}, {"k": "method", "t": "How do I spot odd, even and multiples?", "p": ["Step 1: Look at the last digit.", "Step 2: 0, 2, 4, 6, 8 → even; 1, 3, 5, 7, 9 → odd.", "Step 3: Ends in 0 or 5 → multiple of 5.", "Step 4: Ends in 0 → multiple of 10."]}, {"k": "example", "t": "Even?", "p": [], "q": "476.", "steps": [["ends in 6", ""]], "a": "even"}, {"k": "example", "t": "Multiple of 5?", "p": [], "q": "235.", "steps": [["ends in 5", ""]], "a": "yes"}, {"k": "example", "t": "Multiple of 10?", "p": [], "q": "235.", "steps": [["does not end in 0", ""]], "a": "no"}, {"k": "example", "t": "Pattern", "p": [], "q": "Continue: 4, 8, 12, 16, …", "steps": [["add 4", ""]], "a": "20, 24"}, {"k": "try", "t": "Multiple", "p": [], "qq": {"id": "m3u10s2t03", "type": "mcq", "prompt": "Which is a multiple of 10?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "350", "ok": true, "fb": ""}, {"t": "355", "ok": false, "fb": ""}]}}, {"k": "error", "t": "Looking at the first digit", "p": ["Find the first wrong line."], "q": "Is 41 odd or even?", "lines": ["starts with 4, so even"], "bad": 0, "why": "Look at the last digit: 1 → odd.", "fix": [["odd", ""]], "id": "m3u10s2t04"}, {"k": "mistake", "t": "Checking the first digit", "p": ["Only the ones digit decides odd or even."]}, {"k": "tip", "t": "Real life", "p": ["House numbers: odd on one side of the street, even on the other."]}, {"k": "summary", "t": "What to remember", "p": ["Even: last digit 0, 2, 4, 6, 8.", "Multiples of 5 end in 0 or 5; of 10 end in 0.", "Look at the last digit."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "10.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u10s2k01", "type": "mcq", "prompt": "Before you read on: numbers that can always be paired are…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "even", "ok": true, "fb": ""}, {"t": "odd", "ok": false, "fb": ""}]}}, {"id": "10.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u10s2k02", "type": "mcq", "prompt": "347 is…", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "odd", "ok": true, "fb": ""}, {"t": "even", "ok": false, "fb": ""}], "fixed": true}}, {"id": "10.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u10s2k03", "type": "mcq", "prompt": "Is 235 a multiple of 5?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "yes", "ok": true, "fb": ""}, {"t": "no", "ok": false, "fb": ""}]}}, {"id": "10.2-k4", "t":