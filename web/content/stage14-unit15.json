t?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "5021", "ok": true, "fb": ""}, {"t": "5012", "ok": false, "fb": ""}, {"t": "5002", "ok": false, "fb": ""}]}, {"id": "m4u15s1r08", "type": "mcq", "prompt": "Smallest?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−10", "ok": true, "fb": ""}, {"t": "−1", "ok": false, "fb": ""}, {"t": "0", "ok": false, "fb": ""}]}], "prac": [{"id": "m4u15s1p01", "type": "short", "prompt": "Order from smallest: −2, −8, 3, −5. Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["-8, -5, -2, 3", "/^\\s*[-−]8\\s*[,; ]\\s*[-−]5\\s*[,; ]\\s*[-−]2\\s*[,; ]\\s*3\\s*$/"], "hint": "", "reason": ""}, {"id": "m4u15s1p02", "type": "short", "prompt": "Order from largest: 2905, 2950, 2509, 9250. Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["9250, 2950, 2905, 2509", "/^\\s*9250\\s*[,; ]\\s*2950\\s*[,; ]\\s*2905\\s*[,; ]\\s*2509\\s*$/"], "hint": "", "reason": ""}, {"id": "m4u15s1p03", "type": "mcq", "prompt": "1000 − 1 ☐ 990 + 9", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": false, "fb": ""}, {"t": ">", "ok": false, "fb": ""}, {"t": "=", "ok": true, "fb": ""}], "fixed": true}, {"id": "m4u15s1p04", "type": "explain", "prompt": "Explain why −6 < −1.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "further from zero / left", "kw": ["further|left|below|colder|less"]}], "need": 1, "model": "−6 is further below zero, further left on the number line.", "hint": "", "reason": "−6 is further below zero, further left on the number line."}, {"id": "m4u15s1p05", "type": "num", "prompt": "How many whole numbers are between −4 and 2?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "−3, −2, −1, 0, 1.", "reason": ""}, {"id": "m4u15s1p06", "type": "mcq", "prompt": "Which is true?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−3 < 0 < 3", "ok": true, "fb": ""}, {"t": "3 < 0 < −3", "ok": false, "fb": ""}]}, {"id": "m4u15s1p07", "type": "num", "prompt": "The number halfway between −6 and 0?", "diff": "M", "obj": "O1", "skill": "Application", "answer": -3, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u15s1p08", "type": "mcq", "prompt": "4 × 25 ☐ 99", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": false, "fb": ""}, {"t": ">", "ok": true, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}], "adv": [{"id": "m4u15s1a01", "type": "num", "prompt": "* Advanced. Largest 4-digit number less than 5000 with all digits different?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 4987, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u15s1a02", "type": "num", "prompt": "* Advanced. Smallest whole number greater than −10 that is a multiple of 3?", "diff": "VH", "obj": "O1", "skill": "Application", "answer": -9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m4u15s1a03", "type": "explain", "prompt": "* Advanced. In golf, is a score of −2 better than −6? Explain.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no", "kw": ["\\bno\\b|not|worse"]}, {"pt": "−6 lower", "kw": ["lower|smaller|less"]}], "need": 2, "model": "No – −6 is lower than −2, and the lowest score wins.", "hint": "", "reason": "No – −6 is lower than −2, and the lowest score wins."}], "more": [{"id": "m4u15s1m01", "type": "mcq", "prompt": "2 ☐ 9", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": true, "fb": ""}, {"t": ">", "ok": false, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}, {"id": "m4u15s1m02", "type": "mcq", "prompt": "0 ☐ −2", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": false, "fb": ""}, {"t": ">", "ok": true, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}, {"id": "m4u15s1m03", "type": "mcq", "prompt": "10 ☐ 5 + 5", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": false, "fb": ""}, {"t": ">", "ok": false, "fb": ""}, {"t": "=", "ok": true, "fb": ""}], "fixed": true}, {"id": "m4u15s1m04", "type": "mcq", "prompt": "1234 ☐ 1243", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": true, "fb": ""}, {"t": ">", "ok": false, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}, {"id": "m4u15s1m05", "type": "mcq", "prompt": "Smallest?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−4", "ok": true, "fb": ""}, {"t": "4", "ok": false, "fb": ""}]}, {"id": "m4u15s1m06", "type": "mcq", "prompt": "−1 ☐ −5", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": false, "fb": ""}, {"t": ">", "ok": true, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}], "notes": "v4", "pdf": [{"book": "c4u15", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 15.1 notes · Ordering and comparing numbers", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}, {"id": "15.2", "title": "Working with special numbers", "objs": ["O2"], "lesson": [{"k": "hook", "t": "Square patios", "p": ["A builder makes square patios from square tiles: **1 tile, 4 tiles, 9 tiles, …**", "What comes next? Why are these called square numbers? Think before you read on."]}, {"k": "recall", "t": "Multiplication", "p": ["3 × 3 = 9."], "qq": {"id": "m4u15s2t01", "type": "num", "prompt": "4 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "16."}}, {"k": "idea", "t": "Square numbers", "p": ["A **square number** is a number multiplied by itself. It makes a square pattern."], "fig": {"kind": "cells", "cells": [[0, 0], [0, 1], [0, 2], [0, 3], [1, 0], [1, 1], [1, 2], [1, 3], [2, 0], [2, 1], [2, 2], [2, 3], [3, 0], [3, 1], [3, 2], [3, 3]], "cols": 4, "rows": 4, "grid": true}, "p2": ["4 × 4 = **16**. Square numbers to 100: 1, 4, 9, 16, 25, 36, 49, 64, 81, 100."]}, {"k": "idea", "t": "Multiples and common multiples", "p": ["**Multiples** of 4: 4, 8, 12, 16, 20, 24, …; multiples of 6: 6, 12, 18, 24, …", "Numbers in both lists are **common multiples**: 12, 24, … – useful when things repeat together."]}, {"k": "try", "t": "Square", "p": [], "qq": {"id": "m4u15s2t02", "type": "num", "prompt": "The 5th square number?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 25, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "25."}}, {"k": "method", "t": "How do I use special numbers?", "p": ["Step 1: Square: n × n.", "Step 2: Multiples: count in steps of the number.", "Step 3: Common multiples: in both lists.", "Step 4: Use them to solve 'when together again' problems."]}, {"k": "example", "t": "Square", "p": [], "q": "Is 36 a square number?", "steps": [["6 × 6 = 36", ""]], "a": "yes"}, {"k": "example", "t": "Not square", "p": [], "q": "Is 20 a square number?", "steps": [["4 × 4 = 16, 5 × 5 = 25", ""]], "a": "no"}, {"k": "example", "t": "Common multiple", "p": [], "q": "First common multiple of 3 and 5.", "steps": [["3, 6, 9, 12, 15", ""], ["5, 10, 15", ""]], "a": "15"}, {"k": "example", "t": "Problem", "p": [], "q": "Bus A every 4 min, bus B every 6 min, both leave at 9:00. Together again?", "steps": [["first common multiple 12", ""]], "a": "9:12"}, {"k": "try", "t": "Common", "p": [], "qq": {"id": "m4u15s2t03", "type": "num", "prompt": "First common multiple of 2 and 7?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 14, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "14."}}, {"k": "error", "t": "Doubling instead of squaring", "p": ["Find the first wrong line."], "q": "The square of 7.", "lines": ["7 × 2 = 14"], "bad": 0, "why": "Square means × itself: 7 × 7 = 49.", "fix": [["49", ""]], "id": "m4u15s2t04"}, {"k": "mistake", "t": "Doubling instead of squaring", "p": ["Square = number × the same number."]}, {"k": "tip", "t": "Real life", "p": ["Chessboards (8 × 8 = 64 squares) and square tiles show square numbers; traffic lights and buses repeat on common multiples."]}, {"k": "summary", "t": "What to remember", "p": ["Square numbers: 1, 4, 9, 16, 25, 36, 49, 64, 81, 100.", "Multiples: times-table numbers.", "Common multiples: in both lists."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "15.2-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u15s2k01", "type": "num", "prompt": "Before you read on: the next patio?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 16, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "15.2-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u15s2k02", "type": "num", "prompt": "8 × 8?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 64, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "15.2-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u15s2k03", "type": "num", "prompt": "First common multiple of 3 and 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 15, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "15.2-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m4u15s2k04", "type": "num", "prompt": "Quick check: the square of 