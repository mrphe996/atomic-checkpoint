{"course": {"id": "s14", "title": "Camday – Cambridge Primary Mathematics — Stage 4", "units": [{"n": 1, "t": "Numbers and the Number System"}, {"n": 2, "t": "Time and Timetables"}, {"n": 3, "t": "Addition and Subtraction of Whole Numbers"}, {"n": 4, "t": "Probability"}, {"n": 5, "t": "Multiplication, Multiples and Factors"}, {"n": 6, "t": "2D Shapes"}, {"n": 7, "t": "Fractions"}, {"n": 8, "t": "Angles"}, {"n": 9, "t": "Comparing, Rounding and Dividing"}, {"n": 10, "t": "Collecting and Recording Data"}, {"n": 11, "t": "Fractions and Percentages"}, {"n": 12, "t": "Investigating 3D Shapes and Nets"}, {"n": 13, "t": "Addition and Subtraction"}, {"n": 14, "t": "Area and Perimeter"}, {"n": 15, "t": "Special Numbers"}, {"n": 16, "t": "Data Display and Interpretation"}, {"n": 17, "t": "Multiplication and Division"}, {"n": 18, "t": "Position, Direction and Movement"}]}, "unit": {"n": 15, "stage": 14, "title": "Special Numbers", "strandShort": "Number", "blurb": "Ordering and comparing positive and negative numbers, square numbers and multiples, and tests of divisibility by 2, 5, 10, 25, 50 and 100.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 4", "lesson": true, "subject": "maths", "read": "media/read/m4u15.pdf"}, "objectives": {"O1": {"code": "4Np.03", "sec": "15.1", "codeNote": "", "t": "Order and compare whole numbers, including negative numbers, using < , > and =."}, "O2": {"code": "4Ns.02", "sec": "15.2", "codeNote": "", "t": "Recognise square numbers and multiples, and use them to solve problems."}, "O3": {"code": "4Nc.07", "sec": "15.3", "codeNote": "", "t": "Use tests of divisibility for 2, 5, 10, 25, 50 and 100."}}, "sections": [{"id": "15.1", "title": "Ordering and comparing numbers", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Golf scores", "p": ["In golf the **lowest** score wins. Scores: Ali **−3**, Bea **+2**, Cal **0**, Dev **−5**.", "Who won? Put them in order before you read on."]}, {"k": "recall", "t": "Number line", "p": ["Numbers get smaller to the left."], "qq": {"id": "m4u15s1t01", "type": "mcq", "prompt": "Smaller: −1 or 1?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "−1", "ok": true, "fb": ""}, {"t": "1", "ok": false, "fb": ""}]}}, {"k": "idea", "t": "Comparing with <, > and =", "p": ["**<** means 'is less than', **>** means 'is greater than', **=** means 'is equal to'. The open mouth faces the bigger number: 7 > 3, −5 < −3."], "fig": {"kind": "numline", "min": -6, "max": 3, "marks": [-5, -3, 0, 2]}, "p2": ["Golf order (best first): Dev −5, Ali −3, Cal 0, Bea +2. **Dev won.**"]}, {"k": "idea", "t": "Ordering bigger numbers", "p": ["For whole numbers, compare digits from the **left**: 4085 < 4580 (hundreds 0 < 5).", "Negative numbers are always less than zero and less than every positive number."]}, {"k": "try", "t": "Sign", "p": [], "qq": {"id": "m4u15s1t02", "type": "mcq", "prompt": "−2 ☐ −7", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": false, "fb": ""}, {"t": ">", "ok": true, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}}, {"k": "method", "t": "How do I compare and order numbers?", "p": ["Step 1: Negatives are smallest; further from zero is smaller.", "Step 2: For positives, compare place by place from the left.", "Step 3: Use < > = correctly (mouth to the bigger).", "Step 4: Check with a number line."]}, {"k": "example", "t": "Negatives", "p": [], "q": "Order −4, 1, −9, 0.", "steps": [["−9 furthest left", ""]], "a": "−9, −4, 0, 1"}, {"k": "example", "t": "4-digit", "p": [], "q": "Compare 6702 and 6720.", "steps": [["tens: 0 < 2", ""]], "a": "6702 < 6720"}, {"k": "example", "t": "Equal", "p": [], "q": "300 + 40 ☐ 340.", "steps": [["340 = 340", ""]], "a": "="}, {"k": "example", "t": "Between", "p": [], "q": "A whole number between −3 and 0.", "steps": [["−2 or −1", ""]], "a": "−2 (or −1)"}, {"k": "try", "t": "Order", "p": [], "qq": {"id": "m4u15s1t03", "type": "short", "prompt": "Order from smallest: 5, −2, −6. Separate them with commas.", "diff": "M", "obj": "O1", "skill": "Application", "accept": ["-6, -2, 5", "/^\\s*[-−]6\\s*[,; ]\\s*[-−]2\\s*[,; ]\\s*5\\s*$/"], "hint": "", "reason": "−6, −2, 5."}}, {"k": "error", "t": "Thinking −7 > −2", "p": ["Find the first wrong line."], "q": "Compare −7 and −2.", "lines": ["7 > 2, so −7 > −2"], "bad": 0, "why": "−7 is further below zero: −7 < −2.", "fix": [["−7 < −2", ""]], "id": "m4u15s1t04"}, {"k": "mistake", "t": "Treating negatives like positives", "p": ["Further left on the number line = smaller."]}, {"k": "tip", "t": "Real life", "p": ["Golf scores, temperatures and bank balances can be negative."]}, {"k": "summary", "t": "What to remember", "p": ["< less than, > greater than, = equal.", "Negatives: further from zero → smaller.", "Positives: compare from the left."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "15.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m4u15s1k01", "type": "mcq", "prompt": "Before you read on: who won?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "Dev (−5)", "ok": true, "fb": ""}, {"t": "Bea (+2)", "ok": false, "fb": ""}]}}, {"id": "15.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m4u15s1k02", "type": "mcq", "prompt": "−5 ☐ −3", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": true, "fb": ""}, {"t": ">", "ok": false, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}}, {"id": "15.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m4u15s1k03", "type": "mcq", "prompt": "6702 ☐ 6720", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "<", "ok": true, "fb": ""}, {"t": ">", "ok": false, "fb": ""}, {"t": "=", "ok": false, "fb": ""}], "fixed": true}}, {"id": "15.1-k4", "t": 4, "after": 14, "r