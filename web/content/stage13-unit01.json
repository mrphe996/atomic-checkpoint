{"course": {"id": "s13", "title": "Camday – Cambridge Primary Mathematics — Stage 3", "units": [{"n": 1, "t": "Numbers to 1000"}, {"n": 2, "t": "Addition, Subtraction and Money"}, {"n": 3, "t": "Multiplication and Division"}, {"n": 4, "t": "3D Shapes"}, {"n": 5, "t": "Measurement, Area and Perimeter"}, {"n": 6, "t": "Fractions of Shapes"}, {"n": 7, "t": "Statistics: Tally Charts and Frequency Tables"}, {"n": 8, "t": "Time"}, {"n": 9, "t": "More Addition and Subtraction"}, {"n": 10, "t": "More Multiplication and Division"}, {"n": 11, "t": "More Fractions"}, {"n": 12, "t": "Measure"}, {"n": 13, "t": "Time (2)"}, {"n": 14, "t": "Angles and Movement"}, {"n": 15, "t": "Graphs"}, {"n": 16, "t": "Chance"}, {"n": 17, "t": "Pattern and Symmetry"}]}, "unit": {"n": 1, "stage": 13, "title": "Numbers to 1000", "strandShort": "Number", "blurb": "Reading, writing and making 3-digit numbers, comparing and ordering them, and rounding to the nearest 10 and 100.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 3", "lesson": true, "subject": "maths", "read": "media/read/m3u01.pdf"}, "objectives": {"O1": {"code": "3Np.01", "sec": "1.1", "codeNote": "", "t": "Understand the value of each digit in a 3-digit number: hundreds, tens and ones."}, "O2": {"code": "3Np.02", "sec": "1.2", "codeNote": "", "t": "Compare and order numbers up to 1000 using the symbols <, > and =."}, "O3": {"code": "3Np.03", "sec": "1.3", "codeNote": "", "t": "Estimate and round 3-digit numbers to the nearest 10 or 100."}}, "sections": [{"id": "1.1", "title": "Hundreds, tens and ones", "objs": ["O1"], "lesson": [{"k": "hook", "t": "Counting stickers", "p": ["Mia has **3 sheets** of 100 stickers, **4 strips** of 10 stickers and **6 loose** stickers.", "How many stickers does she have? Try it before you read on."]}, {"k": "recall", "t": "Tens and ones", "p": ["46 = 4 tens and 6 ones."], "qq": {"id": "m3u01s1t01", "type": "num", "prompt": "How many tens in 70?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "7."}}, {"k": "idea", "t": "Place value", "p": ["In a 3-digit number each digit has a value: **hundreds**, **tens**, **ones**."], "table": {"head": ["Hundreds", "Tens", "Ones"], "rows": [["3", "4", "6"]]}, "p2": ["346 = 300 + 40 + 6. Mia has **346 stickers**. We say: three hundred and forty-six."]}, {"k": "idea", "t": "Zero holds a place", "p": ["In 508 there are **no tens**, so we write a 0: 508 = 500 + 8. Without the 0 it would be 58 – a very different number."]}, {"k": "try", "t": "Value", "p": [], "qq": {"id": "m3u01s1t02", "type": "num", "prompt": "The value of the 7 in 274?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 70, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "70."}}, {"k": "method", "t": "How do I read and write 3-digit numbers?", "p": ["Step 1: Put the digits in a place-value table.", "Step 2: Write the value of each digit.", "Step 3: Use 0 when a place is empty.", "Step 4: Read: hundreds, then tens and ones."]}, {"k": "example", "t": "Partition", "p": [], "q": "Partition 628.", "steps": [["6 hundreds, 2 tens, 8 ones", ""]], "a": "600 + 20 + 8"}, {"k": "example", "t": "Build", "p": [], "q": "400 + 50 + 3.", "steps": [["4 in hundreds, 5 in tens, 3 in ones", ""]], "a": "453"}, {"k": "example", "t": "Words", "p": [], "q": "Write 'seven hundred and nine'.", "steps": [["no tens → 0", ""]], "a": "709"}, {"k": "example", "t": "10 more", "p": [], "q": "10 more than 395.", "steps": [["9 tens + 1 ten = 10 tens = 1 hundred", ""]], "a": "405"}, {"k": "try", "t": "Build", "p": [], "qq": {"id": "m3u01s1t03", "type": "num", "prompt": "200 + 30 + 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 235, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "235."}}, {"k": "error", "t": "Missing zero", "p": ["Find the first wrong line."], "q": "Write 'six hundred and four'.", "lines": ["64"], "bad": 0, "why": "Six hundred needs 3 digits: 604.", "fix": [["604", ""]], "id": "m3u01s1t04"}, {"k": "mistake", "t": "Forgetting the zero", "p": ["Use a place-value table – every place needs a digit."]}, {"k": "tip", "t": "Real life", "p": ["House numbers, page numbers and prices often have 3 digits."]}, {"k": "summary", "t": "What to remember", "p": ["Hundreds, tens, ones.", "346 = 300 + 40 + 6.", "Zero holds an empty place."]}], "video": {"src": null, "offset": 0, "dur": 660, "range": ""}, "stops": [{"id": "1.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m3u01s1k01", "type": "num", "prompt": "Before you read on: how many stickers?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 346, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "1.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m3u01s1k02", "type": "num", "prompt": "Value of the 3 in 346?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 300, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "1.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m3u01s1k03", "type": "num", "prompt": "Seven hundred and nine?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 709, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "1.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m3u01s1k04", "type": "num", "prompt": "Quick check: 10 more than 395?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 405, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m3u01s1r01", "type": "num", "prompt": "Value of the 5 in 512?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 500, "unit": "×", "units": ["