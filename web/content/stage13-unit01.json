swer": 9, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u01s1p03", "type": "num", "prompt": "10 less than 503?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 493, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u01s1p04", "type": "explain", "prompt": "Explain what the 0 in 405 means.", "diff": "H", "obj": "O1", "skill": "Reasoning", "rubric": [{"pt": "no tens", "kw": ["no tens|zero tens|0 tens|empty|ten"]}], "need": 1, "model": "There are no tens – the 0 holds the tens place.", "hint": "", "reason": "There are no tens – the 0 holds the tens place."}, {"id": "m3u01s1p05", "type": "num", "prompt": "5 hundreds, 12 tens, 3 ones?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 623, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "12 tens = 120.", "reason": ""}, {"id": "m3u01s1p06", "type": "mcq", "prompt": "Which has 6 tens?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "462", "ok": true, "fb": ""}, {"t": "642", "ok": false, "fb": ""}]}, {"id": "m3u01s1p07", "type": "num", "prompt": "100 less than 105?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 5, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u01s1p08", "type": "num", "prompt": "Nine hundred and ninety?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 990, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "adv": [{"id": "m3u01s1a01", "type": "num", "prompt": "* Advanced. Largest number with digits 2, 7, 5?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 752, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m3u01s1a02", "type": "num", "prompt": "* Advanced. Smallest 3-digit number with digits 0, 4, 9?", "diff": "H", "obj"