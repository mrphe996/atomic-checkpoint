{"course": {"id": "s16", "title": "Camday – Cambridge Primary Mathematics — Stage 6", "units": [{"n": 1, "t": "The Number System"}, {"n": 2, "t": "Numbers and Sequences"}, {"n": 3, "t": "Averages"}, {"n": 4, "t": "Addition and Subtraction (1)"}, {"n": 5, "t": "2D Shapes"}, {"n": 6, "t": "Fractions and Percentages"}, {"n": 7, "t": "Exploring Measures"}, {"n": 8, "t": "Addition and Subtraction (2)"}, {"n": 9, "t": "Probability"}, {"n": 10, "t": "Multiplication and Division (1)"}, {"n": 11, "t": "3D Shapes"}, {"n": 12, "t": "Ratio and Proportion"}, {"n": 13, "t": "Angles"}, {"n": 14, "t": "Multiplication and Division (2)"}, {"n": 15, "t": "Data"}, {"n": 16, "t": "The Laws of Arithmetic"}, {"n": 17, "t": "Transformations"}]}, "unit": {"n": 16, "stage": 16, "title": "The Laws of Arithmetic", "strandShort": "Number", "blurb": "The order of operations with brackets, and using the commutative, associative and distributive laws to calculate efficiently.", "strand": "Number", "framework": "Cambridge Primary Mathematics (0096), Stage 6", "lesson": true, "subject": "maths", "read": "media/read/m6u16.pdf"}, "objectives": {"O1": {"code": "6Ni.04", "sec": "16.1", "codeNote": "", "t": "Use the order of operations, including brackets, to work out calculations."}, "O2": {"code": "6Ni.05", "sec": "16.1", "codeNote": "", "t": "Use the commutative, associative and distributive laws to simplify calculations."}}, "sections": [{"id": "16.1", "title": "The laws of arithmetic", "objs": ["O1", "O2"], "lesson": [{"k": "hook", "t": "Quick calculator", "p": ["Two friends work out **25 × 17 × 4**. One multiplies left to right with big numbers; the other finishes in two seconds.", "What clever trick could make this easy? And what does 3 + 4 × 5 equal – 35 or 23? Think about it before you read on."]}, {"k": "recall", "t": "Order of operations", "p": ["Brackets first, then × and ÷, then + and −."], "qq": {"id": "m6u16s1t01", "type": "num", "prompt": "Work out 3 + 4 × 5.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 23, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "× before +.", "reason": "23."}}, {"k": "idea", "t": "Commutative and associative laws", "p": ["**Commutative**: you can swap the order when you **add** or **multiply**: 25 × 17 × 4 = 25 × 4 × 17.", "**Associative**: you can group in any order: (25 × 4) × 17 = 100 × 17 = **1700**.", "These laws do **not** work for − and ÷: 10 − 3 ≠ 3 − 10."]}, {"k": "idea", "t": "Distributive law", "p": ["**Distributive**: multiply a sum by multiplying each part: 6 × 23 = 6 × 20 + 6 × 3 = 120 + 18 = **138**.", "It works backwards too: 7 × 38 + 7 × 62 = 7 × (38 + 62) = 7 × 100 = **700**."], "table": {"head": ["Law", "Example"], "rows": [["commutative", "8 + 15 = 15 + 8; 4 × 9 = 9 × 4"], ["associative", "(6 + 7) + 3 = 6 + (7 + 3)"], ["distributive", "5 × 46 = 5 × 40 + 5 × 6"], ["order of operations", "(3 + 4) × 5 = 35; 3 + 4 × 5 = 23"]]}}, {"k": "try", "t": "Regroup", "p": [], "qq": {"id": "m6u16s1t02", "type": "num", "prompt": "Work out 5 × 39 × 2 the easy way.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 390, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "5 × 2 = 10.", "reason": "390."}}, {"k": "method", "t": "How do I use the laws to calculate easily?", "p": ["Step 1: Look for pairs that make 10, 100 or 1000.", "Step 2: Reorder and regroup (+ and × only).", "Step 3: Split numbers with the distributive law.", "Step 4: Use brackets and the order of operations correctly."]}, {"k": "example", "t": "Adding", "p": [], "q": "Work out 37 + 48 + 63.", "steps": [["37 + 63 = 100", ""], ["100 + 48 = 148", ""]], "a": "148"}, {"k": "example", "t": "Distributive", "p": [], "q": "Work out 8 × 57.", "steps": [["8 × 50 = 400", ""], ["8 × 7 = 56", ""], ["456", ""]], "a": "456"}, {"k": "example", "t": "Factorise", "p": [], "q": "Work out 13 × 6 + 13 × 4.", "steps": [["13 × (6 + 4) = 13 × 10", ""]], "a": "130"}, {"k": "example", "t": "Brackets", "p": [], "q": "Work out 36 ÷ (9 − 3) + 2.", "steps": [["brackets: 6", ""], ["36 ÷ 6 = 6", ""], ["+ 2 = 8", ""]], "a": "8"}, {"k": "try", "t": "Order", "p": [], "qq": {"id": "m6u16s1t03", "type": "num", "prompt": "Work out (2 + 6) × 5 − 4.", "diff": "M", "obj": "O1", "skill": "Application", "answer": 36, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": "36."}}, {"k": "error", "t": "Changed the order of a subtraction", "p": ["Find the first wrong line."], "q": "Work out 20 − 7 − 3 by regrouping.", "lines": ["20 − (7 − 3) = 20 − 4 = 16"], "bad": 0, "why": "Subtraction isn't associative: 20 − 7 − 3 = 13 − 3 = 10 (or 20 − (7 + 3) = 10).", "fix": [["20 − 10 = 10", ""]], "id": "m6u16s1t04"}, {"k": "mistake", "t": "Using the laws with − or ÷", "p": ["Commutative and associative laws work for + and × only."]}, {"k": "tip", "t": "Real life", "p": ["Shop assistants and mental-maths champions use these laws to calculate quickly."]}, {"k": "summary", "t": "What to remember", "p": ["Commutative: a + b = b + a, a × b = b × a.", "Associative: regroup + or ×.", "Distributive: a × (b + c) = a × b + a × c.", "Brackets, then × ÷, then + −."]}], "video": {"src": null, "offset": 0, "dur": 780, "range": ""}, "stops": [{"id": "16.1-k1", "t": 1, "after": 0, "review": [0, 0], "note": "", "q": {"id": "m6u16s1k01", "type": "num", "prompt": "Before you read on: 25 × 17 × 4?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1700, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "16.1-k2", "t": 2, "after": 4, "review": [0, 0], "note": "", "q": {"id": "m6u16s1k02", "type": "num", "prompt": "6 × 23 using the distributive law?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 138, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "16.1-k3", "t": 3, "after": 9, "review": [0, 0], "note": "", "q": {"id": "m6u16s1k03", "type": "num", "prompt": "7 × 38 + 7 × 62?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 700, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}, {"id": "16.1-k4", "t": 4, "after": 14, "review": [0, 0], "note": "", "q": {"id": "m6u16s1k04", "type": "num", "prompt": "Quick check: (3 + 4) × 5?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 35, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}}], "captions": [], "chapters": [[0, 300]], "req": [{"id": "m6u16s1r01", "type": "num", "prompt": "4 × 19 × 25?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 1900, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1r02", "type": "num", "prompt": "45 + 27 + 55?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 127, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1r03", "type": "num", "prompt": "6 × 34?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 204, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1r04", "type": "num", "prompt": "9 × 12 + 9 × 8?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 180, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1r05", "type": "num", "prompt": "10 − 2 × 3?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 4, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1r06", "type": "num", "prompt": "(10 − 2) × 3?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 24, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1r07", "type": "mcq", "prompt": "Which is true?", "diff": "M", "obj": "O1", "skill": "Reasoning", "hint": "", "reason": "", "options": [{"t": "7 ×