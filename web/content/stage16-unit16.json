": "(2 + 3) × 2?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 10, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1m05", "type": "num", "prompt": "4 × 21?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 84, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}, {"id": "m6u16s1m06", "type": "num", "prompt": "20 ÷ 4 + 1?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 6, "unit": "×", "units": ["×"], "tol": 0, "errs": [], "bare": true, "hint": "", "reason": ""}], "notes": "v4", "pdf": [{"book": "c6u16", "p0": 2, "p1": 5, "label": "pages 2–5", "title": "Lesson 16.1 notes · The laws of arithmetic", "note": "The whole lesson as a document you can print, then Practice on paper with answers at the back.", "look": []}]}], "segments": {"O1": ["16.1", 0, 300, "The laws of arithmetic"], "O2": ["16.1", 0, 300, "The laws of arithmetic"]}, "sources": [], "tests": {"A": [{"id": "m6u16v3Aq01", "type": "mcq", "prompt": "Which law says that a + b = b + a?", "diff": "M", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "associative"}, {"t": "inverse"}, {"t": "distributive"}, {"t": "commutative"}]}, {"id": "m6u16v3Aq02", "type": "num", "prompt": "Tickets cost $23. A family buys 4 adult and 4 child tickets at the same price. How much do they pay?", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "$", "units": ["$", "dollars"]}, {"id": "m6u16v3Aq03", "type": "num", "prompt": "Work out 47 − (5 + 3).", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq04", "type": "num", "prompt": "A pen costs $1 and a pencil costs $2. Kai buys 4 pens and 4 pencils. How much does he spend? (Hint: 4 × (1 + 2).)", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "$", "units": ["$", "dollars"]}, {"id": "m6u16v3Aq05", "type": "num", "prompt": "Use the distributive law to work out 86 × 6.", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq06", "type": "num", "prompt": "Lena works out 27 × 5 as 27 × 10 ÷ 2. What is the answer?", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq07", "type": "num", "prompt": "Use the distributive law to work out 102 × 8.", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "A · Fluency", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq08", "type": "mcq", "prompt": "Which is the same as 4 × (10 + 4)?", "diff": "M", "obj": "O2", "skill": "Reasoning", "pts": 1, "sec": "A · Fluency", "options": [{"t": "4 × 10 + 4"}, {"t": "4 × 10 + 4 × 4"}, {"t": "4 × 14 × 4"}, {"t": "4 + 10 × 4"}]}, {"id": "m6u16v3Aq09", "type": "num", "prompt": "Work out 4 × 12 × 25 in your head.", "diff": "M", "obj": "O2", "skill": "Application", "pts": 1, "sec": "B · Methods", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq10", "type": "num", "prompt": "Work out (9 + 6) × 7.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "B · Methods", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq11", "type": "table", "prompt": "Complete the table.", "diff": "M", "obj": "O1", "skill": "Data", "pts": 2, "sec": "B · Methods", "head": ["Calculation", "Answer"], "rows": [["8 + 4 × 8", {"blank": true}], ["(8 + 4) × 8", {"blank": true}]]}, {"id": "m6u16v3Aq12", "type": "num", "prompt": "Work out 10 + 7 × 9.", "diff": "M", "obj": "O1", "skill": "Application", "pts": 1, "sec": "B · Methods", "unit": "×", "units": ["×"], "bare": true}, {"id": "m6u16v3Aq13", "type": "table", "prompt": "Use the distributive law to work out 26 × 5.", "diff": "M", "obj": "O2", "skill": "Data", "pts": 1, "sec": "B