{"sections": [{"id": "2.1", "prac": [{"id": "u2s1p01", "type": "mcq", "prompt": "A qualitative observation is described…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "in words", "ok": true, "fb": "Correct."}, {"t": "with numbers", "ok": false, "fb": "Quantitative."}, {"t": "with a graph only", "ok": false, "fb": "No."}, {"t": "in SI units", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s1p02", "type": "mcq", "prompt": "A quantitative observation uses…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "only words", "ok": false, "fb": "Qualitative."}, {"t": "colours", "ok": false, "fb": "No."}, {"t": "opinions", "ok": false, "fb": "No."}, {"t": "numbers", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s1p03", "type": "mcq", "prompt": "The SI unit of mass is the…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "gram", "ok": false, "fb": "Common, but not the SI base unit."}, {"t": "kilogram", "ok": true, "fb": "Correct."}, {"t": "newton", "ok": false, "fb": "Force."}, {"t": "litre", "ok": false, "fb": "Volume."}], "hint": "", "reason": ""}, {"id": "u2s1p04", "type": "mcq", "prompt": "The SI unit of temperature is the…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "degree Celsius", "ok": false, "fb": "Common, but SI is kelvin."}, {"t": "metre", "ok": false, "fb": "Length."}, {"t": "kelvin", "ok": true, "fb": "Correct."}, {"t": "second", "ok": false, "fb": "Time."}], "hint": "", "reason": ""}, {"id": "u2s1p05", "type": "mcq", "prompt": "The SI unit of electric current is the…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "volt", "ok": false, "fb": "Voltage."}, {"t": "ampere", "ok": true, "fb": "Correct."}, {"t": "watt", "ok": false, "fb": "Power."}, {"t": "kelvin", "ok": false, "fb": "Temperature."}], "hint": "", "reason": ""}, {"id": "u2s1p06", "type": "mcq", "prompt": "A physical quantity is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "a feeling", "ok": false, "fb": "No."}, {"t": "a colour you like", "ok": false, "fb": "No."}, {"t": "something in the physical world that can be measured", "ok": true, "fb": "Correct."}, {"t": "a type of instrument", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s1p07", "type": "mcq", "prompt": "Why are world records only possible with standard units?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Times and distances from different countries can be compared fairly.", "ok": true, "fb": "Correct."}, {"t": "Athletes like units.", "ok": false, "fb": "No."}, {"t": "Units make people run faster.", "ok": false, "fb": "No."}, {"t": "Records are not measured.", "ok": false, "fb": "They are."}], "hint": "", "reason": ""}, {"id": "u2s1p08", "type": "mcq", "prompt": "Which instrument measures temperature?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Stopwatch", "ok": false, "fb": "Time."}, {"t": "Thermometer", "ok": true, "fb": "Correct."}, {"t": "Balance", "ok": false, "fb": "Mass."}, {"t": "Tape measure", "ok": false, "fb": "Length."}], "hint": "", "reason": ""}, {"id": "u2s1p09", "type": "mcq", "prompt": "Which instrument measures mass?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Thermometer", "ok": false, "fb": "Temperature."}, {"t": "Ruler", "ok": false, "fb": "Length."}, {"t": "Electronic balance", "ok": true, "fb": "Correct."}, {"t": "Stopwatch", "ok": false, "fb": "Time."}], "hint": "", "reason": ""}, {"id": "u2s1p10", "type": "mcq", "prompt": "Observations made with instruments are…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "subjective – based on opinion", "ok": false, "fb": "No."}, {"t": "objective – based on facts", "ok": true, "fb": "Correct."}, {"t": "always wrong", "ok": false, "fb": "No."}, {"t": "qualitative", "ok": false, "fb": "Usually quantitative."}], "hint": "", "reason": ""}, {"id": "u2s1p11", "type": "mcq", "prompt": "Which is quantitative?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "The plant grew a lot", "ok": false, "fb": "Words only."}, {"t": "The plant looks healthy", "ok": false, "fb": "Words only."}, {"t": "The plant smells nice", "ok": false, "fb": "Words only."}, {"t": "The plant grew 4.5 cm in a week", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s1p12", "type": "mcq", "prompt": "Where was the 1875 metre bar kept?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "In London", "ok": false, "fb": "No."}, {"t": "Locked away in Paris", "ok": true, "fb": "Correct."}, {"t": "On the Moon", "ok": false, "fb": "No."}, {"t": "In every school", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s1p13", "type": "mcq", "prompt": "How does measuring help protect the environment?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "It stops all pollution.", "ok": false, "fb": "It helps us see it."}, {"t": "Scientists measure air quality, pollution and populations to see changes.", "ok": true, "fb": "Correct."}, {"t": "It makes animals grow.", "ok": false, "fb": "No."}, {"t": "It does not help.", "ok": false, "fb": "It does."}], "hint": "", "reason": ""}, {"id": "u2s1p14", "type": "grid", "prompt": "Which instrument would you use?", "diff": "M", "obj": "O1", "skill": "Data", "cols": ["Thermometer", "Stopwatch", "Balance", "Tape measure"], "rows": [{"l": "Temperature of soup", "a": ["Thermometer"]}, {"l": "Time for a race", "a": ["Stopwatch"]}, {"l": "Mass of an apple", "a": ["Balance"]}, {"l": "Length of a desk", "a": ["Tape measure"]}], "hint": "", "reason": ""}, {"id": "u2s1p15", "type": "mcq", "prompt": "Which unit symbol is written correctly?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "kg", "ok": true, "fb": "Correct."}, {"t": "KG", "ok": false, "fb": "Lower case k and g."}, {"t": "Kg", "ok": false, "fb": "Lower case k."}, {"t": "kG", "ok": false, "fb": "Lower case g."}], "hint": "", "reason": ""}, {"id": "u2s1p16", "type": "mcq", "prompt": "Before standard units, people measured with…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "parts of their bodies", "ok": true, "fb": "Correct."}, {"t": "lasers", "ok": false, "fb": "Much later."}, {"t": "computers", "ok": false, "fb": "Much later."}, {"t": "satellites", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s1p17", "type": "mcq", "prompt": "A pupil writes 'the pencil is long'. How could she make this quantitative?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Say it is very long", "ok": false, "fb": "Still words."}, {"t": "Measure it with a ruler and give the length in cm", "ok": true, "fb": "Correct."}, {"t": "Draw it", "ok": false, "fb": "Not a measurement."}, {"t": "Ask a friend", "ok": false, "fb": "Still opinion."}], "hint": "", "reason": ""}, {"id": "u2s1p18", "type": "order", "prompt": "Order how length measurement developed.", "diff": "M", "obj": "O1", "skill": "Knowledge", "items": ["Body parts such as the cubit", "Sticks and string with standard lengths", "Platinum–iridium metre bar (1875)", "Modern instruments such as tape measures"], "hint": "", "reason": ""}], "stops": [{"id": "u2v1a", "note": "Paused after: “If we measure that she runs 100 metres in 14.2 seconds, we are making a quantitative obser”", "q": {"id": "u2v1a_q", "type": "mcq", "prompt": "'She runs 100 m in 14.2 s' is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "qualitative", "ok": false, "fb": "It uses numbers."}, {"t": "quantitative", "ok": true, "fb": "Correct."}, {"t": "an opinion", "ok": false, "fb": "No."}, {"t": "a hypothesis", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u2v1b", "note": "Paused after: “Long ago, people measured with parts of their bodies. A cubit was the length from the elbo”", "q": {"id": "u2v1b_q", "type": "mcq", "prompt": "Why was the cubit a problem?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "It was too long", "ok": false, "fb": "No."}, {"t": "Nobody had elbows", "ok": false, "fb": "No."}, {"t": "It varied from person to person", "ok": true, "fb": "Correct."}, {"t": "It was in kg", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u2v1c", "note": "Paused after: “Time is measured in seconds, temperature in kelvin, and electric current in amperes.”", "q": {"id": "u2v1c_q", "type": "mcq", "prompt": "SI unit of length?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "kilogram", "ok": false, "fb": "Mass."}, {"t": "metre", "ok": true, "fb": "Correct."}, {"t": "second", "ok": false, "fb": "Time."}, {"t": "kelvin", "ok": false, "fb": "Temperature."}], "hint": "", "reason": ""}}]}, {"id": "2.2", "prac": [{"id": "u2s2p01", "type": "mcq", "prompt": "'Kilo' means…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a hundred", "ok": false, "fb": "Centi is a hundredth."}, {"t": "a thousandth", "ok": false, "fb": "Milli."}, {"t": "a million", "ok": false, "fb": "Mega."}, {"t": "a thousand", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s2p02", "type": "mcq", "prompt": "'Milli' means…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "one thousandth", "ok": true, "fb": "Correct."}, {"t": "one hundredth", "ok": false, "fb": "Centi."}, {"t": "a thousand", "ok": false, "fb": "Kilo."}, {"t": "ten", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s2p03", "type": "num", "prompt": "How many centimetres are in 3 m?", "diff": "M", "obj": "O2", "skill": "Application", "answer": 300, "unit": "cm", "tol": 0.0, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s2p04", "type": "num", "prompt": "Convert 1200 m to km.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 1.2, "unit": "km", "tol": 0.0, "units": ["km"], "errs": [{"v": 1200000, "fb": "Small → big: divide by 1000."}], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s2p05", "type": "num", "prompt": "Convert 7 cm to mm.", "diff": "M", "obj": "O2", "skill": "Application", "answer": 70, "unit": "mm", "tol": 0.0, "units": ["mm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s2p06", "type": "num", "prompt": "Convert 0.35 m to cm.", "diff": "H", "obj": "O2", "skill": "Application", "answer": 35, "unit": "cm", "tol": 0.0, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s2p07", "type": "num", "prompt": "Convert 2 km to cm.", "diff": "H", "obj": "O2", "skill": "Application", "answer": 200000, "unit": "cm", "tol": 0.0, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": "2 km = 2000 m = 200 000 cm."}, {"id": "u2s2p08", "type": "mcq", "prompt": "To avoid parallax error, put your eye…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "directly above the mark", "ok": true, "fb": "Correct."}, {"t": "to the left", "ok": false, "fb": "Error."}, {"t": "to the right", "ok": false, "fb": "Error."}, {"t": "far away", "ok": false, "fb": "Not the point."}], "hint": "", "reason": ""}, {"id": "u2s2p09", "type": "mcq", "prompt": "A theodolite is used by surveyors to measure…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "mass", "ok": false, "fb": "No."}, {"t": "temperature", "ok": false, "fb": "No."}, {"t": "time", "ok": false, "fb": "No."}, {"t": "distances and angles", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s2p10", "type": "mcq", "prompt": "A hard tape measure is best for…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "rooms and furniture", "ok": true, "fb": "Correct."}, {"t": "your waist", "ok": false, "fb": "Soft tape."}, {"t": "a pin", "ok": false, "fb": "Vernier calipers."}, {"t": "a car journey", "ok": false, "fb": "Odometer."}], "hint": "", "reason": ""}, {"id": "u2s2p11", "type": "mcq", "prompt": "A result that does not fit the pattern is an…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "average", "ok": false, "fb": "No."}, {"t": "outlier", "ok": true, "fb": "Correct."}, {"t": "accurate result", "ok": false, "fb": "No."}, {"t": "instrument", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s2p12", "type": "mcq", "prompt": "Three measurements are enough if…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "at least two of them are close together", "ok": true, "fb": "Correct."}, {"t": "they are all different", "ok": false, "fb": "Then repeat more."}, {"t": "one is very big", "ok": false, "fb": "Check it."}, {"t": "you are tired", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s2p13", "type": "num", "prompt": "Find the average of 12.4, 12.6 and 12.5 cm.", "diff": "H", "obj": "O3", "skill": "Application", "answer": 12.5, "unit": "cm", "tol": 0.01, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s2p14", "type": "mcq", "prompt": "Precise means…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "close to the true value", "ok": false, "fb": "Accurate."}, {"t": "very big", "ok": false, "fb": "No."}, {"t": "written in words", "ok": false, "fb": "No."}, {"t": "close to one another", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s2p15", "type": "mcq", "prompt": "Accurate means…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "close to one another", "ok": false, "fb": "Precise."}, {"t": "close to the true value", "ok": true, "fb": "Correct."}, {"t": "measured once", "ok": false, "fb": "No."}, {"t": "in kilometres", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s2p16", "type": "mcq", "prompt": "If other people repeat your measurement and get the same results, your results are…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "biased", "ok": false, "fb": "No."}, {"t": "qualitative", "ok": false, "fb": "No."}, {"t": "outliers", "ok": false, "fb": "No."}, {"t": "reliable", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s2p17", "type": "mcq", "prompt": "A paper clip measured as 26.8 cm is probably…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "correct", "ok": false, "fb": "Not reasonable."}, {"t": "a mistake – measure again", "ok": true, "fb": "Correct."}, {"t": "the average", "ok": false, "fb": "No."}, {"t": "very precise", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u2s2p18", "type": "order", "prompt": "Order from smallest to largest.", "diff": "M", "obj": "O2", "skill": "Knowledge", "items": ["1 mm", "1 cm", "1 m", "1 km"], "hint": "", "reason": ""}], "stops": [{"id": "u2v2a", "note": "Paused after: “So: one kilometre is 1000 metres, one metre is 100 centimetres, and one centimetre is 10 m”", "q": {"id": "u2v2a_q", "type": "num", "prompt": "1 m = ? cm", "diff": "M", "obj": "O2", "skill": "Application", "answer": 100, "unit": "cm", "tol": 0.0, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}}, {"id": "u2v2b", "note": "Paused after: “Reading from the wrong angle is called a parallax error. Always look vertically down at th”", "q": {"id": "u2v2b_q", "type": "mcq", "prompt": "Reading from an angle causes…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "an outlier", "ok": false, "fb": "No."}, {"t": "parallax error", "ok": true, "fb": "Correct."}, {"t": "zero error", "ok": false, "fb": "No."}, {"t": "precision", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u2v2c", "note": "Paused after: “If other people repeat the measurement and get the same results, our results are reliable.”", "q": {"id": "u2v2c_q", "type": "num", "prompt": "Clip readings 3.2, 3.0 and 26.8 cm. Average without the outlier?", "diff": "H", "obj": "O3", "skill": "Application", "answer": 3.1, "unit": "cm", "tol": 0.01, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}}, {"id": "u2v2d", "note": "Paused after: “Here, the darts are close together but far from the centre: precise but not accurate.”", "q": {"id": "u2v2d_q", "type": "mcq", "prompt": "Close together but away from the target is…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "precise but not accurate", "ok": true, "fb": "Correct."}, {"t": "accurate but not precise", "ok": false, "fb": "No."}, {"t": "both", "ok": false, "fb": "No."}, {"t": "neither", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}]}, {"id": "2.3", "prac": [{"id": "u2s3p01", "type": "num", "prompt": "Area of a 3 cm × 3 cm square?", "diff": "M", "obj": "O4", "skill": "Application", "answer": 9, "unit": "cm²", "tol": 0.0, "units": ["cm²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p02", "type": "num", "prompt": "Area of a 6 m × 2 m rectangle?", "diff": "M", "obj": "O4", "skill": "Application", "answer": 12, "unit": "m²", "tol": 0.0, "units": ["m²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p03", "type": "num", "prompt": "A rectangle has area 24 cm² and base 6 cm. Height?", "diff": "M", "obj": "O4", "skill": "Application", "answer": 4, "unit": "cm", "tol": 0.0, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p04", "type": "num", "prompt": "Convert 3 m² to cm².", "diff": "H", "obj": "O4", "skill": "Application", "answer": 30000, "unit": "cm²", "tol": 0.0, "units": ["cm²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p05", "type": "num", "prompt": "Convert 50 000 cm² to m².", "diff": "H", "obj": "O4", "skill": "Application", "answer": 5, "unit": "m²", "tol": 0.0, "units": ["m²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p06", "type": "num", "prompt": "Area of a 15 cm × 10 cm book cover?", "diff": "M", "obj": "O4", "skill": "Application", "answer": 150, "unit": "cm²", "tol": 0.0, "units": ["cm²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p07", "type": "mcq", "prompt": "Which unit is an area unit?", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "cm", "ok": false, "fb": "Length."}, {"t": "cm³", "ok": false, "fb": "Volume."}, {"t": "kg", "ok": false, "fb": "Mass."}, {"t": "cm²", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u2s3p08", "type": "num", "prompt": "How many 1 cm² tiles cover a 20 cm × 5 cm strip?", "diff": "H", "obj": "O4", "skill": "Application", "answer": 100, "unit": "tiles", "tol": 0.0, "units": ["tiles"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p09", "type": "num", "prompt": "A garden is 12 m × 4 m. What is its area?", "diff": "H", "obj": "O4", "skill": "Application", "answer": 48, "unit": "m²", "tol": 0.0, "units": ["m²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p10", "type": "mcq", "prompt": "Two shapes: A is 4 cm × 9 cm, B is 6 cm × 6 cm. Which has the bigger area?", "diff": "H", "obj": "O4", "skill": "Knowledge", "options": [{"t": "A", "ok": false, "fb": "Both 36 cm²."}, {"t": "B", "ok": false, "fb": "Both 36 cm²."}, {"t": "They are equal (36 cm²)", "ok": true, "fb": "Correct."}, {"t": "Cannot tell", "ok": false, "fb": "Calculate."}], "hint": "", "reason": ""}, {"id": "u2s3p11", "type": "num", "prompt": "A square has area 49 cm². How long is each side?", "diff": "H", "obj": "O4", "skill": "Application", "answer": 7, "unit": "cm", "tol": 0.0, "units": ["cm"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p12", "type": "num", "prompt": "Area of a 2 cm × 2 cm stamp?", "diff": "M", "obj": "O4", "skill": "Application", "answer": 4, "unit": "cm²", "tol": 0.0, "units": ["cm²"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u2s3p13", "type": "mcq", "prompt": "Doubling both the base and the height of a rectangle makes its area…", "diff": "H", "obj": "O4", "skill": "Reasoning", "options": [{"t": "twice as big", "ok": false, "fb": "2 × 2 = 4."}, {"t": "four times bigger", "o