{"sections": [{"id": "5.1", "prac": [{"id": "u5s1p01", "type": "mcq", "prompt": "What does 'micro' mean?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Living", "ok": false, "fb": "That is 'organism'."}, {"t": "Green", "ok": false, "fb": "No."}, {"t": "Old", "ok": false, "fb": "No."}, {"t": "Very small", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u5s1p02", "type": "mcq", "prompt": "A microorganism that causes disease is called a…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "producer", "ok": false, "fb": "Makes food."}, {"t": "pathogen", "ok": true, "fb": "Correct."}, {"t": "decomposer", "ok": false, "fb": "Breaks down dead matter."}, {"t": "colony", "ok": false, "fb": "A group growing together."}], "hint": "", "reason": ""}, {"id": "u5s1p03", "type": "mcq", "prompt": "Why can you see mould on old bread without a microscope?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Millions of cells grow together as a colony.", "ok": true, "fb": "Correct."}, {"t": "Each mould cell is huge.", "ok": false, "fb": "Each is tiny."}, {"t": "Bread is a magnifying glass.", "ok": false, "fb": "No."}, {"t": "Mould is not a microorganism.", "ok": false, "fb": "It is a fungus."}], "hint": "", "reason": ""}, {"id": "u5s1p04", "type": "multi", "prompt": "Select ALL the places microorganisms live.", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "In waste", "ok": true, "fb": ""}, {"t": "Nowhere – they are rare", "ok": false, "fb": "They live almost everywhere."}, {"t": "Soil", "ok": true, "fb": ""}, {"t": "Fresh, salty and brackish water", "ok": true, "fb": ""}, {"t": "On and inside animals' bodies", "ok": true, "fb": ""}], "hint": "4 statements are correct.", "reason": ""}, {"id": "u5s1p05", "type": "mcq", "prompt": "Which protist can photosynthesise?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Alga", "ok": true, "fb": "Correct."}, {"t": "Amoeba", "ok": false, "fb": "Cannot photosynthesise."}, {"t": "Mould", "ok": false, "fb": "A fungus."}, {"t": "Bacterium", "ok": false, "fb": "Not a protist."}], "hint": "", "reason": ""}, {"id": "u5s1p06", "type": "mcq", "prompt": "How do bacteria in your nose help you?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "They make you sneeze all day.", "ok": false, "fb": "No."}, {"t": "They digest food.", "ok": false, "fb": "That is gut bacteria."}, {"t": "They make your hair grow.", "ok": false, "fb": "No."}, {"t": "They help stop harmful microbes getting in.", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u5s1p07", "type": "mcq", "prompt": "Microorganisms that break down dead matter are called…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "producers", "ok": false, "fb": "Make food."}, {"t": "decomposers", "ok": true, "fb": "Correct."}, {"t": "predators", "ok": false, "fb": "Hunt prey."}, {"t": "herbivores", "ok": false, "fb": "Eat plants."}], "hint": "", "reason": ""}, {"id": "u5s1p08", "type": "mcq", "prompt": "Decomposition releases ___ into the soil.", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "sunlight", "ok": false, "fb": "No."}, {"t": "mineral salts", "ok": true, "fb": "Correct."}, {"t": "plastic", "ok": false, "fb": "No."}, {"t": "oxygen only", "ok": false, "fb": "Not the main point."}], "hint": "", "reason": ""}, {"id": "u5s1p09", "type": "mcq", "prompt": "What would happen to dead leaves in a forest with NO decomposers?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "They would disappear faster.", "ok": false, "fb": "Decomposers make them disappear."}, {"t": "They would pile up and nutrients would not be recycled.", "ok": true, "fb": "Correct."}, {"t": "Plants would grow better.", "ok": false, "fb": "Fewer nutrients for plants."}, {"t": "Nothing would change.", "ok": false, "fb": "Waste would build up."}], "hint": "", "reason": ""}, {"id": "u5s1p10", "type": "mcq", "prompt": "Earthworms break dead matter into smaller pieces. They are called…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "producers", "ok": false, "fb": "No."}, {"t": "detritivores", "ok": true, "fb": "Correct."}, {"t": "pathogens", "ok": false, "fb": "No."}, {"t": "carnivores", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s1p11", "type": "mcq", "prompt": "An ecosystem is…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "only the animals in an area", "ok": false, "fb": "Plants and non-living parts too."}, {"t": "a single food chain", "ok": false, "fb": "Much more."}, {"t": "a type of microorganism", "ok": false, "fb": "No."}, {"t": "all the living and non-living parts of an area", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u5s1p12", "type": "multi", "prompt": "Select ALL the non-living parts of an ecosystem.", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Sunlight", "ok": true, "fb": ""}, {"t": "Rain", "ok": true, "fb": ""}, {"t": "Temperature", "ok": true, "fb": ""}, {"t": "Soil", "ok": true, "fb": ""}, {"t": "Fungi", "ok": false, "fb": "Living."}, {"t": "Trees", "ok": false, "fb": "Living."}], "hint": "4 statements are correct.", "reason": ""}, {"id": "u5s1p13", "type": "mcq", "prompt": "In the leaf-bag investigation, which is a control variable?", "diff": "H", "obj": "O2", "skill": "Experiment", "options": [{"t": "The time", "ok": false, "fb": "Independent variable."}, {"t": "The type of leaves", "ok": true, "fb": "Correct."}, {"t": "The mass of leaves", "ok": false, "fb": "Dependent variable."}, {"t": "The result", "ok": false, "fb": "Not a variable to control."}], "hint": "", "reason": ""}, {"id": "u5s1p14", "type": "num", "prompt": "A 200 g pile of leaves loses 45% of its mass. How many grams are lost?", "diff": "H", "obj": "O2", "skill": "Application", "answer": 90, "unit": "g", "tol": 0.0, "units": ["g"], "errs": [{"v": 110, "fb": "That is the mass LEFT. Mass lost = 45% of 200 = 90 g."}], "unitFb": "", "hint": "", "reason": "45 ÷ 100 × 200 = 90 g."}, {"id": "u5s1p15", "type": "mcq", "prompt": "Which is the only thing that must come into an ecosystem from outside?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Water", "ok": false, "fb": "Water cycles round."}, {"t": "Mineral salts", "ok": false, "fb": "These are recycled."}, {"t": "Carbon dioxide", "ok": false, "fb": "Recycled by living things."}, {"t": "Energy, as light from the Sun", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u5s1p16", "type": "mcq", "prompt": "Mouth bacteria can cause…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "athlete's foot", "ok": false, "fb": "Fungus on feet."}, {"t": "dandruff", "ok": false, "fb": "Fungus on the scalp."}, {"t": "tooth decay and bad breath", "ok": true, "fb": "Correct."}, {"t": "photosynthesis", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s1p17", "type": "mcq", "prompt": "Why does food go mouldy faster when it is warm and moist?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "Warmth kills microorganisms.", "ok": false, "fb": "Usually warmth helps them grow."}, {"t": "Microorganisms grow and respire faster in warm, moist conditions.", "ok": true, "fb": "Correct."}, {"t": "Mould is made by the fridge.", "ok": false, "fb": "No."}, {"t": "Dry food rots fastest.", "ok": false, "fb": "Moisture helps decay."}], "hint": "", "reason": ""}, {"id": "u5s1p18", "type": "order", "prompt": "Order the nutrient cycle starting from a living plant.", "diff": "M", "obj": "O2", "skill": "Knowledge", "items": ["Living plant", "Dead leaves fall", "Decomposers break them down", "Mineral salts in soil", "New plant absorbs them"], "hint": "", "reason": ""}], "stops": [{"id": "u5v1a", "note": "Paused after: “When millions grow together they form a colony, like the mould on old bread. A colony is b”", "q": {"id": "u5v1a_q", "type": "mcq", "prompt": "Mould is a kind of…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "bacterium", "ok": false, "fb": "No."}, {"t": "plant", "ok": false, "fb": "No."}, {"t": "fungus", "ok": true, "fb": "Correct."}, {"t": "animal", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u5v1b", "note": "Paused after: “Others are unhelpful. Mouth bacteria cause tooth decay and bad breath, and fungi can cause”", "q": {"id": "u5v1b_q", "type": "mcq", "prompt": "A pathogen is a microorganism that…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "causes disease", "ok": true, "fb": "Correct."}, {"t": "makes food", "ok": false, "fb": "No."}, {"t": "lives in soil only", "ok": false, "fb": "No."}, {"t": "is always helpful", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u5v1c", "note": "Paused after: “The microorganisms that break down dead matter are called decomposers.”", "q": {"id": "u5v1c_q", "type": "mcq", "prompt": "What do decomposers release into the soil?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Sunlight", "ok": false, "fb": "No."}, {"t": "Mineral salts", "ok": true, "fb": "Correct."}, {"t": "Seeds", "ok": false, "fb": "No."}, {"t": "Plastic", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u5v1d", "note": "Paused after: “Here, the independent variable is time, and the dependent variable is the mass of the leav”", "q": {"id": "u5v1d_q", "type": "mcq", "prompt": "What is the independent variable in the leaf-bag investigation?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Mass of leaves", "ok": false, "fb": "Dependent."}, {"t": "Time", "ok": true, "fb": "Correct."}, {"t": "Type of bag", "ok": false, "fb": "Control."}, {"t": "Type of leaves", "ok": false, "fb": "Control."}], "hint": "", "reason": ""}}]}, {"id": "5.2", "prac": [{"id": "u5s2p01", "type": "mcq", "prompt": "An organism that makes its own food is a…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "consumer", "ok": false, "fb": "Eats others."}, {"t": "decomposer", "ok": false, "fb": "Breaks down dead matter."}, {"t": "producer", "ok": true, "fb": "Correct."}, {"t": "predator", "ok": false, "fb": "Hunts."}], "hint": "", "reason": ""}, {"id": "u5s2p02", "type": "mcq", "prompt": "Herbivores eat…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "plants", "ok": true, "fb": "Correct."}, {"t": "animals", "ok": false, "fb": "Carnivores."}, {"t": "both plants and animals", "ok": false, "fb": "Omnivores."}, {"t": "dead matter only", "ok": false, "fb": "Detritivores/decomposers."}], "hint": "", "reason": ""}, {"id": "u5s2p03", "type": "mcq", "prompt": "Humans eat plants and animals, so we are…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "herbivores", "ok": false, "fb": "Only plants."}, {"t": "carnivores", "ok": false, "fb": "Only animals."}, {"t": "producers", "ok": false, "fb": "We cannot photosynthesise."}, {"t": "omnivores", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u5s2p04", "type": "mcq", "prompt": "A lion hunts a zebra. The zebra is the…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "predator", "ok": false, "fb": "The lion."}, {"t": "producer", "ok": false, "fb": "No."}, {"t": "prey", "ok": true, "fb": "Correct."}, {"t": "decomposer", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s2p05", "type": "mcq", "prompt": "What does a plant need for photosynthesis?", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "Oxygen and sugar", "ok": false, "fb": "These are products."}, {"t": "Soil and darkness", "ok": false, "fb": "Light is needed."}, {"t": "Light, carbon dioxide and water", "ok": true, "fb": "Correct."}, {"t": "Meat and water", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s2p06", "type": "mcq", "prompt": "What does photosynthesis produce?", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "Glucose (food) and oxygen", "ok": true, "fb": "Correct."}, {"t": "Carbon dioxide and water", "ok": false, "fb": "These are used up."}, {"t": "Mineral salts", "ok": false, "fb": "No."}, {"t": "Light", "ok": false, "fb": "Light is used."}], "hint": "", "reason": ""}, {"id": "u5s2p07", "type": "mcq", "prompt": "The copper beech has red leaves. Is it a producer?", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "Yes – red pigments hide its chlorophyll but it still photosynthesises.", "ok": true, "fb": "Correct."}, {"t": "No – only green plants photosynthesise.", "ok": false, "fb": "It still has chlorophyll."}, {"t": "No – it is a consumer.", "ok": false, "fb": "No."}, {"t": "Only in winter.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s2p08", "type": "order", "prompt": "Order this mangrove food chain.", "diff": "M", "obj": "O3", "skill": "Knowledge", "items": ["Mangrove plants", "Crab", "Kingfisher", "Python"], "hint": "", "reason": ""}, {"id": "u5s2p09", "type": "mcq", "prompt": "In 'mangrove → crab → kingfisher → python', the kingfisher is the…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "primary consumer", "ok": false, "fb": "The crab."}, {"t": "producer", "ok": false, "fb": "Mangrove."}, {"t": "secondary consumer", "ok": true, "fb": "Correct."}, {"t": "tertiary consumer", "ok": false, "fb": "The python."}], "hint": "", "reason": ""}, {"id": "u5s2p10", "type": "mcq", "prompt": "An animal that eats a tertiary consumer is a…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "primary consumer", "ok": false, "fb": "No."}, {"t": "producer", "ok": false, "fb": "No."}, {"t": "secondary consumer", "ok": false, "fb": "No."}, {"t": "quaternary consumer", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u5s2p11", "type": "mcq", "prompt": "A food web is…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "one food chain", "ok": false, "fb": "A web has many."}, {"t": "a spider's web", "ok": false, "fb": "No."}, {"t": "many food chains joined together", "ok": true, "fb": "Correct."}, {"t": "a list of plants", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s2p12", "type": "mcq", "prompt": "Food web: grass → grasshopper; grass → rabbit; grasshopper → frog; grasshopper → spider; spider → frog; frog → snake; rabbit → snake; rabbit → hawk; snake → hawk. Which organisms are primary consumers?", "diff": "H", "obj": "O3", "skill": "Data", "options": [{"t": "Frog and spider", "ok": false, "fb": "They eat animals."}, {"t": "Snake and hawk", "ok": false, "fb": "They eat animals."}, {"t": "Grasshopper and rabbit", "ok": true, "fb": "Correct."}, {"t": "Grass", "ok": false, "fb": "Producer."}], "hint": "", "reason": ""}, {"id": "u5s2p13", "type": "mcq", "prompt": "Food web: grass → grasshopper; grass → rabbit; grasshopper → frog; grasshopper → spider; spider → frog; frog → snake; rabbit → snake; rabbit → hawk; snake → hawk. Grasshoppers die out. What happens to spiders?", "diff": "H", "obj": "O4", "skill": "Data", "options": [{"t": "They increase.", "ok": false, "fb": "Less food."}, {"t": "Nothing changes.", "ok": false, "fb": "Their food is gone."}, {"t": "They decrease – they lose their only food.", "ok": true, "fb": "Correct."}, {"t": "They start eating grass.", "ok": false, "fb": "Spiders are carnivores."}], "hint": "", "reason": ""}, {"id": "u5s2p14", "type": "mcq", "prompt": "Where do decomposers fit in a food web?", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "They break down dead organisms and wastes from every level.", "ok": true, "fb": "Correct."}, {"t": "Only at the top.", "ok": false, "fb": "Every level."}, {"t": "They are producers.", "ok": false, "fb": "No."}, {"t": "They are not part of webs.", "ok": false, "fb": "They are."}], "hint": "", "reason": ""}, {"id": "u5s2p15", "type": "mcq", "prompt": "Why did huge jellyfish swarms appear on Mediterranean coasts?", "diff": "H", "obj": "O4", "skill": "Knowledge", "options": [{"t": "The sea got colder.", "ok": false, "fb": "Warmer."}, {"t": "More sharks ate jellyfish.", "ok": false, "fb": "No."}, {"t": "A warmer sea from climate change lets jellyfish breed and grow faster.", "ok": true, "fb": "Correct."}, {"t": "Plastic turned into jellyfish.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s2p16", "type": "mcq", "prompt": "More jellyfish eat more phytoplankton. Which animals get LESS food?", "diff": "H", "obj": "O4", "skill": "Reasoning", "options": [{"t": "Turtles", "ok": false, "fb": "They eat jellyfish – more food."}, {"t": "Small fish (and then whales, seals and seabirds)", "ok": true, "fb": "Correct."}, {"t": "Sunfish", "ok": false, "fb": "More food."}, {"t": "Jellyfish", "ok": false, "fb": "More food."}], "hint": "", "reason": ""}, {"id": "u5s2p17", "type": "mcq", "prompt": "PLA is a plastic made from plants. Why is it useful?", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "It never breaks down.", "ok": false, "fb": "It is biodegradable."}, {"t": "Decomposers can break it down into water and carbon dioxide.", "ok": true, "fb": "Correct."}, {"t": "It is a food for sharks.", "ok": false, "fb": "No."}, {"t": "It makes the sea warmer.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u5s2p18", "type": "mcq", "prompt": "A pit viper eats a squirrel and is eaten by an eagle. The pit viper is…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "only a predator", "ok": false, "fb": "It is also eaten."}, {"t": "only prey", "ok": false, "fb": "It also hunts."}, {"t": "both predator and prey", "ok": true, "fb": "Correct."}, {"t": "a producer", "ok": false, "fb": "No."}], "hint": "", "reason": ""}], "stops": [{"id": "u5v2a", "note": "Paused after: “So the arrows point in the direction that energy flows through the ecosystem.”", "q": {"id": "u5v2a_q", "type": "mcq", "prompt": "An arrow in a food chain means…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "'eats'", "ok": false, "fb": "Arrow points to the eater."}, {"t": "'is bigger than'", "ok": false, "fb": "No."}, {"t": "'lives with'", "ok": false, "fb": "No."}, {"t": "'is eaten by'", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}, {"id": "u5v2b", "note": "Paused after: “Consumers can also be predators, which hunt, or prey, which are hunted. A lion is a predat”", "q": {"id": "u5v2b_q", "type": "mcq", "prompt": "A carnivore eats…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "plants", "ok": false, "fb": "Herbivore."}, {"t": "both", "ok": false, "fb": "Omnivore."}, {"t": "other animals", "ok": true, "fb": "Correct."}, {"t": "sunlight", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u5v2c", "note": "Paused after: “The shark eats the fish, so it is a tertiary consumer.”", "q": {"id": "u5v2c_q", "type": "mcq", "prompt": "Zooplankton eat phytoplankton. Zooplankton are…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "producers", "ok": false, "fb": "No."}, {"t": "primary consumers", "ok": true, "fb": "Correct."}, {"t": "secondary consumers", "ok": false, "fb": "No."}, {"t": "decomposers", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u5v2d", "note": "Paused after: “Think about what would happen if one species disappeared. Its predators would have less fo”", "q": {"id": "u5v2d_q", "type": "mcq", "prompt": "If one species disappears from a food web, its prey might…", "diff": "H", "obj": "O4", "skill": "Knowledge", "options": [{"t": "decrease", "ok": false, "fb": "Fewer are eaten."}, {"t": "become producers", "ok": false, "fb": "No."}, {"t": "always disappear too", "ok": false, "fb": "No."}, {"t": "increase", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}]}]}