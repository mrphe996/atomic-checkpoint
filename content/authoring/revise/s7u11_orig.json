{"sections": [{"id": "11.1", "prac": [{"id": "u11s1p01", "type": "mcq", "prompt": "Moving objects have…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "nuclear energy", "ok": false, "fb": "No."}, {"t": "kinetic energy", "ok": true, "fb": "Correct."}, {"t": "elastic energy", "ok": false, "fb": "No."}, {"t": "chemical energy", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p02", "type": "mcq", "prompt": "The faster an object moves, the…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "more kinetic energy it has", "ok": true, "fb": "Correct."}, {"t": "less kinetic energy", "ok": false, "fb": "No."}, {"t": "more mass it has", "ok": false, "fb": "No."}, {"t": "less it weighs", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p03", "type": "mcq", "prompt": "Fuels store…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "kinetic energy", "ok": false, "fb": "No."}, {"t": "chemical energy", "ok": true, "fb": "Correct."}, {"t": "sound energy", "ok": false, "fb": "No."}, {"t": "elastic energy", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p04", "type": "mcq", "prompt": "1 kilojoule =", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "100 joules", "ok": false, "fb": "No."}, {"t": "10 joules", "ok": false, "fb": "No."}, {"t": "1 000 000 joules", "ok": false, "fb": "No."}, {"t": "1000 joules", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u11s1p05", "type": "mcq", "prompt": "The joule is named after…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Isaac Newton", "ok": false, "fb": "Newton."}, {"t": "Galileo", "ok": false, "fb": "No."}, {"t": "Marie Curie", "ok": false, "fb": "No."}, {"t": "James Prescott Joule", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u11s1p06", "type": "mcq", "prompt": "Nuclear energy is stored in…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the electrons", "ok": false, "fb": "No."}, {"t": "the nucleus of an atom", "ok": true, "fb": "Correct."}, {"t": "springs", "ok": false, "fb": "No."}, {"t": "food", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p07", "type": "mcq", "prompt": "Thermal energy is mostly…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "light", "ok": false, "fb": "No."}, {"t": "sound", "ok": false, "fb": "No."}, {"t": "the vibration of particles in an object", "ok": true, "fb": "Correct."}, {"t": "the mass of the object", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p08", "type": "mcq", "prompt": "A stretched rubber band stores…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "elastic potential energy", "ok": true, "fb": "Correct."}, {"t": "nuclear energy", "ok": false, "fb": "No."}, {"t": "chemical energy", "ok": false, "fb": "No."}, {"t": "light energy", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p09", "type": "mcq", "prompt": "Water held behind a dam stores…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "gravitational potential energy", "ok": true, "fb": "Correct."}, {"t": "elastic energy", "ok": false, "fb": "No."}, {"t": "nuclear energy", "ok": false, "fb": "No."}, {"t": "sound energy", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p10", "type": "mcq", "prompt": "A speeding truck vs a slow bicycle: which has more kinetic energy?", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "The bicycle", "ok": false, "fb": "No."}, {"t": "Same", "ok": false, "fb": "No."}, {"t": "Neither", "ok": false, "fb": "No."}, {"t": "The speeding truck", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u11s1p11", "type": "num", "prompt": "Convert 2.5 kJ to joules.", "diff": "H", "obj": "O1", "skill": "Application", "answer": 2500, "unit": "J", "tol": 0.0, "units": ["J"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u11s1p12", "type": "num", "prompt": "Convert 4500 J to kilojoules.", "diff": "H", "obj": "O1", "skill": "Application", "answer": 4.5, "unit": "kJ", "tol": 0.0, "units": ["kJ"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u11s1p13", "type": "mcq", "prompt": "Why do people disagree about nuclear power?", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "It never works", "ok": false, "fb": "No."}, {"t": "It uses food", "ok": false, "fb": "No."}, {"t": "It produces lots of electricity but has risks such as radioactive waste", "ok": true, "fb": "Correct."}, {"t": "It is a type of wind power", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p14", "type": "grid", "prompt": "Which energy store?", "diff": "M", "obj": "O1", "skill": "Data", "cols": ["Chemical", "Kinetic", "Thermal"], "rows": [{"l": "Battery", "a": ["Chemical"]}, {"l": "Ball rolling", "a": ["Kinetic"]}, {"l": "Hot drink", "a": ["Thermal"]}], "hint": "", "reason": ""}, {"id": "u11s1p15", "type": "mcq", "prompt": "Your body gets energy from…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "sound", "ok": false, "fb": "No."}, {"t": "the nucleus of the Sun directly", "ok": false, "fb": "No."}, {"t": "the chemical store in food", "ok": true, "fb": "Correct."}, {"t": "gravity", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p16", "type": "order", "prompt": "Order the foods from least to most energy.", "diff": "M", "obj": "O1", "skill": "Data", "items": ["Large apple (327 kJ)", "Bowl of rice (536 kJ)", "Small chocolate bar (1000 kJ)"], "hint": "", "reason": ""}, {"id": "u11s1p17", "type": "mcq", "prompt": "A book is lifted from the floor to a high shelf. Its gravitational potential energy…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "increases", "ok": true, "fb": "Correct."}, {"t": "decreases", "ok": false, "fb": "No."}, {"t": "stays the same", "ok": false, "fb": "No."}, {"t": "disappears", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s1p18", "type": "mcq", "prompt": "At a hydroelectric dam, rushing water spins…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "magnets only", "ok": false, "fb": "No."}, {"t": "turbines", "ok": true, "fb": "Correct."}, {"t": "solar panels", "ok": false, "fb": "No."}, {"t": "batteries", "ok": false, "fb": "No."}], "hint": "", "reason": ""}], "stops": [{"id": "u11v1a", "note": "Paused after: “Chemical energy is stored in the bonds that hold atoms together. Food, fuels and batteries”", "q": {"id": "u11v1a_q", "type": "mcq", "prompt": "A book on a high shelf stores…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "kinetic energy", "ok": false, "fb": "Not moving."}, {"t": "elastic energy", "ok": false, "fb": "No."}, {"t": "gravitational potential energy", "ok": true, "fb": "Correct."}, {"t": "sound energy", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u11v1b", "note": "Paused after: “Objects that are stretched or squashed store elastic potential energy. As you land on a tr”", "q": {"id": "u11v1b_q", "type": "mcq", "prompt": "How many joules are in 1 kilojoule?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "1000 J", "ok": true, "fb": "Correct."}, {"t": "100 J", "ok": false, "fb": "No."}, {"t": "10 J", "ok": false, "fb": "No."}, {"t": "1 J", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u11v1c", "note": "Paused after: “Thermal energy is the energy of the particles in an object, mostly their vibrations. Hot g”", "q": {"id": "u11v1c_q", "type": "mcq", "prompt": "Nuclear energy is stored in…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the nucleus of an atom", "ok": true, "fb": "Correct."}, {"t": "food", "ok": false, "fb": "Chemical."}, {"t": "springs", "ok": false, "fb": "Elastic."}, {"t": "moving cars", "ok": false, "fb": "Kinetic."}], "hint": "", "reason": ""}}]}, {"id": "11.2", "prac": [{"id": "u11s2p01", "type": "mcq", "prompt": "Energy can only be…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "created", "ok": false, "fb": "No."}, {"t": "transferred from one store to another", "ok": true, "fb": "Correct."}, {"t": "destroyed", "ok": false, "fb": "No."}, {"t": "used up forever", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p02", "type": "mcq", "prompt": "Thermal energy is transferred from…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "colder to hotter", "ok": false, "fb": "No."}, {"t": "only upwards", "ok": false, "fb": "No."}, {"t": "hotter to colder places", "ok": true, "fb": "Correct."}, {"t": "only in water", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p03", "type": "mcq", "prompt": "Sound and light transfer energy as…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a flow of charge", "ok": false, "fb": "Electrical."}, {"t": "a force", "ok": false, "fb": "Mechanical."}, {"t": "matter", "ok": false, "fb": "No."}, {"t": "waves", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u11s2p04", "type": "mcq", "prompt": "Electrical transfer happens by…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "heating", "ok": false, "fb": "No."}, {"t": "light", "ok": false, "fb": "No."}, {"t": "lifting", "ok": false, "fb": "No."}, {"t": "a flow of charge", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u11s2p05", "type": "mcq", "prompt": "A fan: energy ends up in the ___ store of the blades.", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "chemical", "ok": false, "fb": "No."}, {"t": "nuclear", "ok": false, "fb": "No."}, {"t": "kinetic", "ok": true, "fb": "Correct."}, {"t": "elastic", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p06", "type": "mcq", "prompt": "On a stove, energy goes flame → pot → …", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "air only", "ok": false, "fb": "No."}, {"t": "gas", "ok": false, "fb": "No."}, {"t": "water", "ok": true, "fb": "Correct."}, {"t": "cooker", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p07", "type": "mcq", "prompt": "A flow diagram shows…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "energy stores and transfers", "ok": true, "fb": "Correct."}, {"t": "forces only", "ok": false, "fb": "No."}, {"t": "mass", "ok": false, "fb": "No."}, {"t": "circuits only", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p08", "type": "num", "prompt": "A kettle gets 2000 J; 1800 J goes into the water. How much is wasted?", "diff": "H", "obj": "O2", "skill": "Application", "answer": 200, "unit": "J", "tol": 0.0, "units": ["J"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u11s2p09", "type": "mcq", "prompt": "Burning rocket fuel also releases energy to the surroundings as…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "only kinetic", "ok": false, "fb": "No."}, {"t": "mass", "ok": false, "fb": "No."}, {"t": "nuclear", "ok": false, "fb": "No."}, {"t": "heat, light and sound", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u11s2p10", "type": "grid", "prompt": "Starting store?", "diff": "M", "obj": "O2", "skill": "Data", "cols": ["Chemical", "Kinetic", "Gravitational potential"], "rows": [{"l": "Battery-powered torch", "a": ["Chemical"]}, {"l": "Wind turbine", "a": ["Kinetic"]}, {"l": "Hydroelectric dam", "a": ["Gravitational potential"]}], "hint": "", "reason": ""}, {"id": "u11s2p11", "type": "mcq", "prompt": "Power stations burn fuels to…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "generate electricity", "ok": true, "fb": "Correct."}, {"t": "make food", "ok": false, "fb": "No."}, {"t": "store sound", "ok": false, "fb": "No."}, {"t": "create energy", "ok": false, "fb": "Transfer, not create."}], "hint": "", "reason": ""}, {"id": "u11s2p12", "type": "mcq", "prompt": "A ball thrown upwards slows down because…", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "energy is destroyed", "ok": false, "fb": "No."}, {"t": "gravity vanishes", "ok": false, "fb": "No."}, {"t": "kinetic energy is transferred to gravitational potential energy", "ok": true, "fb": "Correct."}, {"t": "it gains mass", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p13", "type": "mcq", "prompt": "Energy from the Sun reaches Earth as…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "light", "ok": true, "fb": "Correct."}, {"t": "electricity", "ok": false, "fb": "No."}, {"t": "sound", "ok": false, "fb": "No."}, {"t": "wind only", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p14", "type": "mcq", "prompt": "Total energy in = 500 J. Useful out = 350 J. Wasted =", "diff": "H", "obj": "O2", "skill": "Data", "options": [{"t": "150 J", "ok": true, "fb": "Correct."}, {"t": "850 J", "ok": false, "fb": "No."}, {"t": "350 J", "ok": false, "fb": "No."}, {"t": "0 J", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p15", "type": "multi", "prompt": "Select ALL ways of transferring energy.", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Electrically", "ok": true, "fb": ""}, {"t": "By heating", "ok": true, "fb": ""}, {"t": "By waves", "ok": true, "fb": ""}, {"t": "By creating it", "ok": false, "fb": "No."}, {"t": "By destroying it", "ok": false, "fb": "No."}, {"t": "Mechanically", "ok": true, "fb": ""}], "hint": "4 statements are correct.", "reason": ""}, {"id": "u11s2p16", "type": "mcq", "prompt": "Your muscles get energy from the ___ store.", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "nuclear", "ok": false, "fb": "No."}, {"t": "elastic", "ok": false, "fb": "No."}, {"t": "chemical", "ok": true, "fb": "Correct."}, {"t": "sound", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u11s2p17", "type": "order", "prompt": "Order the energy path for food energy reaching a plant-eating animal.", "diff": "M", "obj": "O2", "skill": "Knowledge", "items": ["Light from the Sun", "Chemical store in the plant (photosynthesis)", "Chemical store in the animal that eats it"], "hint": "", "reason": ""}, {"id": "u11s2p18", "type": "mcq", "prompt": "Why does a swing eventually stop if nobody pushes?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "Energy is destroyed", "ok": false, "fb": "No."}, {"t": "Gravity stops", "ok": false, "fb": "No."}, {"t": "It runs out of mass", "ok": false, "fb": "No."}, {"t": "Energy is gradually transferred to the surroundings", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}], "stops": [{"id": "u11v2a", "note": "Paused after: “Thermal energy is transferred by heat, from a hotter place to a colder one. On a stove, en”", "q": {"id": "u11v2a_q", "type": "mcq", "prompt": "Lifting a box transfers energy…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "mechanically", "ok": true, "fb": "Correct."}, {"t": "electrically", "ok": false, "fb": "No."}, {"t": "by sound", "ok": false, "fb": "No."}, {"t": "by light", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u11v2b", "note": "Paused after: “Some energy from the fuel is also released to the surroundings as heat, light and sound. A”", "q": {"id": "u11v2b_q", "type": "mcq", "prompt": "In a rocket launch, energy starts in the…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "kinetic store", "ok": false, "fb": "Later."}, {"t": "chemical store of the fuel", "ok": true, "fb": "Correct."}, {"t": "nuclear store", "ok": false, "fb": "No."}, {"t": "elastic store", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}]}, {"id": "11.3", "prac": [{"id": "u11s3p01", "type": "mcq", "prompt": "A tungsten bulb turns ___ of its energy into light.", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "15%", "ok"