{"sections": [{"id": "1.1", "prac": [{"id": "u1s1p01", "type": "mcq", "prompt": "Meteorology is the study of…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the weather", "ok": true, "fb": "Correct."}, {"t": "meteors only", "ok": false, "fb": "No – it means weather."}, {"t": "metals", "ok": false, "fb": "No."}, {"t": "medicine", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s1p02", "type": "mcq", "prompt": "Chemistry is the study of…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "living things", "ok": false, "fb": "Biology."}, {"t": "matter – what things are made of and how they change", "ok": true, "fb": "Correct."}, {"t": "space", "ok": false, "fb": "Astronomy."}, {"t": "forces", "ok": false, "fb": "Physics."}], "hint": "", "reason": ""}, {"id": "u1s1p03", "type": "mcq", "prompt": "Which area of science studies how a cargo ship floats?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Physics", "ok": true, "fb": "Correct."}, {"t": "Biology", "ok": false, "fb": "Not living."}, {"t": "Meteorology", "ok": false, "fb": "Weather."}, {"t": "Astronomy", "ok": false, "fb": "Space."}], "hint": "", "reason": ""}, {"id": "u1s1p04", "type": "mcq", "prompt": "Synthetic materials are…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "always natural", "ok": false, "fb": "No."}, {"t": "only wood and cotton", "ok": false, "fb": "Those are natural."}, {"t": "living things", "ok": false, "fb": "No."}, {"t": "made by people using science", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s1p05", "type": "mcq", "prompt": "Global warming is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "a cold winter", "ok": false, "fb": "No."}, {"t": "only hot summers", "ok": false, "fb": "No."}, {"t": "a type of electricity", "ok": false, "fb": "No."}, {"t": "a rise in Earth's average temperature", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s1p06", "type": "mcq", "prompt": "Science has two main parts. What are they?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "What we already know, and the processes used to find out more", "ok": true, "fb": "Correct."}, {"t": "Physics and biology only", "ok": false, "fb": "Many areas."}, {"t": "Questions and guesses", "ok": false, "fb": "Evidence is needed."}, {"t": "Teachers and students", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s1p07", "type": "mcq", "prompt": "Ibn Sina's idea of collecting evidence to check treatments matters because…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "it made medicines cheaper", "ok": false, "fb": "Not the point."}, {"t": "it shows which treatments really work", "ok": true, "fb": "Correct."}, {"t": "it stopped all disease", "ok": false, "fb": "No."}, {"t": "it replaced doctors", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s1p08", "type": "mcq", "prompt": "Which scientist's work led to X-rays and cancer treatments?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Hypatia", "ok": false, "fb": "Density of liquids."}, {"t": "Feng Zhang", "ok": false, "fb": "Changing DNA."}, {"t": "Marie Curie", "ok": true, "fb": "Correct."}, {"t": "Ibn Sina", "ok": false, "fb": "Evidence in medicine."}], "hint": "", "reason": ""}, {"id": "u1s1p09", "type": "mcq", "prompt": "Do scientists always work alone?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Yes, always alone.", "ok": false, "fb": "Many work together."}, {"t": "No – some work alone and some in teams, and all build on others' work.", "ok": true, "fb": "Correct."}, {"t": "Yes, they must keep work secret.", "ok": false, "fb": "They share results."}, {"t": "No, only in pairs.", "ok": false, "fb": "No fixed rule."}], "hint": "", "reason": ""}, {"id": "u1s1p10", "type": "mcq", "prompt": "Which question is a biology question?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "How do bees find flowers?", "ok": true, "fb": "Correct."}, {"t": "Why does iron rust?", "ok": false, "fb": "Chemistry."}, {"t": "How fast does a car accelerate?", "ok": false, "fb": "Physics."}, {"t": "When will it rain?", "ok": false, "fb": "Meteorology."}], "hint": "", "reason": ""}, {"id": "u1s1p11", "type": "mcq", "prompt": "Which question is an astronomy question?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Why do leaves change colour?", "ok": false, "fb": "Biology."}, {"t": "How do batteries work?", "ok": false, "fb": "Physics/chemistry."}, {"t": "Why does salt dissolve?", "ok": false, "fb": "Chemistry."}, {"t": "Why does the Moon change shape in the sky?", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s1p12", "type": "mcq", "prompt": "Our demand for electricity and transport has…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "cooled the Earth", "ok": false, "fb": "No."}, {"t": "had no effect", "ok": false, "fb": "No."}, {"t": "helped cause global warming and climate change", "ok": true, "fb": "Correct."}, {"t": "stopped pollution", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s1p13", "type": "mcq", "prompt": "Science has developed around the world for…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "about 10 years", "ok": false, "fb": "Far longer."}, {"t": "only since 2000", "ok": false, "fb": "No."}, {"t": "only in Europe", "ok": false, "fb": "Around the world."}, {"t": "thousands of years", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s1p14", "type": "mcq", "prompt": "Feng Zhang helped develop ways to…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "measure liquid density", "ok": false, "fb": "Hypatia."}, {"t": "treat illness by changing a person's DNA", "ok": true, "fb": "Correct."}, {"t": "study the weather", "ok": false, "fb": "No."}, {"t": "make X-ray images of DNA", "ok": false, "fb": "Franklin."}], "hint": "", "reason": ""}, {"id": "u1s1p15", "type": "order", "prompt": "Order these scientists by when they lived, earliest first.", "diff": "M", "obj": "O1", "skill": "Knowledge", "items": ["Hypatia of Alexandria", "Ibn Sina", "Marie Curie", "Rosalind Franklin"], "hint": "", "reason": ""}, {"id": "u1s1p16", "type": "mcq", "prompt": "Which is a phenomenon science explains?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "A favourite colour", "ok": false, "fb": "Opinion."}, {"t": "A football score", "ok": false, "fb": "Not a natural phenomenon."}, {"t": "A poem", "ok": false, "fb": "No."}, {"t": "A chick hatching from an egg", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s1p17", "type": "multi", "prompt": "Select ALL the things developed using science.", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Rain", "ok": false, "fb": "Natural."}, {"t": "Electricity supply", "ok": true, "fb": ""}, {"t": "Synthetic materials", "ok": true, "fb": ""}, {"t": "Aeroplanes", "ok": true, "fb": ""}, {"t": "Natural cotton growing on plants", "ok": false, "fb": "Natural, not invented."}], "hint": "3 statements are correct.", "reason": ""}, {"id": "u1s1p18", "type": "mcq", "prompt": "Why is science split into areas such as physics and biology?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Areas never overlap.", "ok": false, "fb": "They often overlap."}, {"t": "Only one area is real science.", "ok": false, "fb": "All are."}, {"t": "To make it harder.", "ok": false, "fb": "No."}, {"t": "Science is a very big subject, so areas focus on different questions.", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}], "stops": [{"id": "u1v1a", "note": "Paused after: “And why does it get dark at night? All of these phenomena, things we observe happening, ca”", "q": {"id": "u1v1a_q", "type": "mcq", "prompt": "Science is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "a list of rules", "ok": false, "fb": "No."}, {"t": "only maths", "ok": false, "fb": "No."}, {"t": "guessing", "ok": false, "fb": "No."}, {"t": "the study of how things work", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}, {"id": "u1v1b", "note": "Paused after: “And meteorology is the study of the weather. Each area asks different questions, but they ”", "q": {"id": "u1v1b_q", "type": "mcq", "prompt": "Which area studies living things?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Physics", "ok": false, "fb": "Forces and energy."}, {"t": "Chemistry", "ok": false, "fb": "Matter."}, {"t": "Astronomy", "ok": false, "fb": "Space."}, {"t": "Biology", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}, {"id": "u1v1c", "note": "Paused after: “Some scientists work alone and some work together, but each discovery becomes a starting p”", "q": {"id": "u1v1c_q", "type": "mcq", "prompt": "How does scientific knowledge grow?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "One person discovers everything.", "ok": false, "fb": "No."}, {"t": "Each discovery becomes a starting point for the next.", "ok": true, "fb": "Correct."}, {"t": "By keeping results secret.", "ok": false, "fb": "No."}, {"t": "By guessing.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}]}, {"id": "1.2", "prac": [{"id": "u1s2p01", "type": "mcq", "prompt": "A hypothesis is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a final answer", "ok": false, "fb": "It must be tested."}, {"t": "a piece of apparatus", "ok": false, "fb": "No."}, {"t": "a measurement", "ok": false, "fb": "No."}, {"t": "an idea that might explain an observation", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s2p02", "type": "mcq", "prompt": "A prediction often uses the words…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Once upon a time", "ok": false, "fb": "No."}, {"t": "Maybe never", "ok": false, "fb": "No."}, {"t": "If … then …", "ok": true, "fb": "Correct."}, {"t": "Always and never", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p03", "type": "mcq", "prompt": "A variable is…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "something that never changes", "ok": false, "fb": "No."}, {"t": "anything that can change", "ok": true, "fb": "Correct."}, {"t": "a result", "ok": false, "fb": "Not exactly."}, {"t": "a scientist", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p04", "type": "mcq", "prompt": "The independent variable is the one…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "we change on purpose", "ok": true, "fb": "Correct."}, {"t": "that changes as a result", "ok": false, "fb": "Dependent."}, {"t": "we keep the same", "ok": false, "fb": "Control."}, {"t": "we ignore", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p05", "type": "mcq", "prompt": "The dependent variable is the one…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "we change on purpose", "ok": false, "fb": "Independent."}, {"t": "we keep the same", "ok": false, "fb": "Control."}, {"t": "that changes as a result and is measured", "ok": true, "fb": "Correct."}, {"t": "that is never measured", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p06", "type": "mcq", "prompt": "In the ice-pop test, what was the independent variable?", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "Amount of sugar", "ok": true, "fb": "Correct."}, {"t": "Freezing time", "ok": false, "fb": "Dependent."}, {"t": "Volume of liquid", "ok": false, "fb": "Control."}, {"t": "The freezer", "ok": false, "fb": "Control."}], "hint": "", "reason": ""}, {"id": "u1s2p07", "type": "mcq", "prompt": "In the ice-pop test, why were the bags identical with the same volume of liquid?", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "To keep control variables the same so the test is fair", "ok": true, "fb": "Correct."}, {"t": "To save money", "ok": false, "fb": "No."}, {"t": "To make it faster", "ok": false, "fb": "No."}, {"t": "Because sugar is heavy", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p08", "type": "mcq", "prompt": "How an animal burrows into the ground is best investigated by…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "a fair test changing one variable", "ok": false, "fb": "Not every question needs a fair test."}, {"t": "guessing", "ok": false, "fb": "No."}, {"t": "a hazard symbol", "ok": false, "fb": "No."}, {"t": "careful observation", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s2p09", "type": "mcq", "prompt": "A measurement close to the true value is…", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "precise", "ok": false, "fb": "Precise = close to each other."}, {"t": "biased", "ok": false, "fb": "No."}, {"t": "a hypothesis", "ok": false, "fb": "No."}, {"t": "accurate", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s2p10", "type": "mcq", "prompt": "Repeated results that are close together are…", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "precise", "ok": true, "fb": "Correct."}, {"t": "accurate", "ok": false, "fb": "Accurate = close to true value."}, {"t": "random", "ok": false, "fb": "No."}, {"t": "wrong", "ok": false, "fb": "Not necessarily."}], "hint": "", "reason": ""}, {"id": "u1s2p11", "type": "match", "prompt": "Match each instrument to what it measures.", "diff": "M", "obj": "O4", "skill": "Knowledge", "pairs": [{"l": "Thermometer", "r": "temperature"}, {"l": "Stopwatch", "r": "time"}, {"l": "Telescope", "r": "faraway objects"}, {"l": "Hand lens", "r": "tiny objects"}], "hint": "", "reason": ""}, {"id": "u1s2p12", "type": "mcq", "prompt": "Which way of presenting data best shows a trend over time?", "diff": "H", "obj": "O4", "skill": "Knowledge", "options": [{"t": "A list of names", "ok": false, "fb": "No."}, {"t": "A line graph", "ok": true, "fb": "Correct."}, {"t": "A photo", "ok": false, "fb": "No."}, {"t": "A single number", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p13", "type": "mcq", "prompt": "A good conclusion must…", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "agree with what you hoped", "ok": false, "fb": "Be objective."}, {"t": "ignore the results", "ok": false, "fb": "No."}, {"t": "answer the question, be based on the results and support or disprove the hypothesis", "ok": true, "fb": "Correct."}, {"t": "be very long", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s2p14", "type": "mcq", "prompt": "Which attitude means asking questions instead of believing everything?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Healthy scepticism", "ok": true, "fb": "Correct."}, {"t": "Perseverance", "ok": false, "fb": "Keeping going."}, {"t": "Co-operation", "ok": false, "fb": "Teamwork."}, {"t": "Curiosity", "ok": false, "fb": "Wanting to find out."}], "hint": "", "reason": ""}, {"id": "u1s2p15", "type": "match", "prompt": "Match each attitude to its meaning.", "diff": "H", "obj": "O2", "skill": "Knowledge", "pairs": [{"l": "Integrity", "r": "always being truthful about results"}, {"l": "Perseverance", "r": "keep going when it is difficult"}, {"l": "Open-mindedness", "r": "listening to other ideas"}, {"l": "Objectivity", "r": "accepting a result you do not like"}], "hint": "", "reason": ""}, {"id": "u1s2p16", "type": "mcq", "prompt": "Precise, repeatable results are also called…", "diff": "H", "obj": "O4", "skill": "Knowledge", "options": [{"t": "reliable", "ok": true, "fb": "Correct."}, {"t": "biased", "ok": false, "fb": "No."}, {"t": "accurate always", "ok": false, "fb": "Not always."}, {"t": "anomalous", "ok": false, "fb": "Anomalous = do not fit."}], "hint": "", "reason": ""}, {"id": "u1s2p17", "type": "order", "prompt": "Order the five planning steps.", "diff": "M", "obj": "O3", "skill": "Knowledge", "items": ["Ask a question and make a hypothesis", "Identify the variables", "Decide what to measure and how to record it", "Choose materials and equipment", "Decide how to analyse the data"], "hint": "", "reason": ""}, {"id": "u1s2p18", "type": "mcq", "prompt": "Every model has limitations. This means…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "no model shows the real world completely", "ok": true, "fb": "Correct."}, {"t": "models are useless", "ok": false, "fb": "They are very useful."}, {"t": "models are always wrong", "ok": false, "fb": "Not always wrong – just incomplete."}, {"t": "only computer models work", "ok": false, "fb": "No."}], "hint": "", "reason": ""}], "stops": [{"id": "u1v2a", "note": "Paused after: “If the results had not been as expected, the hypothesis would need to change. Science is a”", "q": {"id": "u1v2a_q", "type": "mcq", "prompt": "What comes straight after the hypothesis?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "A prediction", "ok": true, "fb": "Correct."}, {"t": "A conclusion", "ok": false, "fb": "Later."}, {"t": "An observation", "ok": false, "fb": "Before."}, {"t": "Nothing", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u1v2b", "note": "Paused after: “That's why hypotheses often use the words depends on: the temperature of the water depends”", "q": {"id": "u1v2b_q", "type": "mcq", "prompt": "'Temperature depends on heating time.' The dependent variable is…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "the heating time", "ok": false, "fb": "Independent."}, {"t": "the temperature", "ok": true, "fb": "Correct."}, {"t": "the beaker", "ok": false, "fb": "Control."}, {"t": "the burner", "ok": false, "fb": "Control."}], "hint": "", "reason": ""}}, {"id": "u1v2c", "note": "Paused after: “When only the independent variable changes, we call it a fair test.”", "q": {"id": "u1v2c_q", "type": "mcq", "prompt": "Variables kept the same are called…", "diff": "H", "obj": "O3", "skill": "Knowledge", "options": [{"t": "dependent variables", "ok": false, "fb": "No."}, {"t": "independent variables", "ok": false, "fb": "No."}, {"t": "anomalies", "ok": false, "fb": "No."}, {"t": "control variables", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}, {"id": "u1v2d", "note": "Paused after: “Accurate and precise results let us make conclusions we can be sure of. Precise, repeatabl”", "q": {"id": "u1v2d_q", "type": "mcq", "prompt": "Results close to the true value are…", "diff": "H", "obj": "O4", "skill": "Knowledge", "options": [{"t": "accurate", "ok": true, "fb": "Correct."}, {"t": "precise", "ok": false, "fb": "Close to each other."}, {"t": "biased", "ok": false, "fb": "No."}, {"t": "anomalous", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}]}, {"id": "1.3", "prac": [{"id": "u1s3p01", "type": "mcq", "prompt": "What should you wear when heating substances?", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "Sunglasses", "ok": false, "fb": "No."}, {"t": "Safety goggles", "ok": true, "fb": "Correct."}, {"t": "Nothing extra", "ok": false, "fb": "Goggles protect eyes."}, {"t": "A hat", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s3p02", "type": "mcq", "prompt": "Flammable means…", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "catches fire easily", "ok": true, "fb": "Correct."}, {"t": "poisonous", "ok": false, "fb": "Toxic."}, {"t": "destroys skin", "ok": false, "fb": "Corrosive."}, {"t": "harms the environment", "ok": false, "fb": "Different symbol."}], "hint": "", "reason": ""}, {"id": "u1s3p03", "type": "mcq", "prompt": "Corrosive substances…", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "catch fire easily", "ok": false, "fb": "Flammable."}, {"t": "are always safe", "ok": false, "fb": "No."}, {"t": "are only gases", "ok": false, "fb": "No."}, {"t": "destroy skin and other materials", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s3p04", "type": "mcq", "prompt": "What should you do before using any substance?", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "Smell it closely", "ok": false, "fb": "Not safe."}, {"t": "Taste it", "ok": false, "fb": "Never."}, {"t": "Mix it with water", "ok": false, "fb": "Not without instructions."}, {"t": "Check the label and hazard symbol", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u1s3p05", "type": "mcq", "prompt": "Substances hazardous to the environment must never be…", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "labelled", "ok": false, "fb": "They must be labelled."}, {"t": "poured down the drain", "ok": true, "fb": "Correct."}, {"t": "stored safely", "ok": false, "fb": "They should be."}, {"t": "used by teachers", "ok": false, "fb": "Teachers can use them safely."}], "hint": "", "reason": ""}, {"id": "u1s3p06", "type": "mcq", "prompt": "Why must you never eat or drink in the lab?", "diff": "H", "obj": "O5", "skill": "Knowledge", "options": [{"t": "Food could be contaminated with harmful chemicals.", "ok": true, "fb": "Correct."}, {"t": "It is rude.", "ok": false, "fb": "Safety is the reason."}, {"t": "Food is not allowed anywhere.", "ok": false, "fb": "No."}, {"t": "It makes experiments slower.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s3p07", "type": "mcq", "prompt": "What is apparatus?", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "Scientific equipment", "ok": true, "fb": "Correct."}, {"t": "A hazard symbol", "ok": false, "fb": "No."}, {"t": "A type of chemical", "ok": false, "fb": "No."}, {"t": "A scientist", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u1s3p08", "type": "mcq", "prompt": "Which apparatus is used to heat substances?", "diff": "M", "obj": "O5", "skill": "Knowledge", "options": [{"t": "Bunsen burner", "ok": tru