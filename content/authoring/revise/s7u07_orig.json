{"sections": [{"id": "7.1", "prac": [{"id": "u7s1p01", "type": "mcq", "prompt": "Physical properties can be observed…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "only when it reacts", "ok": false, "fb": "Chemical properties."}, {"t": "never", "ok": false, "fb": "No."}, {"t": "only by tasting", "ok": false, "fb": "Never taste."}, {"t": "without changing the substance", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s1p02", "type": "mcq", "prompt": "The hardest material on the Mohs scale is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "talc", "ok": false, "fb": "Softest (1)."}, {"t": "diamond (10)", "ok": true, "fb": "Correct."}, {"t": "glass", "ok": false, "fb": "About 5.5."}, {"t": "steel", "ok": false, "fb": "About 6.5."}], "hint": "", "reason": ""}, {"id": "u7s1p03", "type": "mcq", "prompt": "The softest mineral on the Mohs scale is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "diamond", "ok": false, "fb": "Hardest."}, {"t": "quartz", "ok": false, "fb": "No."}, {"t": "talc (1)", "ok": true, "fb": "Correct."}, {"t": "glass", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p04", "type": "mcq", "prompt": "Aluminium foil is made by rolling aluminium. This shows aluminium is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "malleable", "ok": true, "fb": "Correct."}, {"t": "brittle", "ok": false, "fb": "No."}, {"t": "an insulator", "ok": false, "fb": "No."}, {"t": "flammable", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p05", "type": "mcq", "prompt": "Copper is used in wires because it is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "an insulator", "ok": false, "fb": "No."}, {"t": "a good electrical conductor and ductile", "ok": true, "fb": "Correct."}, {"t": "brittle", "ok": false, "fb": "No."}, {"t": "transparent", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p06", "type": "mcq", "prompt": "Why are electric wires covered in plastic?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Plastic is an electrical insulator, protecting us from shocks.", "ok": true, "fb": "Correct."}, {"t": "To make them heavier", "ok": false, "fb": "No."}, {"t": "Plastic conducts better", "ok": false, "fb": "No."}, {"t": "For colour only", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p07", "type": "mcq", "prompt": "A glass jug cracks when knocked; a metal jug does not. The metal is…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "stronger", "ok": true, "fb": "Correct."}, {"t": "harder", "ok": false, "fb": "Hardness = scratching."}, {"t": "more brittle", "ok": false, "fb": "Glass is brittle."}, {"t": "less dense", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p08", "type": "mcq", "prompt": "A nail scratches a plastic bowl but not a metal bowl. So…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the plastic is harder", "ok": false, "fb": "No."}, {"t": "the metal is harder than the plastic", "ok": true, "fb": "Correct."}, {"t": "they are equally hard", "ok": false, "fb": "No."}, {"t": "the nail is soft", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p09", "type": "mcq", "prompt": "Gold melts at about…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "100 °C", "ok": false, "fb": "No."}, {"t": "0 °C", "ok": false, "fb": "No."}, {"t": "−196 °C", "ok": false, "fb": "No."}, {"t": "1064 °C", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s1p10", "type": "mcq", "prompt": "Why are most metals solid at room temperature?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "They are cold.", "ok": false, "fb": "No."}, {"t": "They have low melting points.", "ok": false, "fb": "No."}, {"t": "They have high melting points.", "ok": true, "fb": "Correct."}, {"t": "They are non-metals.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p11", "type": "mcq", "prompt": "Which is flexible?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Metal wire", "ok": true, "fb": "Correct."}, {"t": "A pencil", "ok": false, "fb": "Snaps."}, {"t": "Glass rod", "ok": false, "fb": "Brittle."}, {"t": "Chalk", "ok": false, "fb": "Brittle."}], "hint": "", "reason": ""}, {"id": "u7s1p12", "type": "mcq", "prompt": "Density measures…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "how hot something is", "ok": false, "fb": "No."}, {"t": "how much matter is packed into a space", "ok": true, "fb": "Correct."}, {"t": "how hard it is", "ok": false, "fb": "No."}, {"t": "how big it is only", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s1p13", "type": "mcq", "prompt": "Wood floats on water because…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "it is heavier", "ok": false, "fb": "No."}, {"t": "it is less dense than water", "ok": true, "fb": "Correct."}, {"t": "it is a metal", "ok": false, "fb": "No."}, {"t": "it absorbs water", "ok": false, "fb": "Not the reason."}], "hint": "", "reason": ""}, {"id": "u7s1p14", "type": "num", "prompt": "A block has mass 27 g and volume 10 cm³. Density?", "diff": "H", "obj": "O1", "skill": "Application", "answer": 2.7, "unit": "g/cm³", "tol": 0.0, "units": ["g/cm³"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u7s1p15", "type": "mcq", "prompt": "Which is a thermal insulator?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Copper", "ok": false, "fb": "Conductor."}, {"t": "Aluminium", "ok": false, "fb": "Conductor."}, {"t": "Iron", "ok": false, "fb": "Conductor."}, {"t": "Silicone", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s1p16", "type": "mcq", "prompt": "Liquid nitrogen boils as soon as it is poured because…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "room temperature is far above its boiling point (−196 °C)", "ok": true, "fb": "Correct."}, {"t": "it is very hot", "ok": false, "fb": "Very cold."}, {"t": "it is a metal", "ok": false, "fb": "No."}, {"t": "it reacts with air", "ok": false, "fb": "Not boiling."}], "hint": "", "reason": ""}, {"id": "u7s1p17", "type": "mcq", "prompt": "A drill bit (8.5) can scratch…", "diff": "H", "obj": "O1", "skill": "Data", "options": [{"t": "diamond (10)", "ok": false, "fb": "No."}, {"t": "nothing", "ok": false, "fb": "No."}, {"t": "only talc", "ok": false, "fb": "More than talc."}, {"t": "glass (5.5) and steel (6.5)", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s1p18", "type": "order", "prompt": "Order from softest to hardest.", "diff": "M", "obj": "O1", "skill": "Knowledge", "items": ["Talc (1)", "Fingernail (2.5)", "Glass (5.5)", "Steel nail (6.5)", "Diamond (10)"], "hint": "", "reason": ""}], "stops": [{"id": "u7v1a", "note": "Paused after: “Chemical properties can only be observed when the material reacts with another substance, ”", "q": {"id": "u7v1a_q", "type": "mcq", "prompt": "Which is a physical property?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Hardness", "ok": true, "fb": "Correct."}, {"t": "Flammability", "ok": false, "fb": "Chemical."}, {"t": "Reactivity", "ok": false, "fb": "Chemical."}, {"t": "Toxicity", "ok": false, "fb": "Chemical."}], "hint": "", "reason": ""}}, {"id": "u7v1b", "note": "Paused after: “Everyday objects fit on the scale too: a fingernail is about 2.5, glass about 5.5, a steel”", "q": {"id": "u7v1b_q", "type": "mcq", "prompt": "Glass (5.5) vs steel nail (6.5): which scratches the other?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Glass scratches steel", "ok": false, "fb": "No."}, {"t": "The steel nail scratches the glass", "ok": true, "fb": "Correct."}, {"t": "Neither", "ok": false, "fb": "No."}, {"t": "Both", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u7v1c", "note": "Paused after: “The metal spoon! Most metals are good thermal conductors. Wood, plastic and silicone are t”", "q": {"id": "u7v1c_q", "type": "mcq", "prompt": "Which spoon gets hot first in boiling water?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "The metal spoon", "ok": true, "fb": "Correct."}, {"t": "The wooden spoon", "ok": false, "fb": "Insulator."}, {"t": "Both together", "ok": false, "fb": "No."}, {"t": "Neither", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u7v1d", "note": "Paused after: “So why don't steel ships sink? Think about all the air inside the hull, which makes the sh”", "q": {"id": "u7v1d_q", "type": "mcq", "prompt": "Why does wood float?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "It is heavy", "ok": false, "fb": "No."}, {"t": "It is a metal", "ok": false, "fb": "No."}, {"t": "It is less dense than water", "ok": true, "fb": "Correct."}, {"t": "It is hard", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}]}, {"id": "7.2", "prac": [{"id": "u7s2p01", "type": "mcq", "prompt": "The opposite of reactive is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "toxic", "ok": false, "fb": "No."}, {"t": "inert", "ok": true, "fb": "Correct."}, {"t": "flammable", "ok": false, "fb": "No."}, {"t": "dense", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p02", "type": "mcq", "prompt": "Which is flammable?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Water", "ok": false, "fb": "No."}, {"t": "Petrol", "ok": true, "fb": "Correct."}, {"t": "Gold", "ok": false, "fb": "No."}, {"t": "Sand", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p03", "type": "mcq", "prompt": "When wood burns it turns into…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "more wood", "ok": false, "fb": "No."}, {"t": "pure oxygen", "ok": false, "fb": "No."}, {"t": "iron", "ok": false, "fb": "No."}, {"t": "ash, carbon dioxide, water vapour and other gases", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s2p04", "type": "mcq", "prompt": "The pH scale runs from…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "0 to 14", "ok": true, "fb": "Correct."}, {"t": "1 to 10", "ok": false, "fb": "No."}, {"t": "0 to 100", "ok": false, "fb": "No."}, {"t": "−7 to 7", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p05", "type": "mcq", "prompt": "pH 7 is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "neutral", "ok": true, "fb": "Correct."}, {"t": "acidic", "ok": false, "fb": "Below 7."}, {"t": "alkaline", "ok": false, "fb": "Above 7."}, {"t": "toxic", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p06", "type": "mcq", "prompt": "Which elements are toxic and harmed people in the past?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Oxygen and nitrogen", "ok": false, "fb": "No."}, {"t": "Lead, arsenic and mercury", "ok": true, "fb": "Correct."}, {"t": "Gold and silver", "ok": false, "fb": "No."}, {"t": "Helium and neon", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p07", "type": "mcq", "prompt": "Batteries left too long can leak…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "water", "ok": false, "fb": "No."}, {"t": "gold", "ok": false, "fb": "No."}, {"t": "oxygen", "ok": false, "fb": "No."}, {"t": "corrosive substances", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s2p08", "type": "mcq", "prompt": "Pesticides kill insects but can…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "make crops toxic-free", "ok": false, "fb": "No."}, {"t": "harm people and the environment", "ok": true, "fb": "Correct."}, {"t": "cure diseases", "ok": false, "fb": "No."}, {"t": "make soil inert", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p09", "type": "mcq", "prompt": "Rust is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "iron oxide", "ok": true, "fb": "Correct."}, {"t": "iron chloride", "ok": false, "fb": "No."}, {"t": "pure iron", "ok": false, "fb": "No."}, {"t": "oxygen gas", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p10", "type": "mcq", "prompt": "Inert gases are used inside some lamps because…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "they burn brightly", "ok": false, "fb": "No."}, {"t": "they are toxic", "ok": false, "fb": "No."}, {"t": "they do not react with the hot filament", "ok": true, "fb": "Correct."}, {"t": "they are cheap metals", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p11", "type": "mcq", "prompt": "Is burning a physical or chemical property?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Physical", "ok": false, "fb": "New substances form."}, {"t": "Chemical – new substances form", "ok": true, "fb": "Correct."}, {"t": "Neither", "ok": false, "fb": "No."}, {"t": "Both always", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p12", "type": "mcq", "prompt": "Many household cleaners are…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "acidic", "ok": false, "fb": "Some are, but many are alkaline."}, {"t": "alkaline", "ok": true, "fb": "Correct."}, {"t": "neutral always", "ok": false, "fb": "No."}, {"t": "toxic metals", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p13", "type": "multi", "prompt": "Select ALL chemical properties.", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Toxicity", "ok": true, "fb": ""}, {"t": "Reactivity", "ok": true, "fb": ""}, {"t": "Density", "ok": false, "fb": "Physical."}, {"t": "Hardness", "ok": false, "fb": "Physical."}, {"t": "Flammability", "ok": true, "fb": ""}], "hint": "3 statements are correct.", "reason": ""}, {"id": "u7s2p14", "type": "mcq", "prompt": "A substance with pH 1 is…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "weakly acidic", "ok": false, "fb": "Lower = stronger."}, {"t": "neutral", "ok": false, "fb": "No."}, {"t": "strongly acidic", "ok": true, "fb": "Correct."}, {"t": "alkaline", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p15", "type": "mcq", "prompt": "How can rusting of iron be prevented?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "Heating it", "ok": false, "fb": "No."}, {"t": "Wetting it", "ok": false, "fb": "Speeds rusting."}, {"t": "Breaking it", "ok": false, "fb": "No."}, {"t": "Painting or coating it to keep out water and oxygen", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u7s2p16", "type": "mcq", "prompt": "Corrosive substances destroy…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "only metals", "ok": false, "fb": "No."}, {"t": "only plastic", "ok": false, "fb": "No."}, {"t": "materials, including living tissue", "ok": true, "fb": "Correct."}, {"t": "nothing", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u7s2p17", "type": "mcq", "prompt": "Which is a chemical property of oxygen?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "It supports burning", "ok": true, "fb": "Correct."}, {"t": "It is colourless", "ok": false, "fb": "Physical."}, {"t": "It is a gas at 20 °C", "ok": false, "fb": "Physical."}, {"t": "It has low density", "ok": false, "fb": "Physical."}], "hint": "", "reason": ""}, {"id": "u7s2p18", "type": "mcq", "prompt": "Why must sodium be stored under oil?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "It is flammable only in oil", "ok": false, "fb": "No."}, {"t": "Oil makes it shiny", "ok": false, "fb": "No."}, {"t": "It is inert", "ok": false, "fb": "No."}, {"t": "It reacts violently with water (and air).", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}], "stops": [{"id": "u7v2a", "note": "Paused after: “Iron is hard and strong. But in wet cond