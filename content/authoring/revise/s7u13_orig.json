{"sections": [{"id": "13.1", "prac": [{"id": "u13s1p01", "type": "mcq", "prompt": "The thin outer layer of solid rock is the…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "mantle", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "fb": "No."}, {"t": "crust", "ok": true, "fb": "Correct."}, {"t": "magma", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p02", "type": "mcq", "prompt": "The crust is up to about ___ km thick.", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "60", "ok": true, "fb": "Correct."}, {"t": "6000", "ok": false, "fb": "No."}, {"t": "600", "ok": false, "fb": "No."}, {"t": "6", "ok": false, "fb": "Too thin."}], "hint": "", "reason": ""}, {"id": "u13s1p03", "type": "mcq", "prompt": "Semi-molten rock is called…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "lava", "ok": false, "fb": "Magma at the surface."}, {"t": "crust", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "fb": "No."}, {"t": "magma", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u13s1p04", "type": "mcq", "prompt": "The lower mantle is solid because of…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "low temperature", "ok": false, "fb": "It's extremely hot."}, {"t": "huge pressure", "ok": true, "fb": "Correct."}, {"t": "water", "ok": false, "fb": "No."}, {"t": "iron", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p05", "type": "mcq", "prompt": "The outer core is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "solid rock", "ok": false, "fb": "No."}, {"t": "liquid metal", "ok": true, "fb": "Correct."}, {"t": "gas", "ok": false, "fb": "No."}, {"t": "water", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p06", "type": "mcq", "prompt": "Plates move about…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "1 to 10 cm a year", "ok": true, "fb": "Correct."}, {"t": "1 to 10 km a year", "ok": false, "fb": "No."}, {"t": "1 m a day", "ok": false, "fb": "No."}, {"t": "not at all", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p07", "type": "mcq", "prompt": "Plates are about ___ thick.", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "1 km", "ok": false, "fb": "No."}, {"t": "10 m", "ok": false, "fb": "No."}, {"t": "10 000 km", "ok": false, "fb": "No."}, {"t": "100 km", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u13s1p08", "type": "mcq", "prompt": "Continental crust forms…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the ocean floor", "ok": false, "fb": "Oceanic."}, {"t": "the core", "ok": false, "fb": "No."}, {"t": "the continents", "ok": true, "fb": "Correct."}, {"t": "clouds", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p09", "type": "mcq", "prompt": "Geothermal energy is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "energy from wind", "ok": false, "fb": "No."}, {"t": "energy from tides", "ok": false, "fb": "No."}, {"t": "energy from food", "ok": false, "fb": "No."}, {"t": "heat from inside the Earth", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u13s1p10", "type": "grid", "prompt": "Which layer?", "diff": "M", "obj": "O1", "skill": "Figure", "cols": ["Core", "Crust", "Mantle"], "rows": [{"l": "Iron and nickel", "a": ["Core"]}, {"l": "Thin solid rock", "a": ["Crust"]}, {"l": "Magma", "a": ["Mantle"]}], "hint": "", "reason": ""}, {"id": "u13s1p11", "type": "mcq", "prompt": "Why do diagrams that show the crust as one piece mislead us?", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "The crust is liquid", "ok": false, "fb": "No."}, {"t": "The crust is really broken into tectonic plates", "ok": true, "fb": "Correct."}, {"t": "There is no crust", "ok": false, "fb": "No."}, {"t": "The crust is the core", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p12", "type": "mcq", "prompt": "The plates rest on the…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "mantle", "ok": true, "fb": "Correct."}, {"t": "inner core", "ok": false, "fb": "No."}, {"t": "ocean", "ok": false, "fb": "No."}, {"t": "atmosphere", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p13", "type": "mcq", "prompt": "Which layer is the hottest?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Inner core", "ok": true, "fb": "Correct."}, {"t": "Crust", "ok": false, "fb": "No."}, {"t": "Upper mantle", "ok": false, "fb": "No."}, {"t": "Outer core", "ok": false, "fb": "Close, but no."}], "hint": "", "reason": ""}, {"id": "u13s1p14", "type": "num", "prompt": "A plate moves 2 cm a year. How far in 1 million years, in km? (100 000 cm = 1 km)", "diff": "H", "obj": "O1", "skill": "Application", "answer": 20, "unit": "km", "tol": 0.0, "units": ["km"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u13s1p15", "type": "mcq", "prompt": "Volcanoes are openings where…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "water enters the core", "ok": false, "fb": "No."}, {"t": "wind is made", "ok": false, "fb": "No."}, {"t": "plates are glued", "ok": false, "fb": "No."}, {"t": "heat escapes from inside the Earth", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u13s1p16", "type": "mcq", "prompt": "Oceanic crust forms…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the ocean floor", "ok": true, "fb": "Correct."}, {"t": "mountains only", "ok": false, "fb": "No."}, {"t": "the continents", "ok": false, "fb": "No."}, {"t": "the core", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s1p17", "type": "mcq", "prompt": "The idea that the crust is made of moving plates is called…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "the water cycle", "ok": false, "fb": "No."}, {"t": "the particle model", "ok": false, "fb": "No."}, {"t": "the Big Bang", "ok": false, "fb": "No."}, {"t": "plate tectonics", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u13s1p18", "type": "order", "prompt": "Order the convection that moves plates.", "diff": "M", "obj": "O1", "skill": "Knowledge", "items": ["Core heats magma", "Hot magma rises", "Magma spreads under the plates", "Magma cools and sinks"], "hint": "", "reason": ""}], "stops": [{"id": "u13v1a", "note": "Paused after: “At the centre is the core, made mainly of iron and nickel. The outer core is liquid metal.”", "q": {"id": "u13v1a_q", "type": "mcq", "prompt": "The thin outer layer of the Earth is the…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "mantle", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "fb": "No."}, {"t": "magma", "ok": false, "fb": "No."}, {"t": "crust", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}, {"id": "u13v1b", "note": "Paused after: “The plates are about 100 kilometres thick, and they move very slowly, between 1 and 10 cen”", "q": {"id": "u13v1b_q", "type": "mcq", "prompt": "Which crust is denser?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Continental crust", "ok": false, "fb": "No."}, {"t": "Both the same", "ok": false, "fb": "No."}, {"t": "Neither", "ok": false, "fb": "No."}, {"t": "Oceanic crust", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}]}, {"id": "13.2", "prac": [{"id": "u13s2p01", "type": "mcq", "prompt": "Where two or more plates meet is a…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "plate centre", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "fb": "No."}, {"t": "plate boundary", "ok": true, "fb": "Correct."}, {"t": "magma chamber", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p02", "type": "mcq", "prompt": "The point on the surface directly above the focus is the…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "vent", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "fb": "No."}, {"t": "epicentre", "ok": true, "fb": "Correct."}, {"t": "crater", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p03", "type": "mcq", "prompt": "Fold mountains form at…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "transform boundaries", "ok": false, "fb": "No."}, {"t": "divergent boundaries", "ok": false, "fb": "No."}, {"t": "convergent boundaries", "ok": true, "fb": "Correct."}, {"t": "the core", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p04", "type": "mcq", "prompt": "Energy from an earthquake travels as…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "light", "ok": false, "fb": "No."}, {"t": "magma", "ok": false, "fb": "No."}, {"t": "seismic waves", "ok": true, "fb": "Correct."}, {"t": "wind", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p05", "type": "mcq", "prompt": "A volcano is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a vent in the crust where magma and gases escape", "ok": true, "fb": "Correct."}, {"t": "a mountain made of ice", "ok": false, "fb": "No."}, {"t": "a hole in the core", "ok": false, "fb": "No."}, {"t": "a type of earthquake", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p06", "type": "mcq", "prompt": "Magma rises because it is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "less dense than the solid rock around it", "ok": true, "fb": "Correct."}, {"t": "heavier", "ok": false, "fb": "No."}, {"t": "cold", "ok": false, "fb": "No."}, {"t": "magnetic", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p07", "type": "mcq", "prompt": "Mount Vesuvius destroyed which Roman city?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Rome", "ok": false, "fb": "No."}, {"t": "Pompeii", "ok": true, "fb": "Correct."}, {"t": "Athens", "ok": false, "fb": "No."}, {"t": "London", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p08", "type": "mcq", "prompt": "There are about ___ active volcanoes today.", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "6", "ok": false, "fb": "No."}, {"t": "600", "ok": true, "fb": "Correct."}, {"t": "60 000", "ok": false, "fb": "No."}, {"t": "6 million", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p09", "type": "mcq", "prompt": "A volcano's cone is made from…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "ice", "ok": false, "fb": "No."}, {"t": "sand from the sea", "ok": false, "fb": "No."}, {"t": "layers of lava and ash", "ok": true, "fb": "Correct."}, {"t": "iron from the core", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p10", "type": "mcq", "prompt": "At a divergent boundary, magma rising into the gap forms…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "volcanoes and valleys", "ok": true, "fb": "Correct."}, {"t": "fold mountains", "ok": false, "fb": "Convergent."}, {"t": "nothing", "ok": false, "fb": "No."}, {"t": "deserts", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p11", "type": "grid", "prompt": "Feature and boundary", "diff": "M", "obj": "O2", "skill": "Data", "cols": ["Convergent", "Transform", "Divergent"], "rows": [{"l": "Fold mountains", "a": ["Convergent"]}, {"l": "Earthquakes from sliding plates", "a": ["Transform"]}, {"l": "New crust from rising magma", "a": ["Divergent"]}], "hint": "", "reason": ""}, {"id": "u13s2p12", "type": "mcq", "prompt": "Geothermal power plants use…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "wind", "ok": false, "fb": "No."}, {"t": "underground water heated by magma", "ok": true, "fb": "Correct."}, {"t": "sunlight", "ok": false, "fb": "No."}, {"t": "coal", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p13", "type": "mcq", "prompt": "You can model fold mountains by…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "gently pushing two sheets of paper together", "ok": true, "fb": "Correct."}, {"t": "pouring water", "ok": false, "fb": "No."}, {"t": "heating ice", "ok": false, "fb": "No."}, {"t": "drawing circles", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p14", "type": "mcq", "prompt": "The Himalayas formed about…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "50 million years ago", "ok": true, "fb": "Correct."}, {"t": "50 years ago", "ok": false, "fb": "No."}, {"t": "5000 years ago", "ok": false, "fb": "No."}, {"t": "5 billion years ago", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p15", "type": "num", "prompt": "Vesuvius erupted in 79 CE. About how many years before 2026 was that?", "diff": "H", "obj": "O2", "skill": "Application", "answer": 1947, "unit": "years", "tol": 0.0, "units": ["years"], "errs": [], "unitFb": "", "hint": "", "reason": ""}, {"id": "u13s2p16", "type": "mcq", "prompt": "Why are earthquakes and volcanoes found in long belts on a world map?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "They mostly occur along plate boundaries", "ok": true, "fb": "Correct."}, {"t": "They follow rivers", "ok": false, "fb": "No."}, {"t": "They follow the equator", "ok": false, "fb": "No."}, {"t": "They are random", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u13s2p17", "type": "order", "prompt": "Order the earthquake process.", "diff": "M", "obj": "O2", "skill": "Knowledge", "items": ["Plates push against each other", "Friction makes them stick", "Stress builds up", "Plates move suddenly – seismic waves"], "hint": "", "reason": ""}, {"id": "u13s2p18", "type": "mcq", "prompt": "Why might Everest still be growing?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Snow keeps falling", "ok": false, "fb": "Not the reason."}, {"t": "Volcanoes underneath", "ok": false, "fb": "No."}, {"t": "Erosion", "ok": false, "fb": "Makes it smaller."}, {"t": "The plates are still colliding", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}], "stops": [{"id": "u13v2a", "note": "Paused after: “At a convergent boundary, plates collide, pushing the land up into fold mountains.”", "q": {"id": "u13v2a_q", "type": "mcq", "prompt": "Plates moving apart is a…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "convergent boundary", "ok": false, "fb": "Collide."}, {"t": "transform boundary", "ok": false, "fb": "Slide."}, {"t": "divergent boundary", "ok": true, "fb": "Correct."}, {"t": "focus", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u13v2b", "note": "Paused after: “The point underground where the earthquake starts is the focus. The point on the surface d”", "q": {"id": "u13v2b_q", "type": "mcq", "prompt": "The point on the surface above an earthquake's focus is the…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "epicentre", "ok": true, "fb": "Correct."}, {"t": "vent", "ok": false, "fb": "No."}, {"t": "crater", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u13v2c", "note": "Paused after: “Magma also heats underground water, making hot water and steam. Geothermal power plants us”", "q": {"id": "u13v2c_q", "type": "mcq", "prompt": "Magma that reaches the surface is…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "ash", "ok": false, "fb": "No."}, {"t": "crust", "ok": false, "fb": "No."}, {"t": "groundwater", "ok": false, "fb": "No."}, {"t": "lava", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}]}, {"id": "13.3", "prac": [{"id": "u13s3p01", "type": "mcq", "prompt": "The layer of air around the Earth is the…", "diff": "M", "obj": "O3", "skill": "Knowledge", "options": [{"t": "atmosphere", "ok": true, "fb": "Correct."}, {"t": "crust", "ok": false, "fb": "No."}, {"t": "mantle", "ok": false, "fb": "No."}, {"t": "core", "ok": false, "