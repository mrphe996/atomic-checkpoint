{"sections": [{"id": "12.1", "prac": [{"id": "u12s1p01", "type": "mcq", "prompt": "Atoms contain protons, neutrons and…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "molecules", "ok": false, "fb": "No."}, {"t": "cells", "ok": false, "fb": "No."}, {"t": "ions only", "ok": false, "fb": "No."}, {"t": "electrons", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s1p02", "type": "mcq", "prompt": "Insulators…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "let electricity flow freely", "ok": false, "fb": "Conductors."}, {"t": "stop electricity flowing", "ok": true, "fb": "Correct."}, {"t": "make electricity", "ok": false, "fb": "No."}, {"t": "store electricity", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p03", "type": "mcq", "prompt": "Which is the best conductor?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Plastic", "ok": false, "fb": "No."}, {"t": "Copper", "ok": true, "fb": "Correct."}, {"t": "Rubber", "ok": false, "fb": "No."}, {"t": "Wood", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p04", "type": "mcq", "prompt": "A plug's cord is covered in plastic because plastic is…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "an insulator", "ok": true, "fb": "Correct."}, {"t": "a conductor", "ok": false, "fb": "No."}, {"t": "magnetic", "ok": false, "fb": "No."}, {"t": "cheap metal", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p05", "type": "mcq", "prompt": "Electricians wear rubber gloves because rubber…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "conducts well", "ok": false, "fb": "No."}, {"t": "doesn't conduct electricity", "ok": true, "fb": "Correct."}, {"t": "is warm", "ok": false, "fb": "No."}, {"t": "is magnetic", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p06", "type": "mcq", "prompt": "In insulators, electrons are…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "free to move", "ok": false, "fb": "Conductors."}, {"t": "missing", "ok": false, "fb": "No."}, {"t": "positive", "ok": false, "fb": "No."}, {"t": "not free to move", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s1p07", "type": "mcq", "prompt": "To test a material, place it…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "in water", "ok": false, "fb": "No."}, {"t": "in a fire", "ok": false, "fb": "No."}, {"t": "next to a magnet", "ok": false, "fb": "No."}, {"t": "in a gap in a simple circuit", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s1p08", "type": "mcq", "prompt": "If the lamp lights when a material bridges the gap, the material is…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "an insulator", "ok": false, "fb": "No."}, {"t": "a cell", "ok": false, "fb": "No."}, {"t": "a conductor", "ok": true, "fb": "Correct."}, {"t": "a switch", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p09", "type": "grid", "prompt": "Conductor or insulator?", "diff": "M", "obj": "O1", "skill": "Data", "cols": ["Conductor", "Insulator"], "rows": [{"l": "Gold", "a": ["Conductor"]}, {"l": "Wood", "a": ["Insulator"]}, {"l": "Aluminium foil", "a": ["Conductor"]}, {"l": "Rubber band", "a": ["Insulator"]}], "hint": "", "reason": ""}, {"id": "u12s1p10", "type": "mcq", "prompt": "Building wiring uses copper because…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "it is one of the best conductors", "ok": true, "fb": "Correct."}, {"t": "it is cheapest", "ok": false, "fb": "No."}, {"t": "it is an insulator", "ok": false, "fb": "No."}, {"t": "it is light", "ok": false, "fb": "Aluminium is lighter."}], "hint": "", "reason": ""}, {"id": "u12s1p11", "type": "mcq", "prompt": "Electrons can be made to flow in…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "all directions randomly only", "ok": false, "fb": "No."}, {"t": "only in insulators", "ok": false, "fb": "No."}, {"t": "one direction around a circuit", "ok": true, "fb": "Correct."}, {"t": "only in a vacuum", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p12", "type": "mcq", "prompt": "Why are kettle plugs safe to touch?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "They have no metal", "ok": false, "fb": "No."}, {"t": "Plastic conducts", "ok": false, "fb": "No."}, {"t": "Electricity is off always", "ok": false, "fb": "No."}, {"t": "Metal inside carries current; plastic outside insulates", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s1p13", "type": "mcq", "prompt": "Graphite in a pencil lead conducts. It is…", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "a non-metal conductor", "ok": true, "fb": "Correct."}, {"t": "a metal", "ok": false, "fb": "No."}, {"t": "an insulator", "ok": false, "fb": "It conducts."}, {"t": "rubber", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p14", "type": "multi", "prompt": "Select ALL electrical insulators.", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Rubber", "ok": true, "fb": ""}, {"t": "Copper", "ok": false, "fb": "Conductor."}, {"t": "Iron", "ok": false, "fb": "Conductor."}, {"t": "Plastic", "ok": true, "fb": ""}, {"t": "Glass", "ok": true, "fb": ""}], "hint": "3 statements are correct.", "reason": ""}, {"id": "u12s1p15", "type": "mcq", "prompt": "The centre of an atom contains…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "electrons only", "ok": false, "fb": "No."}, {"t": "protons and neutrons", "ok": true, "fb": "Correct."}, {"t": "nothing", "ok": false, "fb": "No."}, {"t": "air", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p16", "type": "mcq", "prompt": "Pure water is a poor conductor, but tap water conducts a little. Why must you never touch switches with wet hands?", "diff": "H", "obj": "O1", "skill": "Reasoning", "options": [{"t": "Water is an insulator always", "ok": false, "fb": "No."}, {"t": "Switches melt", "ok": false, "fb": "No."}, {"t": "Water with dissolved substances can conduct, risking a shock", "ok": true, "fb": "Correct."}, {"t": "It's fine", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s1p17", "type": "order", "prompt": "Order the steps to test if a material conducts.", "diff": "M", "obj": "O1", "skill": "Knowledge", "items": ["Build a circuit with a cell, lamp and a gap", "Place the material across the gap", "Observe the lamp", "Record conductor or insulator"], "hint": "", "reason": ""}, {"id": "u12s1p18", "type": "mcq", "prompt": "Electricity carries energy to our…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "food only", "ok": false, "fb": "No."}, {"t": "rocks", "ok": false, "fb": "No."}, {"t": "clouds", "ok": false, "fb": "No."}, {"t": "homes, schools and cars", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}], "stops": [{"id": "u12v1a", "note": "Paused after: “This flow of electrons is electricity.”", "q": {"id": "u12v1a_q", "type": "mcq", "prompt": "Electrons carry a…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "positive charge", "ok": false, "fb": "Protons."}, {"t": "no charge", "ok": false, "fb": "Neutrons."}, {"t": "magnetic pole", "ok": false, "fb": "No."}, {"t": "negative charge", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}, {"id": "u12v1b", "note": "Paused after: “To test a material, place it in a gap in a simple circuit. If the lamp lights up, the mate”", "q": {"id": "u12v1b_q", "type": "mcq", "prompt": "Which is an insulator?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Rubber", "ok": true, "fb": "Correct."}, {"t": "Copper", "ok": false, "fb": "No."}, {"t": "Gold", "ok": false, "fb": "No."}, {"t": "Iron", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u12v1c", "note": "Paused after: “If we touch an exposed wire, electrons can flow through our body into the ground, giving u”", "q": {"id": "u12v1c_q", "type": "mcq", "prompt": "Why do electricians wear rubber-soled shoes?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Rubber doesn't conduct electricity", "ok": true, "fb": "Correct."}, {"t": "Rubber is a conductor", "ok": false, "fb": "No."}, {"t": "For comfort only", "ok": false, "fb": "No."}, {"t": "Rubber is magnetic", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}]}, {"id": "12.2", "prac": [{"id": "u12s2p01", "type": "mcq", "prompt": "If there is a gap in a circuit, it is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "an open circuit", "ok": true, "fb": "Correct."}, {"t": "a closed circuit", "ok": false, "fb": "No."}, {"t": "a battery", "ok": false, "fb": "No."}, {"t": "a conductor", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p02", "type": "mcq", "prompt": "Turning a light switch off…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "opens the circuit", "ok": true, "fb": "Correct."}, {"t": "closes the circuit", "ok": false, "fb": "No."}, {"t": "removes the cell", "ok": false, "fb": "No."}, {"t": "adds a lamp", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p03", "type": "mcq", "prompt": "In circuit diagrams, wires are drawn as…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "wavy lines", "ok": false, "fb": "No."}, {"t": "straight lines", "ok": true, "fb": "Correct."}, {"t": "circles", "ok": false, "fb": "No."}, {"t": "dots", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p04", "type": "mcq", "prompt": "The short line in the cell symbol is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "the positive terminal", "ok": false, "fb": "Long line."}, {"t": "a lamp", "ok": false, "fb": "No."}, {"t": "a switch", "ok": false, "fb": "No."}, {"t": "the negative terminal", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s2p05", "type": "mcq", "prompt": "Energy in a circuit is transferred from the cell to the lamp…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "by sound", "ok": false, "fb": "No."}, {"t": "electrically through the wires", "ok": true, "fb": "Correct."}, {"t": "by magnets", "ok": false, "fb": "No."}, {"t": "by heating the cell", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p06", "type": "mcq", "prompt": "A switch lets us…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "measure current", "ok": false, "fb": "Ammeter."}, {"t": "make light", "ok": false, "fb": "Lamp."}, {"t": "open or close the circuit", "ok": true, "fb": "Correct."}, {"t": "store charge", "ok": false, "fb": "Cell."}], "hint": "", "reason": ""}, {"id": "u12s2p07", "type": "mcq", "prompt": "A buzzer sounds the moment you press the switch because…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "the buzzer is close", "ok": false, "fb": "No."}, {"t": "sound is fast", "ok": false, "fb": "No."}, {"t": "the cell is new", "ok": false, "fb": "No."}, {"t": "electricity travels incredibly fast", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s2p08", "type": "grid", "prompt": "Open or closed circuit?", "diff": "M", "obj": "O2", "skill": "Figure", "cols": ["Closed", "Open"], "rows": [{"l": "Lamp lit", "a": ["Closed"]}, {"l": "Switch off", "a": ["Open"]}, {"l": "Broken wire", "a": ["Open"]}], "hint": "", "reason": ""}, {"id": "u12s2p09", "type": "mcq", "prompt": "A circle with a cross inside is the symbol for a…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "cell", "ok": false, "fb": "No."}, {"t": "lamp", "ok": true, "fb": "Correct."}, {"t": "switch", "ok": false, "fb": "No."}, {"t": "buzzer", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p10", "type": "mcq", "prompt": "A circle with an A inside is the symbol for…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a lamp", "ok": false, "fb": "No."}, {"t": "a cell", "ok": false, "fb": "No."}, {"t": "a switch", "ok": false, "fb": "No."}, {"t": "an ammeter", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s2p11", "type": "mcq", "prompt": "Which component drives the electrons?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "The lamp", "ok": false, "fb": "No."}, {"t": "The switch", "ok": false, "fb": "No."}, {"t": "The cell", "ok": true, "fb": "Correct."}, {"t": "The wire", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p12", "type": "mcq", "prompt": "A circuit has a cell, a lamp and an open switch. The lamp is…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "off", "ok": true, "fb": "Correct."}, {"t": "on", "ok": false, "fb": "No."}, {"t": "dim", "ok": false, "fb": "No."}, {"t": "flashing", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p13", "type": "mcq", "prompt": "Which order must components be drawn in a single loop?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Cell must be last", "ok": false, "fb": "No."}, {"t": "Any order, joined in one complete loop", "ok": true, "fb": "Correct."}, {"t": "Lamp must be first", "ok": false, "fb": "No."}, {"t": "Switch must touch the cell", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p14", "type": "order", "prompt": "Order the steps to draw a doorbell circuit diagram.", "diff": "M", "obj": "O2", "skill": "Knowledge", "items": ["Draw the cell symbol", "Add the buzzer symbol", "Add a switch symbol", "Join them with straight lines into one loop"], "hint": "", "reason": ""}, {"id": "u12s2p15", "type": "mcq", "prompt": "Why might a torch not work even with a new cell?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "New cells never work", "ok": false, "fb": "No."}, {"t": "Light is too fast", "ok": false, "fb": "No."}, {"t": "There may be a break in the circuit", "ok": true, "fb": "Correct."}, {"t": "Torches need two switches", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u12s2p16", "type": "mcq", "prompt": "A battery is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a single lamp", "ok": false, "fb": "No."}, {"t": "a switch", "ok": false, "fb": "No."}, {"t": "a wire", "ok": false, "fb": "No."}, {"t": "two or more cells joined together", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u12s2p17", "type": "grid", "prompt": "Component → job", "diff": "M", "obj": "O2", "skill": "Data", "cols": ["Light", "Sound", "Measure current"], "rows": [{"l": "Lamp", "a": ["Light"]}, {"l": "Buzzer", "a": ["Sound"]}, {"l": "Ammeter", "a": ["Measure current"]}], "hint": "", "reason": ""}, {"id": "u12s2p18", "type": "mcq", "prompt": "Pressing a doorbell button…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "opens it", "ok": false, "fb": "No."}, {"t": "removes the cell", "ok": false, "fb": "No."}, {"t": "adds a lamp", "ok": false, "fb": "No."}, {"t": "closes the circuit", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}], "stops": [{"id": "u12v2a", "note": "Paused after: “If there's a gap or break, electrons can't flow. It's an open circuit, and the lamp goes o”", "q": {"id": "u12v2a_q", "type": "mcq", "prompt": "A complete path for electrons is…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "an open circuit", "ok": false, "fb": "No."}, {"t": "an insulator", "ok": false, "fb": "No."}, {"t": "a closed circuit", "ok": true, "fb": "Correct."}, {"t": "a gap", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u12v2b", "note": "Paused after: “In the cell symbol, the long line is the positive terminal, and the short line is the nega”", "q": {"id": "u12v2b_q", "type": "mcq", "prompt": "In the cell symbol, the long line is…", "diff": "H", "obj": "O2", "skill": "Knowledge", "opt