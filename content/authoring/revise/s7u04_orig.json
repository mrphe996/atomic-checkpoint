 "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "one choice", "ok": false, "fb": "Two."}, {"t": "two choices", "ok": true, "fb": "Correct."}, {"t": "three choices", "ok": false, "fb": "Two."}, {"t": "no choices", "ok": false, "fb": "Two."}], "hint": "", "reason": ""}, {"id": "u4s5p02", "type": "mcq", "prompt": "A key can be drawn as branches or written as…", "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "a poem", "ok": false, "fb": "No."}, {"t": "a graph", "ok": false, "fb": "No."}, {"t": "a single sentence", "ok": false, "fb": "No."}, {"t": "a numbered list of paired statements", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s5p03", "type": "mcq", "prompt": "Key: 1a has wings → 2 | 1b no wings → 3 | 2a protective wing cover → 4 | 2b no cover → moth | 3a very long antennae → silverfish | 3b short antennae → flea | 4a rounded body → ladybird | 4b long, flat body → cockroach. An insect has wings but no protective cover. What is it?", "diff": "H", "obj": "O6", "skill": "Data", "options": [{"t": "Ladybird", "ok": false, "fb": "Needs a cover."}, {"t": "Moth", "ok": true, "fb": "Correct."}, {"t": "Cockroach", "ok": false, "fb": "Needs a cover."}, {"t": "Flea", "ok": false, "fb": "No wings."}], "hint": "", "reason": ""}, {"id": "u4s5p04", "type": "mcq", "prompt": "Key: 1a has wings → 2 | 1b no wings → 3 | 2a protective wing cover → 4 | 2b no cover → moth | 3a very long antennae → silverfish | 3b short antennae → flea | 4a rounded body → ladybird | 4b long, flat body → cockroach. No wings, short antennae.", "diff": "H", "obj": "O6", "skill": "Data", "options": [{"t": "Silverfish", "ok": false, "fb": "Very long antennae."}, {"t": "Moth", "ok": false, "fb": "Wings."}, {"t": "Cockroach", "ok": false, "fb": "Wings."}, {"t": "Flea", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s5p05", "type": "mcq", "prompt": "Paired-statement key for seed plants without flowers: 1a cones → 2; 1b no cones → yew. 2a large cones → 3; 2b small cones → juniper. 3a broad leaves → kauri; 3b narrow leaves → 4. 4a needle-like → pine; 4b fern-like → cycad. A plant has large cones and narrow, needle-like leaves.", "diff": "H", "obj": "O6", "skill": "Data", "options": [{"t": "Cycad", "ok": false, "fb": "Fern-like leaves."}, {"t": "Kauri", "ok": false, "fb": "Broad leaves."}, {"t": "Pine", "ok": true, "fb": "Correct."}, {"t": "Juniper", "ok": false, "fb": "Small cones."}], "hint": "", "reason": ""}, {"id": "u4s5p06", "type": "mcq", "prompt": "Same key: a plant has no cones. What is it?", "diff": "H", "obj": "O6", "skill": "Data", "options": [{"t": "Pine", "ok": false, "fb": "Has cones."}, {"t": "Juniper", "ok": false, "fb": "Has small cones."}, {"t": "Yew", "ok": true, "fb": "Correct."}, {"t": "Cycad", "ok": false, "fb": "Has large cones."}], "hint": "", "reason": ""}, {"id": "u4s5p07", "type": "mcq", "prompt": "What is at the end of each branch of a finished key?", "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "A question", "ok": false, "fb": "Questions come before."}, {"t": "Two organisms", "ok": false, "fb": "Each ends with one."}, {"t": "Nothing", "ok": false, "fb": "A name."}, {"t": "The name of one organism", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s5p08", "type": "mcq", "prompt": "Which feature splits a bird, a fish, a dog and a frog into two groups of two?", "diff": "H", "obj": "O6", "skill": "Reasoning", "options": [{"t": "Is it alive?", "ok": false, "fb": "All are alive."}, {"t": "Does it have a backbone?", "ok": false, "fb": "All four do."}, {"t": "Does it eat?", "ok": false, "fb": "All eat."}, {"t": "Does it have fur or feathers? (bird, dog) vs (fish, frog)", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s5p09", "type": "mcq", "prompt": "Why is 'Does it live in water?' not always a good key question?", "diff": "H", "obj": "O6", "skill": "Reasoning", "options": [{"t": "Some animals live both in water and on land (e.g. frogs), so the answer is unclear.", "ok": true, "fb": "Correct."}, {"t": "Water is not a feature.", "ok": false, "fb": "Habitat can be used but may be unclear."}, {"t": "It is too easy.", "ok": false, "fb": "Not the problem."}, {"t": "All animals live in water.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u4s5p10", "type": "mcq", "prompt": "How can you check that your key works?", "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "Make it longer.", "ok": false, "fb": "Not a check."}, {"t": "Ask a classmate to use it to identify the organisms.", "ok": true, "fb": "Correct."}, {"t": "Use more colours.", "ok": false, "fb": "Not a check."}, {"t": "Hide it.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u4s5p11", "type": "mcq", "prompt": "To identify 6 organisms with a dichotomous key, what is the smallest number of questions you need?", "diff": "H", "obj": "O6", "skill": "Reasoning", "options": [{"t": "3", "ok": false, "fb": "Each question removes only one branch split."}, {"t": "6", "ok": false, "fb": "One fewer than the number of organisms."}, {"t": "5", "ok": true, "fb": "Correct."}, {"t": "12", "ok": false, "fb": "Too many."}], "hint": "", "reason": "Each yes/no question creates one extra branch end: 6 organisms need 6 − 1 = 5 questions."}, {"id": "u4s5p12", "type": "mcq", "prompt": "Which is a visible feature?", "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "Favourite food", "ok": false, "fb": "Not visible."}, {"t": "Number of wings", "ok": true, "fb": "Correct."}, {"t": "Age in days", "ok": false, "fb": "Not visible."}, {"t": "Mood", "ok": false, "fb": "Not visible."}], "hint": "", "reason": ""}, {"id": "u4s5p13", "type": "mcq", "prompt": "A key question is 'Is it longer than 5 cm?'. What do you need to answer it?", "diff": "H", "obj": "O6", "skill": "Knowledge", "options": [{"t": "A microscope", "ok": false, "fb": "Not needed for 5 cm."}, {"t": "A thermometer", "ok": false, "fb": "Measures temperature."}, {"t": "Nothing – guess", "ok": false, "fb": "Measure to be accurate."}, {"t": "A ruler – a measurement", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s5p14", "type": "match", "prompt": "Match the key words.", "diff": "M", "obj": "O6", "skill": "Knowledge", "pairs": [{"l": "Dichotomous", "r": "dividing into two"}, {"l": "Identify", "r": "find the name of"}, {"l": "Feature", "r": "characteristic you can observe"}], "hint": "", "reason": ""}, {"id": "u4s5p15", "type": "mcq", "prompt": "Two students using the same key get different names for one beetle. What is the most likely problem?", "diff": "H", "obj": "O6", "skill": "Reasoning", "options": [{"t": "A question in the key is unclear or uses a feature that varies.", "ok": true, "fb": "Correct."}, {"t": "Beetles cannot be identified.", "ok": false, "fb": "They can."}, {"t": "Keys never work.", "ok": false, "fb": "Good keys do."}, {"t": "One student was too tall.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u4s5p16", "type": "order", "prompt": "Order the steps for using a numbered key.", "diff": "M", "obj": "O6", "skill": "Knowledge", "items": ["Read statement 1a and 1b", "Choose the one that matches", "Go to the number it tells you", "Repeat until you reach a name"], "hint": "", "reason": ""}, {"id": "u4s5p17", "type": "mcq", "prompt": "Which pair of statements is BEST for the first step of a key for fish, birds and dogs?", "diff": "H", "obj": "O6", "skill": "Knowledge", "options": [{"t": "1a Is big / 1b Is small", "ok": false, "fb": "Vague."}, {"t": "1a Is cute / 1b Is not cute", "ok": false, "fb": "Opinion."}, {"t": "1a Is brown / 1b Is grey", "ok": false, "fb": "Colours vary."}, {"t": "1a Has feathers / 1b Has no feathers", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s5p18", "type": "mcq", "prompt": "Keys are used to…", "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "count species", "ok": false, "fb": "No."}, {"t": "make new species", "ok": false, "fb": "No."}, {"t": "identify living things we do not recognise", "ok": true, "fb": "Correct."}, {"t": "measure mass", "ok": false, "fb": "No."}], "hint": "", "reason": ""}], "stops": [{"id": "u4v5a", "note": "Paused after: “Wings with no protective cover? It's a moth.”", "q": {"id": "u4v5a_q", "type": "mcq", "prompt": "A dichotomous key gives how many choices at each step?", "diff": "M", "obj": "O6", "skill": "Knowledge", "options": [{"t": "Two", "ok": true, "fb": "Correct."}, {"t": "One", "ok": false, "fb": "Two."}, {"t": "Three", "ok": false, "fb": "Two."}, {"t": "Seven", "ok": false, "fb": "Two."}], "hint": "", "reason": ""}}, {"id": "u4v5b", "note": "Paused after: “Step 4: the leaves are fern-like, so choose 4b. The plant is a cycad!”", "q": {"id": "u4v5b_q", "type": "mcq", "prompt": "In a numbered key, after choosing 1a you…", "diff": "H", "obj": "O6", "skill": "Knowledge", "options": [{"t": "stop at once", "ok": false, "fb": "Only stop at a name."}, {"t": "go back to the start", "ok": false, "fb": "No."}, {"t": "go to the number it tells you", "ok": true, "fb": "Correct."}, {"t": "pick any number", "ok": false, "fb": "Follow the key."}], "hint": "", "reason": ""}}, {"id": "u4v5c", "note": "Paused after: “Use visible features that don't vary, like the number of legs, and test your key by swappi”", "q": {"id": "u4v5c_q", "type": "mcq", "prompt": "Which feature is best for a key?", "diff": "H", "obj": "O6", "skill": "Knowledge", "options": [{"t": "Colour", "ok": false, "fb": "Varies."}, {"t": "How cute it is", "ok": false, "fb": "Opinion."}, {"t": "Its mood", "ok": false, "fb": "Not observable."}, {"t": "Number of legs", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}}]}]}