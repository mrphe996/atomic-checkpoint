{"sections": [{"id": "4.1", "prac": [{"id": "u4s1p01", "type": "mcq", "prompt": "What does the 'G' in MRS GREN stand for?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Growth", "ok": true, "fb": "Correct."}, {"t": "Gravity", "ok": false, "fb": "Not a life process."}, {"t": "Germination", "ok": false, "fb": "Germination is how a seed starts growing – one example of growth."}, {"t": "Gas exchange", "ok": false, "fb": "Part of breathing, not one of the seven."}], "hint": "", "reason": ""}, {"id": "u4s1p02", "type": "mcq", "prompt": "Which is an example of excretion in humans?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Breathing out carbon dioxide", "ok": true, "fb": "Correct."}, {"t": "Eating lunch", "ok": false, "fb": "That is nutrition."}, {"t": "Running", "ok": false, "fb": "That is movement."}, {"t": "Getting taller", "ok": false, "fb": "That is growth."}], "hint": "", "reason": ""}, {"id": "u4s1p03", "type": "mcq", "prompt": "Where in a cell does aerobic respiration take place?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Mitochondria", "ok": true, "fb": "Correct."}, {"t": "Nucleus", "ok": false, "fb": "The nucleus controls the cell."}, {"t": "Cell wall", "ok": false, "fb": "Supports plant cells."}, {"t": "Vacuole", "ok": false, "fb": "Stores cell sap."}], "hint": "", "reason": ""}, {"id": "u4s1p04", "type": "mcq", "prompt": "How do plants get their food?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "They eat insects only.", "ok": false, "fb": "Only a few plants catch insects – and they still photosynthesise."}, {"t": "They absorb food from soil.", "ok": false, "fb": "Roots take in water and mineral salts, not food."}, {"t": "They make it by photosynthesis using light, carbon dioxide and water.", "ok": true, "fb": "Correct."}, {"t": "They do not need food.", "ok": false, "fb": "All living things need nutrition."}], "hint": "", "reason": ""}, {"id": "u4s1p05", "type": "mcq", "prompt": "Earthworms move away from light. Which life process is this?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Sensitivity", "ok": true, "fb": "Correct."}, {"t": "Respiration", "ok": false, "fb": "Releasing energy – not responding."}, {"t": "Nutrition", "ok": false, "fb": "Not about food here."}, {"t": "Excretion", "ok": false, "fb": "Not about waste."}], "hint": "", "reason": ""}, {"id": "u4s1p06", "type": "mcq", "prompt": "Through which tiny holes in leaves do plants release waste gases?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Roots", "ok": false, "fb": "Roots are not holes in leaves."}, {"t": "Stomata", "ok": true, "fb": "Correct."}, {"t": "Chloroplasts", "ok": false, "fb": "These carry out photosynthesis."}, {"t": "Petals", "ok": false, "fb": "Petals are part of flowers."}], "hint": "", "reason": ""}, {"id": "u4s1p07", "type": "multi", "prompt": "Select ALL the ways humans excrete waste.", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Kidneys make urine", "ok": true, "fb": ""}, {"t": "Skin releases sweat containing salts and a little urea", "ok": true, "fb": ""}, {"t": "Eyes make tears to see better", "ok": false, "fb": "Tears protect the eyes; not the main excretion organs here."}, {"t": "Stomach digests food", "ok": false, "fb": "Digestion is part of nutrition."}, {"t": "Lungs breathe out carbon dioxide", "ok": true, "fb": ""}], "hint": "3 statements are correct.", "reason": ""}, {"id": "u4s1p08", "type": "order", "prompt": "Put these stages of a frog's life in order (growth).", "diff": "M", "obj": "O1", "skill": "Knowledge", "items": ["Egg", "Tadpole", "Tadpole with legs", "Young frog", "Adult frog"], "hint": "", "reason": ""}, {"id": "u4s1p09", "type": "mcq", "prompt": "An organism grows when…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "it drinks more water only.", "ok": false, "fb": "Water alone is not growth."}, {"t": "it moves more.", "ok": false, "fb": "Movement is a different process."}, {"t": "it stops respiring.", "ok": false, "fb": "It needs energy from respiration to grow."}, {"t": "the number of its cells increases or its cells get bigger.", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s1p10", "type": "mcq", "prompt": "Which shows reproduction?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "An ostrich chick hatches from an egg.", "ok": true, "fb": "Correct."}, {"t": "A lizard runs into the sun.", "ok": false, "fb": "That is movement / sensitivity."}, {"t": "A lion eats meat.", "ok": false, "fb": "Nutrition."}, {"t": "A tree loses leaves.", "ok": false, "fb": "Not producing offspring."}], "hint": "", "reason": ""}, {"id": "u4s1p11", "type": "mcq", "prompt": "Why must living things excrete?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "To make room for more food.", "ok": false, "fb": "Excretion is not about undigested food."}, {"t": "To move faster.", "ok": false, "fb": "Not related."}, {"t": "Waste from chemical reactions in cells would harm the organism if it built up.", "ok": true, "fb": "Correct."}, {"t": "To make the organism heavier.", "ok": false, "fb": "The opposite."}], "hint": "", "reason": ""}, {"id": "u4s1p12", "type": "match", "prompt": "Match the example to the process.", "diff": "M", "obj": "O1", "skill": "Knowledge", "pairs": [{"l": "Evening primrose opens at sunset", "r": "sensitivity"}, {"l": "Climbing plant winds round a pole", "r": "movement"}, {"l": "Tulip bulb becomes a plant", "r": "growth"}, {"l": "Plant makes seeds", "r": "reproduction"}], "hint": "", "reason": ""}, {"id": "u4s1p13", "type": "mcq", "prompt": "A sundew's sticky leaves close over insects. This shows sensitivity and…", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "nutrition", "ok": true, "fb": "Correct."}, {"t": "excretion", "ok": false, "fb": "It is getting food, not removing waste."}, {"t": "respiration", "ok": false, "fb": "Respiration happens, but closing on prey is about food."}, {"t": "reproduction", "ok": false, "fb": "No offspring are made."}], "hint": "", "reason": ""}, {"id": "u4s1p14", "type": "num", "prompt": "How many life processes do ALL living things carry out?", "diff": "M", "obj": "O1", "skill": "Application", "answer": 7, "unit": "processes", "tol": 0.0, "units": ["processes"], "errs": [], "unitFb": "", "hint": "Count the letters in MRS GREN.", "reason": ""}, {"id": "u4s1p15", "type": "mcq", "prompt": "Fish have special cells along their sides that sense water movements. Why is this useful?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "They help the fish digest food.", "ok": false, "fb": "These cells sense, they do not digest."}, {"t": "They make the fish grow faster.", "ok": false, "fb": "Not linked to sensing."}, {"t": "They store oxygen.", "ok": false, "fb": "Not their job."}, {"t": "They can detect predators nearby and escape.", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s1p16", "type": "mcq", "prompt": "What do the kidneys make?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Sweat", "ok": false, "fb": "Skin makes sweat."}, {"t": "Urine, containing water, urea and salts", "ok": true, "fb": "Correct."}, {"t": "Carbon dioxide", "ok": false, "fb": "Made in cells and breathed out by the lungs."}, {"t": "Saliva", "ok": false, "fb": "Made in the mouth for digestion."}], "hint": "", "reason": ""}, {"id": "u4s1p17", "type": "mcq", "prompt": "Which statement about plant movement is TRUE?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Plants never move.", "ok": false, "fb": "They do – just slowly."}, {"t": "Plants move parts of themselves slowly, for example turning towards light.", "ok": true, "fb": "Correct."}, {"t": "Plants move from place to place.", "ok": false, "fb": "Plants do not move their whole body to a new place."}, {"t": "Only flowers move.", "ok": false, "fb": "Stems, leaves and tendrils also move."}], "hint": "", "reason": ""}, {"id": "u4s1p18", "type": "multi", "prompt": "A fire grows, moves, uses oxygen and gives off carbon dioxide. Select ALL the reasons it is NOT alive.", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "It uses oxygen", "ok": false, "fb": "Living things use oxygen too – this is not a reason."}, {"t": "It is not made of cells", "ok": true, "fb": ""}, {"t": "It does not reproduce by making offspring", "ok": true, "fb": ""}, {"t": "It does not sense and respond to changes", "ok": true, "fb": ""}, {"t": "It is too hot", "ok": false, "fb": "Temperature does not decide whether something is alive."}], "hint": "3 statements are correct.", "reason": ""}], "stops": [{"id": "u4v1a", "note": "Paused after: “And N is for nutrition. Every living thing does all seven!”", "q": {"id": "u4v1a_q", "type": "mcq", "prompt": "Which list is MRS GREN?", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Movement, Rest, Sleep, Growth, Running, Eating, Noise", "ok": false, "fb": "Not life processes."}, {"t": "Movement, Respiration, Sensitivity, Growth, Reproduction, Excretion, Nutrition", "ok": true, "fb": "Correct."}, {"t": "Muscles, Respiration, Skin, Growth, Reproduction, Eyes, Nose", "ok": false, "fb": "Body parts are not processes."}, {"t": "Movement, Respiration, Sight, Gas, Reproduction, Energy, Nutrition", "ok": false, "fb": "Check S, G and E."}], "hint": "", "reason": ""}}, {"id": "u4v1b", "note": "Paused after: “Respiration is a series of chemical reactions in cells that releases energy from food. Aer”", "q": {"id": "u4v1b_q", "type": "mcq", "prompt": "The yeast made bubbles. Which life process does this show?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Excretion only", "ok": false, "fb": "The gas is a waste product, but it shows respiration happening."}, {"t": "Respiration", "ok": true, "fb": "Correct."}, {"t": "Movement", "ok": false, "fb": "No."}, {"t": "Nutrition", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u4v1c", "note": "Paused after: “Earthworms move away from light. Fish have special cells along their sides that sense move”", "q": {"id": "u4v1c_q", "type": "mcq", "prompt": "Sweating when we are hot is an example of…", "diff": "M", "obj": "O1", "skill": "Knowledge", "options": [{"t": "growth", "ok": false, "fb": "No."}, {"t": "reproduction", "ok": false, "fb": "No."}, {"t": "sensitivity – responding to a change", "ok": true, "fb": "Correct."}, {"t": "nutrition", "ok": false, "fb": "No."}], "hint": "", "reason": ""}}, {"id": "u4v1d", "note": "Paused after: “Humans excrete carbon dioxide through the lungs. The kidneys make urine, containing water,”", "q": {"id": "u4v1d_q", "type": "mcq", "prompt": "Which organ makes urine?", "diff": "H", "obj": "O1", "skill": "Knowledge", "options": [{"t": "Kidneys", "ok": true, "fb": "Correct."}, {"t": "Lungs", "ok": false, "fb": "They excrete carbon dioxide."}, {"t": "Skin", "ok": false, "fb": "Sweat."}, {"t": "Heart", "ok": false, "fb": "Pumps blood."}], "hint": "", "reason": ""}}]}, {"id": "4.2", "prac": [{"id": "u4s2p01", "type": "mcq", "prompt": "A cell that a virus invades is called a…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "host cell", "ok": true, "fb": "Correct."}, {"t": "guest cell", "ok": false, "fb": "Wrong term."}, {"t": "virus cell", "ok": false, "fb": "Viruses are not cells."}, {"t": "dead cell", "ok": false, "fb": "The virus needs a living cell."}], "hint": "", "reason": ""}, {"id": "u4s2p02", "type": "mcq", "prompt": "Which organisms can viruses attack?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Only humans", "ok": false, "fb": "Viruses attack many kinds of organisms."}, {"t": "Only plants", "ok": false, "fb": "Animals and bacteria too."}, {"t": "None – viruses are harmless", "ok": false, "fb": "Many cause disease."}, {"t": "Plants, animals and bacteria", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s2p03", "type": "mcq", "prompt": "Why can't a virus respire?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "It is too cold.", "ok": false, "fb": "Temperature is not the reason."}, {"t": "It has too many cells.", "ok": false, "fb": "It has none."}, {"t": "It has no mitochondria – it is not a cell.", "ok": true, "fb": "Correct."}, {"t": "It only respires at night.", "ok": false, "fb": "It never respires."}], "hint": "", "reason": ""}, {"id": "u4s2p04", "type": "mcq", "prompt": "Do scientists all agree on whether viruses are alive?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Yes – all agree they are alive.", "ok": false, "fb": "There is still debate."}, {"t": "Yes – all agree they are dead.", "ok": false, "fb": "There is still debate."}, {"t": "No – scientists are still debating the question.", "ok": true, "fb": "Correct."}, {"t": "Nobody has ever studied this.", "ok": false, "fb": "It is widely studied."}], "hint": "", "reason": ""}, {"id": "u4s2p05", "type": "multi", "prompt": "Select ALL the features viruses share with living things.", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "They respire", "ok": false, "fb": "They have no mitochondria."}, {"t": "They feed", "ok": false, "fb": "They do not take in food."}, {"t": "They are made of cells", "ok": false, "fb": "They are not cells."}, {"t": "They have genetic material", "ok": true, "fb": ""}, {"t": "They make copies of themselves inside a host cell", "ok": true, "fb": ""}], "hint": "2 statements are correct.", "reason": ""}, {"id": "u4s2p06", "type": "mcq", "prompt": "What often happens to the host cell when new viruses burst out?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "It is destroyed.", "ok": true, "fb": "Correct."}, {"t": "It becomes a virus.", "ok": false, "fb": "It does not change into a virus."}, {"t": "It grows bigger.", "ok": false, "fb": "It is usually destroyed."}, {"t": "It photosynthesises.", "ok": false, "fb": "Not related."}], "hint": "", "reason": ""}, {"id": "u4s2p07", "type": "mcq", "prompt": "Some viruses have an extra layer around the protein coat called…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "a cell wall", "ok": false, "fb": "Viruses have no cell wall."}, {"t": "a nucleus", "ok": false, "fb": "No nucleus."}, {"t": "a shell of bone", "ok": false, "fb": "No."}, {"t": "an envelope", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s2p08", "type": "mcq", "prompt": "Some scientists say a virus INSIDE a host cell could be considered living because…", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "the virus and the cell together carry out life processes, such as making copies.", "ok": true, "fb": "Correct."}, {"t": "the virus becomes a bacterium.", "ok": false, "fb": "It does not."}, {"t": "the virus grows a nucleus.", "ok": false, "fb": "It does not."}, {"t": "the virus can then live without the cell.", "ok": false, "fb": "It still depends on the cell."}], "hint": "", "reason": ""}, {"id": "u4s2p09", "type": "match", "prompt": "Match each part to its description.", "diff": "M", "obj": "O2", "skill": "Knowledge", "pairs": [{"l": "Genetic material", "r": "instructions, such as DNA"}, {"l": "Protein coat", "r": "protects the genetic material"}, {"l": "Envelope", "r": "outer layer some viruses have"}, {"l": "Host cell", "r": "living cell that a virus uses to copy itself"}], "hint": "", "reason": ""}, {"id": "u4s2p10", "type": "mcq", "prompt": "Which is the best way to reduce the spread of a cold virus in class?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Shout loudly.", "ok": false, "fb": "No effect."}, {"t": "Eat more sugar.", "ok": false, "fb": "No effect on spread."}, {"t": "Cover your mouth and nose when you sneeze and wash your hands.", "ok": true, "fb": "Correct."}, {"t": "Open your eyes wide.", "ok": false, "fb": "No effect."}], "hint": "", "reason": ""}, {"id": "u4s2p11", "type": "mcq", "prompt": "Why can't you treat a viral cold by killing virus cells?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Viruses are too big.", "ok": false, "fb": "They are tiny."}, {"t": "Viruses are plants.", "ok": false, "fb": "They are not plants."}, {"t": "Viruses are always helpful.", "ok": false, "fb": "Not true for cold viruses."}, {"t": "Viruses are not cells.", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s2p12", "type": "mcq", "prompt": "Which microscope do we need to see viruses?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "A hand lens", "ok": false, "fb": "Far too weak."}, {"t": "A school light microscope", "ok": false, "fb": "Usually too weak for viruses."}, {"t": "A very powerful microscope (such as an electron microscope)", "ok": true, "fb": "Correct."}, {"t": "No microscope", "ok": false, "fb": "They are far too small to see."}], "hint": "", "reason": ""}, {"id": "u4s2p13", "type": "mcq", "prompt": "Which life process do viruses NOT show?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Having genetic material", "ok": false, "fb": "This is not a life process – and they do have it."}, {"t": "Making copies inside a host", "ok": false, "fb": "They do this."}, {"t": "Excretion", "ok": true, "fb": "Correct."}, {"t": "Being carried in the air", "ok": false, "fb": "That is not a life process."}], "hint": "", "reason": ""}, {"id": "u4s2p14", "type": "mcq", "prompt": "Viruses outside a host cell are usually described as…", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "living cells", "ok": false, "fb": "They are not cells."}, {"t": "multicellular organisms", "ok": false, "fb": "No."}, {"t": "plants", "ok": false, "fb": "No."}, {"t": "non-living particles", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s2p15", "type": "order", "prompt": "Put these in order of size, smallest first.", "diff": "M", "obj": "O2", "skill": "Knowledge", "items": ["Virus", "Bacterium", "Human cheek cell", "Grain of rice"], "hint": "", "reason": ""}, {"id": "u4s2p16", "type": "mcq", "prompt": "A student says 'viruses are alive because they make us ill'. What is wrong with this reasoning?", "diff": "H", "obj": "O2", "skill": "Reasoning", "options": [{"t": "Causing illness does not prove something is alive – some poisons cause illness too.", "ok": true, "fb": "Correct."}, {"t": "Nothing – it is correct.", "ok": false, "fb": "Making you ill is not a life process."}, {"t": "Viruses never cause illness.", "ok": false, "fb": "Many do."}, {"t": "Only bacteria cause illness.", "ok": false, "fb": "Viruses do too."}], "hint": "", "reason": ""}, {"id": "u4s2p17", "type": "mcq", "prompt": "Which word describes a virus particle's protective outer covering?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "Skin", "ok": false, "fb": "Viruses have no skin."}, {"t": "Shell", "ok": false, "fb": "Not the right term."}, {"t": "Protein coat", "ok": true, "fb": "Correct."}, {"t": "Membrane of a cell", "ok": false, "fb": "Viruses are not cells."}], "hint": "", "reason": ""}, {"id": "u4s2p18", "type": "mcq", "prompt": "A sneeze sends droplets across a room. Why does this matter for viruses?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "It carries virus particles to other people, because viruses cannot move themselves.", "ok": true, "fb": "Correct."}, {"t": "It kills all viruses.", "ok": false, "fb": "It spreads them."}, {"t": "It makes viruses grow bigger.", "ok": false, "fb": "No."}, {"t": "It turns viruses into bacteria.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}], "stops": [{"id": "u4v2a", "note": "Paused after: “The virus uses the host cell to make many copies of itself. The new viruses burst out, oft”", "q": {"id": "u4v2a_q", "type": "mcq", "prompt": "Where does a virus make copies of itself?", "diff": "M", "obj": "O2", "skill": "Knowledge", "options": [{"t": "In the air", "ok": false, "fb": "It is only carried by air."}, {"t": "Inside a living host cell", "ok": true, "fb": "Correct."}, {"t": "On its own in water", "ok": false, "fb": "It needs a host."}, {"t": "Inside its own nucleus", "ok": false, "fb": "It has no nucleus."}], "hint": "", "reason": ""}}, {"id": "u4v2b", "note": "Paused after: “So virus particles are usually thought of as non-living. But some scientists say that insi”", "q": {"id": "u4v2b_q", "type": "mcq", "prompt": "Why are virus particles usually thought of as non-living?", "diff": "H", "obj": "O2", "skill": "Knowledge", "options": [{"t": "They are too small to see.", "ok": false, "fb": "Size is not the reason."}, {"t": "They are not made of cells and cannot respire, feed or move by themselves.", "ok": true, "fb": "Correct."}, {"t": "They are made of DNA.", "ok": false, "fb": "Having DNA is a feature of living things."}, {"t": "They never cause disease.", "ok": false, "fb": "They often do."}], "hint": "", "reason": ""}}]}, {"id": "4.3", "prac": [{"id": "u4s3p01", "type": "mcq", "prompt": "Classification means…", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "counting animals.", "ok": false, "fb": "Not the meaning."}, {"t": "killing pests.", "ok": false, "fb": "No."}, {"t": "sorting and grouping things according to their similarities.", "ok": true, "fb": "Correct."}, {"t": "naming countries.", "ok": false, "fb": "No."}], "hint": "", "reason": ""}, {"id": "u4s3p02", "type": "mcq", "prompt": "Who invented the two-word naming system?", "diff": "M", "obj": "O4", "skill": "Knowledge", "options": [{"t": "Aristotle", "ok": false, "fb": "He used two groups: plants and animals."}, {"t": "R. H. Whittaker", "ok": false, "fb": "He proposed five kingdoms."}, {"t": "Robert Hooke", "ok": false, "fb": "He named cells."}, {"t": "Carl Linnaeus", "ok": true, "fb": "Correct."}], "hint": "", "reason": ""}, {"id": "u4s3p03", "type": "mcq", "prompt": "How many kingdoms do most scientists