# --- public (written into web/config.js at build time) ---
ATOMIC_MODE=live                      # live | demo (demo = no server, data in the browser)
BILLING=off                           # off = free test phase (no Paddle needed) | paddle = paid plans
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
PADDLE_ENV=sandbox                    # sandbox | production
PADDLE_CLIENT_TOKEN=test_...
PADDLE_PRICE_MONTHLY=pri_...
PADDLE_PRICE_YEARLY=pri_...
PRICE_LABEL_MONTHLY=£9.99 / month     # display only – Paddle shows the local price and tax at checkout
PRICE_LABEL_YEARLY=£79 / year
SUPPORT_EMAIL=support@example.com
# --- server only (Vercel environment variables, never in the browser) ---
SUPABASE_SERVICE_ROLE_KEY=eyJ...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_API_KEY=pdl_...
RESEND_API_KEY=re_...
MAIL_FROM=Atomic <hello@your-domain>
CRON_SECRET=a-long-random-string
